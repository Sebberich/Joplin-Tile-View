@@ -0,0 +1,21 @@
+import stripMarkdown from './tilePreviewText';
+
+describe('tilePreviewText', () => {
+	test.each([
+		['keeps line breaks between paragraphs', 'Line one\nLine two', 'Line one\nLine two'],
+		['collapses 3+ consecutive newlines to 2', 'a\n\n\n\nb', 'a\n\nb'],
+		['trims leading and trailing blank lines', '\n\nHello\n\n', 'Hello'],
+		['renders unordered list items as bullets', '- item one\n- item two', '• item one\n• item two'],
+		['keeps ordered list numbers as-is', '1. First\n2. Second', '1. First\n2. Second'],
+		['renders unchecked and checked task items', '- [ ] todo\n- [x] done', '☐ todo\n☑ done'],
+		['strips heading markers', '# Heading\nBody', 'Heading\nBody'],
+		['strips blockquote markers', '> Quoted text', 'Quoted text'],
+		['strips emphasis markers', '**bold** and _italic_ and ~strike~', 'bold and italic and strike'],
+		['keeps link text and drops the URL', '[Joplin](https://joplinapp.org)', 'Joplin'],
+		['drops images entirely', 'before ![alt](image.png) after', 'before  after'],
+		['removes fenced code blocks', 'before\n```\nsome code\n```\nafter', 'before\n\nafter'],
+		['unwraps inline code', 'Run `npm install` first', 'Run npm install first'],
+	])('%s', (_name, input, expected) => {
+		expect(stripMarkdown(input)).toBe(expected);
+	});
+});
diff --git a/packages/app-mobile/utils/tilePreviewText.ts b/packages/app-mobile/utils/tilePreviewText.ts
new file mode 100644
index 0000000..9575120
--- /dev/null
+++ b/packages/app-mobile/utils/tilePreviewText.ts
@@ -0,0 +1,55 @@
+// Task list items ("- [ ] foo" / "- [x] foo") must be checked for before plain unordered list
+// items, since they also start with a list marker.
+const taskListItemRegexp = /^(\s*)[-*+]\s+\[([ xX])\]\s+(.*)$/;
+const unorderedListItemRegexp = /^(\s*)[-*+]\s+(.*)$/;
+
+// Rewrites a single line of already-unwrapped Markdown into its plain-text preview form: list
+// markers become bullet/checkbox symbols (ordered list numbers are left as-is), while other line
+// content passes through unchanged.
+const rewriteListMarkers = (line: string) => {
+	const taskMatch = taskListItemRegexp.exec(line);
+	if (taskMatch) {
+		const [, indent, mark, rest] = taskMatch;
+		const checked = mark.toLowerCase() === 'x';
+		return `${indent}${checked ? '☑' : '☐'} ${rest}`;
+	}
+
+	const unorderedMatch = unorderedListItemRegexp.exec(line);
+	if (unorderedMatch) {
+		const [, indent, rest] = unorderedMatch;
+		return `${indent}• ${rest}`;
+	}
+
+	return line;
+};
+
+// Converts a note body from Markdown to plain text for the tile preview. Unlike a plain
+// "collapse everything to one line" strip, this keeps the note's line structure (paragraphs,
+// list items, ...) readable, since tiles show several lines of preview text. This is a rough
+// cleanup, not a full Markdown-to-text conversion.
+const stripMarkdown = (body: string) => {
+	let text = body
+		.replace(/```[\s\S]*?```/g, '')
+		.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
+		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
+		.replace(/`([^`]*)`/g, '$1')
+		.replace(/^\s{0,3}#{1,6}\s+/gm, '')
+		.replace(/^\s{0,3}>+\s?/gm, '');
+
+	text = text
+		.split('\n')
+		.map(rewriteListMarkers)
+		.join('\n');
+
+	text = text
+		.replace(/[*_~]/g, '')
+		.split('\n')
+		.map(line => line.replace(/\s+$/, ''))
+		.join('\n')
+		.replace(/\n{3,}/g, '\n\n')
+		.trim();
+
+	return text;
+};
+
+export default stripMarkdown;
