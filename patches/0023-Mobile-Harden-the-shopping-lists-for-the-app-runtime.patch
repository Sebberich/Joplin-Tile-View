+		const lists = await db.lists();
+		if (!lists.length) return;
+		await getListsSync().refreshAll();
+	} catch (error) {
+		logger.warn('Failed to refresh shopping lists', error);
+	}
+};
+
 // Starts the sync agent's background lifecycle (relay subscriptions, periodic
-// refresh, ...). Safe to call even if lists/sync doesn't exist yet. Ensures
-// ListsSync is initialized first, so the AppState-driven refresh this wires
-// up doesn't hit ListsSync.instance()'s "not initialized" error.
-export const startListsSyncLifecycle = (): void => {
-	getListsSync();
-	const syncModule = tryRequire('../sync') as SyncModule | null;
-	if (syncModule?.startListsSyncLifecycle) syncModule.startListsSyncLifecycle();
+// refresh, ...): refreshes every list when the app comes to the foreground,
+// throttled so rapid foreground/background cycles don't cause a sync storm.
+// Safe to call even if lists/sync doesn't exist yet or the lists DB has never
+// been opened -- see safeRefreshAll() above. Call the returned function to
+// tear it down (e.g. in tests).
+export const startListsSyncLifecycle = (): (()=> void) => {
+	let lastRefresh = 0;
+	const onChange = (nextState: AppStateStatus): void => {
+		if (nextState !== 'active') return;
+		const now = Date.now();
+		if (now - lastRefresh < LIFECYCLE_THROTTLE_MS) return;
+		lastRefresh = now;
+		void safeRefreshAll();
+	};
+	const subscription: NativeEventSubscription = AppState.addEventListener('change', onChange);
+	return () => subscription.remove();
 };
