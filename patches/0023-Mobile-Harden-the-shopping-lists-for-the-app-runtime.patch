+++ b/packages/app-mobile/utils/polyfills/textEncoding.ts
@@ -0,0 +1,105 @@
+// Minimal pure-JS UTF-8 TextEncoder/TextDecoder polyfill, installed on
+// globalThis only when the environment doesn't already provide one. Hermes
+// (RN 0.81) is known to provide TextEncoder but not reliably TextDecoder, and
+// nostr-tools calls `new TextDecoder()` at module load time (see
+// nostr-tools/utils), so this must run before that module is first imported.
+// Not a general TextEncoding implementation: UTF-8 only, no other encodings,
+// no streaming decode -- exactly what the shopping-list crypto/invite code
+// and nostr-tools need.
+
+class PolyfillTextEncoder {
+	public readonly encoding = 'utf-8';
+
+	public encode(input = ''): Uint8Array {
+		const bytes: number[] = [];
+		for (let i = 0; i < input.length; i++) {
+			const codePoint = input.codePointAt(i);
+			if (codePoint > 0xffff) i++; // consumed a surrogate pair
+
+			if (codePoint < 0x80) {
+				bytes.push(codePoint);
+			} else if (codePoint < 0x800) {
+				bytes.push(0xc0 | (codePoint >> 6), 0x80 | (codePoint & 0x3f));
+			} else if (codePoint < 0x10000) {
+				bytes.push(
+					0xe0 | (codePoint >> 12),
+					0x80 | ((codePoint >> 6) & 0x3f),
+					0x80 | (codePoint & 0x3f),
+				);
+			} else {
+				bytes.push(
+					0xf0 | (codePoint >> 18),
+					0x80 | ((codePoint >> 12) & 0x3f),
+					0x80 | ((codePoint >> 6) & 0x3f),
+					0x80 | (codePoint & 0x3f),
+				);
+			}
+		}
+		return Uint8Array.from(bytes);
+	}
+}
+
+class PolyfillTextDecoder {
+	public readonly encoding = 'utf-8';
+
+	public constructor(label = 'utf-8') {
+		if (label && label.toLowerCase() !== 'utf-8' && label.toLowerCase() !== 'utf8') {
+			throw new RangeError(`PolyfillTextDecoder: unsupported encoding "${label}"`);
+		}
+	}
+
+	public decode(input?: ArrayBuffer | ArrayBufferView): string {
+		if (!input) return '';
+		const bytes = input instanceof Uint8Array ? input : new Uint8Array(ArrayBuffer.isView(input) ? input.buffer.slice(input.byteOffset, input.byteOffset + input.byteLength) : input);
+
+		let result = '';
+		let i = 0;
+		while (i < bytes.length) {
+			const byte1 = bytes[i];
+			let codePoint: number;
+			let extraBytes: number;
+
+			if (byte1 < 0x80) {
+				codePoint = byte1;
+				extraBytes = 0;
+			} else if ((byte1 & 0xe0) === 0xc0) {
+				codePoint = byte1 & 0x1f;
+				extraBytes = 1;
+			} else if ((byte1 & 0xf0) === 0xe0) {
+				codePoint = byte1 & 0x0f;
+				extraBytes = 2;
+			} else if ((byte1 & 0xf8) === 0xf0) {
+				codePoint = byte1 & 0x07;
+				extraBytes = 3;
+			} else {
+				// Invalid leading byte; emit the replacement character and move on.
+				result += '�';
+				i++;
+				continue;
+			}
+
+			if (i + extraBytes >= bytes.length) {
+				result += '�';
+				break;
+			}
+
+			for (let j = 1; j <= extraBytes; j++) {
+				const continuationByte = bytes[i + j];
+				codePoint = (codePoint << 6) | (continuationByte & 0x3f);
+			}
+
+			result += String.fromCodePoint(codePoint);
+			i += extraBytes + 1;
+		}
+		return result;
+	}
+}
+
+export const installTextEncodingPolyfill = (target: typeof globalThis = globalThis): void => {
+	if (!target.TextEncoder) target.TextEncoder = PolyfillTextEncoder as unknown as typeof TextEncoder;
+	if (!target.TextDecoder) target.TextDecoder = PolyfillTextDecoder as unknown as typeof TextDecoder;
+};
+
+installTextEncodingPolyfill();
+
+export { PolyfillTextEncoder, PolyfillTextDecoder };
