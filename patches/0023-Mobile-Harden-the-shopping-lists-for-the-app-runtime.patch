+import { installTextEncodingPolyfill, PolyfillTextDecoder, PolyfillTextEncoder } from './textEncoding';
+
+describe('utils/polyfills/textEncoding', () => {
+	test.each([
+		'',
+		'hello world',
+		'Müsli, Käse, Straße',
+		'😀🚀 emoji test 🎉',
+		'混合 テキスト',
+	])('encode/decode roundtrips %j', input => {
+		const encoder = new PolyfillTextEncoder();
+		const decoder = new PolyfillTextDecoder();
+		expect(decoder.decode(encoder.encode(input))).toBe(input);
+	});
+
+	test('encode() matches the native TextEncoder byte-for-byte', () => {
+		const input = 'Müsli, Käse, Straße 😀';
+		const polyfillBytes = Array.from(new PolyfillTextEncoder().encode(input));
+		const nativeBytes = Array.from(new TextEncoder().encode(input));
+		expect(polyfillBytes).toEqual(nativeBytes);
+	});
+
+	test('installTextEncodingPolyfill() is a no-op when natives already exist', () => {
+		const nativeEncoder = function() { /* stand-in for the real TextEncoder */ } as unknown as typeof TextEncoder;
+		const nativeDecoder = function() { /* stand-in for the real TextDecoder */ } as unknown as typeof TextDecoder;
+		const fakeGlobal = { TextEncoder: nativeEncoder, TextDecoder: nativeDecoder } as unknown as typeof globalThis;
+
+		installTextEncodingPolyfill(fakeGlobal);
+
+		expect(fakeGlobal.TextEncoder).toBe(nativeEncoder);
+		expect(fakeGlobal.TextDecoder).toBe(nativeDecoder);
+	});
+
+	test('installTextEncodingPolyfill() installs the polyfill when natives are missing', () => {
+		const fakeGlobal = {} as unknown as typeof globalThis;
+
+		installTextEncodingPolyfill(fakeGlobal);
+
+		expect(fakeGlobal.TextEncoder).toBe(PolyfillTextEncoder);
+		expect(fakeGlobal.TextDecoder).toBe(PolyfillTextDecoder);
+	});
+});
