@@ -0,0 +1,92 @@
+import * as React from 'react';
+import { Store } from 'redux';
+import { AppState } from '../../../utils/types';
+import TestProviderStack from '../../testing/TestProviderStack';
+import NotesScreen from './Notes';
+import createMockReduxStore from '../../../utils/testing/createMockReduxStore';
+import setupGlobalStore from '../../../utils/testing/setupGlobalStore';
+import { fireEvent, render, screen, waitFor } from '../../../utils/testing/testingLibrary';
+import { setupDatabaseAndSynchronizer } from '@joplin/lib/testing/test-utils';
+import Folder from '@joplin/lib/models/Folder';
+import Setting from '@joplin/lib/models/Setting';
+
+let testStore: Store<AppState>;
+
+const WrappedNotesScreen: React.FC = () => {
+	return <TestProviderStack store={testStore}>
+		<NotesScreen visible={true}/>
+	</TestProviderStack>;
+};
+
+describe('Notes', () => {
+	beforeEach(async () => {
+		await setupDatabaseAndSynchronizer(0);
+		testStore = createMockReduxStore();
+		setupGlobalStore(testStore);
+
+		const folder = await Folder.save({ title: 'Test folder' });
+		testStore.dispatch({ type: 'FOLDER_UPDATE_ALL', items: [folder] });
+		testStore.dispatch({ type: 'NAV_GO', routeName: 'Notes', folderId: folder.id });
+	});
+
+	test('should show a notebook filter button in the header when the tile layout is active', async () => {
+		Setting.setValue('notes.mobileLayout', 'tiles');
+		render(<WrappedNotesScreen/>);
+
+		await waitFor(() => {
+			expect(screen.getByLabelText('Filter by notebook')).toBeTruthy();
+		});
+	});
+
+	test('should not show a notebook filter button in the header when the list layout is active', async () => {
+		Setting.setValue('notes.mobileLayout', 'list');
+		render(<WrappedNotesScreen/>);
+
+		await waitFor(() => {
+			expect(screen.getByLabelText('Actions')).toBeTruthy();
+		});
+		expect(screen.queryByLabelText('Filter by notebook')).toBeFalsy();
+	});
+
+	test('should offer zoom and layout-switch entries in the header overflow menu when tiled', async () => {
+		Setting.setValue('notes.mobileLayout', 'tiles');
+		render(<WrappedNotesScreen/>);
+
+		const menuTrigger = await screen.findByTestId('screen-header-menu-trigger');
+		fireEvent.press(menuTrigger);
+
+		await waitFor(() => {
+			expect(screen.getByText('Smaller')).toBeTruthy();
+			expect(screen.getByText('Larger')).toBeTruthy();
+			expect(screen.getByText('Switch to list view')).toBeTruthy();
+		});
+	});
+
+	test('pressing "Switch to list view" should change notes.mobileLayout to list', async () => {
+		Setting.setValue('notes.mobileLayout', 'tiles');
+		render(<WrappedNotesScreen/>);
+
+		const menuTrigger = await screen.findByTestId('screen-header-menu-trigger');
+		fireEvent.press(menuTrigger);
+
+		const switchToListOption = await screen.findByText('Switch to list view');
+		fireEvent.press(switchToListOption);
+
+		await waitFor(() => {
+			expect(Setting.value('notes.mobileLayout')).toBe('list');
+		});
+	});
+
+	test('should offer a "Switch to tile view" entry in the header overflow menu when in list layout', async () => {
+		Setting.setValue('notes.mobileLayout', 'list');
+		render(<WrappedNotesScreen/>);
+
+		const menuTrigger = await screen.findByTestId('screen-header-menu-trigger');
+		fireEvent.press(menuTrigger);
+
+		await waitFor(() => {
+			expect(screen.getByText('Switch to tile view')).toBeTruthy();
+			expect(screen.queryByText('Smaller')).toBeFalsy();
+		});
+	});
+});
