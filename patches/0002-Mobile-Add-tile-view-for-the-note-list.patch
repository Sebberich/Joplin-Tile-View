+import * as React from 'react';
+import { useEffect, useMemo, useRef } from 'react';
+import { connect } from 'react-redux';
+import { Dispatch } from 'redux';
+import { FlatList, Text, StyleSheet, Button, View, ViewStyle, TextStyle } from 'react-native';
+import { FolderEntity, NoteEntity } from '@joplin/lib/services/database/types';
+import { AppState } from '../utils/types';
+import getEmptyFolderMessage from '@joplin/lib/components/shared/NoteList/getEmptyFolderMessage';
+import Folder from '@joplin/lib/models/Folder';
+
+import { _ } from '@joplin/lib/locale';
+import NoteTile from './NoteTile';
+import { themeStyle } from './global-style';
+
+interface Props {
+	themeId: number;
+	dispatch: Dispatch;
+	notesSource: string;
+	items: NoteEntity[];
+	folders: FolderEntity[];
+	noteSelectionEnabled?: boolean;
+	selectedFolderId: string|null;
+	tileColumns: number;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+
+		const noItemMessage: TextStyle = {
+			paddingLeft: theme.marginLeft,
+			paddingRight: theme.marginRight,
+			paddingTop: theme.marginTop,
+			paddingBottom: theme.marginBottom,
+			fontSize: theme.fontSize,
+			color: theme.color,
+			textAlign: 'center',
+		};
+
+		const noNotebookView: ViewStyle = {};
+
+		const list: ViewStyle = {
+			paddingHorizontal: theme.marginLeft / 2,
+			paddingTop: theme.marginTop / 2,
+		};
+
+		const columnWrapper: ViewStyle = {
+			justifyContent: 'flex-start',
+		};
+
+		return StyleSheet.create({
+			noItemMessage,
+			noNotebookView,
+			list,
+			columnWrapper,
+		});
+	}, [themeId]);
+};
+
+// Note tiles are laid out in a fixed number of columns, using the same note data (and
+// selection/dispatch logic, in NoteTile.tsx) as the list view in NoteList.tsx.
+const NoteTileListComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const rootRef = useRef<FlatList<NoteEntity>>(null);
+	const previousNotesSource = useRef(props.notesSource);
+
+	// Make sure scroll position is reset when switching from one folder to another or to a tag list.
+	useEffect(() => {
+		if (previousNotesSource.current !== props.notesSource) {
+			previousNotesSource.current = props.notesSource;
+			rootRef.current?.scrollToOffset({ offset: 0, animated: false });
+		}
+	}, [props.notesSource]);
+
+	const onCreateNotebookButtonPress = () => {
+		props.dispatch({
+			type: 'NAV_GO',
+			routeName: 'Folder',
+			folderId: null,
+		});
+	};
+
+	// FlatList requires a remount (via `key`) when `numColumns` changes.
+	const numColumns = Math.min(4, Math.max(1, props.tileColumns || 1));
+
+	if (props.items.length) {
+		return <FlatList
+			key={`note-tile-list-${numColumns}`}
+			ref={rootRef}
+			style={styles.list}
+			data={props.items}
+			numColumns={numColumns}
+			columnWrapperStyle={numColumns > 1 ? styles.columnWrapper : undefined}
+			renderItem={({ item, index }) => <NoteTile note={item} index={index} numColumns={numColumns} />}
+			keyExtractor={item => item.id}
+		/>;
+	} else {
+		if (!Folder.atLeastOneRealFolderExists(props.folders)) {
+			const noItemMessage = _('You currently have no notebooks.');
+			return (
+				<View style={styles.noNotebookView}>
+					<Text style={styles.noItemMessage}>{noItemMessage}</Text>
+					<Button title={_('Create a notebook')} onPress={onCreateNotebookButtonPress} />
+				</View>
+			);
+		} else {
+			return <Text style={styles.noItemMessage}>
+				{getEmptyFolderMessage(props.folders, props.selectedFolderId)}
+			</Text>;
+		}
+	}
+};
+
+const NoteTileList = connect((state: AppState) => {
+	return {
+		items: state.notes,
+		folders: state.folders,
+		notesSource: state.notesSource,
+		themeId: state.settings.theme,
+		noteSelectionEnabled: state.noteSelectionEnabled,
+		selectedFolderId: state.selectedFolderId,
+		tileColumns: state.settings['notes.tileColumns'],
+	};
+})(NoteTileListComponent);
+
+export default NoteTileList;
