new file mode 100644
index 0000000..db1d21c
--- /dev/null
+++ b/packages/app-mobile/components/NoteTile.tsx
@@ -0,0 +1,291 @@
+import * as React from 'react';
+import { memo, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
+import { connect } from 'react-redux';
+import { Image, Text, StyleSheet, TextStyle, View, ViewStyle, ImageStyle, AccessibilityInfo } from 'react-native';
+import Checkbox from './Checkbox';
+import Note from '@joplin/lib/models/Note';
+import Resource from '@joplin/lib/models/Resource';
+import time from '@joplin/lib/time';
+import { themeStyle } from './global-style';
+import { _ } from '@joplin/lib/locale';
+import { AppState } from '../utils/types';
+import { Dispatch } from 'redux';
+import { NoteEntity } from '@joplin/lib/services/database/types';
+import { toFileProtocolPath } from '@joplin/utils/path';
+import useOnLongPressProps from '../utils/hooks/useOnLongPressProps';
+import MultiTouchableOpacity from './buttons/MultiTouchableOpacity';
+import isNoteLockEnabled from '@joplin/lib/services/noteLock/isNoteLockEnabled';
+import NoteLockNote from '@joplin/lib/services/noteLock/NoteLockNote';
+import NoteLockSession from '@joplin/lib/services/noteLock/NoteLockSession';
+import { DialogContext } from './DialogManager';
+import Icon from './Icon';
+
+interface Props {
+	dispatch: Dispatch;
+	themeId: number;
+	note: NoteEntity;
+	noteSelectionEnabled: boolean;
+	selectedNoteIds: string[];
+	index?: number;
+	numColumns: number;
+}
+
+// Strips the most common Markdown markup so that the tile preview reads as plain text. This is
+// a rough cleanup, not a full Markdown-to-text conversion.
+const stripMarkdown = (body: string) => {
+	return body
+		.replace(/```[\s\S]*?```/g, ' ')
+		.replace(/`([^`]*)`/g, '$1')
+		.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
+		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
+		.replace(/^\s{0,3}#{1,6}\s+/gm, '')
+		.replace(/^\s{0,3}>+\s?/gm, '')
+		.replace(/^\s*[-*+]\s+/gm, '')
+		.replace(/^\s*\d+\.\s+/gm, '')
+		.replace(/[*_~#]/g, '')
+		.replace(/\r?\n+/g, ' ')
+		.replace(/\s+/g, ' ')
+		.trim();
+};
+
+const useStyles = (themeId: number, numColumns: number, isSelected: boolean) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		const gap = theme.marginLeft / 2;
+
+		const outer: ViewStyle = {
+			width: `${100 / numColumns}%`,
+			padding: gap / 2,
+		};
+
+		const card: ViewStyle = {
+			flexGrow: 1,
+			backgroundColor: theme.backgroundColor2,
+			borderRadius: 8,
+			borderWidth: isSelected ? 2 : 1,
+			borderColor: isSelected ? theme.selectedColor : theme.colorFaded,
+			overflow: 'hidden',
+			paddingBottom: 8,
+		};
+
+		const image: ImageStyle = {
+			width: '100%',
+			height: 96,
+			backgroundColor: theme.backgroundColor3,
+		};
+
+		const content: ViewStyle = {
+			paddingHorizontal: 10,
+			paddingTop: 8,
+		};
+
+		const titleRow: ViewStyle = {
+			flexDirection: 'row',
+			alignItems: 'flex-start',
+		};
+
+		const lockIcon: TextStyle = {
+			color: theme.colorFaded,
+			fontSize: theme.fontSizeSmaller,
+			marginRight: 6,
+			marginTop: 2,
+		};
+
+		const title: TextStyle = {
+			flexShrink: 1,
+			fontWeight: 'bold',
+			color: theme.color,
+			fontSize: theme.fontSize,
+		};
+
+		const previewText: TextStyle = {
+			marginTop: 4,
+			color: theme.colorFaded,
+			fontSize: theme.fontSizeSmaller,
+		};
+
+		const checkboxRow: ViewStyle = {
+			flexDirection: 'row',
+			justifyContent: 'flex-end',
+			paddingHorizontal: 4,
+			paddingTop: 4,
+		};
+
+		return StyleSheet.create({
+			outer,
+			card,
+			image,
+			content,
+			titleRow,
+			lockIcon,
+			title,
+			previewText,
+			checkboxRow,
+			checkboxStyle: {
+				color: theme.color,
+			},
+			checkedOpacityStyle: {
+				opacity: 0.4,
+			},
+			uncheckedOpacityStyle: { },
+		});
+	}, [themeId, numColumns, isSelected]);
+};
+
+const NoteTileComponent: React.FC<Props> = memo(props => {
+	const note = props.note ?? {};
+	const isSelected = props.noteSelectionEnabled && props.selectedNoteIds.includes(note.id);
+	const styles = useStyles(props.themeId, props.numColumns, isSelected);
+	const dialogs = useContext(DialogContext);
+	const [checkboxKey, setCheckboxKey] = useState(0);
+	const [previewText, setPreviewText] = useState('');
+	const [imageUri, setImageUri] = useState<string|null>(null);
+	const suppressPressUntilRef = useRef(0);
+
+	// The note preview (body text and first image) isn't part of the preview fields NoteList
+	// loads into Redux state, so it's fetched here, per tile, once the note ID is known.
+	useEffect(() => {
+		let cancelled = false;
+		setPreviewText('');
+		setImageUri(null);
+
+		const noteId = note.id;
+		if (!noteId) return () => { cancelled = true; };
+
+		const loadPreview = async () => {
+			const full = await Note.load(noteId, { fields: ['body'] });
+			if (cancelled || !full) return;
+
+			const body = full.body ?? '';
+			setPreviewText(stripMarkdown(body));
+
+			const resourceIds = await Note.linkedResourceIds(body);
+			if (cancelled || !resourceIds.length) return;
+
+			const resource = await Resource.load(resourceIds[0]);
+			if (cancelled || !resource) return;
+			if (!Resource.isSupportedImageMimeType(resource.mime)) return;
+			if (!(await Resource.isReady(resource))) return;
+			if (cancelled) return;
+
+			setImageUri(toFileProtocolPath(Resource.fullPath(resource)));
+		};
+
+		void loadPreview();
+
+		return () => { cancelled = true; };
+	}, [note.id]);
+
+	// Duplicated from NoteItem.tsx (tap/long-press/selection and to-do checkbox handling) so
+	// that tiles behave exactly like list rows. See NoteItem.tsx for the original.
+	const todoCheckbox_change = useCallback(async (checked: boolean) => {
+		if (!props.note) return;
+
+		if (isNoteLockEnabled()) suppressPressUntilRef.current = Date.now() + 100;
+
+		if (isNoteLockEnabled()) {
+			const lockState = await Note.load(props.note.id, { fields: ['is_locked'] });
+			if (NoteLockNote.isLocked(lockState) && !NoteLockSession.instance().isUnlocked()) {
+				setCheckboxKey(key => key + 1);
+				await dialogs.error(_('Cannot change a locked note while the session is locked'));
+				return;
+			}
+		}
+
+		const newNote = {
+			id: props.note.id,
+			todo_completed: checked ? time.unixMs() : 0,
+		};
+		await Note.save(newNote);
+
+		props.dispatch({ type: 'NOTE_SORT' });
+	}, [props.note, props.dispatch, dialogs]);
+
+	const onPress = useCallback(() => {
+		if (Date.now() < suppressPressUntilRef.current) return;
+		if (!props.note) return;
+		if (props.note.encryption_applied) return;
+
+		if (props.noteSelectionEnabled) {
+			props.dispatch({
+				type: 'NOTE_SELECTION_TOGGLE',
+				id: props.note.id,
+			});
+		} else {
+			props.dispatch({
+				type: 'NAV_GO',
+				routeName: 'Note',
+				noteId: props.note.id,
+			});
+		}
+	}, [props.note, props.noteSelectionEnabled, props.dispatch]);
+
+	const onLongPress = useCallback(() => {
+		const now = Date.now();
+		if (now < suppressPressUntilRef.current) return;
+		suppressPressUntilRef.current = now + 500;
+
+		if (!props.note) return;
+
+		if (!props.noteSelectionEnabled) {
+			AccessibilityInfo.announceForAccessibility(_('Entering selection mode'));
+		}
+
+		props.dispatch({
+			type: props.noteSelectionEnabled ? 'NOTE_SELECTION_TOGGLE' : 'NOTE_SELECTION_START',
+			id: props.note.id,
+		});
+	}, [props.dispatch, props.note, props.noteSelectionEnabled]);
+
+	const isTodo = !!Number(note.is_todo);
+	const checkboxChecked = !!Number(note.todo_completed);
+	const opacityStyle = isTodo && checkboxChecked ? styles.checkedOpacityStyle : styles.uncheckedOpacityStyle;
+
+	const noteTitle = Note.displayTitle(note);
+	const selectDeselectLabel = isSelected ? _('Deselect') : _('Select');
+	const onLongPressProps = useOnLongPressProps({ onLongPress, actionDescription: selectDeselectLabel });
+
+	const todoCheckbox = isTodo ? <Checkbox
+		key={checkboxKey}
+		style={styles.checkboxStyle}
+		checked={checkboxChecked}
+		onChange={todoCheckbox_change}
+		accessibilityLabel={_('to-do: %s', noteTitle)}
+	/> : null;
+
+	const pressableProps = {
+		style: styles.card,
+		accessibilityLabel: noteTitle,
+		accessibilityHint: props.noteSelectionEnabled ? '' : _('Opens note'),
+		'aria-pressed': props.noteSelectionEnabled ? isSelected : undefined,
+		accessibilityState: { selected: isSelected },
+		...onLongPressProps,
+	};
+
+	return (
+		<View style={[styles.outer, opacityStyle]}>
+			<MultiTouchableOpacity
+				{...pressableProps}
+				onPress={onPress}
+				beforePressable={todoCheckbox ? <View style={styles.checkboxRow}>{todoCheckbox}</View> : null}
+			>
+				{imageUri ? <Image source={{ uri: imageUri }} style={styles.image} resizeMode='cover' /> : null}
+				<View style={styles.content}>
+					<View style={styles.titleRow}>
+						{!!note.is_locked && <Icon name='fas fa-lock' style={styles.lockIcon} accessibilityLabel={_('Locked')} />}
+						<Text style={styles.title} numberOfLines={2}>{noteTitle}</Text>
+					</View>
+					{!!previewText && <Text style={styles.previewText} numberOfLines={6}>{previewText}</Text>}
+				</View>
+			</MultiTouchableOpacity>
+		</View>
+	);
+});
+
+export default connect((state: AppState) => {
+	return {
+		themeId: state.settings.theme,
+		noteSelectionEnabled: state.noteSelectionEnabled,
+		selectedNoteIds: state.selectedNoteIds,
+	};
+})(NoteTileComponent);
