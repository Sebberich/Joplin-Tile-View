+import Setting from '@joplin/lib/models/Setting';
+
+// Public, free relays with no signup, picked for general reachability. See
+// docs/KONZEPT.md section 3: several relays in parallel, changeable in
+// settings, self-hosting possible.
+export const defaultRelays: string[] = [
+	'wss://relay.damus.io',
+	'wss://nos.lol',
+	'wss://relay.primal.net',
+	'wss://nostr.mom',
+	'wss://relay.nostr.band',
+];
+
+// Parses the 'lists.relays' setting's raw string value (comma or newline
+// separated relay URLs) into a list, falling back to the defaults when the
+// value is empty or has no valid entry.
+export const relaysFromSetting = (value: string): string[] => {
+	const urls = (value ?? '')
+		.split(/[,\n]/)
+		.map(entry => entry.trim())
+		.filter(entry => entry.startsWith('wss://'));
+	return urls.length > 0 ? urls : defaultRelays;
+};
+
+// Reads the relay list to use right now. The 'lists.relays' setting is
+// registered by the UI (builtInMetadata.ts); if it isn't registered yet,
+// Setting.value() throws and this falls back to the defaults.
+export const currentRelays = (): string[] => {
+	try {
+		return relaysFromSetting(Setting.value('lists.relays'));
+	} catch (error) {
+		return defaultRelays;
+	}
+};
