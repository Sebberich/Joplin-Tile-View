+// Transport 2 from docs/KONZEPT.md section 3 (Bluetooth Low Energy) comes
+// later. This is only the interface the UI can already build the "circle"
+// control against, plus a stub that reports itself unavailable.
+
+export type NearbyMode = 'off' | 'searching' | 'found' | 'unavailable';
+
+export interface NearbyState {
+	mode: NearbyMode;
+	// Members of the open list currently in range, out of the list's total
+	// member count.
+	found: number;
+	total: number;
+}
+
+export type NearbyStateListener = (state: NearbyState)=> void;
+
+export interface NearbyTransport {
+	isAvailable(): boolean;
+	start(listId: string): Promise<void>;
+	stop(): Promise<void>;
+	onState(listener: NearbyStateListener): ()=> void;
+}
+
+const UNAVAILABLE_STATE: NearbyState = { mode: 'unavailable', found: 0, total: 0 };
+
+// Placeholder implementation used until Bluetooth is built: always reports
+// 'unavailable' and never actually starts anything.
+export class UnavailableNearbyTransport implements NearbyTransport {
+	private listeners = new Set<NearbyStateListener>();
+
+	public isAvailable(): boolean {
+		return false;
+	}
+
+	public async start(_listId: string): Promise<void> {
+		for (const listener of this.listeners) listener(UNAVAILABLE_STATE);
+	}
+
+	public async stop(): Promise<void> {
+		// Nothing was started.
+	}
+
+	public onState(listener: NearbyStateListener): ()=> void {
+		this.listeners.add(listener);
+		listener(UNAVAILABLE_STATE);
+		return () => this.listeners.delete(listener);
+	}
+}
