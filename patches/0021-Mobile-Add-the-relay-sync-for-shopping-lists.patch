index 0000000..1df010b
--- /dev/null
+++ b/packages/app-mobile/lists/sync/relayPool.ts
@@ -0,0 +1,339 @@
+// Minimal NIP-01 client over the global WebSocket (React Native provides one;
+// under jest we fall back to the 'ws' package). Deliberately small: only what
+// the shopping-list sync layer needs (publish/query/subscribe), not a general
+// Nostr client.
+import { Filter, VerifiedEvent, verifyEvent } from 'nostr-tools';
+
+// Structural subset of the DOM/RN WebSocket API this module relies on, so we
+// don't need the 'dom' lib (not enabled for this package) just for a type.
+interface WebSocketLike {
+	readyState: number;
+	onopen: (()=> void) | null;
+	onclose: ((event: { code?: number; reason?: string })=> void) | null;
+	onmessage: ((event: { data: string })=> void) | null;
+	onerror: ((event: unknown)=> void) | null;
+	send(data: string): void;
+	close(): void;
+}
+
+type WebSocketCtor = new (url: string)=> WebSocketLike;
+
+const WEBSOCKET_OPEN = 1;
+
+const getWebSocketCtor = (): WebSocketCtor => {
+	const globalCtor = (globalThis as unknown as { WebSocket?: WebSocketCtor }).WebSocket;
+	if (globalCtor) return globalCtor;
+	// Reached only in jest (node has no global WebSocket): the 'ws' package is
+	// a devDependency of several workspace packages and present in node_modules.
+	// eslint-disable-next-line @typescript-eslint/no-var-requires -- test-only fallback, see above
+	return require('ws');
+};
+
+export interface PublishResult {
+	ok: boolean;
+	message: string;
+}
+
+export interface RelayPublishResult extends PublishResult {
+	url: string;
+}
+
+const PUBLISH_TIMEOUT_MS = 10000;
+const QUERY_TIMEOUT_MS = 10000;
+const MIN_BACKOFF_MS = 1000;
+const MAX_BACKOFF_MS = 60000;
+
+let subIdCounter = 0;
+const nextSubId = (): string => `s${++subIdCounter}${Math.random().toString(36).slice(2, 8)}`;
+
+interface PendingPublish {
+	resolve: (result: PublishResult)=> void;
+	timer: ReturnType<typeof setTimeout>;
+}
+
+interface PendingQuery {
+	events: Map<string, VerifiedEvent>;
+	resolve: (events: VerifiedEvent[])=> void;
+	timer: ReturnType<typeof setTimeout>;
+}
+
+interface Subscription {
+	filters: Filter[];
+	onEvent: (event: VerifiedEvent)=> void;
+}
+
+// A single relay connection: connects lazily on the first publish/query/
+// subscribe call, reconnects with exponential backoff (capped at 60s) when
+// the socket drops, and re-issues open subscriptions after a reconnect.
+export class Relay {
+	public readonly url: string;
+	private ws: WebSocketLike | null = null;
+	private connecting = false;
+	private closedByUser = false;
+	private backoffMs = MIN_BACKOFF_MS;
+	private reconnectTimer: ReturnType<typeof setTimeout> | null = null;
+	private sendQueue: string[] = [];
+	private pendingPublishes = new Map<string, PendingPublish>();
+	private pendingQueries = new Map<string, PendingQuery>();
+	private subscriptions = new Map<string, Subscription>();
+	// True once this relay has completed the WebSocket handshake at least
+	// once, used to tell "this relay is unreachable" apart from "this relay
+	// is reachable but has nothing to say yet" (see RelayPool.anyConnected()).
+	public connectedOnce = false;
+
+	public constructor(url: string) {
+		this.url = url;
+	}
+
+	private ensureConnected(): void {
+		if (this.ws || this.connecting || this.closedByUser) return;
+		this.connecting = true;
+		const Ctor = getWebSocketCtor();
+		let socket: WebSocketLike;
+		try {
+			socket = new Ctor(this.url);
+		} catch (error) {
+			this.connecting = false;
+			this.scheduleReconnect();
+			return;
+		}
+		socket.onopen = () => {
+			this.connecting = false;
+			this.connectedOnce = true;
+			this.backoffMs = MIN_BACKOFF_MS;
+			this.ws = socket;
+			const queued = this.sendQueue;
+			this.sendQueue = [];
+			for (const raw of queued) socket.send(raw);
+			for (const [subId, sub] of this.subscriptions) socket.send(JSON.stringify(['REQ', subId, ...sub.filters]));
+		};
+		socket.onerror = () => { /* onclose always follows a failed connection attempt */ };
+		socket.onmessage = event => this.handleMessage(event.data);
+		socket.onclose = () => {
+			this.ws = null;
+			this.connecting = false;
+			for (const [subId, pending] of this.pendingQueries) {
+				clearTimeout(pending.timer);
+				pending.resolve(Array.from(pending.events.values()));
+				this.pendingQueries.delete(subId);
+			}
+			// A relay that drops the connection without ever sending an OK is
+			// treated as a failed publish, not left hanging until the timeout.
+			for (const [eventId, pending] of this.pendingPublishes) {
+				clearTimeout(pending.timer);
+				pending.resolve({ ok: false, message: 'Connection closed' });
+				this.pendingPublishes.delete(eventId);
+			}
+			if (!this.closedByUser) this.scheduleReconnect();
+		};
+	}
+
+	private scheduleReconnect(): void {
+		if (this.closedByUser || this.reconnectTimer) return;
+		this.reconnectTimer = setTimeout(() => {
+			this.reconnectTimer = null;
+			this.backoffMs = Math.min(this.backoffMs * 2, MAX_BACKOFF_MS);
+			this.ensureConnected();
+		}, this.backoffMs);
+	}
+
+	private send(raw: string): void {
+		if (this.ws && this.ws.readyState === WEBSOCKET_OPEN) {
+			this.ws.send(raw);
+			return;
+		}
+		this.sendQueue.push(raw);
+		this.ensureConnected();
+	}
+
+	private handleMessage(raw: string): void {
+		let message: unknown[];
+		try {
+			message = JSON.parse(raw);
+		} catch (error) {
+			return;
+		}
+		const type = message[0];
+
+		if (type === 'EVENT') {
+			const [, subId, event] = message as [string, string, VerifiedEvent];
+			if (!verifyEvent(event)) return;
+			const query = this.pendingQueries.get(subId);
+			if (query) {
+				query.events.set(event.id, event);
+				return;
+			}
+			this.subscriptions.get(subId)?.onEvent(event);
+			return;
+		}
+
+		if (type === 'EOSE') {
+			const [, subId] = message as [string, string];
+			const query = this.pendingQueries.get(subId);
+			if (!query) return;
+			clearTimeout(query.timer);
+			this.pendingQueries.delete(subId);
+			query.resolve(Array.from(query.events.values()));
+			this.send(JSON.stringify(['CLOSE', subId]));
+			return;
+		}
+
+		if (type === 'OK') {
+			const [, eventId, ok, okMessage] = message as [string, string, boolean, string];
+			const pending = this.pendingPublishes.get(eventId);
+			if (!pending) return;
+			clearTimeout(pending.timer);
+			this.pendingPublishes.delete(eventId);
+			pending.resolve({ ok: !!ok, message: okMessage ?? '' });
+			return;
+		}
+
+		if (type === 'CLOSED') {
+			const [, subId, closedMessage] = message as [string, string, string];
+			const query = this.pendingQueries.get(subId);
+			if (query) {
+				clearTimeout(query.timer);
+				this.pendingQueries.delete(subId);
+				query.resolve(Array.from(query.events.values()));
+			}
+			this.subscriptions.delete(subId);
+			void closedMessage;
+			return;
+		}
+
+		// NOTICE and AUTH (and anything else) are ignored: relays send NOTICE
+		// for human-readable diagnostics, and this client never opts into AUTH.
+	}
+
+	public publish(event: VerifiedEvent): Promise<PublishResult> {
+		return new Promise(resolve => {
+			const timer = setTimeout(() => {
+				this.pendingPublishes.delete(event.id);
+				resolve({ ok: false, message: 'Timed out waiting for OK' });
+			}, PUBLISH_TIMEOUT_MS);
+			this.pendingPublishes.set(event.id, { resolve, timer });
+			this.send(JSON.stringify(['EVENT', event]));
+		});
+	}
+
+	public query(filter: Filter | Filter[]): Promise<VerifiedEvent[]> {
+		const filters = Array.isArray(filter) ? filter : [filter];
+		const subId = nextSubId();
+		return new Promise(resolve => {
+			const pending: PendingQuery = {
+				events: new Map(),
+				resolve,
+				timer: setTimeout(() => {
+					this.pendingQueries.delete(subId);
+					resolve(Array.from(pending.events.values()));
+					this.send(JSON.stringify(['CLOSE', subId]));
+				}, QUERY_TIMEOUT_MS),
+			};
+			this.pendingQueries.set(subId, pending);
+			this.send(JSON.stringify(['REQ', subId, ...filters]));
+		});
+	}
+
+	// Live subscription: onEvent fires for every verified event the relay
+	// pushes for this filter, including ones received after a reconnect (the
+	// REQ is re-sent automatically). Returns an unsubscribe function.
+	public subscribe(filter: Filter | Filter[], onEvent: (event: VerifiedEvent)=> void): ()=> void {
+		const filters = Array.isArray(filter) ? filter : [filter];
+		const subId = nextSubId();
+		this.subscriptions.set(subId, { filters, onEvent });
+		this.send(JSON.stringify(['REQ', subId, ...filters]));
+		return () => {
+			this.subscriptions.delete(subId);
+			this.send(JSON.stringify(['CLOSE', subId]));
+		};
+	}
+
+	public close(): void {
+		this.closedByUser = true;
+		if (this.reconnectTimer) {
+			clearTimeout(this.reconnectTimer);
+			this.reconnectTimer = null;
+		}
+		for (const [eventId, pending] of this.pendingPublishes) {
+			clearTimeout(pending.timer);
+			pending.resolve({ ok: false, message: 'Relay closed' });
+			this.pendingPublishes.delete(eventId);
+		}
+		for (const [subId, pending] of this.pendingQueries) {
+			clearTimeout(pending.timer);
+			pending.resolve(Array.from(pending.events.values()));
+			this.pendingQueries.delete(subId);
+		}
+		this.subscriptions.clear();
+		if (this.ws) {
+			this.ws.onclose = null;
+			this.ws.close();
+			this.ws = null;
+		}
+	}
+}
+
+// Convenience: true if at least one publish result reports success. A
+// shopping list only needs one relay to accept an event for it to eventually
+// reach every member (see docs/KONZEPT.md section 3, "Relays sind Briefkasten").
+export const publishSucceeded = (results: RelayPublishResult[]): boolean => results.some(result => result.ok);
+
+// The surface ListsSync actually uses, factored out as an interface (rather
+// than using the RelayPool class directly) so tests can inject an in-memory
+// fake pool -- see lists/sync/testing/fakeRelay.ts -- without it needing to
+// match RelayPool's private fields too.
+export interface RelayPoolLike {
+	publishAll(event: VerifiedEvent): Promise<RelayPublishResult[]>;
+	queryAll(filter: Filter | Filter[]): Promise<VerifiedEvent[]>;
+	subscribeAll(filter: Filter | Filter[], onEvent: (event: VerifiedEvent)=> void): ()=> void;
+	close(): void;
+	anyConnected(): boolean;
+}
+
+// A pool of relays queried/published to in parallel. Callers don't need to
+// know which relay ultimately served a query result or accepted a publish.
+export class RelayPool implements RelayPoolLike {
+	private relays: Relay[];
+
+	public constructor(urls: string[]) {
+		this.relays = urls.map(url => new Relay(url));
+	}
+
+	public async publishAll(event: VerifiedEvent): Promise<RelayPublishResult[]> {
+		return Promise.all(this.relays.map(async relay => ({ url: relay.url, ...(await relay.publish(event)) })));
+	}
+
+	public async queryAll(filter: Filter | Filter[]): Promise<VerifiedEvent[]> {
+		const perRelay = await Promise.all(this.relays.map(relay => relay.query(filter)));
+		const byId = new Map<string, VerifiedEvent>();
+		for (const events of perRelay) {
+			for (const event of events) byId.set(event.id, event);
+		}
+		return Array.from(byId.values());
+	}
+
+	// Subscribes on every relay in the pool; onEvent may fire more than once
+	// for the same event id if several relays have it, which is harmless since
+	// applying an already-applied item/directory update is idempotent.
+	public subscribeAll(filter: Filter | Filter[], onEvent: (event: VerifiedEvent)=> void): ()=> void {
+		const unsubscribes = this.relays.map(relay => relay.subscribe(filter, onEvent));
+		return () => {
+			for (const unsubscribe of unsubscribes) unsubscribe();
+		};
+	}
+
+	public close(): void {
+		for (const relay of this.relays) relay.close();
+	}
+
+	// False only when every relay in the pool has never completed a WebSocket
+	// handshake -- the "no relay reachable" / offline condition the sync layer
+	// reports as status 'offline' rather than 'error'.
+	public anyConnected(): boolean {
+		return this.relays.some(relay => relay.connectedOnce);
+	}
+}
+
+export type RelayPoolFactory = (urls: string[])=> RelayPoolLike;
+
+export const defaultRelayPoolFactory: RelayPoolFactory = (urls: string[]) => new RelayPool(urls);
