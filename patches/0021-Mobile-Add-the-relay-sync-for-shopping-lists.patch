+import WebSocket from 'ws';
+import { finalizeEvent } from 'nostr-tools';
+import { generateKeyPair } from '../core/crypto';
+import { Relay, RelayPool } from './relayPool';
+
+const WebSocketServer = WebSocket.Server;
+type TestWebSocketServer = InstanceType<typeof WebSocket.Server>;
+
+// A tiny real WebSocket server speaking just enough NIP-01 to exercise the
+// Relay/RelayPool client against actual sockets (the sync-layer scenario
+// tests use the faster in-memory FakeRelayNetwork instead, see
+// testing/fakeRelay.ts and listSync.test.ts).
+const startTestRelay = (): Promise<{ url: string; server: TestWebSocketServer; close: ()=> Promise<void> }> => {
+	return new Promise(resolve => {
+		const server = new WebSocketServer({ port: 0 }, () => {
+			const address = server.address();
+			const port = typeof address === 'string' ? 0 : address.port;
+			resolve({
+				url: `ws://127.0.0.1:${port}`,
+				server,
+				close: () => new Promise<void>(closeResolve => server.close(() => closeResolve())),
+			});
+		});
+	});
+};
+
+describe('lists/sync/relayPool', () => {
+	let testRelay: { url: string; server: TestWebSocketServer; close: ()=> Promise<void> };
+
+	afterEach(async () => {
+		if (testRelay) await testRelay.close();
+	});
+
+	test('publish() resolves ok once the relay sends OK', async () => {
+		testRelay = await startTestRelay();
+		testRelay.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, event] = JSON.parse(raw.toString());
+				if (type === 'EVENT') socket.send(JSON.stringify(['OK', event.id, true, '']));
+			});
+		});
+
+		const relay = new Relay(testRelay.url);
+		const device = generateKeyPair();
+		const event = finalizeEvent({ kind: 30078, tags: [], content: 'hi', created_at: Math.floor(Date.now() / 1000) }, device.secretKey);
+
+		const result = await relay.publish(event);
+		expect(result).toEqual({ ok: true, message: '' });
+		relay.close();
+	});
+
+	test('publish() resolves not-ok with the relay message on rejection', async () => {
+		testRelay = await startTestRelay();
+		testRelay.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, event] = JSON.parse(raw.toString());
+				if (type === 'EVENT') socket.send(JSON.stringify(['OK', event.id, false, 'invalid: created_at is too old']));
+			});
+		});
+
+		const relay = new Relay(testRelay.url);
+		const device = generateKeyPair();
+		const event = finalizeEvent({ kind: 30078, tags: [], content: 'hi', created_at: 1 }, device.secretKey);
+
+		const result = await relay.publish(event);
+		expect(result).toEqual({ ok: false, message: 'invalid: created_at is too old' });
+		relay.close();
+	});
+
+	test('query() collects events until EOSE', async () => {
+		testRelay = await startTestRelay();
+		const device = generateKeyPair();
+		const events = [1, 2].map(n => finalizeEvent({ kind: 30078, tags: [['d', `${n}`]], content: 'hi', created_at: n }, device.secretKey));
+
+		testRelay.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, subId] = JSON.parse(raw.toString());
+				if (type !== 'REQ') return;
+				for (const event of events) socket.send(JSON.stringify(['EVENT', subId, event]));
+				socket.send(JSON.stringify(['EOSE', subId]));
+			});
+		});
+
+		const relay = new Relay(testRelay.url);
+		const results = await relay.query({ kinds: [30078] });
+		expect(results.map(e => e.id).sort()).toEqual(events.map(e => e.id).sort());
+		relay.close();
+	});
+
+	test('subscribe() delivers live events until unsubscribed', async () => {
+		testRelay = await startTestRelay();
+		const device = generateKeyPair();
+		const event = finalizeEvent({ kind: 30078, tags: [], content: 'hi', created_at: Math.floor(Date.now() / 1000) }, device.secretKey);
+		let subSocket: WebSocket | null = null;
+		let liveSubId: string | null = null;
+
+		testRelay.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, subId] = JSON.parse(raw.toString());
+				if (type === 'REQ') {
+					subSocket = socket;
+					liveSubId = subId;
+				}
+			});
+		});
+
+		const relay = new Relay(testRelay.url);
+		const received: string[] = [];
+		const unsubscribe = relay.subscribe({ kinds: [30078] }, e => received.push(e.id));
+
+		await new Promise(r => setTimeout(r, 50));
+		expect(subSocket).not.toBeNull();
+		subSocket!.send(JSON.stringify(['EVENT', liveSubId, event]));
+		await new Promise(r => setTimeout(r, 50));
+
+		expect(received).toEqual([event.id]);
+		unsubscribe();
+		relay.close();
+	});
+
+	test('relayPool.queryAll de-duplicates the same event id seen from several relays', async () => {
+		const relayA = await startTestRelay();
+		const relayB = await startTestRelay();
+		const device = generateKeyPair();
+		const event = finalizeEvent({ kind: 30078, tags: [], content: 'hi', created_at: Math.floor(Date.now() / 1000) }, device.secretKey);
+
+		for (const r of [relayA, relayB]) {
+			r.server.on('connection', socket => {
+				socket.on('message', raw => {
+					const [type, subId] = JSON.parse(raw.toString());
+					if (type !== 'REQ') return;
+					socket.send(JSON.stringify(['EVENT', subId, event]));
+					socket.send(JSON.stringify(['EOSE', subId]));
+				});
+			});
+		}
+
+		const pool = new RelayPool([relayA.url, relayB.url]);
+		const results = await pool.queryAll({ kinds: [30078] });
+		expect(results).toHaveLength(1);
+		expect(results[0].id).toBe(event.id);
+
+		pool.close();
+		await relayA.close();
+		await relayB.close();
+	});
+
+	test('relayPool.publishAll succeeds when at least one relay says OK', async () => {
+		const relayA = await startTestRelay();
+		const relayB = await startTestRelay();
+		relayA.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, event] = JSON.parse(raw.toString());
+				if (type === 'EVENT') socket.send(JSON.stringify(['OK', event.id, true, '']));
+			});
+		});
+		relayB.server.on('connection', socket => {
+			socket.on('message', raw => {
+				const [type, event] = JSON.parse(raw.toString());
+				if (type === 'EVENT') socket.send(JSON.stringify(['OK', event.id, false, 'blocked']));
+			});
+		});
+
+		const device = generateKeyPair();
+		const event = finalizeEvent({ kind: 30078, tags: [], content: 'hi', created_at: Math.floor(Date.now() / 1000) }, device.secretKey);
+		const pool = new RelayPool([relayA.url, relayB.url]);
+		const results = await pool.publishAll(event);
+
+		expect(results.find(r => r.url === relayA.url)).toMatchObject({ ok: true });
+		expect(results.find(r => r.url === relayB.url)).toMatchObject({ ok: false, message: 'blocked' });
+
+		pool.close();
+		await relayA.close();
+		await relayB.close();
+	});
+});
diff --git a/packages/app-mobile/lists/sync/relayPool.ts b/packages/app-mobile/lists/sync/relayPool.ts
