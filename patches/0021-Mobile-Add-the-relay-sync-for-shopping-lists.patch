index 0000000..0490187
--- /dev/null
+++ b/packages/app-mobile/lists/sync/testing/fakeRelay.ts
@@ -0,0 +1,142 @@
+// In-memory relay network implementing enough of NIP-01 (addressable-event
+// replacement per author+kind+d-tag, and Filter matching) for lists/sync
+// tests, without opening a real WebSocket. See relayPool.ts#RelayPoolLike for
+// the interface a fake pool needs to satisfy.
+import { Filter, VerifiedEvent } from 'nostr-tools';
+import { PublishResult, RelayPoolFactory, RelayPoolLike, RelayPublishResult } from '../relayPool';
+
+const matchesFilter = (filter: Filter, event: VerifiedEvent): boolean => {
+	if (filter.ids && !filter.ids.includes(event.id)) return false;
+	if (filter.kinds && !filter.kinds.includes(event.kind)) return false;
+	if (filter.authors && !filter.authors.includes(event.pubkey)) return false;
+	if (filter.since !== undefined && event.created_at < filter.since) return false;
+	if (filter.until !== undefined && event.created_at > filter.until) return false;
+	for (const key of Object.keys(filter)) {
+		if (!key.startsWith('#')) continue;
+		const wanted = (filter as Record<string, string[] | undefined>)[key];
+		if (!wanted || wanted.length === 0) continue;
+		const tagName = key.slice(1);
+		const values = event.tags.filter(t => t[0] === tagName).map(t => t[1]);
+		if (!wanted.some(v => values.includes(v))) return false;
+	}
+	return true;
+};
+
+const matchesAny = (filters: Filter[], event: VerifiedEvent): boolean => filters.some(filter => matchesFilter(filter, event));
+
+const addressableKey = (event: VerifiedEvent): string => {
+	const dTag = event.tags.find(t => t[0] === 'd')?.[1] ?? '';
+	return `${event.pubkey}:${event.kind}:${dTag}`;
+};
+
+// A single named relay's storage and live subscribers -- what two
+// FakeRelayPool instances that share a url actually talk to, simulating two
+// devices going through the same real relay.
+class FakeRelay {
+	public readonly url: string;
+	public reachable = true;
+	public rejectTooOld = false;
+	private events = new Map<string, VerifiedEvent>();
+	private subscribers = new Set<(event: VerifiedEvent)=> void>();
+
+	public constructor(url: string) {
+		this.url = url;
+	}
+
+	public publish(event: VerifiedEvent): PublishResult {
+		if (!this.reachable) return { ok: false, message: 'unreachable' };
+		if (this.rejectTooOld && event.created_at < Math.floor(Date.now() / 1000) - 3600) {
+			return { ok: false, message: 'invalid: created_at is too old' };
+		}
+		const key = addressableKey(event);
+		const existing = this.events.get(key);
+		if (!existing || existing.created_at <= event.created_at) {
+			this.events.set(key, event);
+			for (const subscriber of this.subscribers) subscriber(event);
+		}
+		return { ok: true, message: '' };
+	}
+
+	public query(filters: Filter[]): VerifiedEvent[] {
+		if (!this.reachable) return [];
+		return Array.from(this.events.values()).filter(event => matchesAny(filters, event));
+	}
+
+	public subscribe(filters: Filter[], onEvent: (event: VerifiedEvent)=> void): ()=> void {
+		const handler = (event: VerifiedEvent): void => { if (matchesAny(filters, event)) onEvent(event); };
+		this.subscribers.add(handler);
+		return () => this.subscribers.delete(handler);
+	}
+
+	// Simulates a relay losing an event (e.g. it expired it), to test
+	// ListsSync.republishAll().
+	public drop(pubkey: string, kind: number, dTag: string): void {
+		this.events.delete(`${pubkey}:${kind}:${dTag}`);
+	}
+}
+
+// A network of named relays shared by every FakeRelayPool built from the same
+// FakeRelayNetwork instance -- construct one per test, hand its factory to
+// every device's ListsSync so they can reach each other.
+export class FakeRelayNetwork {
+	private relays = new Map<string, FakeRelay>();
+
+	public relay(url: string): FakeRelay {
+		let relay = this.relays.get(url);
+		if (!relay) {
+			relay = new FakeRelay(url);
+			this.relays.set(url, relay);
+		}
+		return relay;
+	}
+
+	public setReachable(url: string, reachable: boolean): void {
+		this.relay(url).reachable = reachable;
+	}
+
+	public setRejectTooOld(url: string, reject: boolean): void {
+		this.relay(url).rejectTooOld = reject;
+	}
+
+	public drop(url: string, pubkey: string, kind: number, dTag: string): void {
+		this.relay(url).drop(pubkey, kind, dTag);
+	}
+}
+
+class FakeRelayPool implements RelayPoolLike {
+	private relays: FakeRelay[];
+
+	public constructor(network: FakeRelayNetwork, urls: string[]) {
+		this.relays = urls.map(url => network.relay(url));
+	}
+
+	public async publishAll(event: VerifiedEvent): Promise<RelayPublishResult[]> {
+		return this.relays.map(relay => ({ url: relay.url, ...relay.publish(event) }));
+	}
+
+	public async queryAll(filter: Filter | Filter[]): Promise<VerifiedEvent[]> {
+		const filters = Array.isArray(filter) ? filter : [filter];
+		const byId = new Map<string, VerifiedEvent>();
+		for (const relay of this.relays) {
+			for (const event of relay.query(filters)) byId.set(event.id, event);
+		}
+		return Array.from(byId.values());
+	}
+
+	public subscribeAll(filter: Filter | Filter[], onEvent: (event: VerifiedEvent)=> void): ()=> void {
+		const filters = Array.isArray(filter) ? filter : [filter];
+		const unsubscribes = this.relays.map(relay => relay.subscribe(filters, onEvent));
+		return () => { for (const unsubscribe of unsubscribes) unsubscribe(); };
+	}
+
+	public close(): void {
+		// Nothing to release: the underlying FakeRelay objects live in the
+		// shared network, not in this pool.
+	}
+
+	public anyConnected(): boolean {
+		return this.relays.some(relay => relay.reachable);
+	}
+}
+
+export const fakeRelayPoolFactory = (network: FakeRelayNetwork): RelayPoolFactory => (urls: string[]) => new FakeRelayPool(network, urls);
