index 0000000..0ba5939
--- /dev/null
+++ b/packages/app-mobile/lists/sync/listSync.test.ts
@@ -0,0 +1,260 @@
+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { ListsDatabase } from '../core/db';
+import { ListsStore } from '../core/store';
+import { ItemRecord } from '../core/types';
+import { hexToBytes } from '../core/crypto';
+import { ListsSync } from './listSync';
+import { FakeRelayNetwork, fakeRelayPoolFactory } from './testing/fakeRelay';
+import { defaultRelays } from './defaultRelays';
+import { buildManagedDirectoryEvent, LIST_EVENT_KIND } from '../core/events';
+
+interface Device {
+	store: ListsStore;
+	db: ListsDatabase;
+	sync: ListsSync;
+	path: string;
+}
+
+const openDevice = async (network: FakeRelayNetwork): Promise<Device> => {
+	const path = join(tmpdir(), `tiles-sync-test-${uuid.createNano()}.sqlite`);
+	const db = new ListsDatabase(new Database(new DatabaseDriverNode()));
+	await db.openOrCreate(path);
+	const store = new ListsStore(db, path);
+	const sync = new ListsSync(store, db, fakeRelayPoolFactory(network));
+	return { store, db, sync, path };
+};
+
+const closeDevice = async (device: Device): Promise<void> => {
+	device.sync.closeAll();
+	await device.db.close();
+	await rm(device.path, { force: true });
+};
+
+const findItem = (items: ItemRecord[], name: string): ItemRecord | undefined => items.find(i => i.name === name);
+
+describe('lists/sync/listSync', () => {
+	let network: FakeRelayNetwork;
+	let devices: Device[];
+
+	beforeEach(() => {
+		network = new FakeRelayNetwork();
+		devices = [];
+	});
+
+	afterEach(async () => {
+		for (const device of devices) await closeDevice(device);
+	});
+
+	const addDevice = async (): Promise<Device> => {
+		const device = await openDevice(network);
+		devices.push(device);
+		return device;
+	};
+
+	test('open list: an item added on one device reaches another after both sync', async () => {
+		const a = await addDevice();
+		const b = await addDevice();
+
+		const list = await a.store.createOpenList('Groceries');
+		await a.sync.syncList(list.id);
+
+		await b.store.joinFromInvite((await a.store.inviteFor(list.id)).link);
+		await b.sync.syncList(list.id); // learns about A, announces itself
+		await a.sync.syncList(list.id); // learns about B
+
+		await a.store.addItem(list.id, 'Milch');
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+
+		const bItems = await b.store.items(list.id);
+		expect(findItem(bItems, 'Milch')).toMatchObject({ open: true, pending: false });
+	});
+
+	test('open list: concurrent changes on two devices converge field-wise', async () => {
+		const a = await addDevice();
+		const b = await addDevice();
+		const list = await a.store.createOpenList('Groceries');
+		await a.sync.syncList(list.id);
+		await b.store.joinFromInvite((await a.store.inviteFor(list.id)).link);
+		await b.sync.syncList(list.id);
+		await a.sync.syncList(list.id);
+
+		await a.store.addItem(list.id, 'Milch');
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+
+		// B ticks the item off, A concurrently sets its detail -- neither has
+		// seen the other's change yet.
+		const bItem = findItem(await b.store.items(list.id), 'Milch')!;
+		await b.store.toggleOpen(list.id, bItem.dTag);
+		const aItem = findItem(await a.store.items(list.id), 'Milch')!;
+		await a.store.setDetail(list.id, aItem.dTag, '2 l');
+
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+		await a.sync.syncList(list.id); // picks up B's publish too
+
+		for (const device of [a, b]) {
+			const item = findItem(await device.store.items(list.id), 'Milch')!;
+			expect(item).toMatchObject({ open: false, detail: '2 l' });
+		}
+	});
+
+	test('open list: a tombstone propagates to another device', async () => {
+		const a = await addDevice();
+		const b = await addDevice();
+		const list = await a.store.createOpenList('Groceries');
+		await a.sync.syncList(list.id);
+		await b.store.joinFromInvite((await a.store.inviteFor(list.id)).link);
+		await b.sync.syncList(list.id);
+		await a.sync.syncList(list.id);
+
+		await a.store.addItem(list.id, 'Milch');
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+
+		const aItem = findItem(await a.store.items(list.id), 'Milch')!;
+		await a.store.removeItem(list.id, aItem.dTag);
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+
+		expect(await b.store.items(list.id)).toEqual([]);
+	});
+
+	test('republishAll restores an item to a relay that lost it', async () => {
+		const a = await addDevice();
+		const b = await addDevice();
+		const list = await a.store.createOpenList('Groceries');
+		await a.sync.syncList(list.id);
+		await b.store.joinFromInvite((await a.store.inviteFor(list.id)).link);
+		await b.sync.syncList(list.id);
+		await a.sync.syncList(list.id);
+
+		const item = await a.store.addItem(list.id, 'Milch');
+		await a.sync.syncList(list.id);
+		await b.sync.syncList(list.id);
+		expect(findItem(await b.store.items(list.id), 'Milch')).toBeDefined();
+
+		const identity = await a.db.deviceIdentity();
+		for (const url of defaultRelays) network.drop(url, identity.publicKey, LIST_EVENT_KIND, item.dTag);
+
+		// A fresh device joining now would get nothing for this item until A
+		// republishes its full state.
+		const c = await addDevice();
+		await c.store.joinFromInvite((await a.store.inviteFor(list.id)).link);
+		await c.sync.syncList(list.id);
+		expect(findItem(await c.store.items(list.id), 'Milch')).toBeUndefined();
+
+		await a.sync.republishAll(list.id);
+		await c.sync.syncList(list.id);
+		expect(findItem(await c.store.items(list.id), 'Milch')).toBeDefined();
+	});
+
+	test('a relay rejecting a publish as too old is retried with created_at = now', async () => {
+		const a = await addDevice();
+		const list = await a.store.createOpenList('Groceries');
+		await a.sync.syncList(list.id);
+		for (const url of defaultRelays) network.setRejectTooOld(url, true);
+
+		await a.store.addItem(list.id, 'Milch');
+		await a.sync.syncList(list.id);
+
+		// The retry with created_at = now() is no longer "too old" and succeeds.
+		expect(await a.store.pendingItems(list.id)).toEqual([]);
+	});
+
+	test('managed list: a device joins via invite, the admin accepts it, and both end up with the same items', async () => {
+		const admin = await addDevice();
+		const joiner = await addDevice();
+
+		const list = await admin.store.createManagedList('Household');
+		await admin.sync.syncList(list.id);
+
+		const invite = await admin.store.inviteFor(list.id);
+		const joinResult = await joiner.store.joinFromInvite(invite.link);
+		if (joinResult.type !== 'managed') throw new Error('expected a managed join');
+		await joiner.sync.publishJoinRequest(list.id, joinResult.joinRequest);
+
+		await admin.sync.syncList(list.id); // accepts the join request, publishes directory + content key
+		await joiner.sync.syncList(list.id); // recovers the content key from the directory
+
+		const joinerList = await joiner.db.list(list.id);
+		expect(joinerList?.contentKey).not.toBeNull();
+
+		await admin.store.addItem(list.id, 'Brot');
+		await admin.sync.syncList(list.id);
+		await joiner.sync.syncList(list.id);
+
+		expect(findItem(await joiner.store.items(list.id), 'Brot')).toMatchObject({ open: true });
+	});
+
+	test('managed list: a removed member\'s later events are ignored', async () => {
+		const admin = await addDevice();
+		const member = await addDevice();
+
+		const list = await admin.store.createManagedList('Household');
+		await admin.sync.syncList(list.id);
+		const invite = await admin.store.inviteFor(list.id);
+		const joinResult = await member.store.joinFromInvite(invite.link);
+		if (joinResult.type !== 'managed') throw new Error('expected a managed join');
+		await member.sync.publishJoinRequest(list.id, joinResult.joinRequest);
+		await admin.sync.syncList(list.id);
+		await member.sync.syncList(list.id);
+
+		// The member adds an item before being removed; it should still sync.
+		await member.store.addItem(list.id, 'Kaffee');
+		await member.sync.syncList(list.id);
+		await admin.sync.syncList(list.id);
+		expect(findItem(await admin.store.items(list.id), 'Kaffee')).toBeDefined();
+
+		// The admin removes the member and publishes an updated directory (a
+		// full removal would also rotate the content key -- not needed to
+		// prove events from a removed member are ignored).
+		const memberIdentity = await member.db.deviceIdentity();
+		const adminMembers = await admin.db.members(list.id);
+		const updatedMembers = adminMembers.map(m => (m.pubkey === memberIdentity.publicKey ? { ...m, removedAt: Date.now() } : m));
+		for (const m of updatedMembers) await admin.db.upsertMember(m);
+		const adminList = await admin.db.list(list.id);
+		const directoryPayload = { members: updatedMembers, settings: adminList!.settings };
+		const directoryEvent = buildManagedDirectoryEvent(hexToBytes(adminList!.listKey!), hexToBytes(adminList!.contentKey!), directoryPayload, undefined, list.id);
+		for (const url of defaultRelays) network.relay(url).publish(directoryEvent);
+		await admin.db.setMeta(`directory:${list.id}`, JSON.stringify(directoryPayload));
+
+		// The removed member, still on the old content key, tries to add
+		// another item; the admin's author filter no longer includes them.
+		await member.store.addItem(list.id, 'Tee');
+		await member.sync.syncList(list.id);
+		await admin.sync.syncList(list.id);
+
+		expect(findItem(await admin.store.items(list.id), 'Tee')).toBeUndefined();
+	});
+
+	test('a directory signed by a non-admin device is rejected', async () => {
+		const admin = await addDevice();
+		const outsider = await addDevice();
+
+		const list = await admin.store.createManagedList('Household');
+		await admin.sync.syncList(list.id);
+
+		// The outsider is not a member at all, let alone an admin; forging a
+		// directory event under this list's id must not be accepted.
+		const outsiderIdentity = await outsider.db.deviceIdentity();
+		const forged = buildManagedDirectoryEvent(
+			outsiderIdentity.secretKey,
+			new Uint8Array(32),
+			{ members: [{ listId: list.id, pubkey: outsiderIdentity.publicKey, name: 'Intruder', role: 'admin', since: Date.now(), removedAt: null }], settings: null },
+			undefined,
+			list.id,
+		);
+		for (const url of defaultRelays) network.relay(url).publish(forged);
+
+		await admin.sync.syncList(list.id);
+		const members = await admin.db.members(list.id);
+		expect(members.some(m => m.pubkey === outsiderIdentity.publicKey)).toBe(false);
+	});
+});
