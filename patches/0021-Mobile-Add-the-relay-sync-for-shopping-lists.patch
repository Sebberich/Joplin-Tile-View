@@ -0,0 +1,532 @@
+// Transport 1 from docs/KONZEPT.md section 3: syncing a shopping list over
+// Nostr relays. Builds on lists/core (events, merge, invite) plus the
+// RelayPool from ./relayPool for the actual network traffic.
+import { AppState, AppStateStatus, NativeEventSubscription } from 'react-native';
+import { Filter, VerifiedEvent } from 'nostr-tools';
+import { ListsDatabase, DeviceIdentity } from '../core/db';
+import { ListsStore, itemRecordToPayload } from '../core/store';
+import {
+	buildItemEvent,
+	buildManagedDirectoryEvent,
+	buildOpenDirectoryEvent,
+	DIRECTORY_D_TAG,
+	DirectoryPayload,
+	isDirectoryAcceptable,
+	LIST_EVENT_KIND,
+	parseItemEvent,
+	parseJoinRequestEvent,
+	parseManagedDirectoryEvent,
+	parseOpenDirectoryEvent,
+	unwrapManagedContentKey,
+} from '../core/events';
+import { deriveOpenListKeys, hexToBytes } from '../core/crypto';
+import { isInviteExpired, ListInvite, parseInvite, verifyManagedInviteToken } from '../core/invite';
+import { ItemPayload, ItemRecord, ListRecord, MemberRecord } from '../core/types';
+import { defaultRelayPoolFactory, publishSucceeded, RelayPoolFactory, RelayPoolLike, RelayPublishResult } from './relayPool';
+import { currentRelays } from './defaultRelays';
+
+const REPUBLISH_INTERVAL_MS = 7 * 24 * 60 * 60 * 1000;
+const ITEM_SYNC_LOOKBACK_MS = 24 * 60 * 60 * 1000;
+const LIFECYCLE_THROTTLE_MS = 30 * 1000;
+
+// A relay's OK message rejecting an event as too old for it to keep; the
+// device was offline long enough that its clamped local timestamp now lags
+// behind what the relay considers recent. See docs/KONZEPT.md section 3.
+const TOO_OLD_MESSAGE = /too old|invalid:\s*created_at/i;
+
+export type SyncState = 'idle' | 'syncing' | 'offline' | 'error';
+
+export interface SyncStatus {
+	listId: string;
+	state: SyncState;
+	lastSync?: number;
+	message?: string;
+}
+
+export type StatusListener = (status: SyncStatus)=> void;
+
+const itemEventCreatedAt = (item: ItemRecord): number => {
+	const times = [item.openT, item.detailT, item.categoryT, item.deletedT].filter((t): t is number => t !== null);
+	const maxMs = times.length > 0 ? Math.max(...times) : Date.now();
+	return Math.floor(maxMs / 1000);
+};
+
+const eventDTag = (event: VerifiedEvent): string | undefined => event.tags.find(tag => tag[0] === 'd')?.[1];
+
+// Syncs shopping lists over Nostr relays: fetches and applies the member
+// directory and item events for a list, publishes local pending changes, and
+// (for managed lists) lets an admin device accept join requests. No UI or
+// Bluetooth code -- this is transport 1 only, see ./nearby.ts for transport 2.
+export class ListsSync {
+	private static singleton: ListsSync | null = null;
+
+	private db: ListsDatabase;
+	private store: ListsStore;
+	private poolFactory: RelayPoolFactory;
+	private pools = new Map<string, RelayPoolLike>();
+	private subscriptions: Map<string, ()=> void> = new Map();
+	private statusListeners = new Set<StatusListener>();
+	private statuses = new Map<string, SyncStatus>();
+
+	public constructor(store: ListsStore, db: ListsDatabase, poolFactory: RelayPoolFactory = defaultRelayPoolFactory) {
+		this.store = store;
+		this.db = db;
+		this.poolFactory = poolFactory;
+	}
+
+	// Creates (or replaces) the process-wide singleton. Call once at startup,
+	// after the lists ListsStore/ListsDatabase have been constructed.
+	public static init(store: ListsStore, db: ListsDatabase, poolFactory?: RelayPoolFactory): ListsSync {
+		ListsSync.singleton = new ListsSync(store, db, poolFactory);
+		return ListsSync.singleton;
+	}
+
+	public static instance(): ListsSync {
+		if (!ListsSync.singleton) throw new Error('ListsSync.init() has not been called yet');
+		return ListsSync.singleton;
+	}
+
+	public onStatus(listener: StatusListener): ()=> void {
+		this.statusListeners.add(listener);
+		return () => this.statusListeners.delete(listener);
+	}
+
+	public status(listId: string): SyncStatus | undefined {
+		return this.statuses.get(listId);
+	}
+
+	private setStatus(status: SyncStatus): void {
+		this.statuses.set(status.listId, status);
+		for (const listener of this.statusListeners) listener(status);
+	}
+
+	private poolFor(listId: string, list?: ListRecord | null): RelayPoolLike {
+		let pool = this.pools.get(listId);
+		if (!pool) {
+			const urls = list?.relays && list.relays.length > 0 ? list.relays : currentRelays();
+			pool = this.poolFactory(urls);
+			this.pools.set(listId, pool);
+		}
+		return pool;
+	}
+
+	// Closes every relay connection and cancels every live subscription. Tests
+	// call this in afterEach(); the app doesn't normally need to.
+	public closeAll(): void {
+		for (const unsubscribe of this.subscriptions.values()) unsubscribe();
+		this.subscriptions.clear();
+		for (const pool of this.pools.values()) pool.close();
+		this.pools.clear();
+	}
+
+	private lastSyncKey = (listId: string): string => `lastSync:${listId}`;
+	private lastRepublishKey = (listId: string): string => `lastRepublish:${listId}`;
+	private directoryMetaKey = (listId: string): string => `directory:${listId}`;
+	private usedInviteKey = (listId: string, tokenId: string): string => `usedInvite:${listId}:${tokenId}`;
+	private handledJoinKey = (listId: string, eventId: string): string => `handledJoin:${listId}:${eventId}`;
+
+	// --- one full sync pass for a single list -----------------------------
+
+	public async syncList(listId: string): Promise<void> {
+		const initialList = await this.db.list(listId);
+		if (!initialList) return;
+		const identity = await this.db.deviceIdentity();
+		const pool = this.poolFor(listId, initialList);
+		this.setStatus({ listId, state: 'syncing' });
+
+		try {
+			await this.syncDirectory(initialList, identity, pool);
+			const list = (await this.db.list(listId)) ?? initialList;
+
+			if (list.kind === 'managed' && await this.isLocalAdmin(listId, identity.publicKey)) {
+				await this.acceptJoinRequests(list, identity, pool);
+			}
+
+			await this.syncItems(list, pool);
+			await this.publishPending(list, identity, pool);
+			await this.ensureSelfInDirectory(list, identity, pool);
+			await this.maybeRepublish(list, identity, pool);
+
+			const now = Date.now();
+			await this.db.setMeta(this.lastSyncKey(listId), String(now));
+
+			if (!pool.anyConnected()) this.setStatus({ listId, state: 'offline' });
+			else this.setStatus({ listId, state: 'idle', lastSync: now });
+		} catch (error) {
+			if (!pool.anyConnected()) this.setStatus({ listId, state: 'offline' });
+			else this.setStatus({ listId, state: 'error', message: error instanceof Error ? error.message : String(error) });
+		}
+	}
+
+	public async refreshAll(): Promise<void> {
+		const lists = await this.db.lists();
+		for (const list of lists) await this.syncList(list.id);
+	}
+
+	private async isLocalAdmin(listId: string, publicKey: string): Promise<boolean> {
+		const members = await this.db.members(listId);
+		return members.some(m => m.pubkey === publicKey && m.role === 'admin' && !m.removedAt);
+	}
+
+	// --- directory ----------------------------------------------------------
+
+	private async syncDirectory(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		const filter: Filter = { kinds: [LIST_EVENT_KIND], '#d': [DIRECTORY_D_TAG], '#L': [list.id] };
+		const events = await pool.queryAll(filter);
+		// Oldest first: replays the admin trust chain forward from whatever was
+		// last accepted, so a later event can only be trusted via an earlier
+		// one in this same batch (or the one already on disk).
+		const ordered = [...events].sort((a, b) => a.created_at - b.created_at);
+		for (const event of ordered) {
+			const current = (await this.db.list(list.id)) ?? list;
+			await this.handleDirectoryEvent(current, identity, event);
+		}
+	}
+
+	private async handleDirectoryEvent(list: ListRecord, identity: DeviceIdentity, event: VerifiedEvent): Promise<void> {
+		if (list.kind === 'open') {
+			// Every open-list directory, forever, is signed by the same list key
+			// (every member derives it, see crypto.ts#deriveOpenListKeys) -- so
+			// isDirectoryAcceptable()'s admin-chain (built for managed lists,
+			// where the signer changes over time) never re-matches after the
+			// first directory. Checking the signer against the list id directly
+			// is exactly as strong here: it's the same cryptographic proof the
+			// chain's bootstrap case already relies on.
+			if (event.pubkey !== list.id) return;
+		} else if (event.pubkey !== list.id) {
+			// Not signed by the list's own root key (see signManagedDirectory()):
+			// only acceptable via the admin chain, same as isDirectoryAcceptable()
+			// intends for its "previously accepted" case. A root-key-signed event
+			// is always acceptable, matching its "first ever" case generalised to
+			// "any time it's used" -- the creating admin keeps using it for
+			// exactly this reason, see signManagedDirectory().
+			const previousJson = await this.db.getMeta(this.directoryMetaKey(list.id));
+			const previouslyAccepted: DirectoryPayload | null = previousJson ? JSON.parse(previousJson) : null;
+			if (!isDirectoryAcceptable(previouslyAccepted, list.id, event.pubkey)) return;
+		}
+
+		let payload: DirectoryPayload | null;
+		try {
+			if (list.kind === 'open') {
+				if (!list.contentKey) return;
+				payload = parseOpenDirectoryEvent(event, hexToBytes(list.contentKey));
+			} else {
+				payload = await this.acceptManagedDirectory(list, identity, event);
+			}
+		} catch (error) {
+			return; // undecryptable or tampered: ignore, as if we never saw it
+		}
+		if (!payload) return;
+
+		await this.applyDirectory(list.id, payload);
+		await this.db.setMeta(this.directoryMetaKey(list.id), JSON.stringify(payload));
+	}
+
+	// Recovers the content key either from what we already have (fast path,
+	// also covers the admin's own device) or by unwrapping it from this
+	// event's entry for us -- which only works once we've actually been added.
+	private async acceptManagedDirectory(list: ListRecord, identity: DeviceIdentity, event: VerifiedEvent): Promise<DirectoryPayload | null> {
+		if (list.contentKey) {
+			try {
+				return parseManagedDirectoryEvent(event, hexToBytes(list.contentKey));
+			} catch (error) {
+				// Falls through to try unwrapping a fresh key below, e.g. after
+				// the admin rotated it and we haven't caught up yet.
+			}
+		}
+		let contentKey: Uint8Array;
+		try {
+			contentKey = unwrapManagedContentKey(event, identity.secretKey);
+		} catch (error) {
+			return null; // we're not a wrapped member of this directory (yet)
+		}
+		const payload = parseManagedDirectoryEvent(event, contentKey);
+		await this.db.setContentKey(list.id, contentKey);
+		return payload;
+	}
+
+	private async applyDirectory(listId: string, payload: DirectoryPayload): Promise<void> {
+		for (const member of payload.members) await this.db.upsertMember(member);
+		await this.db.setListSettings(listId, payload.settings ?? null);
+	}
+
+	// Signs a managed directory update. The creating admin keeps its copy of
+	// the list's own key (see db.ts) and always signs with it rather than its
+	// device key: isDirectoryAcceptable() only lets a brand-new joiner bootstrap
+	// trust via a listPubkey-signed event, so every directory update needs to
+	// keep coming from that same signer for later joiners to ever get in, not
+	// just the very first one. An admin device that only ever joined (no local
+	// list key) has no choice but to sign with its own device key -- members
+	// that already have a previously-accepted directory naming it as admin
+	// will follow it via isDirectoryAcceptable()'s chain, but a first-time
+	// joiner can only bootstrap once the creator republishes again.
+	private async signManagedDirectory(list: ListRecord, identity: DeviceIdentity, contentKey: Uint8Array, payload: DirectoryPayload): Promise<VerifiedEvent> {
+		const signerKey = list.listKey ? hexToBytes(list.listKey) : identity.secretKey;
+		return buildManagedDirectoryEvent(signerKey, contentKey, payload, undefined, list.id);
+	}
+
+	// Publishes an up-to-date directory for this device's own list membership.
+	// Open lists: any member may sign (everyone holds the list key), so this
+	// always republishes to keep the directory's member list current. Managed
+	// lists: only an admin may sign, and only for the very first publish --
+	// acceptJoinRequests() republishes on every later membership change.
+	private async ensureSelfInDirectory(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		if (!list.contentKey) return;
+		const members = await this.db.members(list.id);
+
+		if (list.kind === 'open') {
+			if (!list.listKey || !members.some(m => m.pubkey === identity.publicKey)) return;
+			const payload: DirectoryPayload = { members, settings: list.settings };
+			// list.listKey is the raw shared secret carried by an open-list invite
+			// (the HKDF input), not a usable Nostr key by itself -- derive the
+			// actual list key pair from it first, see crypto.ts#deriveOpenListKeys.
+			const listSecretKey = deriveOpenListKeys(hexToBytes(list.listKey)).listSecretKey;
+			const event = buildOpenDirectoryEvent(listSecretKey, hexToBytes(list.contentKey), payload, undefined, list.id);
+			await pool.publishAll(event);
+			await this.db.setMeta(this.directoryMetaKey(list.id), JSON.stringify(payload));
+			return;
+		}
+
+		if (!await this.isLocalAdmin(list.id, identity.publicKey)) return;
+		const previousJson = await this.db.getMeta(this.directoryMetaKey(list.id));
+		if (previousJson) return;
+		const payload: DirectoryPayload = { members, settings: list.settings };
+		const event = await this.signManagedDirectory(list, identity, hexToBytes(list.contentKey), payload);
+		await pool.publishAll(event);
+		await this.db.setMeta(this.directoryMetaKey(list.id), JSON.stringify(payload));
+	}
+
+	// --- join requests (managed lists, admin only) --------------------------
+
+	private async acceptJoinRequests(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		if (!list.contentKey) return;
+		// Join requests are tagged ['p', adminPubkey] (see events.ts), not with
+		// a predictable 'd' tag -- the device pubkey it's keyed on isn't known
+		// in advance -- so this is the only filter that finds them all.
+		const filter: Filter = { kinds: [LIST_EVENT_KIND], '#p': [identity.publicKey] };
+		const events = await pool.queryAll(filter);
+		if (events.length === 0) return;
+
+		let members = await this.db.members(list.id);
+		let changed = false;
+
+		for (const event of events) {
+			// A join request is addressable per device (not per invite), so the
+			// same event keeps sitting on the relay long after it was accepted;
+			// without this, accepting it again after the member is later removed
+			// would silently re-add them. A genuinely new request (e.g. after a
+			// fresh invite) is a different event id and isn't skipped by this.
+			if (await this.db.getMeta(this.handledJoinKey(list.id, event.id))) continue;
+
+			let parsed;
+			try {
+				parsed = parseJoinRequestEvent(event, identity.secretKey);
+			} catch (error) {
+				continue;
+			}
+			if (members.some(m => m.pubkey === parsed.devicePubkey && !m.removedAt)) continue;
+
+			let invite: ListInvite;
+			try {
+				invite = parseInvite(parsed.inviteToken);
+			} catch (error) {
+				continue;
+			}
+			if (invite.kind !== 'managed' || invite.listPubkey !== list.id || invite.adminPubkey !== identity.publicKey) continue;
+			if (!verifyManagedInviteToken(invite.token, invite.adminPubkey) || isInviteExpired(invite.token)) continue;
+			if (invite.token.once && await this.db.getMeta(this.usedInviteKey(list.id, invite.token.id))) continue;
+
+			const newMember: MemberRecord = { listId: list.id, pubkey: parsed.devicePubkey, name: parsed.deviceName, role: invite.token.role, since: Date.now(), removedAt: null };
+			await this.db.upsertMember(newMember);
+			members = [...members, newMember];
+			if (invite.token.once) await this.db.setMeta(this.usedInviteKey(list.id, invite.token.id), '1');
+			await this.db.setMeta(this.handledJoinKey(list.id, event.id), '1');
+			changed = true;
+		}
+
+		if (!changed) return;
+		const payload: DirectoryPayload = { members, settings: list.settings };
+		const directoryEvent = await this.signManagedDirectory(list, identity, hexToBytes(list.contentKey), payload);
+		await pool.publishAll(directoryEvent);
+		await this.db.setMeta(this.directoryMetaKey(list.id), JSON.stringify(payload));
+	}
+
+	// A managed join request is built by ListsStore.joinFromInvite(); sending
+	// it to the admin is the sync layer's job (over relays here, or directly
+	// over Bluetooth later -- same signed event either way).
+	public async publishJoinRequest(listId: string, joinRequestEvent: VerifiedEvent): Promise<RelayPublishResult[]> {
+		const list = await this.db.list(listId);
+		return this.poolFor(listId, list).publishAll(joinRequestEvent);
+	}
+
+	// --- items ----------------------------------------------------------
+
+	private async itemsSince(listId: string): Promise<number | undefined> {
+		const lastSyncJson = await this.db.getMeta(this.lastSyncKey(listId));
+		if (!lastSyncJson) return undefined; // first sync: fetch everything
+		return Math.max(0, Math.floor((Number(lastSyncJson) - ITEM_SYNC_LOOKBACK_MS) / 1000));
+	}
+
+	private async syncItems(list: ListRecord, pool: RelayPoolLike): Promise<void> {
+		if (!list.contentKey) return;
+		const members = await this.db.members(list.id);
+		const memberPubkeys = members.filter(m => !m.removedAt).map(m => m.pubkey);
+		if (memberPubkeys.length === 0) return;
+
+		const filter: Filter = { kinds: [LIST_EVENT_KIND], authors: memberPubkeys, '#L': [list.id] };
+		const since = await this.itemsSince(list.id);
+		if (since !== undefined) filter.since = since;
+
+		const events = await pool.queryAll(filter);
+		for (const event of events) {
+			const dTagValue = eventDTag(event);
+			// The author filter above also matches this member's own directory
+			// or join-request events (same kind, same 'L' tag); skip them here.
+			if (!dTagValue || dTagValue === DIRECTORY_D_TAG || dTagValue.startsWith('join:')) continue;
+			await this.handleItemEvent(list, event);
+		}
+	}
+
+	private async handleItemEvent(list: ListRecord, event: VerifiedEvent): Promise<void> {
+		if (!list.contentKey) return;
+		const members = await this.db.members(list.id);
+		if (!members.some(m => m.pubkey === event.pubkey && !m.removedAt)) return;
+		const dTagValue = eventDTag(event);
+		if (!dTagValue) return;
+		let payload: ItemPayload;
+		try {
+			payload = parseItemEvent(event, hexToBytes(list.contentKey));
+		} catch (error) {
+			return; // wrong/rotated content key, or a tampered event
+		}
+		await this.store.applyRemoteItem(list.id, dTagValue, payload);
+	}
+
+	private async publishPending(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		if (!list.contentKey) return;
+		const contentKey = hexToBytes(list.contentKey);
+		const pending = await this.store.pendingItems(list.id);
+
+		for (const item of pending) {
+			const payload = itemRecordToPayload(item);
+			const event = buildItemEvent(identity.secretKey, list.id, item.dTag, contentKey, payload, itemEventCreatedAt(item));
+			let results = await pool.publishAll(event);
+
+			if (!publishSucceeded(results) && results.some(r => TOO_OLD_MESSAGE.test(r.message))) {
+				const retryEvent = buildItemEvent(identity.secretKey, list.id, item.dTag, contentKey, payload, Math.floor(Date.now() / 1000));
+				results = await pool.publishAll(retryEvent);
+			}
+
+			if (publishSucceeded(results)) await this.store.markPublished(list.id, item.dTag);
+		}
+	}
+
+	// --- "relays are a mailbox": periodic full republish -------------------
+
+	private async maybeRepublish(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		const key = this.lastRepublishKey(list.id);
+		const lastJson = await this.db.getMeta(key);
+		const last = lastJson ? Number(lastJson) : 0;
+		if (Date.now() - last < REPUBLISH_INTERVAL_MS) return;
+		await this.republishAllFor(list, identity, pool);
+		await this.db.setMeta(key, String(Date.now()));
+	}
+
+	public async republishAll(listId: string): Promise<void> {
+		const list = await this.db.list(listId);
+		if (!list) return;
+		const identity = await this.db.deviceIdentity();
+		const pool = this.poolFor(listId, list);
+		await this.republishAllFor(list, identity, pool);
+		await this.db.setMeta(this.lastRepublishKey(listId), String(Date.now()));
+	}
+
+	private async republishAllFor(list: ListRecord, identity: DeviceIdentity, pool: RelayPoolLike): Promise<void> {
+		if (list.contentKey) {
+			const contentKey = hexToBytes(list.contentKey);
+			const items = await this.db.items(list.id); // excludes tombstoned items
+			for (const item of items) {
+				const event = buildItemEvent(identity.secretKey, list.id, item.dTag, contentKey, itemRecordToPayload(item), itemEventCreatedAt(item));
+				await pool.publishAll(event);
+			}
+		}
+		await this.ensureSelfInDirectory(list, identity, pool);
+	}
+
+	// --- live subscription (list screen open) --------------------------
+
+	public async subscribe(listId: string): Promise<void> {
+		if (this.subscriptions.has(listId)) return;
+		const list = await this.db.list(listId);
+		if (!list) return;
+		const identity = await this.db.deviceIdentity();
+		const pool = this.poolFor(listId, list);
+
+		const unsubscribeContent = pool.subscribeAll(
+			{ kinds: [LIST_EVENT_KIND], '#L': [listId] },
+			event => { void this.handleLiveEvent(listId, event); },
+		);
+		const unsubscribeJoins = list.kind === 'managed'
+			? pool.subscribeAll(
+				{ kinds: [LIST_EVENT_KIND], '#p': [identity.publicKey] },
+				event => { void this.handleLiveJoinRequest(listId, event); },
+			)
+			: (): void => { /* open lists don't take join requests */ };
+
+		this.subscriptions.set(listId, () => {
+			unsubscribeContent();
+			unsubscribeJoins();
+		});
+	}
+
+	public unsubscribe(listId: string): void {
+		this.subscriptions.get(listId)?.();
+		this.subscriptions.delete(listId);
+	}
+
+	private async handleLiveEvent(listId: string, event: VerifiedEvent): Promise<void> {
+		const dTagValue = eventDTag(event);
+		if (!dTagValue || dTagValue.startsWith('join:')) return; // join requests: see handleLiveJoinRequest
+		const list = await this.db.list(listId);
+		if (!list) return;
+		if (dTagValue === DIRECTORY_D_TAG) {
+			const identity = await this.db.deviceIdentity();
+			await this.handleDirectoryEvent(list, identity, event);
+			return;
+		}
+		await this.handleItemEvent(list, event);
+	}
+
+	private async handleLiveJoinRequest(listId: string, event: VerifiedEvent): Promise<void> {
+		const list = await this.db.list(listId);
+		if (!list) return;
+		const identity = await this.db.deviceIdentity();
+		if (!await this.isLocalAdmin(listId, identity.publicKey)) return;
+		const pool = this.poolFor(listId, list);
+		// Reuses the same acceptance logic as a normal sync, scoped to just
+		// this one event by querying nothing else -- acceptJoinRequests()
+		// itself re-fetches all pending join requests, which is fine since
+		// already-accepted ones are skipped via the membership check.
+		void event;
+		await this.acceptJoinRequests(list, identity, pool);
+	}
+}
+
+// --- foreground lifecycle ---------------------------------------------
+
+// Wires ListsSync.instance().refreshAll() to the app coming to the
+// foreground, throttled so rapid foreground/background cycles don't cause a
+// sync storm. The UI calls this once from root.tsx; call the returned
+// function to tear it down (e.g. in tests).
+export const startListsSyncLifecycle = (): (()=> void) => {
+	let lastRefresh = 0;
+	const onChange = (nextState: AppStateStatus): void => {
+		if (nextState !== 'active') return;
+		const now = Date.now();
+		if (now - lastRefresh < LIFECYCLE_THROTTLE_MS) return;
+		lastRefresh = now;
+		void ListsSync.instance().refreshAll();
+	};
+	const subscription: NativeEventSubscription = AppState.addEventListener('change', onChange);
+	return () => subscription.remove();
+};
