diff --git a/packages/app-mobile/lists/ui/parseItemInput.ts b/packages/app-mobile/lists/ui/parseItemInput.ts
new file mode 100644
index 0000000..d49f5d2
--- /dev/null
+++ b/packages/app-mobile/lists/ui/parseItemInput.ts
@@ -0,0 +1,40 @@
+// Simple quantity heuristic for the "add item" field: pulls a leading or
+// trailing amount (with an optional unit) out of free-typed text, e.g.
+// "2 Milch", "Milch 2l", "3x Eier", "Äpfel 1 kg". The amount becomes the
+// item's `detail`; the rest is passed on to the catalog matcher (normalize.ts)
+// as the name. No autocomplete or catalog lookup happens here -- see
+// docs/KONZEPT.md section 2 for why quantity itself stays free text.
+
+export interface ParsedItemInput {
+	name: string;
+	detail: string | null;
+}
+
+const UNIT_WORDS = ['kg', 'g', 'l', 'ml', 'stk', 'stück', 'st', 'pkg', 'pck', 'dose', 'dosen', 'flasche', 'flaschen', 'packung', 'packungen', 'bund', 'bündel'];
+
+const NUMBER = '\\d+(?:[.,]\\d+)?';
+const UNIT = UNIT_WORDS.join('|');
+
+// "<amount>[x|<unit>] <name>", e.g. "2 Milch", "3x Eier", "2kg Möhren".
+const LEADING_AMOUNT = new RegExp(`^(${NUMBER}\\s*(?:x|${UNIT})?)\\s+(.+)$`, 'i');
+// "<name> <amount>[<unit>]", e.g. "Milch 2l", "Äpfel 1 kg".
+const TRAILING_AMOUNT = new RegExp(`^(.+?)\\s+(${NUMBER}\\s*(?:${UNIT})?)$`, 'i');
+
+export const parseItemInput = (text: string): ParsedItemInput => {
+	const trimmed = text.trim().replace(/\s+/g, ' ');
+	if (!trimmed) return { name: '', detail: null };
+
+	const leading = trimmed.match(LEADING_AMOUNT);
+	if (leading) {
+		const [, amount, name] = leading;
+		return { name: name.trim(), detail: amount.trim() };
+	}
+
+	const trailing = trimmed.match(TRAILING_AMOUNT);
+	if (trailing) {
+		const [, name, amount] = trailing;
+		return { name: name.trim(), detail: amount.trim() };
+	}
+
+	return { name: trimmed, detail: null };
+};
