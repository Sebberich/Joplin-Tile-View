@@ -0,0 +1,44 @@
+// Grouping/ordering helpers for the tile grid: open items grouped by category
+// (in the same walk-the-store order as the shipped catalog, see
+// lists/catalog/categories.json) and bought items ordered most-recently-bought
+// first.
+
+import { categoryOrder, fallbackCategoryId } from '../core/normalize';
+import { ItemRecord } from '../core/types';
+
+export interface ItemGroup {
+	categoryId: string;
+	categoryName: string;
+	emoji: string;
+	items: ItemRecord[];
+}
+
+export const groupOpenItems = (items: ItemRecord[]): ItemGroup[] => {
+	const categories = categoryOrder();
+	const knownIds = new Set(categories.map(c => c.id));
+	const itemsByCategory = new Map<string, ItemRecord[]>();
+
+	for (const item of items) {
+		const categoryId = item.category && knownIds.has(item.category) ? item.category : fallbackCategoryId;
+		if (!itemsByCategory.has(categoryId)) itemsByCategory.set(categoryId, []);
+		itemsByCategory.get(categoryId).push(item);
+	}
+
+	const groups: ItemGroup[] = [];
+	for (const category of categories) {
+		const categoryItems = itemsByCategory.get(category.id);
+		if (!categoryItems || !categoryItems.length) continue;
+		groups.push({
+			categoryId: category.id,
+			categoryName: category.name,
+			emoji: category.emoji,
+			items: categoryItems.slice().sort((a, b) => a.name.localeCompare(b.name)),
+		});
+	}
+	return groups;
+};
+
+// Most recently marked as bought first.
+export const sortRecentlyBought = (items: ItemRecord[]): ItemRecord[] => {
+	return items.slice().sort((a, b) => b.openT - a.openT);
+};
