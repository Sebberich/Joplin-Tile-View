+import * as React from 'react';
+import { useEffect, useRef, useState } from 'react';
+import { Alert, Animated, Easing, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { _ } from '@joplin/lib/locale';
+import { getNearbyTransport, NearbyStatus } from '../syncApi';
+
+interface Props {
+	listId: string;
+}
+
+const COLORS: Record<NearbyStatus['state'], string> = {
+	off: '#c0392b',
+	searching: '#e1b12c',
+	found: '#27ae60',
+	unavailable: '#9e9e9e',
+};
+
+const styles = StyleSheet.create({
+	touchable: {
+		padding: 10,
+	},
+	circle: {
+		width: 22,
+		height: 22,
+		borderRadius: 11,
+		alignItems: 'center',
+		justifyContent: 'center',
+		overflow: 'hidden',
+	},
+	ring: {
+		position: 'absolute',
+		width: 22,
+		height: 22,
+		borderRadius: 11,
+		borderWidth: 2,
+		borderColor: 'rgba(255,255,255,0.85)',
+		borderTopColor: 'transparent',
+	},
+	countText: {
+		fontSize: 9,
+		color: '#ffffff',
+		fontWeight: 'bold',
+	},
+});
+
+// The "circle in the top right" from docs/KONZEPT.md section 3: shows and
+// toggles the nearby (Bluetooth) sync state for the currently open list. With
+// no real transport wired up yet, it stays grey ("unavailable") and tapping
+// it explains why; see UnavailableNearbyTransport in syncApi.ts.
+const NearbyStatusCircle: React.FC<Props> = ({ listId }) => {
+	const transport = useRef(getNearbyTransport()).current;
+	const available = transport.isAvailable();
+
+	const [status, setStatus] = useState<NearbyStatus>({
+		state: available ? 'off' : 'unavailable',
+		foundCount: 0,
+		memberCount: 0,
+	});
+
+	useEffect(() => {
+		return transport.onStateChange(setStatus);
+	}, [transport]);
+
+	const spin = useRef(new Animated.Value(0)).current;
+	useEffect(() => {
+		if (status.state !== 'searching') {
+			spin.setValue(0);
+			return undefined;
+		}
+		const animation = Animated.loop(
+			Animated.timing(spin, { toValue: 1, duration: 1200, easing: Easing.linear, useNativeDriver: true }),
+		);
+		animation.start();
+		return () => animation.stop();
+	}, [status.state, spin]);
+
+	const rotate = spin.interpolate({ inputRange: [0, 1], outputRange: ['0deg', '360deg'] });
+
+	const onPress = () => {
+		if (!available) {
+			Alert.alert(_('Nearby sync'), _('Bluetooth sync will come in a later version.'));
+			return;
+		}
+		if (status.state === 'off') {
+			transport.start(listId);
+		} else {
+			transport.stop();
+		}
+	};
+
+	const description =
+		status.state === 'off' ? _('Nearby sync is off. Tap to search for nearby devices.')
+			: status.state === 'searching' ? _('Searching for nearby devices…')
+				: status.state === 'found' ? _('%d of %d members nearby', status.foundCount, status.memberCount)
+					: _('Nearby sync is not available on this device.');
+
+	return (
+		<TouchableOpacity style={styles.touchable} onPress={onPress}
+			accessibilityRole='button' accessibilityLabel={description}>
+			<View style={[styles.circle, { backgroundColor: COLORS[status.state] }]}>
+				{status.state === 'searching' && <Animated.View style={[styles.ring, { transform: [{ rotate }] }]} />}
+				{status.state === 'found' && <Text style={styles.countText}>{status.foundCount}/{status.memberCount}</Text>}
+			</View>
+		</TouchableOpacity>
+	);
+};
+
+export default NearbyStatusCircle;
