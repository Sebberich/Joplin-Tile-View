+import * as React from 'react';
+import { useEffect, useMemo, useState } from 'react';
+import { Alert, Share as RNShare, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { Dispatch } from 'redux';
+import Clipboard from '@react-native-clipboard/clipboard';
+import { _ } from '@joplin/lib/locale';
+import { ScreenHeader } from '../../components/ScreenHeader';
+import { BaseScreenComponent } from '../../components/base-screen';
+import { themeStyle } from '../../components/global-style';
+import { getListsDatabase, getListsStore } from './listsRuntime';
+import QrCode from './components/QrCode';
+import { EncodedInvite } from '../core/invite';
+import { Role } from '../core/types';
+
+interface Props {
+	navigation: { state: { listId: string } };
+	themeId: number;
+	dispatch: Dispatch;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1, alignItems: 'center', padding: theme.margin },
+			qrWrapper: { marginTop: 24, padding: 12, backgroundColor: '#ffffff', borderRadius: 8 },
+			roleRow: { flexDirection: 'row', marginTop: 16 },
+			roleOption: {
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+				borderRadius: 16,
+				paddingVertical: 6,
+				paddingHorizontal: 14,
+				marginHorizontal: 6,
+			},
+			roleOptionSelected: { backgroundColor: theme.selectedColor, borderColor: theme.colorBright2 },
+			roleOptionText: { color: theme.color },
+			codeBox: {
+				marginTop: 24,
+				paddingVertical: 12,
+				paddingHorizontal: 16,
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+				borderRadius: 8,
+			},
+			codeText: { fontFamily: 'monospace', fontSize: 18, color: theme.color, textAlign: 'center' },
+			linkText: { color: theme.color, marginTop: 16, textAlign: 'center' },
+			buttonRow: { flexDirection: 'row', marginTop: 16 },
+			button: { paddingVertical: 10, paddingHorizontal: 16 },
+			buttonText: { color: theme.colorBright2, fontWeight: 'bold' },
+			errorText: { color: theme.colorError2, marginTop: 24, textAlign: 'center' },
+		});
+	}, [themeId]);
+};
+
+const ShareScreenComponent: React.FC<Props> = props => {
+	const listId = props.navigation.state.listId;
+	const styles = useStyles(props.themeId);
+	const store = useMemo(() => getListsStore(), []);
+
+	const [managed, setManaged] = useState(false);
+	const [isAdmin, setIsAdmin] = useState(true);
+	const [role, setRole] = useState<Role>('member');
+	const [invite, setInvite] = useState<EncodedInvite | null>(null);
+	const [error, setError] = useState<string | null>(null);
+
+	useEffect(() => {
+		void (async () => {
+			const [lists, db] = await Promise.all([store.lists(), getListsDatabase()]);
+			const list = lists.find(l => l.id === listId);
+			setManaged(list?.kind === 'managed');
+			if (list?.kind === 'managed') {
+				const identity = await db.deviceIdentity();
+				const members = await db.members(listId);
+				const self = members.find(m => m.pubkey === identity.publicKey && !m.removedAt);
+				setIsAdmin(self?.role === 'admin');
+			}
+		})();
+	}, [store, listId]);
+
+	useEffect(() => {
+		setError(null);
+		setInvite(null);
+		if (managed && !isAdmin) return;
+		void (async () => {
+			try {
+				setInvite(await store.inviteFor(listId, role));
+			} catch (e) {
+				setError(e instanceof Error ? e.message : String(e));
+			}
+		})();
+	}, [store, listId, managed, isAdmin, role]);
+
+	const copy = (text: string) => {
+		Clipboard.setString(text);
+		Alert.alert(_('Copied'));
+	};
+
+	return (
+		<View style={styles.container}>
+			<ScreenHeader title={_('Share list')} showBackButton />
+
+			{managed && !isAdmin && (
+				<Text style={styles.errorText}>{_('Only an admin can invite people to this list.')}</Text>
+			)}
+
+			{(!managed || isAdmin) && (
+				<>
+					{managed && (
+						<View style={styles.roleRow}>
+							{(['member', 'admin'] as Role[]).map(r => (
+								<TouchableOpacity
+									key={r}
+									style={[styles.roleOption, role === r ? styles.roleOptionSelected : null]}
+									onPress={() => setRole(r)}
+								>
+									<Text style={styles.roleOptionText}>{r === 'admin' ? _('Admin') : _('Member')}</Text>
+								</TouchableOpacity>
+							))}
+						</View>
+					)}
+
+					{!!error && <Text style={styles.errorText}>{error}</Text>}
+
+					{!!invite && (
+						<>
+							<View style={styles.qrWrapper}>
+								<QrCode value={invite.link} size={220} />
+							</View>
+
+							<Text style={styles.linkText} numberOfLines={2} selectable>{invite.link}</Text>
+
+							<View style={styles.codeBox}>
+								<Text style={styles.codeText} selectable>{invite.code}</Text>
+							</View>
+
+							<View style={styles.buttonRow}>
+								<TouchableOpacity style={styles.button} onPress={() => copy(invite.link)}>
+									<Text style={styles.buttonText}>{_('Copy link')}</Text>
+								</TouchableOpacity>
+								<TouchableOpacity style={styles.button} onPress={() => copy(invite.code)}>
+									<Text style={styles.buttonText}>{_('Copy code')}</Text>
+								</TouchableOpacity>
+								<TouchableOpacity style={styles.button} onPress={() => void RNShare.share({ message: invite.link })}>
+									<Text style={styles.buttonText}>{_('Share')}</Text>
+								</TouchableOpacity>
+							</View>
+						</>
+					)}
+				</>
+			)}
+		</View>
+	);
+};
+
+class ShareScreenClass extends BaseScreenComponent<Props, Record<string, never>> {
+	public override render() {
+		return <ShareScreenComponent {...this.props} />;
+	}
+}
+
+export default ShareScreenClass;
+export { ShareScreenComponent };
