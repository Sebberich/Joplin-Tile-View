@@ -0,0 +1,182 @@
+import * as React from 'react';
+import { useCallback, useMemo, useState } from 'react';
+import { Alert, Modal, StyleSheet, Text, TextInput, TouchableOpacity, View } from 'react-native';
+import { CameraView, useCameraPermissions } from 'expo-camera';
+import { Dispatch } from 'redux';
+import Clipboard from '@react-native-clipboard/clipboard';
+import Setting from '@joplin/lib/models/Setting';
+import { _ } from '@joplin/lib/locale';
+import { ScreenHeader } from '../../components/ScreenHeader';
+import { BaseScreenComponent } from '../../components/base-screen';
+import { themeStyle } from '../../components/global-style';
+import { getListsStore } from './listsRuntime';
+import { getListsSync } from './syncApi';
+
+interface Props {
+	navigation: { state: { inviteText?: string } };
+	themeId: number;
+	dispatch: Dispatch;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1, padding: theme.margin },
+			input: {
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+				borderRadius: 8,
+				padding: 10,
+				fontSize: theme.fontSize,
+				color: theme.color,
+				minHeight: 80,
+				textAlignVertical: 'top',
+			},
+			buttonRow: { flexDirection: 'row', marginTop: 16 },
+			button: {
+				paddingVertical: 10,
+				paddingHorizontal: 16,
+				marginRight: 8,
+				borderRadius: 8,
+				backgroundColor: theme.color4,
+			},
+			buttonText: { color: '#ffffff', fontWeight: 'bold' },
+			secondaryButton: {
+				paddingVertical: 10,
+				paddingHorizontal: 16,
+				marginRight: 8,
+				borderRadius: 8,
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+			},
+			secondaryButtonText: { color: theme.color },
+			errorText: { color: theme.colorError2, marginTop: 16 },
+			camera: { flex: 1 },
+			cameraOverlay: {
+				position: 'absolute',
+				bottom: 40,
+				left: 0,
+				right: 0,
+				alignItems: 'center',
+			},
+			cameraCancel: { backgroundColor: 'rgba(0,0,0,0.6)', paddingVertical: 10, paddingHorizontal: 20, borderRadius: 20 },
+			cameraCancelText: { color: '#ffffff' },
+		});
+	}, [themeId]);
+};
+
+const JoinScreenComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const store = useMemo(() => getListsStore(), []);
+	const sync = useMemo(() => getListsSync(), []);
+
+	const [text, setText] = useState(props.navigation.state.inviteText ?? '');
+	const [error, setError] = useState<string | null>(null);
+	const [pending, setPending] = useState(false);
+	const [scanning, setScanning] = useState(false);
+	const [permission, requestPermission] = useCameraPermissions();
+	const scannedRef = React.useRef(false);
+
+	const handleJoin = useCallback(async (inviteText: string) => {
+		const trimmed = inviteText.trim();
+		if (!trimmed) return;
+		setError(null);
+		setPending(true);
+		try {
+			const deviceName = Setting.value('lists.deviceName') || undefined;
+			const result = await store.joinFromInvite(trimmed, deviceName);
+			if (result.type === 'open') {
+				props.dispatch({ type: 'NAV_GO', routeName: 'ListsList', listId: result.list.id } as never);
+			} else {
+				await sync.publishJoinRequest(result.list.id, result.joinRequest);
+				Alert.alert(_('Join request sent'), _('Waiting for the admin to accept your request.'));
+				props.dispatch({ type: 'NAV_GO', routeName: 'Lists' } as never);
+			}
+		} catch (e) {
+			setError(e instanceof Error ? e.message : String(e));
+		} finally {
+			setPending(false);
+		}
+	}, [store, sync, props]);
+
+	const onPaste = useCallback(async () => {
+		const clipboardText = await Clipboard.getString();
+		if (clipboardText) setText(clipboardText);
+	}, []);
+
+	const onScanPress = useCallback(async () => {
+		if (!permission?.granted) {
+			const result = await requestPermission();
+			if (!result.granted) return;
+		}
+		scannedRef.current = false;
+		setScanning(true);
+	}, [permission, requestPermission]);
+
+	const onBarcodeScanned = useCallback((result: { data: string }) => {
+		if (scannedRef.current) return;
+		scannedRef.current = true;
+		setScanning(false);
+		setText(result.data);
+		void handleJoin(result.data);
+	}, [handleJoin]);
+
+	if (scanning) {
+		return (
+			<Modal visible animationType='slide' onRequestClose={() => setScanning(false)}>
+				<CameraView
+					style={styles.camera}
+					facing='back'
+					barcodeScannerSettings={{ barcodeTypes: ['qr'] }}
+					onBarcodeScanned={onBarcodeScanned}
+				/>
+				<View style={styles.cameraOverlay}>
+					<TouchableOpacity style={styles.cameraCancel} onPress={() => setScanning(false)}>
+						<Text style={styles.cameraCancelText}>{_('Cancel')}</Text>
+					</TouchableOpacity>
+				</View>
+			</Modal>
+		);
+	}
+
+	return (
+		<View style={styles.container}>
+			<ScreenHeader title={_('Join a list')} showBackButton />
+
+			<TextInput
+				style={styles.input}
+				value={text}
+				onChangeText={setText}
+				placeholder={_('Paste an invite link or code')}
+				multiline
+			/>
+
+			<View style={styles.buttonRow}>
+				<TouchableOpacity style={styles.secondaryButton} onPress={() => void onPaste()}>
+					<Text style={styles.secondaryButtonText}>{_('Paste')}</Text>
+				</TouchableOpacity>
+				<TouchableOpacity style={styles.secondaryButton} onPress={() => void onScanPress()}>
+					<Text style={styles.secondaryButtonText}>{_('Scan QR code')}</Text>
+				</TouchableOpacity>
+			</View>
+
+			{!!error && <Text style={styles.errorText}>{error}</Text>}
+
+			<View style={styles.buttonRow}>
+				<TouchableOpacity style={styles.button} onPress={() => void handleJoin(text)} disabled={pending || !text.trim()}>
+					<Text style={styles.buttonText}>{_('Join')}</Text>
+				</TouchableOpacity>
+			</View>
+		</View>
+	);
+};
+
+class JoinScreenClass extends BaseScreenComponent<Props, Record<string, never>> {
+	public override render() {
+		return <JoinScreenComponent {...this.props} />;
+	}
+}
+
+export default JoinScreenClass;
+export { JoinScreenComponent };
