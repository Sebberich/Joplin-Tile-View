diff --git a/packages/app-mobile/lists/ui/syncApi.ts b/packages/app-mobile/lists/ui/syncApi.ts
new file mode 100644
index 0000000..45191fa
--- /dev/null
+++ b/packages/app-mobile/lists/ui/syncApi.ts
@@ -0,0 +1,228 @@
+// Thin interface onto the lists/sync module (owned by a separate agent, see
+// docs/KONZEPT.md section 3), plus a lazy, failure-tolerant loader for it and
+// a small adapter translating its field names to the shape this UI code
+// wants. The UI imports the sync API from here rather than from '../sync'
+// directly, so it keeps compiling and running (with the transport reporting
+// as unavailable) whether or not that module exists yet, and so a field
+// rename on the sync side only needs to be reflected in the adapter below.
+
+import { getListsDatabaseInstance, getListsStore } from './listsRuntime';
+
+export type NearbyState = 'off' | 'searching' | 'found' | 'unavailable';
+
+export interface NearbyStatus {
+	state: NearbyState;
+	// Members currently in range, out of the list's total member count.
+	foundCount: number;
+	memberCount: number;
+}
+
+export interface NearbyTransport {
+	isAvailable(): boolean;
+	start(listId: string): void;
+	stop(): void;
+	onStateChange(listener: (status: NearbyStatus)=> void): ()=> void;
+}
+
+export interface SyncStatus {
+	listId: string;
+	// Milliseconds since epoch, or null if this list has never synced.
+	lastSyncedAt: number | null;
+	online: boolean;
+}
+
+export interface PendingJoinRequest {
+	pubkey: string;
+	deviceName: string;
+	requestedAt: number;
+}
+
+export interface ListsSyncApi {
+	syncList(listId: string): Promise<void>;
+	subscribe(listId: string): void;
+	unsubscribe(listId: string): void;
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- the join request event's shape is owned by lists/core, not by this interface
+	publishJoinRequest(listId: string, event: any): Promise<void>;
+	refreshAll(): Promise<void>;
+	onStatus(listener: (status: SyncStatus)=> void): ()=> void;
+	// Not offered by lists/sync: a managed list's admin device accepts valid
+	// join requests automatically the next time it syncs (see
+	// ListsSync#acceptJoinRequests), rather than through a manual UI action.
+	// Kept optional here in case a future version adds one.
+	acceptJoinRequest?(listId: string, pubkey: string): Promise<void>;
+	pendingJoinRequests?(listId: string): Promise<PendingJoinRequest[]>;
+}
+
+class NoopListsSync implements ListsSyncApi {
+	public async syncList(_listId: string): Promise<void> {
+		// lists/sync isn't available yet -- nothing to do.
+	}
+
+	public subscribe(_listId: string): void {
+		// no-op
+	}
+
+	public unsubscribe(_listId: string): void {
+		// no-op
+	}
+
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- see ListsSyncApi#publishJoinRequest
+	public async publishJoinRequest(_listId: string, _event: any): Promise<void> {
+		// no-op
+	}
+
+	public async refreshAll(): Promise<void> {
+		// no-op
+	}
+
+	public onStatus(_listener: (status: SyncStatus)=> void): ()=> void {
+		return () => {};
+	}
+}
+
+class UnavailableNearbyTransportFallback implements NearbyTransport {
+	public isAvailable(): boolean {
+		return false;
+	}
+
+	public start(_listId: string): void {
+		// no-op
+	}
+
+	public stop(): void {
+		// no-op
+	}
+
+	public onStateChange(_listener: (status: NearbyStatus)=> void): ()=> void {
+		return () => {};
+	}
+}
+
+// --- shapes of the real lists/sync module (see lists/sync/listSync.ts and
+// lists/sync/nearby.ts), kept minimal and local so this file doesn't need to
+// import from '../sync' statically. -------------------------------------
+
+interface RealSyncStatus {
+	listId: string;
+	state: 'idle' | 'syncing' | 'offline' | 'error';
+	lastSync?: number;
+	message?: string;
+}
+
+interface RealListsSync {
+	syncList(listId: string): Promise<void>;
+	subscribe(listId: string): Promise<void>;
+	unsubscribe(listId: string): void;
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- see ListsSyncApi#publishJoinRequest
+	publishJoinRequest(listId: string, event: any): Promise<unknown>;
+	refreshAll(): Promise<void>;
+	onStatus(listener: (status: RealSyncStatus)=> void): ()=> void;
+}
+
+interface RealListsSyncStatic {
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- ListsStore/ListsDatabase, typed loosely to avoid a static import of lists/core just for this
+	init(store: any, db: any, poolFactory?: unknown): RealListsSync;
+	instance(): RealListsSync;
+}
+
+interface RealNearbyState {
+	mode: NearbyState;
+	found: number;
+	total: number;
+}
+
+interface RealNearbyTransport {
+	isAvailable(): boolean;
+	start(listId: string): Promise<void>;
+	stop(): Promise<void>;
+	onState(listener: (state: RealNearbyState)=> void): ()=> void;
+}
+
+interface SyncModule {
+	ListsSync?: RealListsSyncStatic;
+	startListsSyncLifecycle?: ()=> void;
+}
+
+interface NearbyModule {
+	UnavailableNearbyTransport?: new ()=> RealNearbyTransport;
+}
+
+const adaptSyncStatus = (status: RealSyncStatus): SyncStatus => ({
+	listId: status.listId,
+	lastSyncedAt: status.lastSync ?? null,
+	online: status.state !== 'offline',
+});
+
+const adaptListsSync = (real: RealListsSync): ListsSyncApi => ({
+	syncList: (listId: string) => real.syncList(listId),
+	subscribe: (listId: string) => { void real.subscribe(listId); },
+	unsubscribe: (listId: string) => real.unsubscribe(listId),
+	publishJoinRequest: async (listId: string, event: unknown) => { await real.publishJoinRequest(listId, event); },
+	refreshAll: () => real.refreshAll(),
+	onStatus: listener => real.onStatus(status => listener(adaptSyncStatus(status))),
+});
+
+const adaptNearbyTransport = (real: RealNearbyTransport): NearbyTransport => ({
+	isAvailable: () => real.isAvailable(),
+	start: (listId: string) => { void real.start(listId); },
+	stop: () => { void real.stop(); },
+	onStateChange: listener => real.onState(state => listener({
+		state: state.mode,
+		foundCount: state.found,
+		memberCount: state.total,
+	})),
+});
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any -- require() has no typings for an as-yet-unbuilt module
+const tryRequire = (path: string): any => {
+	try {
+		// eslint-disable-next-line @typescript-eslint/no-var-requires -- lazy, optional load of a module that may not exist yet
+		return require(path);
+	} catch {
+		return null;
+	}
+};
+
+let cachedSync: ListsSyncApi | null = null;
+let cachedNearby: NearbyTransport | null = null;
+
+export const getListsSync = (): ListsSyncApi => {
+	if (!cachedSync) {
+		const syncModule = tryRequire('../sync') as SyncModule | null;
+		if (!syncModule?.ListsSync) {
+			cachedSync = new NoopListsSync();
+		} else {
+			// ListsSync.instance() throws until init() has been called once;
+			// do so lazily here (with the same store/db this runtime module
+			// owns) rather than forcing it at app startup.
+			let real: RealListsSync;
+			try {
+				real = syncModule.ListsSync.instance();
+			} catch {
+				real = syncModule.ListsSync.init(getListsStore(), getListsDatabaseInstance());
+			}
+			cachedSync = adaptListsSync(real);
+		}
+	}
+	return cachedSync;
+};
+
+export const getNearbyTransport = (): NearbyTransport => {
+	if (!cachedNearby) {
+		const nearbyModule = tryRequire('../sync/nearby') as NearbyModule | null;
+		cachedNearby = nearbyModule?.UnavailableNearbyTransport
+			? adaptNearbyTransport(new nearbyModule.UnavailableNearbyTransport())
+			: new UnavailableNearbyTransportFallback();
+	}
+	return cachedNearby;
+};
+
+// Starts the sync agent's background lifecycle (relay subscriptions, periodic
+// refresh, ...). Safe to call even if lists/sync doesn't exist yet. Ensures
+// ListsSync is initialized first, so the AppState-driven refresh this wires
+// up doesn't hit ListsSync.instance()'s "not initialized" error.
+export const startListsSyncLifecycle = (): void => {
+	getListsSync();
+	const syncModule = tryRequire('../sync') as SyncModule | null;
+	if (syncModule?.startListsSyncLifecycle) syncModule.startListsSyncLifecycle();
+};
