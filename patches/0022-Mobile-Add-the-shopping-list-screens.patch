@@ -0,0 +1,169 @@
+import * as React from 'react';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { FlatList, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { Dispatch } from 'redux';
+import shim from '@joplin/lib/shim';
+import time from '@joplin/lib/time';
+import { _ } from '@joplin/lib/locale';
+import { ScreenHeader } from '../../components/ScreenHeader';
+import { BaseScreenComponent } from '../../components/base-screen';
+import { themeStyle } from '../../components/global-style';
+import { getListsDatabase, getListsStore } from './listsRuntime';
+import { getListsSync, PendingJoinRequest } from './syncApi';
+import { ListRecord, MemberRecord } from '../core/types';
+
+interface Props {
+	navigation: { state: { listId: string } };
+	themeId: number;
+	dispatch: Dispatch;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1 },
+			sectionHeader: {
+				paddingHorizontal: theme.margin,
+				paddingTop: 16,
+				paddingBottom: 4,
+				fontSize: theme.fontSize * 0.9,
+				fontWeight: 'bold',
+				color: theme.colorFaded,
+			},
+			row: {
+				flexDirection: 'row',
+				alignItems: 'center',
+				paddingHorizontal: theme.margin,
+				paddingVertical: 12,
+				borderBottomWidth: 1,
+				borderBottomColor: theme.dividerColor,
+			},
+			name: { fontSize: theme.fontSize, color: theme.color, flex: 1 },
+			meta: { fontSize: theme.fontSize * 0.8, color: theme.colorFaded },
+			actionText: { color: theme.colorBright2, marginLeft: 12 },
+			hintText: { padding: theme.margin, color: theme.colorFaded, fontSize: theme.fontSize * 0.85 },
+		});
+	}, [themeId]);
+};
+
+const MembersScreenComponent: React.FC<Props> = props => {
+	const listId = props.navigation.state.listId;
+	const styles = useStyles(props.themeId);
+	const sync = useMemo(() => getListsSync(), []);
+
+	const [list, setList] = useState<ListRecord | null>(null);
+	const [members, setMembers] = useState<MemberRecord[]>([]);
+	const [isAdmin, setIsAdmin] = useState(false);
+	const [pendingRequests, setPendingRequests] = useState<PendingJoinRequest[]>([]);
+	const [pendingRequestsSupported, setPendingRequestsSupported] = useState(false);
+
+	const reload = useCallback(async () => {
+		const [store, db] = await Promise.all([getListsStore(), getListsDatabase()]);
+		const [lists, memberRows, identity] = await Promise.all([
+			store.lists(), db.members(listId), db.deviceIdentity(),
+		]);
+		const current = lists.find(l => l.id === listId) ?? null;
+		setList(current);
+		setMembers(memberRows.filter(m => !m.removedAt));
+		const self = memberRows.find(m => m.pubkey === identity.publicKey && !m.removedAt);
+		setIsAdmin(current?.kind === 'managed' && self?.role === 'admin');
+
+		if (current?.kind === 'managed' && sync.pendingJoinRequests) {
+			setPendingRequestsSupported(true);
+			setPendingRequests(await sync.pendingJoinRequests(listId));
+		} else {
+			setPendingRequestsSupported(false);
+			setPendingRequests([]);
+		}
+	}, [listId, sync]);
+
+	useEffect(() => { void reload(); }, [reload]);
+
+	const onRemoveMember = useCallback(async (member: MemberRecord) => {
+		const ok = await shim.showConfirmationDialog(_('Remove %s from this list?', member.name || member.pubkey.slice(0, 8)));
+		if (!ok) return;
+		const db = await getListsDatabase();
+		await db.removeMember(listId, member.pubkey, Date.now());
+		await reload();
+	}, [listId, reload]);
+
+	const onToggleRole = useCallback(async (member: MemberRecord) => {
+		const db = await getListsDatabase();
+		await db.upsertMember({ ...member, role: member.role === 'admin' ? 'member' : 'admin' });
+		await reload();
+	}, [reload]);
+
+	const onAcceptRequest = useCallback(async (request: PendingJoinRequest) => {
+		if (!sync.acceptJoinRequest) return;
+		await sync.acceptJoinRequest(listId, request.pubkey);
+		await reload();
+	}, [sync, listId, reload]);
+
+	return (
+		<View style={styles.container}>
+			<ScreenHeader title={_('Members')} showBackButton />
+
+			{list?.kind === 'managed' && (
+				<>
+					<Text style={styles.sectionHeader}>{_('Pending join requests')}</Text>
+					{!pendingRequestsSupported && (
+						<Text style={styles.hintText}>{_('Valid join requests are accepted automatically the next time this device syncs.')}</Text>
+					)}
+					{pendingRequestsSupported && !pendingRequests.length && (
+						<Text style={styles.hintText}>{_('No pending join requests.')}</Text>
+					)}
+					<FlatList
+						data={pendingRequests}
+						keyExtractor={r => r.pubkey}
+						renderItem={({ item }) => (
+							<View style={styles.row}>
+								<Text style={styles.name}>{item.deviceName || item.pubkey.slice(0, 8)}</Text>
+								{isAdmin && !!sync.acceptJoinRequest && (
+									<TouchableOpacity onPress={() => void onAcceptRequest(item)}>
+										<Text style={styles.actionText}>{_('Accept')}</Text>
+									</TouchableOpacity>
+								)}
+							</View>
+						)}
+					/>
+				</>
+			)}
+
+			<Text style={styles.sectionHeader}>{_('Members')}</Text>
+			<FlatList
+				data={members}
+				keyExtractor={m => m.pubkey}
+				renderItem={({ item }) => (
+					<View style={styles.row}>
+						<Text style={styles.name} numberOfLines={1}>{item.name || item.pubkey.slice(0, 8)}</Text>
+						<Text style={styles.meta}>
+							{list?.kind === 'managed' ? (item.role === 'admin' ? _('Admin') : _('Member')) : ''}
+							{'  ·  '}
+							{time.formatMsToLocal(item.since)}
+						</Text>
+						{isAdmin && (
+							<>
+								<TouchableOpacity onPress={() => void onToggleRole(item)}>
+									<Text style={styles.actionText}>{item.role === 'admin' ? _('Make member') : _('Make admin')}</Text>
+								</TouchableOpacity>
+								<TouchableOpacity onPress={() => void onRemoveMember(item)}>
+									<Text style={styles.actionText}>{_('Remove')}</Text>
+								</TouchableOpacity>
+							</>
+						)}
+					</View>
+				)}
+			/>
+		</View>
+	);
+};
+
+class MembersScreenClass extends BaseScreenComponent<Props, Record<string, never>> {
+	public override render() {
+		return <MembersScreenComponent {...this.props} />;
+	}
+}
+
+export default MembersScreenClass;
+export { MembersScreenComponent };
