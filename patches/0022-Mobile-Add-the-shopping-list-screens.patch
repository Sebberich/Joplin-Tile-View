+import * as React from 'react';
+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import { Store } from 'redux';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import TestProviderStack from '../../components/testing/TestProviderStack';
+import createMockReduxStore from '../../utils/testing/createMockReduxStore';
+import setupGlobalStore from '../../utils/testing/setupGlobalStore';
+import { render, screen, waitFor } from '../../utils/testing/testingLibrary';
+import { AppState } from '../../utils/types';
+import { ListsDatabase } from '../core/db';
+import { ListsStore } from '../core/store';
+
+// listsRuntime normally opens a real device (expo-sqlite) database, which
+// isn't available under Jest -- swap in a ListsStore/ListsDatabase backed by
+// the Node driver instead, as lists/core's own tests do.
+let testStore: ListsStore;
+let testDatabase: ListsDatabase;
+
+jest.mock('./listsRuntime', () => ({
+	getListsStore: () => testStore,
+	getListsDatabase: async () => { await testDatabase.openOrCreate('ignored'); return testDatabase; },
+	getListsDatabaseInstance: () => testDatabase,
+}));
+
+// The real lists/sync module wires up relay connections; keep this smoke
+// test focused on rendering by using the built-in no-op fallback instead.
+jest.mock('./syncApi', () => ({
+	getListsSync: () => ({
+		syncList: async () => {},
+		subscribe: () => {},
+		unsubscribe: () => {},
+		publishJoinRequest: async () => {},
+		refreshAll: async () => {},
+		onStatus: () => () => {},
+	}),
+	getNearbyTransport: () => ({
+		isAvailable: () => false,
+		start: () => {},
+		stop: () => {},
+		onStateChange: () => () => {},
+	}),
+}));
+
+import { ListScreenComponent } from './ListScreen';
+
+let reduxStore: Store<AppState>;
+let dbPath: string;
+
+const WrappedListScreen: React.FC<{ listId: string }> = ({ listId }) => {
+	return <TestProviderStack store={reduxStore}>
+		<ListScreenComponent navigation={{ state: { listId } }} themeId={reduxStore.getState().settings.theme} dispatch={reduxStore.dispatch} />
+	</TestProviderStack>;
+};
+
+describe('lists/ui/ListScreen', () => {
+	beforeEach(async () => {
+		dbPath = join(tmpdir(), `tiles-lists-screen-test-${uuid.createNano()}.sqlite`);
+		testDatabase = new ListsDatabase(new Database(new DatabaseDriverNode()));
+		testStore = new ListsStore(testDatabase, dbPath);
+
+		reduxStore = createMockReduxStore();
+		setupGlobalStore(reduxStore);
+	});
+
+	afterEach(async () => {
+		await rm(dbPath, { force: true });
+	});
+
+	test('shows items added to the list as tiles', async () => {
+		const list = await testStore.createOpenList('Groceries');
+		await testStore.addItem(list.id, 'Milch');
+
+		render(<WrappedListScreen listId={list.id} />);
+
+		await waitFor(() => {
+			expect(screen.getByText('Milch')).toBeTruthy();
+		});
+	});
+
+	test('shows the empty state when the list has no items', async () => {
+		const list = await testStore.createOpenList('Groceries');
+
+		render(<WrappedListScreen listId={list.id} />);
+
+		await waitFor(() => {
+			expect(screen.getByText('No items yet. Type above to add the first one.')).toBeTruthy();
+		});
+	});
+});
