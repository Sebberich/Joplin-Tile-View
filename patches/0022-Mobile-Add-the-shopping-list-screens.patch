+++ b/packages/app-mobile/lists/ui/ListsOverviewScreen.tsx
@@ -0,0 +1,174 @@
+import * as React from 'react';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { FlatList, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { Dispatch } from 'redux';
+import { _ } from '@joplin/lib/locale';
+import { ScreenHeader } from '../../components/ScreenHeader';
+import Icon from '../../components/Icon';
+import { BaseScreenComponent } from '../../components/base-screen';
+import { themeStyle } from '../../components/global-style';
+import { getListsDatabase, getListsStore } from './listsRuntime';
+import CreateListModal from './components/CreateListModal';
+import PromptModal from './components/PromptModal';
+import { ListKind, ListRecord } from '../core/types';
+
+interface Props {
+	navigation: { state: Record<string, never> };
+	themeId: number;
+	dispatch: Dispatch;
+}
+
+interface ListRow {
+	list: ListRecord;
+	openCount: number;
+	memberCount: number;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1 },
+			row: {
+				flexDirection: 'row',
+				alignItems: 'center',
+				paddingHorizontal: theme.margin,
+				paddingVertical: 14,
+				borderBottomWidth: 1,
+				borderBottomColor: theme.dividerColor,
+			},
+			kindIcon: { fontSize: 22, color: theme.color, marginRight: 12, width: 26, textAlign: 'center' },
+			name: { fontSize: theme.fontSize, color: theme.color, flex: 1 },
+			meta: { fontSize: theme.fontSize * 0.8, color: theme.colorFaded },
+			emptyState: { padding: theme.margin, alignItems: 'center' },
+			emptyText: { fontSize: theme.fontSize, color: theme.colorFaded, textAlign: 'center' },
+			fab: {
+				position: 'absolute',
+				right: 20,
+				bottom: 20,
+				width: 56,
+				height: 56,
+				borderRadius: 28,
+				backgroundColor: theme.color4,
+				alignItems: 'center',
+				justifyContent: 'center',
+				elevation: 4,
+			},
+			fabIcon: { fontSize: 26, color: '#ffffff' },
+		});
+	}, [themeId]);
+};
+
+const ListsOverviewComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const store = useMemo(() => getListsStore(), []);
+
+	const [rows, setRows] = useState<ListRow[]>([]);
+	const [createVisible, setCreateVisible] = useState(false);
+	const [renamingList, setRenamingList] = useState<ListRecord | null>(null);
+
+	const reload = useCallback(async () => {
+		const lists = await store.lists();
+		const db = await getListsDatabase();
+		const nextRows = await Promise.all(lists.map(async list => {
+			const [openItems, members] = await Promise.all([
+				store.items(list.id, { open: true }),
+				db.members(list.id),
+			]);
+			return { list, openCount: openItems.length, memberCount: members.filter(m => !m.removedAt).length };
+		}));
+		setRows(nextRows);
+	}, [store]);
+
+	useEffect(() => {
+		void reload();
+		return store.onChange(() => { void reload(); });
+	}, [store, reload]);
+
+	const openList = useCallback((listId: string) => {
+		props.dispatch({ type: 'NAV_GO', routeName: 'ListsList', listId } as never);
+	}, [props]);
+
+	const onCreate = useCallback(async (name: string, kind: ListKind) => {
+		setCreateVisible(false);
+		if (!name) return;
+		const list = kind === 'open' ? await store.createOpenList(name) : await store.createManagedList(name);
+		openList(list.id);
+	}, [store, openList]);
+
+	const onEnterInvite = useCallback(() => {
+		setCreateVisible(false);
+		props.dispatch({ type: 'NAV_GO', routeName: 'ListsJoin' } as never);
+	}, [props]);
+
+	const onRenameSubmit = useCallback(async (name: string) => {
+		const list = renamingList;
+		setRenamingList(null);
+		if (!list) return;
+		const trimmed = name.trim();
+		if (!trimmed) return;
+		const db = await getListsDatabase();
+		await db.renameList(list.id, trimmed);
+		await reload();
+	}, [renamingList, reload]);
+
+	return (
+		<View style={styles.container}>
+			<ScreenHeader title={_('Shopping lists')} showBackButton />
+
+			{!rows.length && (
+				<View style={styles.emptyState}>
+					<Text style={styles.emptyText}>{_('No shopping lists yet. Tap + to create one, or join an existing one with an invite.')}</Text>
+				</View>
+			)}
+
+			<FlatList
+				data={rows}
+				keyExtractor={row => row.list.id}
+				renderItem={({ item }) => (
+					<TouchableOpacity
+						style={styles.row}
+						onPress={() => openList(item.list.id)}
+						onLongPress={() => setRenamingList(item.list)}
+					>
+						<Icon
+							name={item.list.kind === 'managed' ? 'ionicon shield-checkmark-outline' : 'ionicon people-outline'}
+							style={styles.kindIcon}
+							accessibilityLabel={item.list.kind === 'managed' ? _('Managed list') : _('Open list')}
+						/>
+						<Text style={styles.name} numberOfLines={1}>{item.list.name}</Text>
+						<Text style={styles.meta}>{_('%d open, %d members', item.openCount, item.memberCount)}</Text>
+					</TouchableOpacity>
+				)}
+			/>
+
+			<TouchableOpacity style={styles.fab} onPress={() => setCreateVisible(true)} accessibilityLabel={_('New list')} accessibilityRole='button'>
+				<Icon name='ionicon add' style={styles.fabIcon} accessibilityLabel={null} />
+			</TouchableOpacity>
+
+			<CreateListModal
+				visible={createVisible}
+				onCreate={(name, kind) => void onCreate(name, kind)}
+				onEnterInvite={onEnterInvite}
+				onCancel={() => setCreateVisible(false)}
+			/>
+
+			<PromptModal
+				visible={!!renamingList}
+				title={_('Rename list')}
+				initialValue={renamingList?.name ?? ''}
+				onSubmit={name => void onRenameSubmit(name)}
+				onCancel={() => setRenamingList(null)}
+			/>
+		</View>
+	);
+};
+
+class ListsOverviewScreenClass extends BaseScreenComponent<Props, Record<string, never>> {
+	public override render() {
+		return <ListsOverviewComponent {...this.props} />;
+	}
+}
+
+export default ListsOverviewScreenClass;
+export { ListsOverviewComponent };
