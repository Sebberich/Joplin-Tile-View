+import * as React from 'react';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { AppState as RNAppState, FlatList, ScrollView, StyleSheet, Text, TextInput, TouchableOpacity, View } from 'react-native';
+import { Dispatch } from 'redux';
+import { _ } from '@joplin/lib/locale';
+import shim from '@joplin/lib/shim';
+import time from '@joplin/lib/time';
+import { ScreenHeader, MenuOption } from '../../components/ScreenHeader';
+import { MenuOptionStyle } from '../../components/BottomDrawerMenu';
+import { BaseScreenComponent } from '../../components/base-screen';
+import { themeStyle } from '../../components/global-style';
+import { getListsDatabase, getListsStore } from './listsRuntime';
+import { itemRecordToPayload } from '../core/store';
+import PromptModal from './components/PromptModal';
+import { getListsSync } from './syncApi';
+import { parseItemInput } from './parseItemInput';
+import { groupOpenItems, sortRecentlyBought } from './groupItems';
+import NearbyStatusCircle from './components/NearbyStatusCircle';
+import ItemEditModal from './components/ItemEditModal';
+import { ItemRecord, ListRecord, CatalogMatch } from '../core/types';
+
+interface Props {
+	navigation: { state: { listId: string } };
+	themeId: number;
+	dispatch: Dispatch;
+}
+
+const RECENTLY_BOUGHT_LIMIT = 20;
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1 },
+			syncLine: {
+				paddingHorizontal: theme.margin,
+				paddingVertical: 4,
+				fontSize: theme.fontSize * 0.75,
+				color: theme.colorFaded,
+			},
+			inputRow: {
+				paddingHorizontal: theme.margin,
+				paddingTop: 8,
+			},
+			input: {
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+				borderRadius: 8,
+				paddingHorizontal: 12,
+				paddingVertical: 8,
+				fontSize: theme.fontSize,
+				color: theme.color,
+			},
+			suggestionsRow: {
+				paddingVertical: 8,
+			},
+			chip: {
+				flexDirection: 'row',
+				alignItems: 'center',
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+				borderRadius: 16,
+				paddingVertical: 6,
+				paddingHorizontal: 10,
+				marginLeft: theme.margin,
+			},
+			chipText: { fontSize: theme.fontSize * 0.9, color: theme.color, marginLeft: 4 },
+			sectionHeader: {
+				paddingHorizontal: theme.margin,
+				paddingTop: 16,
+				paddingBottom: 4,
+				fontSize: theme.fontSize,
+				fontWeight: 'bold',
+				color: theme.color,
+			},
+			tileGrid: {
+				flexDirection: 'row',
+				flexWrap: 'wrap',
+				paddingHorizontal: theme.margin - 4,
+			},
+			tile: {
+				width: '31%',
+				margin: '1.16%',
+				backgroundColor: theme.backgroundColor2,
+				borderRadius: 10,
+				paddingVertical: 10,
+				alignItems: 'center',
+			},
+			tileBought: {
+				opacity: 0.5,
+			},
+			tileEmoji: { fontSize: 28 },
+			tileName: { fontSize: theme.fontSize * 0.85, color: theme.color, textAlign: 'center', marginTop: 4 },
+			tileDetail: { fontSize: theme.fontSize * 0.75, color: theme.colorFaded, textAlign: 'center' },
+			emptyState: {
+				padding: theme.margin,
+				alignItems: 'center',
+			},
+			emptyText: { fontSize: theme.fontSize, color: theme.colorFaded, textAlign: 'center' },
+		});
+	}, [themeId]);
+};
+
+const ListScreenComponent: React.FC<Props> = props => {
+	const listId = props.navigation.state.listId;
+	const styles = useStyles(props.themeId);
+	const store = useMemo(() => getListsStore(), []);
+	const sync = useMemo(() => getListsSync(), []);
+
+	const [list, setList] = useState<ListRecord | null>(null);
+	const [openItems, setOpenItems] = useState<ItemRecord[]>([]);
+	const [boughtItems, setBoughtItems] = useState<ItemRecord[]>([]);
+	const [inputText, setInputText] = useState('');
+	const [suggestions, setSuggestions] = useState<CatalogMatch[]>([]);
+	const [editingItem, setEditingItem] = useState<ItemRecord | null>(null);
+	const [lastSyncedAt, setLastSyncedAt] = useState<number | null>(null);
+	const [online, setOnline] = useState(true);
+	const [renaming, setRenaming] = useState(false);
+
+	const reload = useCallback(async () => {
+		const [lists, open, bought] = await Promise.all([
+			store.lists(),
+			store.items(listId, { open: true }),
+			store.items(listId, { open: false }),
+		]);
+		setList(lists.find(l => l.id === listId) ?? null);
+		setOpenItems(open);
+		setBoughtItems(bought);
+	}, [store, listId]);
+
+	useEffect(() => {
+		void reload();
+		const unsubscribeChange = store.onChange(() => { void reload(); });
+
+		sync.subscribe(listId);
+		void sync.syncList(listId);
+		const unsubscribeStatus = sync.onStatus(status => {
+			if (status.listId !== listId) return;
+			setLastSyncedAt(status.lastSyncedAt);
+			setOnline(status.online);
+		});
+
+		const appStateSub = RNAppState.addEventListener('change', state => {
+			if (state === 'active') void sync.syncList(listId);
+		});
+
+		return () => {
+			unsubscribeChange();
+			sync.unsubscribe(listId);
+			unsubscribeStatus();
+			appStateSub.remove();
+		};
+	}, [store, sync, listId, reload]);
+
+	useEffect(() => {
+		let cancelled = false;
+		void (async () => {
+			const results = await store.suggestions(inputText);
+			if (!cancelled) setSuggestions(results);
+		})();
+		return () => { cancelled = true; };
+	}, [store, inputText]);
+
+	const addItemByName = useCallback(async (rawText: string) => {
+		const trimmed = rawText.trim();
+		if (!trimmed) return;
+		const parsed = parseItemInput(trimmed);
+		if (!parsed.name) return;
+		const record = await store.addItem(listId, parsed.name);
+		if (parsed.detail) await store.setDetail(listId, record.dTag, parsed.detail);
+		setInputText('');
+	}, [store, listId]);
+
+	const openGroups = useMemo(() => groupOpenItems(openItems), [openItems]);
+	const recentlyBought = useMemo(() => sortRecentlyBought(boughtItems).slice(0, RECENTLY_BOUGHT_LIMIT), [boughtItems]);
+
+	const onCleanUpBought = useCallback(async () => {
+		if (!boughtItems.length) return;
+		const ok = await shim.showConfirmationDialog(_('Remove all bought items from "Recently bought"?'));
+		if (!ok) return;
+		for (const item of boughtItems) await store.removeItem(listId, item.dTag);
+	}, [store, listId, boughtItems]);
+
+	// The store has no dedicated "set category" call (only setDetail/setOpen),
+	// so this goes through the same LWW merge applyRemoteItem() uses for
+	// incoming events, bumping the category field's timestamp directly. Unlike
+	// setDetail/setOpen this doesn't mark the item `pending`, so a category
+	// change made here won't be picked up for publishing until the store
+	// gains a real setCategory() -- left as an open item for lists/core.
+	const setItemCategory = useCallback(async (item: ItemRecord, category: string | null) => {
+		const payload = itemRecordToPayload(item);
+		payload.category = { v: category ?? '', t: Date.now() };
+		await store.applyRemoteItem(listId, item.dTag, payload);
+	}, [store, listId]);
+
+	const onRenameSubmit = useCallback(async (name: string) => {
+		setRenaming(false);
+		const trimmed = name.trim();
+		if (!trimmed) return;
+		const db = await getListsDatabase();
+		await db.renameList(listId, trimmed);
+		await reload();
+	}, [listId, reload]);
+
+	const goTo = useCallback((routeName: string): void => {
+		props.dispatch({ type: 'NAV_GO', routeName, listId } as never);
+	}, [props, listId]);
+
+	const menuOptions: MenuOption[] = [
+		{ title: _('Share'), onPress: (): void => goTo('ListsShare') },
+		{ title: _('Members'), onPress: (): void => goTo('ListsMembers') },
+		{ title: _('Rename'), onPress: (): void => setRenaming(true) },
+		{ title: _('Clean up bought items'), onPress: (): void => { void onCleanUpBought(); }, style: MenuOptionStyle.Normal },
+	];
+
+	const syncLine = !online
+		? _('Offline – changes will be sent later')
+		: lastSyncedAt
+			? _('Last synced %s', time.formatMsToLocal(lastSyncedAt))
+			: _('Not synced yet');
+
+	const renderTile = (item: ItemRecord, bought: boolean) => (
+		<TouchableOpacity
+			key={item.dTag}
+			style={[styles.tile, bought ? styles.tileBought : null]}
+			onPress={() => void store.toggleOpen(listId, item.dTag)}
+			onLongPress={() => setEditingItem(item)}
+		>
+			<Text style={styles.tileEmoji}>{item.icon ?? item.name.charAt(0).toUpperCase()}</Text>
+			<Text style={styles.tileName} numberOfLines={2}>{item.name}</Text>
+			{!!item.detail && <Text style={styles.tileDetail} numberOfLines={1}>{item.detail}</Text>}
+		</TouchableOpacity>
+	);
+
+	const isEmpty = !openItems.length && !boughtItems.length;
+
+	return (
+		<View style={styles.container}>
+			<ScreenHeader
+				title={list?.name ?? ''}
+				showBackButton
+				menuOptions={menuOptions}
+				rightElement={<NearbyStatusCircle listId={listId} />}
+			/>
+			<Text style={styles.syncLine}>{syncLine}</Text>
+
+			<View style={styles.inputRow}>
+				<TextInput
+					style={styles.input}
+					placeholder={_('Add an item…')}
+					value={inputText}
+					onChangeText={setInputText}
+					onSubmitEditing={() => void addItemByName(inputText)}
+					returnKeyType='done'
+				/>
+			</View>
+
+			{!!inputText.trim() && !!suggestions.length && (
+				<FlatList
+					horizontal
+					data={suggestions}
+					keyExtractor={s => s.canonical}
+					style={styles.suggestionsRow}
+					showsHorizontalScrollIndicator={false}
+					renderItem={({ item }) => (
+						<TouchableOpacity style={styles.chip} onPress={() => void addItemByName(item.canonical)}>
+							{!!item.emoji && <Text>{item.emoji}</Text>}
+							<Text style={styles.chipText}>{item.canonical}</Text>
+						</TouchableOpacity>
+					)}
+				/>
+			)}
+
+			<ScrollView>
+				{isEmpty && (
+					<View style={styles.emptyState}>
+						<Text style={styles.emptyText}>{_('No items yet. Type above to add the first one.')}</Text>
+					</View>
+				)}
+
+				{openGroups.map(group => (
+					<View key={group.categoryId}>
+						<Text style={styles.sectionHeader}>{group.emoji} {group.categoryName}</Text>
+						<View style={styles.tileGrid}>
+							{group.items.map(item => renderTile(item, false))}
+						</View>
+					</View>
+				))}
+
+				{!!recentlyBought.length && (
+					<View>
+						<Text style={styles.sectionHeader}>{_('Recently bought')}</Text>
+						<View style={styles.tileGrid}>
+							{recentlyBought.map(item => renderTile(item, true))}
+						</View>
+					</View>
+				)}
+			</ScrollView>
+
+			<PromptModal
+				visible={renaming}
+				title={_('Rename list')}
+				initialValue={list?.name ?? ''}
+				onSubmit={name => void onRenameSubmit(name)}
+				onCancel={() => setRenaming(false)}
+			/>
+
+			<ItemEditModal
+				item={editingItem}
+				onClose={() => setEditingItem(null)}
+				onSave={async (detail, category) => {
+					if (!editingItem) return;
+					await store.setDetail(listId, editingItem.dTag, detail);
+					if (category !== editingItem.category) await setItemCategory(editingItem, category);
+					setEditingItem(null);
+				}}
+				onDelete={async () => {
+					if (!editingItem) return;
+					await store.removeItem(listId, editingItem.dTag);
+					setEditingItem(null);
+				}}
+			/>
+		</View>
+	);
+};
+
+class ListScreenClass extends BaseScreenComponent<Props, Record<string, never>> {
+	public override render() {
+		return <ListScreenComponent {...this.props} />;
+	}
+}
+
+export default ListScreenClass;
+export { ListScreenComponent };
