+import { groupOpenItems, sortRecentlyBought } from './groupItems';
+import { ItemRecord } from '../core/types';
+
+const makeItem = (overrides: Partial<ItemRecord>): ItemRecord => ({
+	listId: 'list-1',
+	dTag: overrides.name ?? 'item',
+	name: 'Item',
+	detail: null,
+	detailT: null,
+	category: null,
+	categoryT: null,
+	icon: null,
+	iconT: null,
+	open: true,
+	openT: 0,
+	deleted: false,
+	deletedT: null,
+	device: 'device1',
+	pending: false,
+	...overrides,
+});
+
+describe('lists/ui/groupItems', () => {
+	test('groups items by the catalog\'s category order, not insertion order', () => {
+		const items = [
+			makeItem({ name: 'Sonstiges Ding', category: 'sonstiges' }),
+			makeItem({ name: 'Milch', category: 'kuehlregal' }),
+			makeItem({ name: 'Äpfel', category: 'obst_gemuese' }),
+		];
+
+		const groups = groupOpenItems(items);
+
+		expect(groups.map(g => g.categoryId)).toEqual(['obst_gemuese', 'kuehlregal', 'sonstiges']);
+	});
+
+	test('items with an unknown or missing category fall back to "sonstiges"', () => {
+		const items = [
+			makeItem({ name: 'Unbekannt', category: 'does-not-exist' }),
+			makeItem({ name: 'Ohne Kategorie', category: null }),
+		];
+
+		const groups = groupOpenItems(items);
+
+		expect(groups).toHaveLength(1);
+		expect(groups[0].categoryId).toBe('sonstiges');
+		expect(groups[0].items.map(i => i.name)).toEqual(['Ohne Kategorie', 'Unbekannt']);
+	});
+
+	test('sortRecentlyBought puts the most recently bought item first', () => {
+		const items = [
+			makeItem({ name: 'Alt', openT: 100 }),
+			makeItem({ name: 'Neu', openT: 300 }),
+			makeItem({ name: 'Mittel', openT: 200 }),
+		];
+
+		expect(sortRecentlyBought(items).map(i => i.name)).toEqual(['Neu', 'Mittel', 'Alt']);
+	});
+});
