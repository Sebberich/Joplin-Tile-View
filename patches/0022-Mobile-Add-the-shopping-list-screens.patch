@@ -0,0 +1,37 @@
+// Singleton access to the shopping-list database and store, opened lazily on
+// first use by a screen rather than at app startup (see docs/KONZEPT.md
+// section 2 and the mobile-map.md startup task for the sibling log.sqlite
+// file this mirrors).
+
+import Database from '@joplin/lib/database';
+import DatabaseDriverReactNative from '../../utils/database-driver-react-native';
+import { ListsDatabase } from '../core/db';
+import { ListsStore } from '../core/store';
+
+export const LISTS_DB_FILENAME = 'tiles-lists.sqlite';
+
+let database: ListsDatabase | null = null;
+let store: ListsStore | null = null;
+
+const ensureInstances = () => {
+	if (!database) database = new ListsDatabase(new Database(new DatabaseDriverReactNative()));
+	if (!store) store = new ListsStore(database, LISTS_DB_FILENAME);
+	return { database, store };
+};
+
+export const getListsStore = (): ListsStore => ensureInstances().store;
+
+// Synchronous access to the (not-necessarily-open) ListsDatabase instance,
+// for code that only needs the object reference itself -- e.g. wiring up
+// lists/sync's ListsSync.init(store, db) once, without forcing the database
+// open before the person has visited a shopping-list screen.
+export const getListsDatabaseInstance = (): ListsDatabase => ensureInstances().database;
+
+// Direct database access for reads the ListsStore façade doesn't expose
+// (member lists, list renaming). openOrCreate() is idempotent, so calling it
+// here is safe whether or not the store has already opened the database.
+export const getListsDatabase = async (): Promise<ListsDatabase> => {
+	const { database } = ensureInstances();
+	await database.openOrCreate(LISTS_DB_FILENAME);
+	return database;
+};
