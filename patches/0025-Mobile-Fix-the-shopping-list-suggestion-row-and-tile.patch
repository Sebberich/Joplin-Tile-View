@@ -0,0 +1,27 @@
+import { clampTileColumns, tileZoomStep, DEFAULT_TILE_COLUMNS, MIN_TILE_COLUMNS, MAX_TILE_COLUMNS } from './listTileZoom';
+
+describe('lists/ui/listTileZoom', () => {
+	test.each([
+		[2, MIN_TILE_COLUMNS],
+		[3, 3],
+		[4.4, 4],
+		[6, MAX_TILE_COLUMNS],
+		[9, MAX_TILE_COLUMNS],
+	])('clampTileColumns(%s) -> %s', (input, expected) => {
+		expect(clampTileColumns(input)).toBe(expected);
+	});
+
+	test('clampTileColumns falls back to the default for a non-finite value', () => {
+		expect(clampTileColumns(NaN)).toBe(DEFAULT_TILE_COLUMNS);
+	});
+
+	test('zooming in (spreading fingers) decreases the column count, down to the minimum', () => {
+		expect(tileZoomStep(DEFAULT_TILE_COLUMNS, 1)).toBe(3);
+		expect(tileZoomStep(MIN_TILE_COLUMNS, 1)).toBe(MIN_TILE_COLUMNS);
+	});
+
+	test('zooming out (pinching together) increases the column count, up to the maximum', () => {
+		expect(tileZoomStep(DEFAULT_TILE_COLUMNS, -1)).toBe(5);
+		expect(tileZoomStep(MAX_TILE_COLUMNS, -1)).toBe(MAX_TILE_COLUMNS);
+	});
+});
diff --git a/packages/app-mobile/lists/ui/listTileZoom.ts b/packages/app-mobile/lists/ui/listTileZoom.ts
new file mode 100644
index 0000000..07851fb
--- /dev/null
+++ b/packages/app-mobile/lists/ui/listTileZoom.ts
@@ -0,0 +1,20 @@
+// Pinch-to-zoom column ladder for the shopping-list tile grid. Deliberately separate from
+// utils/tileZoom.ts (used by the note tile view, which also scales a font percentage) -- lists
+// only ever change the column count, and emoji/text size are derived from the resulting tile
+// width in ListScreen.tsx itself, not stored as a separate setting.
+
+export const MIN_TILE_COLUMNS = 3;
+export const MAX_TILE_COLUMNS = 6;
+export const DEFAULT_TILE_COLUMNS = 4;
+
+export const clampTileColumns = (columns: number): number => {
+	if (!Number.isFinite(columns)) return DEFAULT_TILE_COLUMNS;
+	return Math.min(MAX_TILE_COLUMNS, Math.max(MIN_TILE_COLUMNS, Math.round(columns)));
+};
+
+// One step along the ladder, clamped to its ends. `direction` follows utils/tileZoom.ts's
+// convention: 1 means zooming in (fingers spreading apart -- fewer, bigger tiles), -1 means
+// zooming out (fingers pinching together -- more, smaller tiles).
+export const tileZoomStep = (columns: number, direction: 1 | -1): number => {
+	return clampTileColumns(clampTileColumns(columns) - direction);
+};
