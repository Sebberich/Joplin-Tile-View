diff --git a/packages/app-mobile/utils/tileZoom.test.ts b/packages/app-mobile/utils/tileZoom.test.ts
new file mode 100644
index 0000000..88bf19f
--- /dev/null
+++ b/packages/app-mobile/utils/tileZoom.test.ts
@@ -0,0 +1,42 @@
+import { findZoomLevel, zoomLevels, zoomStep } from './tileZoom';
+
+describe('tileZoom', () => {
+	// Excludes the two ends of the ladder -- zooming past an end is clamped rather than reversed
+	// (covered separately below), so a round trip through an end doesn't return to the start.
+	test('zooming in then out returns to the starting ladder entry', () => {
+		for (let index = 1; index < zoomLevels.length - 1; index++) {
+			const start = zoomLevels[index];
+			const zoomedIn = zoomStep(start.columns, start.fontScale, 1);
+			const zoomedOut = zoomStep(zoomedIn.columns, zoomedIn.fontScale, -1);
+			expect(zoomedOut).toEqual(start);
+		}
+	});
+
+	test('zooming out then in returns to the starting ladder entry', () => {
+		for (let index = 1; index < zoomLevels.length - 1; index++) {
+			const start = zoomLevels[index];
+			const zoomedOut = zoomStep(start.columns, start.fontScale, -1);
+			const zoomedIn = zoomStep(zoomedOut.columns, zoomedOut.fontScale, 1);
+			expect(zoomedIn).toEqual(start);
+		}
+	});
+
+	test('zooming in from an off-ladder state lands on a ladder entry with 100% font', () => {
+		const result = zoomStep(5, 160, 1);
+		expect(result).toEqual({ columns: 4, fontScale: 100 });
+	});
+
+	test('zooming out is clamped at the most zoomed-out ladder entry', () => {
+		const mostZoomedOut = zoomLevels[0];
+		expect(zoomStep(mostZoomedOut.columns, mostZoomedOut.fontScale, -1)).toEqual(mostZoomedOut);
+	});
+
+	test('zooming in is clamped at the most zoomed-in ladder entry', () => {
+		const mostZoomedIn = zoomLevels[zoomLevels.length - 1];
+		expect(zoomStep(mostZoomedIn.columns, mostZoomedIn.fontScale, 1)).toEqual(mostZoomedIn);
+	});
+
+	test('findZoomLevel finds the exact match when the state is on the ladder', () => {
+		expect(findZoomLevel(3, 100)).toBe(zoomLevels.findIndex(level => level.columns === 3 && level.fontScale === 100));
+	});
+});
diff --git a/packages/app-mobile/utils/tileZoom.ts b/packages/app-mobile/utils/tileZoom.ts
new file mode 100644
index 0000000..c03a850
--- /dev/null
+++ b/packages/app-mobile/utils/tileZoom.ts
@@ -0,0 +1,71 @@
+interface ZoomLevel {
+	columns: number;
+	fontScale: number;
+}
+
+// A fixed sequence of (columns, fontScale) pairs, from most zoomed-out to most zoomed-in. Zooming
+// always moves one step along this ladder, which keeps the tile view's appearance a function of
+// the zoom level alone -- unlike changing columns and fontScale independently, where the same
+// column count could look different depending on how the user got there.
+export const zoomLevels: ZoomLevel[] = [
+	{ columns: 5, fontScale: 60 },
+	{ columns: 5, fontScale: 70 },
+	{ columns: 5, fontScale: 80 },
+	{ columns: 5, fontScale: 90 },
+	{ columns: 5, fontScale: 100 },
+	{ columns: 4, fontScale: 100 },
+	{ columns: 3, fontScale: 100 },
+	{ columns: 2, fontScale: 100 },
+	{ columns: 1, fontScale: 100 },
+	{ columns: 1, fontScale: 110 },
+	{ columns: 1, fontScale: 120 },
+	{ columns: 1, fontScale: 130 },
+	{ columns: 1, fontScale: 140 },
+	{ columns: 1, fontScale: 150 },
+	{ columns: 1, fontScale: 160 },
+];
+
+// Finds the ladder entry closest to the given (columns, fontScale) pair. Used to map a
+// possibly-off-ladder state (for example, one saved before the ladder existed) onto the nearest
+// step before zooming in or out.
+export const findZoomLevel = (columns: number, fontScale: number): number => {
+	const exactIndex = zoomLevels.findIndex(level => level.columns === columns && level.fontScale === fontScale);
+	if (exactIndex !== -1) return exactIndex;
+
+	const sameColumns = zoomLevels
+		.map((level, index) => ({ level, index }))
+		.filter(({ level }) => level.columns === columns);
+
+	if (sameColumns.length) {
+		let best = sameColumns[0];
+		let bestDiff = Math.abs(best.level.fontScale - fontScale);
+		for (const candidate of sameColumns.slice(1)) {
+			const diff = Math.abs(candidate.level.fontScale - fontScale);
+			if (diff < bestDiff) {
+				best = candidate;
+				bestDiff = diff;
+			}
+		}
+		return best.index;
+	}
+
+	// No ladder entry has this column count -- fall back to the entry with the closest one.
+	let bestIndex = 0;
+	let bestDiff = Math.abs(zoomLevels[0].columns - columns);
+	for (let index = 1; index < zoomLevels.length; index++) {
+		const diff = Math.abs(zoomLevels[index].columns - columns);
+		if (diff < bestDiff) {
+			bestIndex = index;
+			bestDiff = diff;
+		}
+	}
+	return bestIndex;
+};
+
+// Returns the next ladder entry in the given direction (1 to zoom in, -1 to zoom out), clamped to
+// the ends of the ladder.
+export const zoomStep = (columns: number, fontScale: number, direction: 1|-1): ZoomLevel => {
+	const currentIndex = findZoomLevel(columns, fontScale);
+	const nextIndex = Math.min(zoomLevels.length - 1, Math.max(0, currentIndex + direction));
+	return zoomLevels[nextIndex];
+};
