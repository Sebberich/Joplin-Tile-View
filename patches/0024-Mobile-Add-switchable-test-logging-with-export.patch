+import { setupDatabaseAndSynchronizer } from '@joplin/lib/testing/test-utils';
+import Setting from '@joplin/lib/models/Setting';
+import { initDebugLog, isDebugLogSettingKey, updateDebugLogConfig } from './debugLogSettings';
+import { isDebugLogEnabled, resetDebugLogPersistenceForTests, setDebugLogConfig } from './debugLog';
+
+describe('debugLogSettings', () => {
+	beforeEach(async () => {
+		await setupDatabaseAndSynchronizer(0);
+		setDebugLogConfig(false, []);
+		resetDebugLogPersistenceForTests();
+	});
+
+	afterEach(() => {
+		resetDebugLogPersistenceForTests();
+	});
+
+	test('isDebugLogSettingKey should match the master switch and per-category keys only', () => {
+		expect(isDebugLogSettingKey('debugLog.enabled')).toBe(true);
+		expect(isDebugLogSettingKey('debugLog.category.tiles')).toBe(true);
+		expect(isDebugLogSettingKey('debugLog.category.lists.nearby')).toBe(true);
+		expect(isDebugLogSettingKey('sync.interval')).toBe(false);
+	});
+
+	test('updateDebugLogConfig should reflect the master switch and per-category settings', () => {
+		Setting.setValue('debugLog.enabled', true);
+		Setting.setValue('debugLog.category.tiles', true);
+		Setting.setValue('debugLog.category.lists.sync', false);
+
+		updateDebugLogConfig();
+
+		expect(isDebugLogEnabled('tiles')).toBe(true);
+		expect(isDebugLogEnabled('lists.sync')).toBe(false);
+	});
+
+	test('updateDebugLogConfig should disable everything when the master switch is off, even if categories are on', () => {
+		Setting.setValue('debugLog.enabled', false);
+		Setting.setValue('debugLog.category.tiles', true);
+
+		updateDebugLogConfig();
+
+		expect(isDebugLogEnabled('tiles')).toBe(false);
+	});
+
+	test('initDebugLog should apply the current settings and start persistence', async () => {
+		Setting.setValue('debugLog.enabled', true);
+		Setting.setValue('debugLog.category.tiles', true);
+		Setting.setValue('debugLog.category.lists.sync', false);
+
+		await initDebugLog();
+
+		expect(isDebugLogEnabled('tiles')).toBe(true);
+		expect(isDebugLogEnabled('lists.sync')).toBe(false);
+	});
+});
