diff --git a/packages/app-mobile/utils/debugLog.test.ts b/packages/app-mobile/utils/debugLog.test.ts
new file mode 100644
index 0000000..0255664
--- /dev/null
+++ b/packages/app-mobile/utils/debugLog.test.ts
@@ -0,0 +1,202 @@
+import FsDriverBase, { Stat } from '@joplin/lib/fs-driver-base';
+import {
+	clearDebugLog, clearDebugLogFiles, debugLog, debugLogEntries, flushDebugLog, formatDebugLog,
+	formatDebugLogEntry, initDebugLogPersistence, isDebugLogEnabled, onDebugLogChange,
+	resetDebugLogPersistenceForTests, setDebugLogConfig, setDebugLogProfileDirForTests,
+} from './debugLog';
+
+// A minimal in-memory stand-in for the platform filesystem driver, just covering the methods
+// debugLog.ts's persistence uses.
+class FakeFsDriver extends FsDriverBase {
+	public files = new Map<string, string>();
+
+	public override async exists(path: string): Promise<boolean> {
+		return this.files.has(path);
+	}
+
+	public override async appendFile(path: string, content: string): Promise<void> {
+		this.files.set(path, (this.files.get(path) ?? '') + content);
+	}
+
+	public override async writeFile(path: string, content: string): Promise<void> {
+		this.files.set(path, content);
+	}
+
+	public override async readFile(path: string): Promise<string> {
+		if (!this.files.has(path)) throw new Error(`ENOENT: ${path}`);
+		return this.files.get(path);
+	}
+
+	public override async unlink(path: string): Promise<void> {
+		this.files.delete(path);
+	}
+
+	public override async move(source: string, dest: string): Promise<void> {
+		this.files.set(dest, this.files.get(source) ?? '');
+		this.files.delete(source);
+	}
+
+	public override async stat(path: string): Promise<Stat> {
+		if (!this.files.has(path)) return null;
+		const content = this.files.get(path);
+		return { size: Buffer.byteLength(content), isDirectory: () => false, birthtime: new Date(), mtime: new Date(), path };
+	}
+}
+
+describe('debugLog', () => {
+	beforeEach(() => {
+		clearDebugLog();
+		setDebugLogConfig(false, []);
+		resetDebugLogPersistenceForTests();
+		setDebugLogProfileDirForTests('/fake-profile');
+	});
+
+	afterEach(() => {
+		resetDebugLogPersistenceForTests();
+	});
+
+	test('should not record entries for a disabled category', () => {
+		setDebugLogConfig(true, ['lists.sync']);
+		const log = debugLog('lists.nearby');
+		expect(log.enabled()).toBe(false);
+		log.info('Should not be recorded');
+		expect(debugLogEntries()).toHaveLength(0);
+	});
+
+	test('should not record entries while the master switch is off', () => {
+		setDebugLogConfig(false, ['lists.nearby']);
+		debugLog('lists.nearby').info('Should not be recorded');
+		expect(debugLogEntries()).toHaveLength(0);
+	});
+
+	test('should record entries for an enabled category, and notify listeners', () => {
+		setDebugLogConfig(true, ['lists.nearby']);
+		const listener = jest.fn();
+		const unsubscribe = onDebugLogChange(listener);
+
+		const log = debugLog('lists.nearby');
+		expect(log.enabled()).toBe(true);
+		log.info('Scan started', { listId: 'abc' });
+		log.warn('Retrying');
+		log.error('Failed', new Error('boom'));
+
+		const entries = debugLogEntries();
+		expect(entries).toHaveLength(3);
+		expect(entries[0]).toMatchObject({ level: 'info', category: 'lists.nearby', message: 'Scan started' });
+		expect(entries[0].data).toBe('{"listId":"abc"}');
+		expect(entries[2].data).toContain('Error: boom');
+		expect(listener).toHaveBeenCalledTimes(3);
+
+		unsubscribe();
+		log.info('After unsubscribe');
+		expect(listener).toHaveBeenCalledTimes(3);
+	});
+
+	test('clearDebugLog should empty the ring buffer', () => {
+		setDebugLogConfig(true, ['tiles']);
+		debugLog('tiles').info('Some entry');
+		expect(debugLogEntries()).toHaveLength(1);
+
+		clearDebugLog();
+		expect(debugLogEntries()).toHaveLength(0);
+	});
+
+	test('formatDebugLog should filter by category and always keep separator lines', () => {
+		setDebugLogConfig(true, ['tiles', 'lists.sync']);
+		debugLog('tiles').info('Tile event');
+		debugLog('lists.sync').info('Sync event');
+
+		const filtered = formatDebugLog(['tiles']);
+		expect(filtered).toContain('[tiles] Tile event');
+		expect(filtered).not.toContain('[lists.sync]');
+
+		const all = formatDebugLog();
+		expect(all).toContain('[tiles] Tile event');
+		expect(all).toContain('[lists.sync] Sync event');
+	});
+
+	test('formatDebugLogEntry should append the data payload only when present', () => {
+		const withData = formatDebugLogEntry({ time: 0, category: 'tiles', level: 'debug', message: 'Msg', data: '{"a":1}' });
+		expect(withData).toContain('Msg {"a":1}');
+
+		const withoutData = formatDebugLogEntry({ time: 0, category: 'tiles', level: 'debug', message: 'Msg' });
+		expect(withoutData.endsWith('Msg')).toBe(true);
+	});
+
+	test('setDebugLogConfig should be re-enterable and only enable the given categories', () => {
+		setDebugLogConfig(true, ['tiles', 'lists.sync']);
+		expect(isDebugLogEnabled('tiles')).toBe(true);
+		expect(isDebugLogEnabled('lists.sync')).toBe(true);
+		expect(isDebugLogEnabled('lists.nearby')).toBe(false);
+
+		setDebugLogConfig(true, ['lists.nearby']);
+		expect(isDebugLogEnabled('tiles')).toBe(false);
+		expect(isDebugLogEnabled('lists.nearby')).toBe(true);
+	});
+
+	describe('persistence', () => {
+		let fsDriver: FakeFsDriver;
+
+		beforeEach(() => {
+			fsDriver = new FakeFsDriver();
+		});
+
+		test('flushDebugLog should append pending entries to the log file, batched', async () => {
+			setDebugLogConfig(true, ['tiles']);
+			await initDebugLogPersistence(fsDriver);
+			debugLog('tiles').info('First');
+			debugLog('tiles').info('Second');
+
+			// Nothing written yet -- append() only queues, flushDebugLog() writes.
+			const path = '/fake-profile/test-log.txt';
+			expect(fsDriver.files.has(path)).toBe(false);
+
+			await flushDebugLog(fsDriver);
+
+			const afterFlush = fsDriver.files.get(path);
+			expect(afterFlush).toContain('app started');
+			expect(afterFlush).toContain('[tiles] First');
+			expect(afterFlush).toContain('[tiles] Second');
+		});
+
+		test('flushDebugLog should rotate the log file to a .1 backup once it grows past the size limit', async () => {
+			const path = '/fake-profile/test-log.txt';
+			const backupPath = `${path}.1`;
+			fsDriver.files.set(path, 'x'.repeat(2 * 1024 * 1024));
+
+			setDebugLogConfig(true, ['tiles']);
+			await initDebugLogPersistence(fsDriver);
+			debugLog('tiles').info('Triggers rotation');
+			await flushDebugLog(fsDriver);
+
+			expect(fsDriver.files.get(backupPath)?.length).toBe(2 * 1024 * 1024);
+			expect(fsDriver.files.get(path)).toContain('Triggers rotation');
+			expect(fsDriver.files.get(path)).not.toContain('x'.repeat(100));
+		});
+
+		test('initDebugLogPersistence should load the tail of a previous session into the ring buffer', async () => {
+			const path = '/fake-profile/test-log.txt';
+			const previousEntry = formatDebugLogEntry({ time: Date.parse('2024-01-01T00:00:00.000Z'), category: 'tiles', level: 'info', message: 'From last session' });
+			fsDriver.files.set(path, `${previousEntry}\n--- app started 2024-01-01 00:00:00.000 ---\n`);
+
+			await initDebugLogPersistence(fsDriver);
+
+			const entries = debugLogEntries();
+			expect(entries.some(e => e.message === 'From last session' && e.category === 'tiles')).toBe(true);
+			expect(entries.some(e => e.separator && e.message.includes('app started'))).toBe(true);
+			// A fresh "app started" marker for *this* session is appended too.
+			expect(entries.filter(e => e.separator).length).toBeGreaterThanOrEqual(2);
+		});
+
+		test('clearDebugLogFiles should delete the main and backup log files', async () => {
+			const path = '/fake-profile/test-log.txt';
+			fsDriver.files.set(path, 'some content');
+			fsDriver.files.set(`${path}.1`, 'older content');
+
+			await clearDebugLogFiles(fsDriver);
+
+			expect(fsDriver.files.has(path)).toBe(false);
+			expect(fsDriver.files.has(`${path}.1`)).toBe(false);
+		});
+	});
+});
diff --git a/packages/app-mobile/utils/debugLog.ts b/packages/app-mobile/utils/debugLog.ts
new file mode 100644
index 0000000..fcfaf39
--- /dev/null
+++ b/packages/app-mobile/utils/debugLog.ts
@@ -0,0 +1,290 @@
+// Test logging for features under device testing (shopping lists, relays, Bluetooth, tile view).
+//
+// Separate from Joplin's own log: entries are kept in a bounded in-memory ring buffer, only while
+// test logging is switched on in the settings (master switch plus one switch per category), and
+// can be viewed and shared as a text file from the settings screen. Calls are cheap no-ops while
+// a category is off, so they can stay in the code permanently.
+//
+// Usage:
+//   import { debugLog } from '../../utils/debugLog';
+//   const log = debugLog('lists.nearby');
+//   log.info('Scan started', { listId });
+//
+// Persistence (see initDebugLogPersistence below): while active, entries are also appended to a
+// file in the profile directory, batched and flushed at most every couple of seconds so that
+// entries survive an app crash (relevant for Bluetooth testing, which can crash the app). On the
+// next start, the tail of that file is loaded back into the ring buffer, so the viewer shows
+// entries from the previous session too.
+
+import shim from '@joplin/lib/shim';
+import Setting from '@joplin/lib/models/Setting';
+import FsDriverBase from '@joplin/lib/fs-driver-base';
+import { AppState as RNAppState, AppStateStatus } from 'react-native';
+
+export type DebugLogCategory =
+	'lists.store' | // local list database and store operations
+	'lists.relays' | // relay connections, publish/query results
+	'lists.sync' | // list sync passes, directory, join requests, merge results
+	'lists.nearby' | // Bluetooth: advertising, scanning, connections, handshake, transfer
+	'lists.invite' | // creating and parsing invites, deep links
+	'lists.ui' | // list screens: input, suggestions, taps
+	'tiles'; // note tile view: zoom, filter, layout
+
+export const debugLogCategories: DebugLogCategory[] = [
+	'lists.store', 'lists.relays', 'lists.sync', 'lists.nearby', 'lists.invite', 'lists.ui', 'tiles',
+];
+
+export type DebugLogLevel = 'debug' | 'info' | 'warn' | 'error';
+
+export interface DebugLogEntry {
+	time: number;
+	category: DebugLogCategory;
+	level: DebugLogLevel;
+	message: string;
+	data?: string;
+	// Set on the "--- app started ... ---" markers loaded from the persisted file (and on lines
+	// from that file that could not be parsed back into a normal entry). Shown regardless of the
+	// active category filter.
+	separator?: boolean;
+}
+
+export interface DebugLogger {
+	debug(message: string, data?: unknown): void;
+	info(message: string, data?: unknown): void;
+	warn(message: string, data?: unknown): void;
+	error(message: string, data?: unknown): void;
+	enabled(): boolean;
+}
+
+const maxEntries = 5000;
+const entries: DebugLogEntry[] = [];
+const listeners = new Set<()=> void>();
+
+// Which categories are on. Set by the settings integration (see setDebugLogConfig); everything
+// is off until then.
+let masterEnabled = false;
+const enabledCategories = new Set<DebugLogCategory>();
+
+export const setDebugLogConfig = (enabled: boolean, categories: DebugLogCategory[]) => {
+	masterEnabled = enabled;
+	enabledCategories.clear();
+	for (const c of categories) enabledCategories.add(c);
+};
+
+export const isDebugLogEnabled = (category: DebugLogCategory) => masterEnabled && enabledCategories.has(category);
+
+const stringifyData = (data: unknown): string | undefined => {
+	if (data === undefined) return undefined;
+	if (data instanceof Error) return `${data.name}: ${data.message}${data.stack ? `\n${data.stack}` : ''}`;
+	if (typeof data === 'string') return data;
+	try {
+		return JSON.stringify(data, (_key, value) => {
+			if (value instanceof Uint8Array) return `<${value.length} bytes>`;
+			if (value instanceof Error) return `${value.name}: ${value.message}`;
+			return value;
+		});
+	} catch (error) {
+		return String(data);
+	}
+};
+
+const pushEntry = (entry: DebugLogEntry) => {
+	entries.push(entry);
+	if (entries.length > maxEntries) entries.splice(0, entries.length - maxEntries);
+	for (const listener of listeners) listener();
+};
+
+const append = (category: DebugLogCategory, level: DebugLogLevel, message: string, data: unknown) => {
+	if (!isDebugLogEnabled(category)) return;
+	const entry: DebugLogEntry = { time: Date.now(), category, level, message, data: stringifyData(data) };
+	pushEntry(entry);
+	if (persistenceEnabled) pendingLines.push(formatDebugLogEntry(entry));
+};
+
+export const debugLog = (category: DebugLogCategory): DebugLogger => ({
+	debug: (message, data) => append(category, 'debug', message, data),
+	info: (message, data) => append(category, 'info', message, data),
+	warn: (message, data) => append(category, 'warn', message, data),
+	error: (message, data) => append(category, 'error', message, data),
+	enabled: () => isDebugLogEnabled(category),
+});
+
+export const debugLogEntries = (): DebugLogEntry[] => entries.slice();
+
+export const clearDebugLog = () => {
+	entries.splice(0, entries.length);
+	pendingLines.splice(0, pendingLines.length);
+	for (const listener of listeners) listener();
+};
+
+// Also deletes the persisted log files (main and backup). Separate from clearDebugLog so that
+// callers that only need the in-memory buffer cleared (e.g. tests) don't have to deal with a
+// filesystem driver.
+export const clearDebugLogFiles = async (fsDriver: FsDriverBase = shim.fsDriver()): Promise<void> => {
+	const path = logFilePath();
+	const backupPath = logFileBackupPath();
+	if (await fsDriver.exists(path)) await fsDriver.unlink(path);
+	if (await fsDriver.exists(backupPath)) await fsDriver.unlink(backupPath);
+};
+
+export const onDebugLogChange = (listener: ()=> void) => {
+	listeners.add(listener);
+	return () => {
+		listeners.delete(listener);
+	};
+};
+
+const pad = (n: number, width = 2) => String(n).padStart(width, '0');
+
+const formatTime = (time: number) => {
+	const d = new Date(time);
+	return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`;
+};
+
+export const formatDebugLogEntry = (entry: DebugLogEntry) => {
+	if (entry.separator) return entry.message;
+	const head = `${formatTime(entry.time)} ${entry.level.toUpperCase().padEnd(5)} [${entry.category}] ${entry.message}`;
+	return entry.data === undefined ? head : `${head} ${entry.data}`;
+};
+
+export const formatDebugLog = (filter?: DebugLogCategory[]) => {
+	const selected = filter ? entries.filter(e => e.separator || filter.includes(e.category)) : entries;
+	return selected.map(formatDebugLogEntry).join('\n');
+};
+
+// --- Persistence -------------------------------------------------------------------------------
+//
+// Entries are appended to a file in the profile directory so they survive an app crash. Writes
+// are batched: append() above only pushes to `pendingLines`, and a timer flushes them to disk at
+// most every `flushIntervalMs`. A flush is also forced when the app goes to the background, since
+// that's the last reliable point before a crash or the OS killing the process.
+
+const maxLogFileSize = 2 * 1024 * 1024;
+const flushIntervalMs = 2000;
+const logFileName = 'test-log.txt';
+
+let persistenceEnabled = false;
+let pendingLines: string[] = [];
+let flushTimer: ReturnType<typeof setInterval> | null = null;
+let flushing = false;
+let appStateSubscription: { remove(): void } | null = null;
+
+// Overridable for tests, which don't have a real profile directory.
+let profileDirOverride: string | null = null;
+export const setDebugLogProfileDirForTests = (dir: string | null) => {
+	profileDirOverride = dir;
+};
+
+const profileDir = () => profileDirOverride ?? Setting.value('profileDir');
+const logFilePath = () => `${profileDir()}/${logFileName}`;
+const logFileBackupPath = () => `${logFilePath()}.1`;
+
+const rotateIfNeeded = async (fsDriver: FsDriverBase, addedBytes: number) => {
+	const path = logFilePath();
+	if (!(await fsDriver.exists(path))) return;
+	const stat = await fsDriver.stat(path);
+	if (!stat || stat.size + addedBytes <= maxLogFileSize) return;
+
+	const backupPath = logFileBackupPath();
+	if (await fsDriver.exists(backupPath)) await fsDriver.unlink(backupPath);
+	await fsDriver.move(path, backupPath);
+};
+
+// Flushes any pending lines to the log file, rotating it first if it's about to exceed
+// maxLogFileSize. Safe to call when there's nothing pending, or while a flush is already running
+// (the second call is a no-op -- the pending lines it would have written stay in `pendingLines`
+// and go out on the next flush).
+export const flushDebugLog = async (fsDriver: FsDriverBase = shim.fsDriver()): Promise<void> => {
+	if (flushing || !pendingLines.length) return;
+	flushing = true;
+	try {
+		const toWrite = `${pendingLines.join('\n')}\n`;
+		pendingLines = [];
+		await rotateIfNeeded(fsDriver, toWrite.length);
+		await fsDriver.appendFile(logFilePath(), toWrite, 'utf8');
+	} finally {
+		flushing = false;
+	}
+};
+
+// Parses a line previously written by formatDebugLogEntry back into an entry, for loading the
+// tail of the log file on startup. Lines that don't match (in particular, previous separator
+// lines) are returned as-is, marked as a separator so they're still shown in the viewer.
+const logLineRegex = /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}) (\w+)\s+\[([^\]]+)\] (.*)$/;
+const debugLogLevels: DebugLogLevel[] = ['debug', 'info', 'warn', 'error'];
+
+const parseTime = (formatted: string): number => {
+	const match = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})\.(\d{3})$/.exec(formatted);
+	if (!match) return Date.now();
+	const [year, month, day, hour, minute, second, ms] = match.slice(1).map(Number);
+	return new Date(year, month - 1, day, hour, minute, second, ms).getTime();
+};
+
+const parseLogLine = (line: string): DebugLogEntry => {
+	const match = logLineRegex.exec(line);
+	const level = match ? match[2].toLowerCase() as DebugLogLevel : null;
+	if (match && debugLogLevels.includes(level)) {
+		return { time: parseTime(match[1]), category: match[3] as DebugLogCategory, level, message: match[4] };
+	}
+	return { time: Date.now(), category: debugLogCategories[0], level: 'info', message: line, separator: true };
+};
+
+const loadTail = async (fsDriver: FsDriverBase) => {
+	const path = logFilePath();
+	if (!(await fsDriver.exists(path))) return;
+
+	let content = '';
+	try {
+		content = await fsDriver.readFile(path, 'utf8');
+	} catch (error) {
+		return;
+	}
+
+	const lines = content.split('\n').filter(line => line.length > 0);
+	for (const line of lines.slice(-maxEntries)) pushEntry(parseLogLine(line));
+};
+
+// Starts persistence: loads the tail of the previous session's log into the ring buffer, marks
+// the new session with a separator line, and starts batching new entries to disk. Called once,
+// from the settings bridge (utils/debugLogSettings.ts), after settings have loaded.
+export const initDebugLogPersistence = async (fsDriver: FsDriverBase = shim.fsDriver()): Promise<void> => {
+	if (persistenceEnabled) return;
+	persistenceEnabled = true;
+
+	await loadTail(fsDriver);
+
+	const startedEntry: DebugLogEntry = {
+		time: Date.now(),
+		category: debugLogCategories[0],
+		level: 'info',
+		message: `--- app started ${formatTime(Date.now())} ---`,
+		separator: true,
+	};
+	pushEntry(startedEntry);
+	pendingLines.push(formatDebugLogEntry(startedEntry));
+
+	if (!flushTimer) {
+		flushTimer = setInterval(() => { void flushDebugLog(fsDriver); }, flushIntervalMs);
+	}
+	if (!appStateSubscription) {
+		appStateSubscription = RNAppState.addEventListener('change', (state: AppStateStatus) => {
+			if (state !== 'active') void flushDebugLog(fsDriver);
+		});
+	}
+};
+
+// For tests: undoes initDebugLogPersistence so each test starts from a clean slate.
+export const resetDebugLogPersistenceForTests = () => {
+	persistenceEnabled = false;
+	pendingLines = [];
+	flushing = false;
+	if (flushTimer) {
+		clearInterval(flushTimer);
+		flushTimer = null;
+	}
+	if (appStateSubscription) {
+		appStateSubscription.remove();
+		appStateSubscription = null;
+	}
+	profileDirOverride = null;
+};
