+++ b/packages/app-mobile/utils/debugLogSettings.ts
@@ -0,0 +1,26 @@
+// Bridges the "Test logging" settings (packages/lib/models/settings/builtInMetadata.ts, section
+// 'testLogging') to the debugLog module: reads the master switch and the per-category toggles and
+// pushes them into setDebugLogConfig, so that debugLog() calls elsewhere in the app become no-ops
+// or start recording accordingly.
+//
+// initDebugLog() is called once from root.tsx after settings have loaded. After that,
+// updateDebugLogConfig() is called by root.tsx's redux middleware whenever a 'debugLog.*' setting
+// changes.
+
+import Setting from '@joplin/lib/models/Setting';
+import { debugLogCategories, initDebugLogPersistence, setDebugLogConfig } from './debugLog';
+
+export const updateDebugLogConfig = () => {
+	const enabled = !!Setting.value('debugLog.enabled');
+	const categories = debugLogCategories.filter(category => !!Setting.value(`debugLog.category.${category}`));
+	setDebugLogConfig(enabled, categories);
+};
+
+export const initDebugLog = async (): Promise<void> => {
+	updateDebugLogConfig();
+	await initDebugLogPersistence();
+};
+
+// True for any settings key that should trigger updateDebugLogConfig() when changed -- the master
+// switch and every per-category toggle.
+export const isDebugLogSettingKey = (key: string): boolean => key === 'debugLog.enabled' || key.startsWith('debugLog.category.');
diff --git a/packages/app-mobile/utils/shareDebugLog.ts b/packages/app-mobile/utils/shareDebugLog.ts
new file mode 100644
index 0000000..89303a7
--- /dev/null
+++ b/packages/app-mobile/utils/shareDebugLog.ts
@@ -0,0 +1,63 @@
+// Builds and shares the test log as a text file, and clears it (buffer and persisted files).
+// Shared by the "Share test log" / "Clear test log" settings buttons (ConfigScreen.tsx) and the
+// DebugLogScreen viewer, so both act on the log the same way.
+
+import { Platform } from 'react-native';
+import shim from '@joplin/lib/shim';
+import Logger from '@joplin/utils/Logger';
+import { _ } from '@joplin/lib/locale';
+import { writeTextToCacheFile } from './ShareUtils';
+import shareFile from './shareFile';
+import {
+	DebugLogCategory, clearDebugLog, clearDebugLogFiles, debugLogCategories, debugLogEntries,
+	formatDebugLogEntry, isDebugLogEnabled,
+} from './debugLog';
+
+const logger = Logger.create('shareDebugLog');
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+// yyyymmdd-hhmm, for the shared file name.
+const shareFileTimestamp = (date: Date) => {
+	return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}-${pad(date.getHours())}${pad(date.getMinutes())}`;
+};
+
+const buildShareHeader = (): string => {
+	const enabledCategories = debugLogCategories.filter(isDebugLogEnabled);
+	const model = Platform.OS === 'android' ? (Platform.constants as { Model?: string })?.Model ?? '' : '';
+
+	return [
+		'Joplin Tiles -- test log',
+		`Generated: ${new Date().toString()}`,
+		`App version: ${shim.appVersion()}`,
+		`Platform: ${Platform.OS} ${Platform.Version}${model ? ` (${model})` : ''}`,
+		`Enabled categories: ${enabledCategories.length ? enabledCategories.join(', ') : 'none'}`,
+		'',
+	].join('\n');
+};
+
+// categoryFilter: when given, only entries in one of these categories (plus separator lines) are
+// included. Leave undefined to share everything currently in the ring buffer.
+export const shareDebugLog = async (categoryFilter?: DebugLogCategory[]): Promise<void> => {
+	const allEntries = debugLogEntries();
+	const entries = categoryFilter ? allEntries.filter(entry => entry.separator || categoryFilter.includes(entry.category)) : allEntries;
+	const logData = entries.map(formatDebugLogEntry).join('\n');
+	const content = `${buildShareHeader()}\n${logData}\n`;
+	const fileName = `joplin-tiles-test-log-${shareFileTimestamp(new Date())}.txt`;
+
+	let fileToShare: string|null = null;
+	try {
+		fileToShare = await writeTextToCacheFile(content, fileName);
+		await shareFile(fileToShare, 'text/plain');
+	} catch (error) {
+		logger.error('Unable to share test log:', error);
+		void shim.showErrorDialog(_('Unable to share the test log. Reason: %s', error.toString()));
+	} finally {
+		if (fileToShare) await shim.fsDriver().remove(fileToShare);
+	}
+};
+
+export const clearDebugLogAndFiles = async (): Promise<void> => {
