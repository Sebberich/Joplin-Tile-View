@@ -0,0 +1,85 @@
+import * as React from 'react';
+import { Store } from 'redux';
+import { setupDatabaseAndSynchronizer } from '@joplin/lib/testing/test-utils';
+import TestProviderStack from '../testing/TestProviderStack';
+import createMockReduxStore from '../../utils/testing/createMockReduxStore';
+import setupGlobalStore from '../../utils/testing/setupGlobalStore';
+import { render, screen, fireEvent, waitFor } from '../../utils/testing/testingLibrary';
+import { AppState } from '../../utils/types';
+import { clearDebugLog, debugLog, resetDebugLogPersistenceForTests, setDebugLogConfig } from '../../utils/debugLog';
+
+// The share/clear buttons hand off to shareDebugLog / clearDebugLogAndFiles, which touch the
+// filesystem -- keep this a focused UI test by mocking them out, same as ListScreen.test.tsx mocks
+// out its runtime dependencies.
+const shareDebugLog = jest.fn();
+const clearDebugLogAndFiles = jest.fn();
+jest.mock('../../utils/shareDebugLog', () => ({
+	shareDebugLog: (...args: unknown[]) => shareDebugLog(...args),
+	clearDebugLogAndFiles: () => clearDebugLogAndFiles(),
+}));
+
+import { DebugLogScreenComponent } from './DebugLogScreen';
+
+let testStore: Store<AppState>;
+
+const WrappedDebugLogScreen: React.FC = () => {
+	return <TestProviderStack store={testStore}>
+		<DebugLogScreenComponent navigation={{}} themeId={testStore.getState().settings.theme} />
+	</TestProviderStack>;
+};
+
+describe('DebugLogScreen', () => {
+	beforeEach(async () => {
+		await setupDatabaseAndSynchronizer(0);
+		testStore = createMockReduxStore();
+		setupGlobalStore(testStore);
+
+		clearDebugLog();
+		setDebugLogConfig(false, []);
+		resetDebugLogPersistenceForTests();
+		shareDebugLog.mockClear();
+		clearDebugLogAndFiles.mockClear();
+	});
+
+	afterEach(() => {
+		resetDebugLogPersistenceForTests();
+	});
+
+	test('should show the empty state when there are no entries', async () => {
+		render(<WrappedDebugLogScreen/>);
+
+		await waitFor(() => {
+			expect(screen.getByText(/No log entries yet/)).toBeTruthy();
+		});
+	});
+
+	test('should list existing entries', async () => {
+		setDebugLogConfig(true, ['tiles', 'lists.sync']);
+		debugLog('tiles').info('Tile zoom changed');
+		debugLog('lists.sync').info('Sync finished');
+
+		render(<WrappedDebugLogScreen/>);
+
+		await waitFor(() => {
+			expect(screen.getByText(/Tile zoom changed/)).toBeTruthy();
+			expect(screen.getByText(/Sync finished/)).toBeTruthy();
+		});
+	});
+
+	test('toggling a category chip off should hide that category\'s entries', async () => {
+		setDebugLogConfig(true, ['tiles', 'lists.sync']);
+		debugLog('tiles').info('Tile zoom changed');
+		debugLog('lists.sync').info('Sync finished');
+
+		render(<WrappedDebugLogScreen/>);
+
+		await waitFor(() => expect(screen.getByText(/Tile zoom changed/)).toBeTruthy());
+
+		fireEvent.press(screen.getByText('Note tiles'));
+
+		await waitFor(() => {
+			expect(screen.queryByText(/Tile zoom changed/)).toBeFalsy();
+			expect(screen.getByText(/Sync finished/)).toBeTruthy();
+		});
+	});
+});
diff --git a/packages/app-mobile/components/screens/DebugLogScreen.tsx b/packages/app-mobile/components/screens/DebugLogScreen.tsx
new file mode 100644
index 0000000..c1b9e10
--- /dev/null
+++ b/packages/app-mobile/components/screens/DebugLogScreen.tsx
@@ -0,0 +1,269 @@
+import * as React from 'react';
+
+import { FlatList, View, Text, StyleSheet, Platform, TouchableOpacity, NativeSyntheticEvent, NativeScrollEvent } from 'react-native';
+import { connect } from 'react-redux';
+import { _ } from '@joplin/lib/locale';
+import { themeStyle } from '../global-style';
+import { BaseScreenComponent } from '../base-screen';
+import ScreenHeader, { MenuOption } from '../ScreenHeader';
+import { AppState } from '../../utils/types';
+import { shareDebugLog, clearDebugLogAndFiles } from '../../utils/shareDebugLog';
+import {
+	DebugLogCategory, DebugLogEntry, debugLogCategories, debugLogEntries, formatDebugLogEntry,
+	onDebugLogChange,
+} from '../../utils/debugLog';
+
+interface Props {
+	themeId: number;
+	navigation: unknown;
+}
+
+interface State {
+	entries: DebugLogEntry[];
+	activeCategories: DebugLogCategory[]|null; // null: no filter, show every category
+	atBottom: boolean;
+}
+
+const categoryLabels: Record<DebugLogCategory, string> = {
+	'lists.store': _('Local database'),
+	'lists.relays': _('Relays'),
+	'lists.sync': _('Sync'),
+	'lists.nearby': _('Bluetooth'),
+	'lists.invite': _('Invites and links'),
+	'lists.ui': _('Screens'),
+	'tiles': _('Note tiles'),
+};
+
+export class DebugLogScreenComponent extends BaseScreenComponent<Props, State> {
+
+	private readonly menuOptions_: MenuOption[];
+	private styles_: Record<number, ReturnType<typeof StyleSheet.create>> = {};
+	private readonly listRef_ = React.createRef<FlatList>();
+	private unsubscribeDebugLog_: (()=> void)|null = null;
+
+	public static navigationOptions(): { header: null } {
+		return { header: null };
+	}
+
+	public constructor(props: Props) {
+		super(props);
+
+		this.state = {
+			entries: debugLogEntries(),
+			activeCategories: null,
+			atBottom: true,
+		};
+
+		this.menuOptions_ = [
+			{
+				title: _('Share'),
+				onPress: () => {
+					void this.onSharePress_();
+				},
+			},
+			{
+				title: _('Clear'),
+				onPress: () => {
+					void this.onClearPress_();
+				},
+			},
+		];
+	}
+
+	public override componentDidMount() {
+		this.unsubscribeDebugLog_ = onDebugLogChange(this.onDebugLogChange_);
+	}
+
+	public override componentWillUnmount() {
+		if (this.unsubscribeDebugLog_) this.unsubscribeDebugLog_();
+	}
+
+	private onDebugLogChange_ = () => {
+		this.setState({ entries: debugLogEntries() }, () => {
+			if (this.state.atBottom) {
+				// Wait for the FlatList to have laid out the new row before scrolling to it.
+				requestAnimationFrame(() => this.listRef_.current?.scrollToEnd({ animated: true }));
+			}
+		});
+	};
+
+	private onScroll_ = (event: NativeSyntheticEvent<NativeScrollEvent>) => {
+		const { layoutMeasurement, contentOffset, contentSize } = event.nativeEvent;
+		const distanceFromBottom = contentSize.height - layoutMeasurement.height - contentOffset.y;
+		this.setState({ atBottom: distanceFromBottom < 40 });
+	};
+
+	private toggleCategory_ = (category: DebugLogCategory) => {
+		this.setState(state => {
+			const current = state.activeCategories ?? [...debugLogCategories];
+			const isActive = current.includes(category);
+			let next = isActive ? current.filter(c => c !== category) : [...current, category];
+			// Selecting every category is the same as no filter -- and clearing the last one
+			// resets to "show everything" too, rather than leaving the list empty.
+			if (next.length === 0 || next.length === debugLogCategories.length) next = null;
+			return { activeCategories: next };
+		});
+	};
+
+	private filteredEntries(): DebugLogEntry[] {
+		const { activeCategories, entries } = this.state;
+		if (!activeCategories) return entries;
+		return entries.filter(entry => entry.separator || activeCategories.includes(entry.category));
+	}
+
+	private async onSharePress_() {
+		await shareDebugLog(this.state.activeCategories ?? undefined);
+	}
+
+	private async onClearPress_() {
+		await clearDebugLogAndFiles();
+	}
+
+	public styles() {
+		if (this.styles_[this.props.themeId]) return this.styles_[this.props.themeId];
+		this.styles_ = {};
+
+		const theme = themeStyle(this.props.themeId);
+
+		// eslint-disable-next-line @typescript-eslint/no-explicit-any -- Heterogeneous style entries (row text variants for warn/error/separator built off rowText)
+		const styles: Record<string, any> = {
+			row: {
+				paddingHorizontal: 8,
+				paddingVertical: 1,
+			},
+			rowText: {
+				fontSize: 11,
+				color: theme.color,
+			},
+			separatorText: {
+				fontSize: 11,
+				color: theme.colorFaded,
+				fontStyle: 'italic',
+				textAlign: 'center',
+				paddingVertical: 4,
+			},
+			filterRow: {
+				flexDirection: 'row',
+				flexWrap: 'wrap',
+				paddingHorizontal: 8,
+				paddingVertical: 6,
+				backgroundColor: theme.backgroundColor3,
+			},
+			chip: {
+				borderRadius: 12,
+				paddingHorizontal: 10,
+				paddingVertical: 4,
+				marginRight: 6,
+				marginBottom: 6,
+				borderWidth: 1,
+				borderColor: theme.dividerColor,
+			},
+			chipActive: {
+				backgroundColor: theme.selectedColor2,
+				borderColor: theme.selectedColor2,
+			},
+			chipText: {
+				fontSize: 12,
+				color: theme.color,
+			},
+			emptyText: {
+				color: theme.colorFaded,
+				textAlign: 'center',
+				marginTop: 20,
+			},
+		};
+
+		if (Platform.OS !== 'ios') {
+			// Crashes on iOS with error "Unrecognized font family 'monospace'" (see LogScreen.tsx).
+			styles.rowText.fontFamily = 'monospace';
+		}
+
+		styles.rowTextWarn = { ...styles.rowText, color: theme.colorWarn };
+		styles.rowTextError = { ...styles.rowText, color: theme.colorError };
+
+		this.styles_[this.props.themeId] = StyleSheet.create(styles);
+		return this.styles_[this.props.themeId];
+	}
+
+	private onRenderRow_ = ({ item }: { item: DebugLogEntry }) => {
+		const styles = this.styles();
+		if (item.separator) {
+			return (
+				<View style={styles.row}>
+					<Text style={styles.separatorText}>{item.message}</Text>
+				</View>
+			);
+		}
+
+		let textStyle = styles.rowText;
+		if (item.level === 'warn') textStyle = styles.rowTextWarn;
+		if (item.level === 'error') textStyle = styles.rowTextError;
+
+		return (
+			<View style={styles.row}>
+				<Text style={textStyle}>{formatDebugLogEntry(item)}</Text>
+			</View>
+		);
+	};
+
+	private renderFilterChips() {
+		const styles = this.styles();
+		const active = this.state.activeCategories;
+
+		return (
+			<View style={styles.filterRow}>
+				{debugLogCategories.map(category => {
+					const isActive = !active || active.includes(category);
+					return (
+						<TouchableOpacity
+							key={category}
+							style={[styles.chip, isActive ? styles.chipActive : null]}
+							onPress={() => this.toggleCategory_(category)}
+							accessibilityRole="button"
+							accessibilityLabel={categoryLabels[category]}
+						>
+							<Text style={styles.chipText}>{categoryLabels[category]}</Text>
+						</TouchableOpacity>
+					);
+				})}
+			</View>
+		);
+	}
+
+	public render() {
+		const styles = this.styles();
+		const entries = this.filteredEntries();
+
+		return (
+			<View style={this.rootStyle(this.props.themeId).root}>
+				<ScreenHeader
+					title={_('Test log')}
+					menuOptions={this.menuOptions_}
+				/>
+				{this.renderFilterChips()}
+				{entries.length ? (
+					<FlatList
+						ref={this.listRef_}
+						data={entries}
+						initialNumToRender={200}
+						renderItem={this.onRenderRow_}
+						keyExtractor={(item, index) => `${item.time}-${index}`}
+						onScroll={this.onScroll_}
+						scrollEventThrottle={200}
+					/>
+				) : (
+					<Text style={styles.emptyText}>{_('No log entries yet. Enable test logging in the settings and use the feature you want to test.')}</Text>
+				)}
+			</View>
+		);
+	}
+
+}
+
+const DebugLogScreen = connect((state: AppState) => {
+	return {
+		themeId: state.settings.theme,
+	};
+})(DebugLogScreenComponent);
+
+export default DebugLogScreen;
