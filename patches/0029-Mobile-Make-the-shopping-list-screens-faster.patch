diff --git a/packages/app-mobile/lists/ui/components/ItemTile.tsx b/packages/app-mobile/lists/ui/components/ItemTile.tsx
new file mode 100644
index 0000000..351fa86
--- /dev/null
+++ b/packages/app-mobile/lists/ui/components/ItemTile.tsx
@@ -0,0 +1,70 @@
+// One shopping-list tile, split out from ListScreen.tsx and wrapped in
+// React.memo (with a field-by-field comparator, see areEqual below) so that
+// re-rendering the grid after a store change only actually re-renders the
+// tiles whose own fields changed -- not all of them. See device-test
+// feedback: "re-rendering: store.onChange probably reloads all items ... and
+// re-renders every tile on each change".
+//
+// A plain identity comparator wouldn't be enough here: reload() in
+// ListScreen.tsx re-queries the DB and gets back fresh ItemRecord objects
+// (new references) for every item on every change, whether or not that
+// item's own fields actually changed.
+import * as React from 'react';
+import { Text, TouchableOpacity, View } from 'react-native';
+import { formatQty, REOPEN_UNDO_WINDOW_MS } from '../../core/qty';
+import { ItemRecord } from '../../core/types';
+
+type TileStylesheet = ReturnType<typeof import('react-native').StyleSheet.create>;
+
+interface ItemTileProps {
+	item: ItemRecord;
+	bought: boolean;
+	// Both come from useMemo() in ListScreen.tsx (see useStyles/useTileMetrics
+	// there), so they're stable references across re-renders that don't
+	// actually change the theme, window size or column count.
+	styles: TileStylesheet;
+	tileStyles: TileStylesheet;
+	onPress: (item: ItemRecord)=> void;
+	onLongPress: (item: ItemRecord)=> void;
+}
+
+const ItemTileComponent: React.FC<ItemTileProps> = ({ item, bought, styles, tileStyles, onPress, onLongPress }) => {
+	const qtyText = formatQty(item.qty);
+	// Once bought, the quantity is only shown while still inside the
+	// undo window (see core/qty.ts#epochForReopen) -- past it, re-opening
+	// the item would start a fresh (empty) quantity anyway, so showing the
+	// stale one here would be misleading.
+	const showQty = !!qtyText && (!bought || Date.now() - item.openT <= REOPEN_UNDO_WINDOW_MS);
+	return (
+		<TouchableOpacity
+			style={[tileStyles.tile, bought ? styles.tileBought : null]}
+			onPress={() => onPress(item)}
+			onLongPress={() => onLongPress(item)}
+		>
+			{item.icon ? (
+				<Text style={tileStyles.tileEmoji}>{item.icon}</Text>
+			) : (
+				<View style={[styles.letterCircle, tileStyles.letterCircle]}>
+					<Text style={[styles.letterCircleText, tileStyles.letterCircleText]}>{item.name.charAt(0).toUpperCase()}</Text>
+				</View>
+			)}
+			<Text style={tileStyles.tileName} numberOfLines={2} ellipsizeMode='tail'>{item.name}</Text>
+			{showQty && <Text style={tileStyles.tileQty} numberOfLines={1}>{qtyText}</Text>}
+			{!!item.detail && <Text style={tileStyles.tileDetail} numberOfLines={1}>{item.detail}</Text>}
+		</TouchableOpacity>
+	);
+};
+
+const areEqual = (prev: ItemTileProps, next: ItemTileProps): boolean => {
+	if (prev.bought !== next.bought) return false;
+	if (prev.styles !== next.styles || prev.tileStyles !== next.tileStyles) return false;
+	if (prev.onPress !== next.onPress || prev.onLongPress !== next.onLongPress) return false;
+	const a = prev.item, b = next.item;
+	if (a === b) return true;
+	return a.dTag === b.dTag && a.name === b.name && a.icon === b.icon && a.detail === b.detail
+		&& a.open === b.open && a.openT === b.openT && a.deleted === b.deleted
+		&& formatQty(a.qty) === formatQty(b.qty);
+};
+
+const ItemTile = React.memo(ItemTileComponent, areEqual);
+export default ItemTile;
diff --git a/packages/app-mobile/lists/ui/warmup.ts b/packages/app-mobile/lists/ui/warmup.ts
new file mode 100644
index 0000000..6960b92
--- /dev/null
+++ b/packages/app-mobile/lists/ui/warmup.ts
@@ -0,0 +1,59 @@
+// Warms up the shopping-list feature's cold paths a few seconds after app
+// start, so the first time someone actually opens a list, taps a suggestion
+// or adds an item isn't also the first time the lists DB opens, the catalog
+// index gets built or the signing library precomputes its tables -- see
+// device-test feedback: "first use is slow, then gets faster". Called once
+// from root.tsx, via InteractionManager.runAfterInteractions() plus a short
+// delay so it never competes with the app's own startup work.
+import { finalizeEvent, EventTemplate } from 'nostr-tools';
+import { generateKeyPair } from '../core/crypto';
+import { warmCatalogIndex } from '../core/normalize';
+import { getListsDatabase } from './listsRuntime';
+import { debugLog } from '../../utils/debugLog';
+
+const log = debugLog('lists.ui');
+
+const now = (): number => (typeof performance !== 'undefined' && typeof performance.now === 'function' ? performance.now() : Date.now());
+
+// A tick back to the JS event loop between steps, so a slow step here never
+// blocks the UI thread for one long chunk -- see the module doc comment.
+const yieldToUi = (): Promise<void> => new Promise(resolve => setTimeout(resolve, 0));
+
+// Signs one throwaway event with a freshly generated key, which is enough to
+// make noble-secp256k1 do its one-time precomputation (see
+// @noble/curves/secp256k1's schnorr signer) -- the actual event and key are
+// discarded immediately.
+const warmSigning = (): void => {
+	const key = generateKeyPair();
+	const template: EventTemplate = { kind: 1, tags: [], content: '', created_at: Math.floor(Date.now() / 1000) };
+	finalizeEvent(template, key.secretKey);
+};
+
+// Opens the lists DB and builds the catalog index unconditionally (both
+// cheap), but only warms signing if at least one list already exists --
+// nothing needs to sign an event yet for someone who has never used the
+// feature.
+const warmUpLists = async (): Promise<void> => {
+	const start = now();
+	try {
+		const db = await getListsDatabase();
+		await yieldToUi();
+
+		warmCatalogIndex();
+		await yieldToUi();
+
+		const lists = await db.lists();
+		let signedWarmup = false;
+		if (lists.length > 0) {
+			await yieldToUi();
+			warmSigning();
+			signedWarmup = true;
+		}
+
+		log.info('Warm-up finished', { ms: Math.round(now() - start), listCount: lists.length, signedWarmup });
+	} catch (error) {
+		log.warn('Warm-up failed', { error: String(error) });
+	}
+};
+
+export default warmUpLists;
