+
+const formatSince = (connectedAtMs: number): string => {
+	const seconds = Math.max(0, Math.round((Date.now() - connectedAtMs) / 1000));
+	if (seconds < 60) return _('%d s', seconds);
+	return _('%d min', Math.round(seconds / 60));
+};
+
+// Shown on a long press on NearbyStatusCircle: the devices currently
+// connected over Bluetooth for this list, per docs/KONZEPT.md section 3.
+const NearbyPeersModal: React.FC<Props> = ({ visible, transport, onClose }) => {
+	const [peers, setPeers] = useState<NearbyPeer[]>([]);
+
+	useEffect(() => {
+		if (!visible || !transport.peers) return undefined;
+		let cancelled = false;
+		const load = async () => {
+			const result = await transport.peers();
+			if (!cancelled) setPeers(result);
+		};
+		void load();
+		const interval = setInterval(() => { void load(); }, 2000);
+		return () => {
+			cancelled = true;
+			clearInterval(interval);
+		};
+	}, [visible, transport]);
