+++ b/packages/app-mobile/lists/nearby/nearbyManager.ts
@@ -0,0 +1,490 @@
+// Implements NearbyTransport (see ../sync/nearby.ts) on top of the BLE
+// protocol/session layer: discovers nearby devices advertising the same
+// list, connects, runs the handshake + sync via Session, keeps pushing local
+// changes to connected peers, and reports found/total for the UI's status
+// circle. See docs/KONZEPT.md section 3 and PROTOCOL.md.
+import { AppState, AppStateStatus, NativeEventSubscription } from 'react-native';
+import { VerifiedEvent } from 'nostr-tools';
+import { ListsDatabase } from '../core/db';
+import { ListsStore, itemRecordToPayload } from '../core/store';
+import { buildItemEvent, parseItemEvent } from '../core/events';
+import { hexToBytes } from '../core/crypto';
+import { ItemRecord, ListRecord } from '../core/types';
+import { NearbyPeerInfo, NearbyState, NearbyStateListener, NearbyTransport } from '../sync/nearby';
+import { ListsSync } from '../sync/listSync';
+import { debugLog } from '../../utils/debugLog';
+import { BleAdapterState, BleConnectedEvent, BleConnectionRole, BleDriver, getNativeBle, nativeBleAvailable } from './nativeBle';
+import { NEARBY_SERVICE_UUID, advertisingTokenMatches, deriveAdvertisingTokenHex } from './protocol';
+import { Session, SessionState } from './session';
+
+const log = debugLog('lists.nearby');
+
+export const TOKEN_ROTATION_MS = 15 * 60 * 1000;
+export const BACKGROUND_AUTO_OFF_MS = 5 * 60 * 1000;
+const BASE64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
+
+// React Native's `global.Buffer` isn't guaranteed on-device; base64 encode/
+// decode small byte arrays by hand rather than pull in a dependency.
+const bytesToBase64 = (bytes: Uint8Array): string => {
+	let out = '';
+	for (let i = 0; i < bytes.length; i += 3) {
+		const b0 = bytes[i], b1 = bytes[i + 1], b2 = bytes[i + 2];
+		const triple = (b0 << 16) | ((b1 ?? 0) << 8) | (b2 ?? 0);
+		out += BASE64_CHARS[(triple >> 18) & 63];
+		out += BASE64_CHARS[(triple >> 12) & 63];
+		out += i + 1 < bytes.length ? BASE64_CHARS[(triple >> 6) & 63] : '=';
+		out += i + 2 < bytes.length ? BASE64_CHARS[triple & 63] : '=';
+	}
+	return out;
+};
+
+const base64ToBytes = (base64: string): Uint8Array => {
+	const clean = base64.replace(/=+$/, '');
+	const bytes: number[] = [];
+	let buffer = 0;
+	let bits = 0;
+	for (const char of clean) {
+		const value = BASE64_CHARS.indexOf(char);
+		if (value === -1) continue;
+		buffer = (buffer << 6) | value;
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			bytes.push((buffer >> bits) & 0xff);
+		}
+	}
+	return Uint8Array.from(bytes);
+};
+
+const itemEventCreatedAt = (item: ItemRecord): number => {
+	const times = [item.openT, item.detailT, item.categoryT, item.deletedT].filter((t): t is number => t !== null);
+	const maxMs = times.length > 0 ? Math.max(...times) : Date.now();
+	return Math.floor(maxMs / 1000);
+};
+
+const itemMaxFieldTime = (item: ItemRecord): number =>
+	Math.max(item.openT, item.detailT ?? 0, item.categoryT ?? 0, item.iconT ?? 0, item.deletedT ?? 0);
+
+interface Connection {
+	session: Session;
+	role: BleConnectionRole;
+	peerPubkey: string | null;
+	rssi: number | null;
+	connectedAt: number;
+}
+
+// Best-effort reader for the setting owned by another agent's work
+// (builtInMetadata.ts / Setting.ts); Setting may not be initialized in tests
+// or very early app startup, so this never throws.
+const readAutoOffMinutes = (): number => {
+	try {
+		// eslint-disable-next-line @typescript-eslint/no-var-requires -- optional, avoids a hard dependency for lists/nearby's own tests
+		const Setting = require('@joplin/lib/models/Setting').default;
+		const value = Setting.value('lists.nearbyAutoOffMinutes');
+		return typeof value === 'number' && value > 0 ? value : 0;
+	} catch (error) {
+		return 0;
+	}
+};
+
+export interface NearbyManagerOptions {
+	ble?: BleDriver;
+	now?: ()=> number;
+}
+
+// One instance is enough for the whole app (see getNearbyManager() below): it
+// only ever syncs the single list currently open on screen, same as
+// UnavailableNearbyTransport did before it.
+export class NearbyManager implements NearbyTransport {
+	private db: ListsDatabase;
+	private store: ListsStore;
+	private ble: BleDriver;
+	private now: ()=> number;
+
+	private listeners = new Set<NearbyStateListener>();
+	private state: NearbyState = { mode: 'off', found: 0, total: 0 };
+
+	private listId: string | null = null;
+	private list: ListRecord | null = null;
+	private localPubkey: string | null = null;
+	private localDeviceName: string | undefined;
+	private localSecretKey: Uint8Array | null = null;
+	private contentKey: Uint8Array | null = null;
+	private connections = new Map<string, Connection>();
+
+	private tokenTimer: ReturnType<typeof setInterval> | null = null;
+	private autoOffTimer: ReturnType<typeof setTimeout> | null = null;
+	private backgroundTimer: ReturnType<typeof setTimeout> | null = null;
+	private appStateSub: NativeEventSubscription | null = null;
+	private storeChangeUnsub: (()=> void) | null = null;
+	private bleUnsubs: (()=> void)[] = [];
+	private starting = false;
+
+	public constructor(db: ListsDatabase, store: ListsStore, options: NearbyManagerOptions = {}) {
+		this.db = db;
+		this.store = store;
+		this.ble = options.ble ?? (nativeBleAvailable() ? getNativeBle() : (undefined as unknown as BleDriver));
+		this.now = options.now ?? (() => Date.now());
+	}
+
+	public isAvailable(): boolean {
+		return !!this.ble;
+	}
+
+	public onState(listener: NearbyStateListener): ()=> void {
+		this.listeners.add(listener);
+		listener(this.state);
+		return () => this.listeners.delete(listener);
+	}
+
+	private setState(patch: Partial<NearbyState>): void {
+		this.state = { ...this.state, ...patch };
+		for (const listener of this.listeners) listener(this.state);
+	}
+
+	public async start(listId: string): Promise<void> {
+		if (!this.isAvailable()) {
+			this.setState({ mode: 'unavailable', found: 0, total: 0 });
+			return;
+		}
+		if (this.starting || this.listId === listId) return;
+		if (this.listId) await this.stop();
+		this.starting = true;
+		try {
+			await this.doStart(listId);
+		} finally {
+			this.starting = false;
+		}
+	}
+
+	private async doStart(listId: string): Promise<void> {
+		const list = await this.db.list(listId);
+		if (!list || !list.contentKey) {
+			log.warn('Nearby: list has no content key yet, not starting', { listId: listId.slice(0, 8) });
+			return;
+		}
+		const identity = await this.db.deviceIdentity();
+		const adapterState = await this.ble.state();
+		if (adapterState !== 'on') {
+			log.info('Nearby: adapter not on, staying off', { adapterState });
+			this.setState({ mode: 'off', found: 0, total: 0 });
+			return;
+		}
+
+		this.listId = listId;
+		this.list = list;
+		this.localPubkey = identity.publicKey;
+		this.localDeviceName = identity.name;
+		this.localSecretKey = identity.secretKey;
+		this.contentKey = hexToBytes(list.contentKey);
+
+		const capabilities = await this.ble.isSupported();
+		const total = await this.activeMemberCount(listId);
+		this.setState({ mode: 'searching', found: 0, total });
+
+		this.wireBleEvents();
+		const tokenHex = deriveAdvertisingTokenHex(this.contentKey, this.now());
+		log.info('Nearby: starting', { listId: listId.slice(0, 8), codedPhy: capabilities.codedPhy });
+		await this.ble.startAdvertising(NEARBY_SERVICE_UUID, tokenHex, capabilities.codedPhy);
+		await this.ble.startScan(NEARBY_SERVICE_UUID, capabilities.codedPhy);
+
+		this.tokenTimer = setInterval(() => { void this.rotateToken(); }, TOKEN_ROTATION_MS);
+		this.storeChangeUnsub = this.store.onChange(() => { void this.onLocalChange(); });
+		this.appStateSub = AppState.addEventListener('change', (next: AppStateStatus) => this.onAppStateChange(next));
+		this.resetAutoOffTimer();
+	}
+
+	public async stop(): Promise<void> {
+		log.info('Nearby: stopping', { listId: this.listId?.slice(0, 8) });
+		for (const unsub of this.bleUnsubs) unsub();
+		this.bleUnsubs = [];
+		if (this.tokenTimer) { clearInterval(this.tokenTimer); this.tokenTimer = null; }
+		if (this.autoOffTimer) { clearTimeout(this.autoOffTimer); this.autoOffTimer = null; }
+		if (this.backgroundTimer) { clearTimeout(this.backgroundTimer); this.backgroundTimer = null; }
+		if (this.storeChangeUnsub) { this.storeChangeUnsub(); this.storeChangeUnsub = null; }
+		if (this.appStateSub) { this.appStateSub.remove(); this.appStateSub = null; }
+		for (const connection of this.connections.values()) connection.session.close('Nearby stopped');
+		this.connections.clear();
+		if (this.isAvailable()) {
+			try {
+				await this.ble.stopAll();
+			} catch (error) {
+				log.warn('Nearby: stopAll failed', { error: String(error) });
+			}
+		}
+		this.listId = null;
+		this.list = null;
+		this.contentKey = null;
+		this.setState({ mode: this.isAvailable() ? 'off' : 'unavailable', found: 0, total: 0 });
+	}
+
+	private async activeMemberCount(listId: string): Promise<number> {
+		const members = await this.db.members(listId);
+		return members.filter(m => !m.removedAt).length;
+	}
+
+	private async rotateToken(): Promise<void> {
+		if (!this.contentKey) return;
+		const tokenHex = deriveAdvertisingTokenHex(this.contentKey, this.now());
+		log.debug('Nearby: rotating advertising token');
+		try {
+			await this.ble.updateToken(tokenHex);
+		} catch (error) {
+			log.warn('Nearby: token rotation failed', { error: String(error) });
+		}
+	}
+
+	// --- BLE event wiring -------------------------------------------------
+
+	private wireBleEvents(): void {
+		this.bleUnsubs.push(this.ble.onScanResult(event => { void this.onScanResult(event.address, event.rssi, event.tokenHex); }));
+		this.bleUnsubs.push(this.ble.onConnected(event => { void this.onConnected(event); }));
+		this.bleUnsubs.push(this.ble.onDisconnected(event => this.onDisconnected(event.address, event.reason)));
+		this.bleUnsubs.push(this.ble.onFrame(event => { void this.onFrame(event.address, event.base64); }));
+		this.bleUnsubs.push(this.ble.onError(event => log.warn('Nearby native error', event)));
+		this.bleUnsubs.push(this.ble.onAdapterState(state => this.onAdapterState(state)));
+	}
+
+	private onAdapterState(state: BleAdapterState): void {
+		log.info('Nearby: adapter state changed', { state });
+		if (state !== 'on' && this.listId) void this.stop();
+	}
+
+	private async onScanResult(address: string, rssi: number, tokenHex: string): Promise<void> {
+		const existing = this.connections.get(address);
+		if (existing) { existing.rssi = rssi; return; }
+		if (!this.contentKey) return;
+		const matches = advertisingTokenMatches(this.contentKey, tokenHex, this.now());
+		log.debug('Nearby: scan result', { address: address.slice(0, 8), rssi, tokenMatches: matches });
+		if (!matches) return;
+		try {
+			await this.ble.connect(address);
+		} catch (error) {
+			log.warn('Nearby: connect failed', { address: address.slice(0, 8), error: String(error) });
+		}
+	}
+
+	private async onConnected(event: BleConnectedEvent): Promise<void> {
+		if (!this.listId || !this.contentKey || !this.localPubkey || !this.list) return;
+		if (this.connections.has(event.address)) {
+			// The native module reports frames and writes for a given address
+			// under one event stream regardless of which underlying link
+			// (central or peripheral) carries them -- see NearbyModule.kt -- so
+			// a second 'connected' event for an address we already have a
+			// session for (e.g. the peer connecting back to us right after we
+			// connected to it) isn't a new, independent channel from this
+			// module's point of view. Keep the existing session; starting a
+			// second one would desync the two sides' nonces mid-handshake.
+			log.debug('Nearby: extra connected event for an address already connected, ignoring', { address: event.address.slice(0, 8), role: event.role });
+			return;
+		}
+		log.info('Nearby: connected', { address: event.address.slice(0, 8), role: event.role, mtu: event.mtu });
+		const session = new Session(
+			{
+				listId: this.listId, localPubkey: this.localPubkey, localDeviceName: this.localDeviceName,
+				contentKey: this.contentKey, mtu: event.mtu, isOpenList: this.list.kind === 'open',
+			},
+			this.sessionCallbacks(event.address),
+		);
+		this.connections.set(event.address, { session, role: event.role, peerPubkey: null, rssi: null, connectedAt: this.now() });
+		session.start();
+	}
+
+	private onDisconnected(address: string, reason: string): void {
+		const connection = this.connections.get(address);
+		log.info('Nearby: disconnected', { address: address.slice(0, 8), reason });
+		if (connection) {
+			connection.session.close(reason);
+			this.connections.delete(address);
+		}
+		this.recomputeFound();
+	}
+
+	private async onFrame(address: string, base64: string): Promise<void> {
+		const connection = this.connections.get(address);
+		if (!connection) return;
+		await connection.session.onFrameBytes(base64ToBytes(base64));
+	}
+
+	// --- session callbacks --------------------------------------------
+
+	private sessionCallbacks(address: string) {
+		return {
+			sendFrame: async (bytes: Uint8Array) => { await this.ble.send(address, bytesToBase64(bytes)); },
+			isActiveMember: async (pubkey: string) => {
+				const members = await this.db.members(this.listId as string);
+				return members.some(m => m.pubkey === pubkey && !m.removedAt);
+			},
+			localSummary: async () => {
+				const items = await this.db.allItemsForSync(this.listId as string);
+				const directoryEvent = await this.latestDirectoryEvent();
+				return {
+					items: items.map(item => ({ dTag: item.dTag, maxFieldTime: itemMaxFieldTime(item) })),
+					directoryTime: directoryEvent?.created_at ?? 0,
+				};
+			},
+			buildLocalItemEvent: async (dTag: string): Promise<VerifiedEvent | null> => {
+				// eslint-disable-next-line no-console
+				const item = await this.db.item(this.listId as string, dTag);
+				if (!item || !this.contentKey || !this.localSecretKey) return null;
+				return buildItemEvent(this.localSecretKey, this.listId as string, dTag, this.contentKey, itemRecordToPayload(item), itemEventCreatedAt(item));
+			},
+			applyRemoteItemEvent: async (event: VerifiedEvent): Promise<boolean> => {
+				if (!this.contentKey) return false;
+				const members = await this.db.members(this.listId as string);
+				if (!members.some(m => m.pubkey === event.pubkey && !m.removedAt)) return false;
+				const dTagValue = event.tags.find(t => t[0] === 'd')?.[1];
+				if (!dTagValue) return false;
+				try {
+					const payload = parseItemEvent(event, this.contentKey);
+					await this.store.applyRemoteItem(this.listId as string, dTagValue, payload);
+					return true;
+				} catch (error) {
+					return false;
+				}
+			},
+			localDirectoryEvent: async () => this.latestDirectoryEvent(),
+			applyRemoteDirectoryEvent: async (event: VerifiedEvent): Promise<boolean> => {
+				try {
+					return await ListsSync.instance().applyIncomingDirectoryEvent(this.listId as string, event);
+				} catch (error) {
+					log.warn('Nearby: failed to apply incoming directory event', { error: String(error) });
+					return false;
+				}
+			},
+			acceptUnknownOpenListMember: this.list?.kind === 'open' ? async (pubkey: string, deviceName: string | undefined) => {
+				log.info('Nearby: accepting new open-list member seen only over Bluetooth (no internet join)', { pubkey: pubkey.slice(0, 8) });
+				await this.db.upsertMember({ listId: this.listId as string, pubkey, name: deviceName ?? null, role: 'member', since: this.now(), removedAt: null });
+			} : undefined,
+			onPeerIdentified: (peerPubkey: string) => this.onPeerIdentified(address, peerPubkey),
+			onStateChange: (_state: SessionState) => this.recomputeFound(),
+			onSyncComplete: (sent: number, received: number) => {
+				log.info('Nearby: session sync complete', { address: address.slice(0, 8), sent, received });
+				this.recomputeFound();
+			},
+			onClosed: (reason: string) => {
+				log.info('Nearby: session closed', { address: address.slice(0, 8), reason });
+				const connection = this.connections.get(address);
+				if (connection && connection.session.state === 'closed') {
+					this.connections.delete(address);
+					this.recomputeFound();
+				}
+			},
+		};
+	}
+
+	private async latestDirectoryEvent(): Promise<VerifiedEvent | null> {
+		if (!this.listId) return null;
+		try {
+			return await ListsSync.instance().latestDirectoryEvent(this.listId);
+		} catch (error) {
+			return null;
+		}
+	}
+
+	// Two devices that both scan and advertise can end up with two GATT
+	// connections to each other (one where we're central, one where we're
+	// peripheral). Once both hellos have identified the same peer pubkey,
+	// keep only the connection whose central side has the numerically
+	// smaller pubkey; drop the other. See PROTOCOL.md.
+	private onPeerIdentified(address: string, peerPubkey: string): void {
+		const connection = this.connections.get(address);
+		if (!connection || !this.localPubkey) return;
+		connection.peerPubkey = peerPubkey;
+		const duplicate = [...this.connections.entries()].find(([otherAddress, other]) => otherAddress !== address && other.peerPubkey === peerPubkey);
+		if (!duplicate) return;
+		const [otherAddress, otherConnection] = duplicate;
+		const centralPubkey = (c: Connection): string => (c.role === 'central' ? (this.localPubkey as string) : peerPubkey);
+		const dropAddress = centralPubkey(connection) < centralPubkey(otherConnection) ? otherAddress : address;
+		const dropConnection = this.connections.get(dropAddress);
+		if (!dropConnection) return;
+		log.info('Nearby: resolving duplicate connection', { peer: peerPubkey.slice(0, 8), dropping: dropAddress.slice(0, 8) });
+		dropConnection.session.close('Duplicate connection to same peer');
+		this.connections.delete(dropAddress);
+		void this.ble.disconnect(dropAddress);
+	}
+
+	public async peers(): Promise<NearbyPeerInfo[]> {
+		if (!this.listId) return [];
+		const members = await this.db.members(this.listId);
+		const result: NearbyPeerInfo[] = [];
+		for (const connection of this.connections.values()) {
+			if (!connection.peerPubkey) continue;
+			const member = members.find(m => m.pubkey === connection.peerPubkey);
+			result.push({ pubkey: connection.peerPubkey, name: member?.name ?? null, rssi: connection.rssi, connectedAt: connection.connectedAt });
+		}
+		return result;
+	}
+
+	private recomputeFound(): void {
+		let found = 0;
+		for (const connection of this.connections.values()) {
+			if (connection.session.state === 'active' || connection.session.state === 'syncing') found++;
+		}
+		if (found > 0) this.resetAutoOffTimer();
+		this.setState({ mode: found > 0 ? 'found' : 'searching', found });
+	}
+
+	// --- local push -----------------------------------------------------
+
+	private lastPendingSeen = new Set<string>();
+
+	private async onLocalChange(): Promise<void> {
+		if (!this.listId || this.connections.size === 0) return;
+		const pending = await this.store.pendingItems(this.listId);
+		for (const item of pending) {
+			if (this.lastPendingSeen.has(item.dTag) && !this.dirtyMoreRecently(item)) continue;
+			for (const connection of this.connections.values()) void connection.session.pushLocalChange(item.dTag);
+		}
+		this.lastPendingSeen = new Set(pending.map(i => i.dTag));
+		const directoryEvent = await this.latestDirectoryEvent();
+		if (directoryEvent && directoryEvent.created_at !== this.lastPushedDirectoryTime) {
+			this.lastPushedDirectoryTime = directoryEvent.created_at;
+			for (const connection of this.connections.values()) void connection.session.pushLocalDirectoryChange();
+		}
+	}
+
+	private lastPushedDirectoryTime = 0;
+
+	// Conservative: without a per-item last-pushed timestamp, a pending item
+	// already seen last time is pushed again too -- harmless (Session just
+	// sends its current state again) and simpler than tracking one.
+	private dirtyMoreRecently(_item: ItemRecord): boolean {
+		return true;
+	}
+
+	// --- lifecycle: auto-off ---------------------------------------------
+
+	private resetAutoOffTimer(): void {
+		if (this.autoOffTimer) clearTimeout(this.autoOffTimer);
+		const minutes = readAutoOffMinutes();
+		if (!minutes) { this.autoOffTimer = null; return; }
+		this.autoOffTimer = setTimeout(() => {
+			log.info('Nearby: auto-off after inactivity', { minutes });
+			void this.stop();
+		}, minutes * 60 * 1000);
+	}
+
+	private onAppStateChange(next: AppStateStatus): void {
+		if (!this.listId) return;
+		if (next === 'background' || next === 'inactive') {
+			if (this.backgroundTimer) clearTimeout(this.backgroundTimer);
+			this.backgroundTimer = setTimeout(() => {
+				log.info('Nearby: auto-off after being backgrounded');
+				void this.stop();
+			}, BACKGROUND_AUTO_OFF_MS);
+		} else if (next === 'active' && this.backgroundTimer) {
+			clearTimeout(this.backgroundTimer);
+			this.backgroundTimer = null;
+		}
+	}
+}
+
+let singleton: NearbyManager | null = null;
+
+// Lazily built process-wide instance, mirroring ListsSync.instance(). Reused
+// by lists/ui/syncApi.ts.
+export const getNearbyManager = (db: ListsDatabase, store: ListsStore): NearbyManager => {
+	if (!singleton) singleton = new NearbyManager(db, store);
+	return singleton;
+};
diff --git a/packages/app-mobile/lists/nearby/protocol.test.ts b/packages/app-mobile/lists/nearby/protocol.test.ts
new file mode 100644
index 0000000..40fafcc
--- /dev/null
+++ b/packages/app-mobile/lists/nearby/protocol.test.ts
@@ -0,0 +1,122 @@
+import { randomBytes } from '../core/crypto';
+import {
+	advertisingTokenMatches, advertisingWindowIndex, decodeFrame, deriveAdvertisingToken, deriveAdvertisingTokenHex,
+	deriveProof, encodeFrame, FrameReassembler, FrameType, fragmentMessage, maxFramePayloadLength,
+	ADV_TOKEN_WINDOW_MS, FRAME_HEADER_LENGTH, MessageIdAllocator, REASSEMBLY_TIMEOUT_MS,
+} from './protocol';
+
+describe('lists/nearby/protocol', () => {
+	test('encodeFrame/decodeFrame round-trip', () => {
+		const frame = { type: FrameType.Summary, messageId: 42, index: 1, count: 3, payload: new Uint8Array([1, 2, 3, 255]) };
+		const decoded = decodeFrame(encodeFrame(frame));
+		expect(decoded).toEqual(frame);
+	});
+
+	test('decodeFrame rejects a frame shorter than the header', () => {
+		expect(() => decodeFrame(new Uint8Array(FRAME_HEADER_LENGTH - 1))).toThrow();
+	});
+
+	test('maxFramePayloadLength accounts for ATT overhead and the frame header', () => {
+		expect(maxFramePayloadLength(23)).toBe(23 - 3 - FRAME_HEADER_LENGTH);
+		expect(maxFramePayloadLength(3)).toBe(1); // never goes to zero or below
+	});
+
+	test('fragmentMessage splits a large payload into MTU-sized frames that reassemble to the original value', () => {
+		const value = { items: Array.from({ length: 50 }, (_, i) => ({ dTag: `item-${i}`, maxFieldTime: i })) };
+		const frames = fragmentMessage(FrameType.Summary, 7, value, 40);
+		expect(frames.length).toBeGreaterThan(1);
+		expect(frames.every(f => f.messageId === 7 && f.count === frames.length)).toBe(true);
+
+		const reassembler = new FrameReassembler();
+		let result = null;
+		for (const frame of frames) result = reassembler.addFrame(frame) ?? result;
+		expect(result).toEqual({ type: FrameType.Summary, value });
+	});
+
+	test('fragmentMessage fits a small payload into a single frame', () => {
+		const frames = fragmentMessage(FrameType.Heartbeat, 1, {}, 517);
+		expect(frames).toHaveLength(1);
+		expect(frames[0].index).toBe(0);
+		expect(frames[0].count).toBe(1);
+	});
+
+	test('frameReassembler reassembles out-of-order fragments', () => {
+		const frames = fragmentMessage(FrameType.Directory, 3, { text: 'x'.repeat(200) }, 30);
+		expect(frames.length).toBeGreaterThan(2);
+		const reassembler = new FrameReassembler();
+		const shuffled = [...frames].reverse();
+		let result = null;
+		for (const frame of shuffled) result = reassembler.addFrame(frame) ?? result;
+		expect(result?.value).toEqual({ text: 'x'.repeat(200) });
+	});
+
+	test('frameReassembler drops a partial message after the reassembly timeout', () => {
+		const frames = fragmentMessage(FrameType.Event, 9, { a: 1, b: 2, c: 3, d: 4, e: 5 }, 20);
+		expect(frames.length).toBeGreaterThan(1);
+		const reassembler = new FrameReassembler();
+		let now = 1000;
+		expect(reassembler.addFrame(frames[0], now)).toBeNull();
+		now += REASSEMBLY_TIMEOUT_MS + 1;
+		// The rest of the fragments arrive after the first one's already stale:
+		// they start a fresh (still incomplete) message instead of completing it.
+		for (let i = 1; i < frames.length - 1; i++) expect(reassembler.addFrame(frames[i], now)).toBeNull();
+		expect(reassembler.addFrame(frames[frames.length - 1], now)).toBeNull();
+	});
+
+	test('messageIdAllocator hands out increasing, non-zero ids that wrap around', () => {
+		const allocator = new MessageIdAllocator();
+		const first = allocator.allocate();
+		const second = allocator.allocate();
+		expect(first).toBeGreaterThan(0);
+		expect(second).toBe(first + 1);
+	});
+
+	test('advertisingWindowIndex groups timestamps into 15-minute windows', () => {
+		const t0 = advertisingWindowIndex(0);
+		expect(advertisingWindowIndex(ADV_TOKEN_WINDOW_MS - 1)).toBe(t0);
+		expect(advertisingWindowIndex(ADV_TOKEN_WINDOW_MS)).toBe(t0 + 1);
+	});
+
+	test('advertisingTokenMatches accepts the current and previous window, rejects others', () => {
+		const contentKey = randomBytes(32);
+		const now = 10 * ADV_TOKEN_WINDOW_MS + 1000;
+		const currentToken = deriveAdvertisingTokenHex(contentKey, now);
+		const previousToken = deriveAdvertisingTokenHex(contentKey, now - ADV_TOKEN_WINDOW_MS);
+		const futureToken = deriveAdvertisingTokenHex(contentKey, now + 2 * ADV_TOKEN_WINDOW_MS);
+
+		expect(advertisingTokenMatches(contentKey, currentToken, now)).toBe(true);
+		expect(advertisingTokenMatches(contentKey, previousToken, now)).toBe(true);
+		expect(advertisingTokenMatches(contentKey, futureToken, now)).toBe(false);
+	});
+
+	test('advertisingTokenMatches rejects a token derived from a different content key', () => {
+		const now = Date.now();
+		const token = deriveAdvertisingTokenHex(randomBytes(32), now);
+		expect(advertisingTokenMatches(randomBytes(32), token, now)).toBe(false);
+	});
+
+	test('deriveAdvertisingToken is deterministic for the same window', () => {
+		const contentKey = randomBytes(32);
+		const window = advertisingWindowIndex(Date.now());
+		expect(deriveAdvertisingToken(contentKey, window)).toEqual(deriveAdvertisingToken(contentKey, window));
+	});
+
+	test('deriveProof: the verifier recomputes the same value the signer sent', () => {
+		const contentKey = randomBytes(32);
+		const pubkeyA = 'aa'.repeat(32);
+		const nonceA = 'nonce-a';
+		const nonceB = 'nonce-b';
+		// A signs from its own point of view: peer's nonce (B's), then its own.
+		const proofFromA = deriveProof(contentKey, pubkeyA, nonceB, nonceA);
+		// B verifies by recomputing with A's identity and A's view of the nonces.
+		const recomputedByB = deriveProof(contentKey, pubkeyA, nonceB, nonceA);
+		expect(recomputedByB).toBe(proofFromA);
+	});
+
+	test('deriveProof differs for a different content key or swapped nonces', () => {
+		const contentKey = randomBytes(32);
+		const base = deriveProof(contentKey, 'aa'.repeat(32), 'n1', 'n2');
+		expect(deriveProof(randomBytes(32), 'aa'.repeat(32), 'n1', 'n2')).not.toBe(base);
+		expect(deriveProof(contentKey, 'aa'.repeat(32), 'n2', 'n1')).not.toBe(base);
+	});
+});
diff --git a/packages/app-mobile/lists/nearby/protocol.ts b/packages/app-mobile/lists/nearby/protocol.ts
new file mode 100644
index 0000000..40490d3
--- /dev/null
+++ b/packages/app-mobile/lists/nearby/protocol.ts
@@ -0,0 +1,233 @@
+// Nearby (Bluetooth LE) sync protocol: message framing, fragmentation,
+// reassembly and handshake cryptography. Pure and unit-testable -- no BLE or
+// other I/O here. See PROTOCOL.md for the full wire-format writeup and
+// docs/KONZEPT.md section 3 for the feature this implements.
+
+import { bytesToHex, hmacSha256 } from '../core/crypto';
+
+// Newly generated for this feature; never reused elsewhere. 128-bit UUID used
+// both as the GATT service UUID and as the BLE advertisement's service UUID.
+export const NEARBY_SERVICE_UUID = 'd7a1e2b0-5f3c-4a9e-8b1d-6c2f9e4a7b3d';
+
+// Characteristic UUIDs under NEARBY_SERVICE_UUID. `rx`: central -> peripheral
+// (write). `tx`: peripheral -> central (notify).
+export const NEARBY_RX_CHARACTERISTIC_UUID = 'd7a1e2b1-5f3c-4a9e-8b1d-6c2f9e4a7b3d';
+export const NEARBY_TX_CHARACTERISTIC_UUID = 'd7a1e2b2-5f3c-4a9e-8b1d-6c2f9e4a7b3d';
+export const NEARBY_CCCD_UUID = '00002902-0000-1000-8000-00805f9b34fb';
+
+// --- advertising token -------------------------------------------------
+
+export const ADV_TOKEN_WINDOW_MS = 15 * 60 * 1000;
+export const ADV_TOKEN_LENGTH = 8;
+
+export const advertisingWindowIndex = (nowMs: number): number => Math.floor(nowMs / ADV_TOKEN_WINDOW_MS);
+
+// First 8 bytes of HMAC-SHA256(contentKey, 'adv' || windowIndex). Rotates
+// every 15 minutes so a passive observer can't track a list across scans.
+export const deriveAdvertisingToken = (contentKey: Uint8Array, windowIndex: number): Uint8Array =>
+	hmacSha256(contentKey, `adv${windowIndex}`).slice(0, ADV_TOKEN_LENGTH);
+
+export const deriveAdvertisingTokenHex = (contentKey: Uint8Array, nowMs: number = Date.now()): string =>
+	bytesToHex(deriveAdvertisingToken(contentKey, advertisingWindowIndex(nowMs)));
+
+// Whether a scanned token could plausibly be this list's, tolerating the
+// current window and the previous one (clock skew / a scan landing just
+// after a rotation on the advertiser's side but before ours).
+export const advertisingTokenMatches = (contentKey: Uint8Array, tokenHex: string, nowMs: number = Date.now()): boolean => {
+	const normalized = tokenHex.toLowerCase();
+	const currentWindow = advertisingWindowIndex(nowMs);
+	for (const window of [currentWindow, currentWindow - 1]) {
+		if (bytesToHex(deriveAdvertisingToken(contentKey, window)) === normalized) return true;
+	}
+	return false;
+};
+
+// --- handshake proof -----------------------------------------------------
+
+// HMAC(contentKey, 'proof' || signerPubkey || nonceOfPeer || nonceOfSigner),
+// always computed from the signer's point of view: `nonceOfPeer` is the
+// nonce the signer received from the other side, `nonceOfSigner` is the
+// nonce the signer generated itself. Verifying a received proof means
+// recomputing this same value with the signer's identity substituted in --
+// see session.ts.
+export const deriveProof = (contentKey: Uint8Array, signerPubkey: string, nonceOfPeer: string, nonceOfSigner: string): string =>
+	bytesToHex(hmacSha256(contentKey, `proof${signerPubkey}${nonceOfPeer}${nonceOfSigner}`));
+
+// --- frames ----------------------------------------------------------
+
+export enum FrameType {
+	Hello = 1,
+	Proof = 2,
+	Summary = 3,
+	Event = 4,
+	Directory = 5,
+	Heartbeat = 6,
+	Done = 7,
+	Bye = 8,
+}
+
+export interface Frame {
+	type: FrameType;
+	// Identifies one logical (possibly fragmented) message; wraps around.
+	messageId: number;
+	// 0-based fragment index within the message.
+	index: number;
+	// Total number of fragments in the message.
+	count: number;
+	payload: Uint8Array;
+}
+
+// 1 byte type | 2 byte message id | 2 byte index | 2 byte count.
+export const FRAME_HEADER_LENGTH = 7;
+// GATT ATT overhead subtracted from the negotiated MTU to get the usable
+// payload size for a single write/notify.
+export const ATT_OVERHEAD = 3;
+
+export const maxFramePayloadLength = (mtu: number): number => Math.max(1, mtu - ATT_OVERHEAD - FRAME_HEADER_LENGTH);
+
+export const encodeFrame = (frame: Frame): Uint8Array => {
+	if (frame.type < 0 || frame.type > 0xff) throw new Error(`Invalid frame type: ${frame.type}`);
+	const out = new Uint8Array(FRAME_HEADER_LENGTH + frame.payload.length);
+	const view = new DataView(out.buffer);
+	view.setUint8(0, frame.type);
+	view.setUint16(1, frame.messageId, false);
+	view.setUint16(3, frame.index, false);
+	view.setUint16(5, frame.count, false);
+	out.set(frame.payload, FRAME_HEADER_LENGTH);
+	return out;
+};
+
+export const decodeFrame = (bytes: Uint8Array): Frame => {
+	if (bytes.length < FRAME_HEADER_LENGTH) throw new Error('Frame is shorter than the header');
+	const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+	return {
+		type: view.getUint8(0),
+		messageId: view.getUint16(1, false),
+		index: view.getUint16(3, false),
+		count: view.getUint16(5, false),
+		payload: bytes.slice(FRAME_HEADER_LENGTH),
+	};
+};
+
+// Message ids only need to be unique among a session's currently in-flight
+// (unacknowledged/unreassembled) messages, not globally -- a small rolling
+// counter per session is enough. 0 is avoided so it's never mistaken for an
+// unset field.
+export class MessageIdAllocator {
+	private next = 1;
+
+	public allocate(): number {
+		const id = this.next;
+		this.next = this.next >= 0xffff ? 1 : this.next + 1;
+		return id;
+	}
+}
+
+// Splits a JSON-serializable value into one or more frames of the given
+// type/message id, sized to fit the given MTU.
+export const fragmentMessage = (type: FrameType, messageId: number, value: unknown, mtu: number): Frame[] => {
+	const bytes = new TextEncoder().encode(JSON.stringify(value));
+	const chunkSize = maxFramePayloadLength(mtu);
+	const count = Math.max(1, Math.ceil(bytes.length / chunkSize));
+	const frames: Frame[] = [];
+	for (let i = 0; i < count; i++) {
+		frames.push({ type, messageId, index: i, count, payload: bytes.slice(i * chunkSize, (i + 1) * chunkSize) });
+	}
+	return frames;
+};
+
+// --- reassembly --------------------------------------------------------
+
+export const REASSEMBLY_TIMEOUT_MS = 10 * 1000;
+
+interface PendingMessage {
+	type: FrameType;
+	count: number;
+	chunks: (Uint8Array | undefined)[];
+	received: number;
+	firstSeenAtMs: number;
+}
+
+export interface ReassembledMessage {
+	type: FrameType;
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- caller knows the shape for each FrameType
+	value: any;
+}
+
+// Reassembles fragmented messages for one connection. Partial messages that
+// haven't completed within REASSEMBLY_TIMEOUT_MS are dropped (their frames,
+// if they ever arrive, start a fresh message under the same id).
+export class FrameReassembler {
+	private pending = new Map<number, PendingMessage>();
+
+	public addFrame(frame: Frame, nowMs: number = Date.now()): ReassembledMessage | null {
+		this.expireStale(nowMs);
+
+		let pending = this.pending.get(frame.messageId);
+		if (!pending || pending.type !== frame.type) {
+			pending = { type: frame.type, count: frame.count, chunks: new Array(frame.count), received: 0, firstSeenAtMs: nowMs };
+			this.pending.set(frame.messageId, pending);
+		}
+		if (frame.index >= pending.chunks.length) return null; // malformed; ignore
+		if (pending.chunks[frame.index] === undefined) {
+			pending.chunks[frame.index] = frame.payload;
+			pending.received++;
+		}
+		if (pending.received < pending.count) return null;
+
+		this.pending.delete(frame.messageId);
+		let total = 0;
+		for (const chunk of pending.chunks) total += chunk?.length ?? 0;
+		const combined = new Uint8Array(total);
+		let offset = 0;
+		for (const chunk of pending.chunks) {
+			if (!chunk) continue;
+			combined.set(chunk, offset);
+			offset += chunk.length;
+		}
+		const text = new TextDecoder().decode(combined);
+		return { type: pending.type, value: JSON.parse(text) };
+	}
+
+	private expireStale(nowMs: number): void {
+		for (const [id, message] of this.pending) {
+			if (nowMs - message.firstSeenAtMs > REASSEMBLY_TIMEOUT_MS) this.pending.delete(id);
+		}
+	}
+
+	public reset(): void {
+		this.pending.clear();
+	}
+}
+
+// --- message payload shapes ---------------------------------------------
+
+export const PROTOCOL_VERSION = 1;
+
+export interface HelloMessage {
+	v: number;
+	listId: string;
+	pubkey: string;
+	nonce: string;
+	// Present only when the sender doesn't yet have a directory entry for
+	// itself (fresh QR-code join to an open list, no internet yet) -- lets
+	// the responder decide whether the "join without internet" path applies.
+	// See docs/KONZEPT.md section 3 and PROTOCOL.md.
+	deviceName?: string;
+}
+
+export interface ProofMessage {
+	proof: string;
+}
+
+export interface SummaryItemEntry {
+	dTag: string;
+	maxFieldTime: number;
+}
+
+export interface SummaryMessage {
+	items: SummaryItemEntry[];
+	// Directory event timestamp (created_at, seconds) this device currently
+	// has, or 0 if none.
+	directoryTime: number;
+}
