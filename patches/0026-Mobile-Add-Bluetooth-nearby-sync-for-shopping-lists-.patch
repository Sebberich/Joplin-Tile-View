+import { VerifiedEvent } from 'nostr-tools';
+import { randomBytes } from '../core/crypto';
+import { Session, SessionCallbacks, SessionOptions, SessionState } from './session';
+
+interface FakeMember {
+	pubkey: string;
+	active: boolean;
+}
+
+interface Harness {
+	session: Session;
+	events: VerifiedEvent[];
+	receivedEvents: VerifiedEvent[];
+	closedReason: string | null;
+	syncResult: { sent: number; received: number } | null;
+	states: SessionState[];
+}
+
+const makeItemEvent = (dTag: string, pubkey: string, createdAt: number): VerifiedEvent => ({
+	kind: 30078, tags: [['d', dTag]], content: '', created_at: createdAt, pubkey, id: `${dTag}-${pubkey}-${createdAt}`, sig: 'sig',
+} as VerifiedEvent);
+
+const makeHarness = (
+	options: SessionOptions,
+	members: FakeMember[],
+	localItems: { dTag: string; maxFieldTime: number }[],
+	sendTo: (bytes: Uint8Array)=> Promise<void>,
+): Harness => {
+	const harness: Harness = { session: null as unknown as Session, events: [], receivedEvents: [], closedReason: null, syncResult: null, states: [] };
+	const callbacks: SessionCallbacks = {
+		sendFrame: sendTo,
+		isActiveMember: async pubkey => members.some(m => m.pubkey === pubkey && m.active),
+		localSummary: async () => ({ items: localItems, directoryTime: 0 }),
+		buildLocalItemEvent: async dTag => {
+			const item = localItems.find(i => i.dTag === dTag);
+			if (!item) return null;
+			const event = makeItemEvent(dTag, options.localPubkey, item.maxFieldTime);
+			harness.events.push(event);
+			return event;
+		},
+		applyRemoteItemEvent: async event => { harness.receivedEvents.push(event); return true; },
+		localDirectoryEvent: async () => null,
+		applyRemoteDirectoryEvent: async () => false,
+		onStateChange: state => harness.states.push(state),
+		onSyncComplete: (sent, received) => { harness.syncResult = { sent, received }; },
+		onClosed: reason => { harness.closedReason = reason; },
+	};
+	harness.session = new Session(options, callbacks);
+	return harness;
+};
+
+const CONTENT_KEY = randomBytes(32);
+const PUBKEY_A = 'a'.repeat(64);
+const PUBKEY_B = 'b'.repeat(64);
+
+const baseOptions = (localPubkey: string): SessionOptions => ({
+	listId: 'list-1', localPubkey, contentKey: CONTENT_KEY, mtu: 40, isOpenList: false,
+});
+
+describe('lists/nearby/session', () => {
+	test('handshake succeeds and both sides exchange their newer items', async () => {
+		const queueAtoB: Uint8Array[] = [];
+		const queueBtoA: Uint8Array[] = [];
+
+		const a = makeHarness(baseOptions(PUBKEY_A), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[{ dTag: 'milk', maxFieldTime: 100 }], async bytes => { queueAtoB.push(bytes); });
+		const b = makeHarness(baseOptions(PUBKEY_B), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[{ dTag: 'bread', maxFieldTime: 50 }], async bytes => { queueBtoA.push(bytes); });
+
+		a.session.start();
+		b.session.start();
+
+		for (let i = 0; i < 20 && (queueAtoB.length || queueBtoA.length); i++) {
+			while (queueAtoB.length) await b.session.onFrameBytes(queueAtoB.shift() as Uint8Array);
+			while (queueBtoA.length) await a.session.onFrameBytes(queueBtoA.shift() as Uint8Array);
+		}
+
+		expect(a.session.state).toBe('active');
+		expect(b.session.state).toBe('active');
+		expect(a.session.peerPubkey).toBe(PUBKEY_B);
+		expect(b.session.peerPubkey).toBe(PUBKEY_A);
+		// A has 'milk' which B doesn't have: A sends it, B receives it.
+		expect(b.receivedEvents.map(e => e.tags[0][1])).toContain('milk');
+		// B has 'bread' which A doesn't have: B sends it, A receives it.
+		expect(a.receivedEvents.map(e => e.tags[0][1])).toContain('bread');
+		expect(a.syncResult).not.toBeNull();
+		expect(b.syncResult).not.toBeNull();
+		a.session.close('test done');
+		b.session.close('test done');
+	});
+
+	test('a wrong content key fails the proof check and the session is closed', async () => {
+		const queueAtoB: Uint8Array[] = [];
+		const queueBtoA: Uint8Array[] = [];
+		const a = makeHarness(baseOptions(PUBKEY_A), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[], async bytes => { queueAtoB.push(bytes); });
+		const wrongKeyOptions = { ...baseOptions(PUBKEY_B), contentKey: randomBytes(32) };
+		const b = makeHarness(wrongKeyOptions, [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[], async bytes => { queueBtoA.push(bytes); });
+
+		a.session.start();
+		b.session.start();
+		for (let i = 0; i < 10 && (queueAtoB.length || queueBtoA.length); i++) {
+			while (queueAtoB.length) await b.session.onFrameBytes(queueAtoB.shift() as Uint8Array);
+			while (queueBtoA.length) await a.session.onFrameBytes(queueBtoA.shift() as Uint8Array);
+		}
+
+		expect(a.session.state).toBe('closed');
+		expect(b.session.state).toBe('closed');
+	});
+
+	test('a peer that is not a directory member is rejected after a correct proof', async () => {
+		const queueAtoB: Uint8Array[] = [];
+		const queueBtoA: Uint8Array[] = [];
+		const a = makeHarness(baseOptions(PUBKEY_A), [{ pubkey: PUBKEY_A, active: true }], // B is not a member here
+			[], async bytes => { queueAtoB.push(bytes); });
+		const b = makeHarness(baseOptions(PUBKEY_B), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[], async bytes => { queueBtoA.push(bytes); });
+
+		a.session.start();
+		b.session.start();
+		for (let i = 0; i < 10 && (queueAtoB.length || queueBtoA.length); i++) {
+			while (queueAtoB.length) await b.session.onFrameBytes(queueAtoB.shift() as Uint8Array);
+			while (queueBtoA.length) await a.session.onFrameBytes(queueBtoA.shift() as Uint8Array);
+		}
+
+		expect(a.session.state).toBe('closed');
+	});
+
+	test('after the initial sync, pushLocalChange sends a single item immediately', async () => {
+		const queueAtoB: Uint8Array[] = [];
+		const queueBtoA: Uint8Array[] = [];
+		const a = makeHarness(baseOptions(PUBKEY_A), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			[], async bytes => { queueAtoB.push(bytes); });
+		const bItems: { dTag: string; maxFieldTime: number }[] = [];
+		const b = makeHarness(baseOptions(PUBKEY_B), [{ pubkey: PUBKEY_A, active: true }, { pubkey: PUBKEY_B, active: true }],
+			bItems, async bytes => { queueBtoA.push(bytes); });
+
+		a.session.start();
+		b.session.start();
+		for (let i = 0; i < 10 && (queueAtoB.length || queueBtoA.length); i++) {
+			while (queueAtoB.length) await b.session.onFrameBytes(queueAtoB.shift() as Uint8Array);
+			while (queueBtoA.length) await a.session.onFrameBytes(queueBtoA.shift() as Uint8Array);
+		}
+		expect(a.session.state).toBe('active');
+
+		bItems.push({ dTag: 'eggs', maxFieldTime: 999 });
+		await b.session.pushLocalChange('eggs');
+		while (queueBtoA.length) await a.session.onFrameBytes(queueBtoA.shift() as Uint8Array);
+
+		expect(a.receivedEvents.map(e => e.tags[0][1])).toContain('eggs');
+		a.session.close('test done');
+		b.session.close('test done');
+	});
+
+	test('close() is idempotent and reports the given reason once', () => {
+		const a = makeHarness(baseOptions(PUBKEY_A), [], [], async () => {});
+		a.session.close('first');
+		a.session.close('second');
+		expect(a.closedReason).toBe('first');
+		expect(a.session.state).toBe('closed');
+	});
+});
