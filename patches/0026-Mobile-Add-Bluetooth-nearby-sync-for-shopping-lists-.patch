@@ -0,0 +1,161 @@
+// Thin wrapper around the native `TilesNearby` module (see
+// android/app/src/main/java/net/cozic/joplin/nearby/NearbyModule.kt) and its
+// NativeEventEmitter events. All BLE logic (protocol, sessions, peer
+// bookkeeping) lives in TS; this file only translates to/from the native
+// bridge, so nearbyManager.ts can be driven either by this or by
+// testing/fakeBle.ts under the same BleDriver interface.
+import { NativeEventEmitter, NativeModules, Platform } from 'react-native';
+
+export interface BleCapabilities {
+	ble: boolean;
+	peripheral: boolean;
+	codedPhy: boolean;
+}
+
+export type BleAdapterState = 'on' | 'off' | 'unauthorized' | 'unsupported';
+export type BleConnectionRole = 'central' | 'peripheral';
+
+export interface BleScanResult {
+	address: string;
+	rssi: number;
+	tokenHex: string;
+}
+
+export interface BleConnectedEvent {
+	address: string;
+	mtu: number;
+	role: BleConnectionRole;
+}
+
+export interface BleDisconnectedEvent {
+	address: string;
+	reason: string;
+}
+
+export interface BleFrameEvent {
+	address: string;
+	base64: string;
+}
+
+export interface BleErrorEvent {
+	code: string;
+	message: string;
+}
+
+// The subset of native calls/events nearbyManager.ts needs. Implemented by
+// both NativeBle (real device) and testing/fakeBle.ts (Jest).
+export interface BleDriver {
+	isSupported(): Promise<BleCapabilities>;
+	state(): Promise<BleAdapterState>;
+	startAdvertising(serviceUuid: string, tokenHex: string, useCodedPhy: boolean): Promise<void>;
+	updateToken(tokenHex: string): Promise<void>;
+	stopAdvertising(): Promise<void>;
+	startScan(serviceUuid: string, useCodedPhy: boolean): Promise<void>;
+	stopScan(): Promise<void>;
+	connect(address: string): Promise<void>;
+	send(address: string, base64: string): Promise<void>;
+	disconnect(address: string): Promise<void>;
+	stopAll(): Promise<void>;
+	onScanResult(listener: (event: BleScanResult)=> void): ()=> void;
+	onConnected(listener: (event: BleConnectedEvent)=> void): ()=> void;
+	onDisconnected(listener: (event: BleDisconnectedEvent)=> void): ()=> void;
+	onFrame(listener: (event: BleFrameEvent)=> void): ()=> void;
+	onError(listener: (event: BleErrorEvent)=> void): ()=> void;
+	onAdapterState(listener: (state: BleAdapterState)=> void): ()=> void;
+}
+
+// True when the native module is linked in this build (Android only -- iOS
+// has no TilesNearby module yet, see PROTOCOL.md).
+export const nativeBleAvailable = (): boolean => Platform.OS === 'android' && !!NativeModules.TilesNearby;
+
+class NativeBle implements BleDriver {
+	private readonly emitter = new NativeEventEmitter(NativeModules.TilesNearby);
+
+	private get native() {
+		return NativeModules.TilesNearby;
+	}
+
+	public isSupported(): Promise<BleCapabilities> {
+		return this.native.isSupported();
+	}
+
+	public state(): Promise<BleAdapterState> {
+		return this.native.state();
+	}
+
+	public startAdvertising(serviceUuid: string, tokenHex: string, useCodedPhy: boolean): Promise<void> {
+		return this.native.startAdvertising(serviceUuid, tokenHex, useCodedPhy);
+	}
+
+	public updateToken(tokenHex: string): Promise<void> {
+		return this.native.updateToken(tokenHex);
+	}
+
+	public stopAdvertising(): Promise<void> {
+		return this.native.stopAdvertising();
+	}
+
+	public startScan(serviceUuid: string, useCodedPhy: boolean): Promise<void> {
+		return this.native.startScan(serviceUuid, useCodedPhy);
+	}
+
+	public stopScan(): Promise<void> {
+		return this.native.stopScan();
+	}
+
+	public connect(address: string): Promise<void> {
+		return this.native.connect(address);
+	}
+
+	public send(address: string, base64: string): Promise<void> {
+		return this.native.send(address, base64);
+	}
+
+	public disconnect(address: string): Promise<void> {
+		return this.native.disconnect(address);
+	}
+
+	public stopAll(): Promise<void> {
+		return this.native.stopAll();
+	}
+
+	public onScanResult(listener: (event: BleScanResult)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyScanResult', listener);
+		return () => sub.remove();
+	}
+
+	public onConnected(listener: (event: BleConnectedEvent)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyConnected', listener);
+		return () => sub.remove();
+	}
+
+	public onDisconnected(listener: (event: BleDisconnectedEvent)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyDisconnected', listener);
+		return () => sub.remove();
+	}
+
+	public onFrame(listener: (event: BleFrameEvent)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyFrame', listener);
+		return () => sub.remove();
+	}
+
+	public onError(listener: (event: BleErrorEvent)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyError', listener);
+		return () => sub.remove();
+	}
+
+	public onAdapterState(listener: (state: BleAdapterState)=> void): ()=> void {
+		const sub = this.emitter.addListener('nearbyAdapterState', (event: { state: BleAdapterState }) => listener(event.state));
+		return () => sub.remove();
+	}
+}
+
+let cached: BleDriver | null = null;
+
+// Lazily constructed so importing this module never touches NativeModules on
+// platforms/tests where TilesNearby doesn't exist -- callers must check
+// nativeBleAvailable() first.
+export const getNativeBle = (): BleDriver => {
+	if (!cached) cached = new NativeBle();
+	return cached;
+};
