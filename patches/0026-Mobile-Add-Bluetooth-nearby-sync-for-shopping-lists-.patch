+// A fake BleDriver (see ../nativeBle.ts) simulating two or more devices
+// "in range" of each other over an in-memory channel, for nearbyManager.test.ts
+// (and any other test that needs a fake transport without a real Android
+// device). Not meant to model real BLE timing precisely -- just discovery
+// (advertise/scan), connect and frame delivery, closely enough that
+// nearbyManager's own logic (token checks, handshake, duplicate-connection
+// resolution, heartbeat/timeout) can be exercised end-to-end.
+import {
+	BleAdapterState, BleCapabilities, BleConnectedEvent, BleDisconnectedEvent,
+	BleDriver, BleErrorEvent, BleFrameEvent, BleScanResult,
+} from '../nativeBle';
+
+type Listener<T> = (event: T)=> void;
+
+class Listeners<T> {
+	private set = new Set<Listener<T>>();
+
+	public add(listener: Listener<T>): ()=> void {
+		this.set.add(listener);
+		return () => this.set.delete(listener);
+	}
+
+	public emit(event: T): void {
+		for (const listener of [...this.set]) listener(event);
+	}
+}
+
+// Shared "air": every FakeBleDevice created with the same network can see
+// each other. One network per test.
+export class FakeBleNetwork {
+	private devices = new Map<string, FakeBleDevice>();
+
+	public register(device: FakeBleDevice): void {
+		this.devices.set(device.id, device);
+	}
+
+	public get(id: string): FakeBleDevice | undefined {
+		return this.devices.get(id);
+	}
+
+	public others(exceptId: string): FakeBleDevice[] {
+		return [...this.devices.values()].filter(d => d.id !== exceptId);
+	}
+
+	// Called by a device when it starts (or updates) advertising: pushes an
+	// immediate scan result to every other device currently scanning for the
+	// same service.
+	public announceAdvertising(from: FakeBleDevice, serviceUuid: string, tokenHex: string): void {
+		for (const device of this.others(from.id)) device.onPeerAdvertising(from.id, serviceUuid, tokenHex);
+	}
+}
+
+const FAKE_MTU = 517;
+const FAKE_RSSI = -55;
+
+export class FakeBleDevice implements BleDriver {
+	public readonly id: string;
+	private network: FakeBleNetwork;
+	private advertising: { serviceUuid: string; tokenHex: string } | null = null;
+	private scanningServiceUuid: string | null = null;
+	private connections = new Set<string>();
+	// Test-only: makes send() a black hole (frames are accepted but never
+	// delivered, and no disconnect event fires) -- simulates a peer that goes
+	// out of range without a clean disconnect, for tests of the 30s
+	// peer-lost heartbeat timeout. See setSilent().
+	private silent = false;
+	private supported: BleCapabilities;
+	private adapterState: BleAdapterState = 'on';
+
+	private scanResultListeners = new Listeners<BleScanResult>();
+	private connectedListeners = new Listeners<BleConnectedEvent>();
+	private disconnectedListeners = new Listeners<BleDisconnectedEvent>();
+	private frameListeners = new Listeners<BleFrameEvent>();
+	private errorListeners = new Listeners<BleErrorEvent>();
+	private adapterStateListeners = new Listeners<BleAdapterState>();
+
+	public constructor(id: string, network: FakeBleNetwork, supported: Partial<BleCapabilities> = {}) {
+		this.id = id;
+		this.network = network;
+		this.supported = { ble: true, peripheral: true, codedPhy: true, ...supported };
+		network.register(this);
+	}
+
+	// --- test helpers, not part of BleDriver --------------------------
+
+	public onPeerAdvertising(peerId: string, serviceUuid: string, tokenHex: string): void {
+		if (this.scanningServiceUuid !== serviceUuid) return;
+		this.scanResultListeners.emit({ address: peerId, rssi: FAKE_RSSI, tokenHex });
+	}
+
+	public setAdapterState(state: BleAdapterState): void {
+		this.adapterState = state;
+		this.adapterStateListeners.emit(state);
+	}
+
+	public setSilent(value: boolean): void {
+		this.silent = value;
+	}
+
+	// --- BleDriver -------------------------------------------------------
+
+	public async isSupported(): Promise<BleCapabilities> {
+		return this.supported;
+	}
+
+	public async state(): Promise<BleAdapterState> {
+		return this.adapterState;
+	}
+
+	public async startAdvertising(serviceUuid: string, tokenHex: string, _useCodedPhy: boolean): Promise<void> {
+		this.advertising = { serviceUuid, tokenHex };
+		this.network.announceAdvertising(this, serviceUuid, tokenHex);
+	}
+
+	public async updateToken(tokenHex: string): Promise<void> {
+		if (!this.advertising) return;
+		this.advertising = { ...this.advertising, tokenHex };
+		this.network.announceAdvertising(this, this.advertising.serviceUuid, tokenHex);
+	}
+
+	public async stopAdvertising(): Promise<void> {
+		this.advertising = null;
+	}
+
+	public async startScan(serviceUuid: string, _useCodedPhy: boolean): Promise<void> {
+		this.scanningServiceUuid = serviceUuid;
+		for (const peer of this.network.others(this.id)) {
+			if (peer.advertising?.serviceUuid === serviceUuid) {
+				this.scanResultListeners.emit({ address: peer.id, rssi: FAKE_RSSI, tokenHex: peer.advertising.tokenHex });
+			}
+		}
+	}
+
+	public async stopScan(): Promise<void> {
+		this.scanningServiceUuid = null;
+	}
+
+	public async connect(address: string): Promise<void> {
+		const peer = this.network.get(address);
+		if (!peer) throw new Error(`fakeBle: no such device ${address}`);
+		this.connections.add(address);
+		peer.connections.add(this.id);
+		await new Promise(resolve => setImmediate(resolve));
+		this.emitConnected({ address, mtu: FAKE_MTU, role: 'central' });
+		peer.emitConnected({ address: this.id, mtu: FAKE_MTU, role: 'peripheral' });
+	}
+
+	private emitConnected(event: BleConnectedEvent): void {
+		this.connectedListeners.emit(event);
+	}
+
+	public async send(address: string, base64: string): Promise<void> {
+		const peer = this.network.get(address);
+		if (!peer || !this.connections.has(address)) throw new Error(`fakeBle: not connected to ${address}`);
+		await new Promise(resolve => setImmediate(resolve));
+		if (this.silent) return; // dropped, see setSilent()
+		peer.frameListeners.emit({ address: this.id, base64 });
+	}
+
+	public async disconnect(address: string): Promise<void> {
+		this.disconnectInternal(address, 'Local disconnect');
+	}
+
+	private disconnectInternal(address: string, reason: string): void {
+		if (!this.connections.has(address)) return;
+		this.connections.delete(address);
+		this.disconnectedListeners.emit({ address, reason });
+		const peer = this.network.get(address);
+		if (peer && peer.connections.has(this.id)) peer.disconnectInternal(this.id, reason);
+	}
+
+	public async stopAll(): Promise<void> {
+		this.advertising = null;
+		this.scanningServiceUuid = null;
+		for (const address of [...this.connections]) this.disconnectInternal(address, 'stopAll');
+	}
+
+	public onScanResult(listener: Listener<BleScanResult>): ()=> void {
+		return this.scanResultListeners.add(listener);
+	}
+
+	public onConnected(listener: Listener<BleConnectedEvent>): ()=> void {
+		return this.connectedListeners.add(listener);
+	}
+
+	public onDisconnected(listener: Listener<BleDisconnectedEvent>): ()=> void {
+		return this.disconnectedListeners.add(listener);
+	}
+
+	public onFrame(listener: Listener<BleFrameEvent>): ()=> void {
+		return this.frameListeners.add(listener);
+	}
+
+	public onError(listener: Listener<BleErrorEvent>): ()=> void {
+		return this.errorListeners.add(listener);
+	}
+
+	public onAdapterState(listener: Listener<BleAdapterState>): ()=> void {
+		return this.adapterStateListeners.add(listener);
+	}
+}
+
+export const createFakeBle = (id: string, network: FakeBleNetwork, supported?: Partial<BleCapabilities>): FakeBleDevice =>
+	new FakeBleDevice(id, network, supported);
