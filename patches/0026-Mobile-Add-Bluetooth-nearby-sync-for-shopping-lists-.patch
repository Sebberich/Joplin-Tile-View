@@ -0,0 +1,178 @@
+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { ListsDatabase } from '../core/db';
+import { ListsStore } from '../core/store';
+import { ListRecord } from '../core/types';
+import { NearbyManager } from './nearbyManager';
+import { FakeBleDevice, FakeBleNetwork, createFakeBle } from './testing/fakeBle';
+
+jest.mock('@joplin/lib/models/Setting', () => ({ __esModule: true, default: { value: jest.fn(() => 0) } }));
+// eslint-disable-next-line @typescript-eslint/no-var-requires -- see jest.mock above
+const mockSetting = require('@joplin/lib/models/Setting').default;
+
+interface Device {
+	db: ListsDatabase;
+	store: ListsStore;
+	manager: NearbyManager;
+	ble: FakeBleDevice;
+	path: string;
+}
+
+const openDevice = async (id: string, network: FakeBleNetwork): Promise<Device> => {
+	const path = join(tmpdir(), `tiles-nearby-test-${uuid.createNano()}.sqlite`);
+	const db = new ListsDatabase(new Database(new DatabaseDriverNode()));
+	await db.openOrCreate(path);
+	const store = new ListsStore(db, path);
+	const ble = createFakeBle(id, network);
+	const manager = new NearbyManager(db, store, { ble });
+	return { db, store, manager, ble, path };
+};
+
+const closeDevice = async (device: Device): Promise<void> => {
+	await device.manager.stop();
+	await device.db.close();
+	await rm(device.path, { force: true });
+};
+
+// Runs pending async work (frame delivery, handshake steps, sqlite I/O
+// callbacks) until it's all settled, without needing real BLE latency.
+// setImmediate alone isn't enough here: the node sqlite driver delivers
+// query results via libuv's thread pool, which needs real event-loop turns
+// (not just drained microtasks/immediates) to catch up -- so this yields
+// with a short real setTimeout instead. See useFakeTimers() below for how
+// this stays compatible with tests that also need fake timers.
+const settle = async (rounds = 40, delayMs = 25): Promise<void> => {
+	for (let i = 0; i < rounds; i++) await new Promise(resolve => setTimeout(resolve, delayMs));
+};
+
+// advanceTimers keeps the fake clock auto-ticking at (roughly) real speed,
+// so code that awaits real sqlite I/O (via settle() above) isn't starved --
+// only jest.advanceTimersByTimeAsync()'s extra jump is "free".
+const useFakeTimers = (): void => {
+	jest.useFakeTimers({ advanceTimers: true, doNotFake: ['setImmediate', 'nextTick'] });
+};
+
+describe('lists/nearby/nearbyManager', () => {
+	let network: FakeBleNetwork;
+	let devices: Device[];
+
+	beforeEach(() => {
+		network = new FakeBleNetwork();
+		devices = [];
+		mockSetting.value.mockReturnValue(0);
+	});
+
+	afterEach(async () => {
+		jest.useRealTimers();
+		for (const device of devices) await closeDevice(device);
+	});
+
+	const addDevice = async (id: string): Promise<Device> => {
+		const device = await openDevice(id, network);
+		devices.push(device);
+		return device;
+	};
+
+	const createSharedOpenList = async (owner: Device, ...joiners: Device[]): Promise<ListRecord> => {
+		const list = await owner.store.createOpenList('Groceries');
+		const invite = await owner.store.inviteFor(list.id);
+		for (const joiner of joiners) await joiner.store.joinFromInvite(invite.link);
+		return list;
+	};
+
+	test('two devices discover each other, hand-shake and sync an existing item', async () => {
+		const a = await addDevice('a');
+		const b = await addDevice('b');
+		const list = await createSharedOpenList(a, b);
+		await a.store.addItem(list.id, 'Milch');
+
+		await a.manager.start(list.id);
+		await b.manager.start(list.id);
+		await settle();
+
+		const bItems = await b.store.items(list.id);
+		expect(bItems.map(i => i.name)).toContain('Milch');
+
+		let aState: { mode: string; found: number } | null = null;
+		a.manager.onState(s => { aState = s; })();
+		expect(aState).not.toBeNull();
+	});
+
+	test('found/total are reported once devices are connected', async () => {
+		const a = await addDevice('a');
+		const b = await addDevice('b');
+		const list = await createSharedOpenList(a, b);
+
+		const states: { mode: string; found: number }[] = [];
+		a.manager.onState(s => states.push(s));
+
+		await a.manager.start(list.id);
+		await b.manager.start(list.id);
+		await settle();
+
+		expect(states.some(s => s.mode === 'found' && s.found >= 1)).toBe(true);
+	});
+
+	test('a change on one device reaches a third device via a second (mesh propagation)', async () => {
+		const a = await addDevice('a');
+		const b = await addDevice('b');
+		const c = await addDevice('c');
+		const list = await createSharedOpenList(a, b, c);
+
+		await a.manager.start(list.id);
+		await b.manager.start(list.id);
+		await c.manager.start(list.id);
+		await settle();
+
+		await a.store.addItem(list.id, 'Kaffee');
+		await settle();
+
+		const cItems = await c.store.items(list.id);
+		expect(cItems.map(i => i.name)).toContain('Kaffee');
+	});
+
+	test('auto-off stops nearby after the configured number of minutes of inactivity', async () => {
+		mockSetting.value.mockReturnValue(5); // lists.nearbyAutoOffMinutes
+
+		const a = await addDevice('a');
+		const list = await a.store.createOpenList('Groceries');
+		const states: { mode: string }[] = [];
+		a.manager.onState(s => states.push(s));
+
+		useFakeTimers();
+		await a.manager.start(list.id);
+		expect(states[states.length - 1].mode).toBe('searching');
+
+		await jest.advanceTimersByTimeAsync(5 * 60 * 1000 + 1000);
+
+		expect(states[states.length - 1].mode).toBe('off');
+	});
+
+	test('a peer that stops responding is counted as lost after 30s and the session closes', async () => {
+		const a = await addDevice('a');
+		const b = await addDevice('b');
+		const list = await createSharedOpenList(a, b);
+
+		useFakeTimers();
+		await a.manager.start(list.id);
+		await b.manager.start(list.id);
+		await settle();
+
+		const states: { mode: string; found: number }[] = [];
+		a.manager.onState(s => states.push(s));
+		expect(states[states.length - 1].found).toBeGreaterThanOrEqual(1);
+
+		// B disappears without a clean disconnect (out of range): frames it
+		// sends are silently dropped rather than delivered, so A has to notice
+		// via the heartbeat timeout instead of a disconnect event.
+		b.ble.setSilent(true);
+
+		await jest.advanceTimersByTimeAsync(31 * 1000);
+
+		expect(states[states.length - 1].found).toBe(0);
+	});
+});
diff --git a/packages/app-mobile/lists/nearby/nearbyManager.ts b/packages/app-mobile/lists/nearby/nearbyManager.ts
