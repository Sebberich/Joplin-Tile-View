+package net.cozic.joplin.nearby
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.bluetooth.BluetoothAdapter
+import android.bluetooth.BluetoothDevice
+import android.bluetooth.BluetoothGatt
+import android.bluetooth.BluetoothGattCallback
+import android.bluetooth.BluetoothGattCharacteristic
+import android.bluetooth.BluetoothGattDescriptor
+import android.bluetooth.BluetoothGattServer
+import android.bluetooth.BluetoothGattServerCallback
+import android.bluetooth.BluetoothGattService
+import android.bluetooth.BluetoothManager
+import android.bluetooth.BluetoothProfile
+import android.bluetooth.le.AdvertiseCallback
+import android.bluetooth.le.AdvertiseData
+import android.bluetooth.le.AdvertiseSettings
+import android.bluetooth.le.AdvertisingSet
+import android.bluetooth.le.AdvertisingSetCallback
+import android.bluetooth.le.AdvertisingSetParameters
+import android.bluetooth.le.BluetoothLeAdvertiser
+import android.bluetooth.le.BluetoothLeScanner
+import android.bluetooth.le.ScanCallback
+import android.bluetooth.le.ScanFilter
+import android.bluetooth.le.ScanResult
+import android.bluetooth.le.ScanSettings
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.ParcelUuid
+import android.util.Base64
+import androidx.core.content.ContextCompat
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.modules.core.DeviceEventManagerModule
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+
+// Deliberately "dumb": every protocol/session decision (framing, handshake,
+// who talks to whom) lives in TS (see lists/nearby/*.ts and PROTOCOL.md).
+// This module only exposes raw BLE primitives -- advertise/scan/connect/send
+// -- as a promise-based bridge plus a handful of events, mirrored on the TS
+// side by lists/nearby/nativeBle.ts.
+//
+// Threading: every GATT/advertise/scan callback below runs on a Binder
+// thread, not the JS thread -- state is kept in ConcurrentHashMaps and events
+// are always emitted through reactApplicationContext's JS module, which is
+// itself thread-safe to call from any thread.
+class NearbyModule(reactContext: ReactApplicationContext) : ReactContextBaseJavaModule(reactContext) {
+
+	companion object {
+		private val RX_CHARACTERISTIC_UUID: UUID = UUID.fromString("d7a1e2b1-5f3c-4a9e-8b1d-6c2f9e4a7b3d")
+		private val TX_CHARACTERISTIC_UUID: UUID = UUID.fromString("d7a1e2b2-5f3c-4a9e-8b1d-6c2f9e4a7b3d")
+		private val CCCD_UUID: UUID = UUID.fromString("00002902-0000-1000-8000-00805f9b34fb")
+		// Throttles scan-result events per address, see PROTOCOL.md.
+		private const val SCAN_RESULT_THROTTLE_MS = 1000L
+	}
+
+	override fun getName(): String = "TilesNearby"
+
+	private val bluetoothManager: BluetoothManager?
+		get() = reactApplicationContext.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager
+
+	private val adapter: BluetoothAdapter?
+		get() = bluetoothManager?.adapter
+
+	private var serviceUuid: UUID? = null
+	private var advertiser: BluetoothLeAdvertiser? = null
+	private var legacyAdvertiseCallback: AdvertiseCallback? = null
+	private var extendedAdvertiseCallback: AdvertisingSetCallback? = null
+	private var advertisingSet: AdvertisingSet? = null
+
+	private var gattServer: BluetoothGattServer? = null
+	private var gattServerCallback: BluetoothGattServerCallback? = null
+	private var rxCharacteristic: BluetoothGattCharacteristic? = null
+	private var txCharacteristic: BluetoothGattCharacteristic? = null
+
+	private var scanner: BluetoothLeScanner? = null
+	private var scanCallback: ScanCallback? = null
+
+	// address -> ...
+	private val clientGatts = ConcurrentHashMap<String, BluetoothGatt>()
+	private val clientMtus = ConcurrentHashMap<String, Int>()
+	private val serverDevices = ConcurrentHashMap<String, BluetoothDevice>()
+	private val serverMtus = ConcurrentHashMap<String, Int>()
+	private val pendingSendPromises = ConcurrentHashMap<String, Promise>()
+	private val lastScanEmitMs = ConcurrentHashMap<String, Long>()
+
+	private var adapterStateReceiver: BroadcastReceiver? = null
+
+	init {
+		registerAdapterStateReceiver()
+	}
+
+	// --- capabilities / state ---------------------------------------------
+
+	@ReactMethod
+	fun isSupported(promise: Promise) {
+		val result: WritableMap = Arguments.createMap()
+		val a = adapter
+		result.putBoolean("ble", reactApplicationContext.packageManager.hasSystemFeature(PackageManager.FEATURE_BLUETOOTH_LE))
+		result.putBoolean("peripheral", a?.isMultipleAdvertisementSupported == true)
+		result.putBoolean("codedPhy", Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && a?.isLeCodedPhySupported == true)
+		promise.resolve(result)
+	}
+
+	@ReactMethod
+	fun state(promise: Promise) {
+		val a = adapter
+		when {
+			a == null || !reactApplicationContext.packageManager.hasSystemFeature(PackageManager.FEATURE_BLUETOOTH_LE) -> promise.resolve("unsupported")
+			!hasRequiredPermissions() -> promise.resolve("unauthorized")
+			a.isEnabled -> promise.resolve("on")
+			else -> promise.resolve("off")
+		}
+	}
+
+	private fun hasPermission(permission: String): Boolean =
+		ContextCompat.checkSelfPermission(reactApplicationContext, permission) == PackageManager.PERMISSION_GRANTED
+
+	// Android 12 (API 31) replaced the old BLUETOOTH/BLUETOOTH_ADMIN pair with
+	// BLUETOOTH_SCAN/BLUETOOTH_ADVERTISE/BLUETOOTH_CONNECT; below that,
+	// scanning for BLE devices requires location permission instead. The TS
+	// side (NearbyStatusCircle) requests the matching set before calling
+	// start(), this just double-checks before touching the adapter.
+	private fun hasRequiredPermissions(): Boolean {
+		return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+			hasPermission(Manifest.permission.BLUETOOTH_SCAN) &&
+				hasPermission(Manifest.permission.BLUETOOTH_ADVERTISE) &&
+				hasPermission(Manifest.permission.BLUETOOTH_CONNECT)
+		} else {
+			hasPermission(Manifest.permission.ACCESS_FINE_LOCATION)
+		}
+	}
+
+	// --- advertising + GATT server -----------------------------------------
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun startAdvertising(serviceUuidString: String, tokenHex: String, useCodedPhy: Boolean, promise: Promise) {
+		try {
+			val uuid = UUID.fromString(serviceUuidString)
+			serviceUuid = uuid
+			val a = adapter ?: throw IllegalStateException("No Bluetooth adapter")
+			advertiser = a.bluetoothLeAdvertiser ?: throw IllegalStateException("No BLE advertiser")
+			openGattServerIfNeeded(uuid)
+			startLegacyAdvertising(uuid, tokenHex)
+			if (useCodedPhy && Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && a.isLeCodedPhySupported) {
+				startExtendedAdvertising(uuid, tokenHex)
+			}
+			promise.resolve(null)
+		} catch (e: SecurityException) {
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_ADVERTISE", e.message, e)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun openGattServerIfNeeded(uuid: UUID) {
+		if (gattServer != null) return
+		val callback = buildGattServerCallback()
+		gattServerCallback = callback
+		gattServer = bluetoothManager?.openGattServer(reactApplicationContext, callback)
+		val service = BluetoothGattService(uuid, BluetoothGattService.SERVICE_TYPE_PRIMARY)
+		val rx = BluetoothGattCharacteristic(
+			RX_CHARACTERISTIC_UUID,
+			BluetoothGattCharacteristic.PROPERTY_WRITE or BluetoothGattCharacteristic.PROPERTY_WRITE_NO_RESPONSE,
+			BluetoothGattCharacteristic.PERMISSION_WRITE,
+		)
+		val tx = BluetoothGattCharacteristic(
+			TX_CHARACTERISTIC_UUID,
+			BluetoothGattCharacteristic.PROPERTY_NOTIFY,
+			BluetoothGattCharacteristic.PERMISSION_READ,
+		)
+		val cccd = BluetoothGattDescriptor(
+			CCCD_UUID,
+			BluetoothGattDescriptor.PERMISSION_READ or BluetoothGattDescriptor.PERMISSION_WRITE,
+		)
+		tx.addDescriptor(cccd)
+		service.addCharacteristic(rx)
+		service.addCharacteristic(tx)
+		gattServer?.addService(service)
+		rxCharacteristic = rx
+		txCharacteristic = tx
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun buildGattServerCallback(): BluetoothGattServerCallback = object : BluetoothGattServerCallback() {
+		override fun onConnectionStateChange(device: BluetoothDevice, status: Int, newState: Int) {
+			if (newState == BluetoothProfile.STATE_CONNECTED) {
+				serverDevices[device.address] = device
+				serverMtus[device.address] = 23
+				// The central side hasn't written anything yet, but the link is up;
+				// see PROTOCOL.md for why 'peripheral' is reported at connection
+				// time rather than waiting for the first write.
+				emitConnected(device.address, 23, "peripheral")
+			} else if (newState == BluetoothProfile.STATE_DISCONNECTED) {
+				serverDevices.remove(device.address)
+				serverMtus.remove(device.address)
+				emitDisconnected(device.address, "server status=$status")
+			}
+		}
+
+		override fun onMtuChanged(device: BluetoothDevice, mtu: Int) {
+			serverMtus[device.address] = mtu
+			emitConnected(device.address, mtu, "peripheral")
+		}
+
+		override fun onCharacteristicWriteRequest(
+			device: BluetoothDevice, requestId: Int, characteristic: BluetoothGattCharacteristic,
+			preparedWrite: Boolean, responseNeeded: Boolean, offset: Int, value: ByteArray,
+		) {
+			if (characteristic.uuid == RX_CHARACTERISTIC_UUID) emitFrame(device.address, value)
+			if (responseNeeded) gattServer?.sendResponse(device, requestId, BluetoothGatt.GATT_SUCCESS, offset, value)
+		}
+
+		override fun onDescriptorWriteRequest(
+			device: BluetoothDevice, requestId: Int, descriptor: BluetoothGattDescriptor,
+			preparedWrite: Boolean, responseNeeded: Boolean, offset: Int, value: ByteArray,
+		) {
+			// CCCD subscribe/unsubscribe: nothing to track beyond acking the
+			// write -- send() always targets a specific device and will simply
+			// fail (see resolvePendingSend) if it never subscribed.
+			if (responseNeeded) gattServer?.sendResponse(device, requestId, BluetoothGatt.GATT_SUCCESS, offset, value)
+		}
+
+		override fun onNotificationSent(device: BluetoothDevice, status: Int) {
+			resolvePendingSend(device.address, status == BluetoothGatt.GATT_SUCCESS)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun startLegacyAdvertising(uuid: UUID, tokenHex: String) {
+		val settings = AdvertiseSettings.Builder()
+			.setAdvertiseMode(AdvertiseSettings.ADVERTISE_MODE_LOW_LATENCY)
+			.setConnectable(true)
+			.setTimeout(0)
+			.build()
+		val data = AdvertiseData.Builder()
+			.addServiceUuid(ParcelUuid(uuid))
+			.addServiceData(ParcelUuid(uuid), hexToBytes(tokenHex))
+			.setIncludeDeviceName(false)
+			.build()
+		val callback = object : AdvertiseCallback() {
+			override fun onStartFailure(errorCode: Int) {
+				emitError("E_ADVERTISE", "Legacy advertising failed to start: $errorCode")
+			}
+		}
+		legacyAdvertiseCallback = callback
+		advertiser?.startAdvertising(settings, data, callback)
+	}
+
+	// Extended advertising set on the coded PHY (long range), in addition to
+	// the always-on legacy (1M PHY) advertisement above. Requires API 26.
+	@SuppressLint("MissingPermission")
+	private fun startExtendedAdvertising(uuid: UUID, tokenHex: String) {
+		val parameters = AdvertisingSetParameters.Builder()
+			.setLegacyMode(false)
+			.setConnectable(true)
+			.setPrimaryPhy(BluetoothDevice.PHY_LE_1M)
+			.setSecondaryPhy(BluetoothDevice.PHY_LE_CODED)
+			.setInterval(AdvertisingSetParameters.INTERVAL_LOW)
+			.build()
+		val data = AdvertiseData.Builder()
+			.addServiceUuid(ParcelUuid(uuid))
+			.addServiceData(ParcelUuid(uuid), hexToBytes(tokenHex))
+			.setIncludeDeviceName(false)
+			.build()
+		val callback = object : AdvertisingSetCallback() {
+			override fun onAdvertisingSetStarted(advertisingSet: AdvertisingSet?, txPower: Int, status: Int) {
+				this@NearbyModule.advertisingSet = advertisingSet
+				if (status != AdvertisingSetCallback.ADVERTISE_SUCCESS) {
+					emitError("E_ADVERTISE", "Extended advertising failed to start: $status")
+				}
+			}
+
+			override fun onAdvertisingSetStopped(advertisingSet: AdvertisingSet?) {
+				this@NearbyModule.advertisingSet = null
+			}
+		}
+		extendedAdvertiseCallback = callback
+		advertiser?.startAdvertisingSet(parameters, data, null, null, null, callback)
+	}
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun updateToken(tokenHex: String, promise: Promise) {
+		try {
+			val uuid = serviceUuid
+			if (uuid == null) {
+				promise.resolve(null) // not advertising yet; nothing to update
+				return
+			}
+			legacyAdvertiseCallback?.let { advertiser?.stopAdvertising(it) }
+			startLegacyAdvertising(uuid, tokenHex)
+			extendedAdvertiseCallback?.let { callback ->
+				advertiser?.stopAdvertisingSet(callback)
+				startExtendedAdvertising(uuid, tokenHex)
+			}
+			promise.resolve(null)
+		} catch (e: SecurityException) {
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_ADVERTISE", e.message, e)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun stopAdvertising(promise: Promise) {
+		try {
+			legacyAdvertiseCallback?.let { advertiser?.stopAdvertising(it) }
+			legacyAdvertiseCallback = null
+			extendedAdvertiseCallback?.let { advertiser?.stopAdvertisingSet(it) }
+			extendedAdvertiseCallback = null
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_ADVERTISE", e.message, e)
+		}
+	}
+
+	// --- scanning -----------------------------------------------------
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun startScan(serviceUuidString: String, useCodedPhy: Boolean, promise: Promise) {
+		try {
+			val uuid = UUID.fromString(serviceUuidString)
+			serviceUuid = uuid
+			val a = adapter ?: throw IllegalStateException("No Bluetooth adapter")
+			scanner = a.bluetoothLeScanner ?: throw IllegalStateException("No BLE scanner")
+			val filters = listOf(ScanFilter.Builder().setServiceUuid(ParcelUuid(uuid)).build())
+			val settingsBuilder = ScanSettings.Builder().setScanMode(ScanSettings.SCAN_MODE_LOW_LATENCY)
+			if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+				settingsBuilder.setPhy(if (useCodedPhy) ScanSettings.PHY_LE_ALL_SUPPORTED else BluetoothDevice.PHY_LE_1M)
+				if (useCodedPhy) settingsBuilder.setLegacy(false)
+			}
+			val callback = object : ScanCallback() {
+				override fun onScanResult(callbackType: Int, result: ScanResult) {
+					handleScanResult(uuid, result)
+				}
+
+				override fun onScanFailed(errorCode: Int) {
+					emitError("E_SCAN", "Scan failed to start: $errorCode")
+				}
+			}
+			scanCallback = callback
+			scanner?.startScan(filters, settingsBuilder.build(), callback)
+			promise.resolve(null)
+		} catch (e: SecurityException) {
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_SCAN", e.message, e)
+		}
+	}
+
+	private fun handleScanResult(uuid: UUID, result: ScanResult) {
+		val serviceData = result.scanRecord?.getServiceData(ParcelUuid(uuid)) ?: return
+		val address = result.device.address
+		val now = System.currentTimeMillis()
+		val last = lastScanEmitMs[address] ?: 0L
+		if (now - last < SCAN_RESULT_THROTTLE_MS) return
+		lastScanEmitMs[address] = now
+		emitScanResult(address, result.rssi, bytesToHex(serviceData))
+	}
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun stopScan(promise: Promise) {
+		try {
+			scanCallback?.let { scanner?.stopScan(it) }
+			scanCallback = null
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_SCAN", e.message, e)
+		}
+	}
+
+	// --- client (central) connection ---------------------------------------
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun connect(address: String, promise: Promise) {
+		try {
+			val a = adapter ?: throw IllegalStateException("No Bluetooth adapter")
+			val device = a.getRemoteDevice(address)
+			val callback = buildGattCallback(address)
+			val gatt = device.connectGatt(reactApplicationContext, false, callback, BluetoothDevice.TRANSPORT_LE)
+			clientGatts[address] = gatt
+			promise.resolve(null)
+		} catch (e: SecurityException) {
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_CONNECT", e.message, e)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun buildGattCallback(address: String): BluetoothGattCallback = object : BluetoothGattCallback() {
+		override fun onConnectionStateChange(gatt: BluetoothGatt, status: Int, newState: Int) {
+			when (newState) {
+				BluetoothProfile.STATE_CONNECTED -> gatt.requestMtu(517)
+				BluetoothProfile.STATE_DISCONNECTED -> {
+					clientGatts.remove(address)
+					clientMtus.remove(address)
+					emitDisconnected(address, "client status=$status")
+					gatt.close()
+				}
+			}
+		}
+
+		override fun onMtuChanged(gatt: BluetoothGatt, mtu: Int, status: Int) {
+			clientMtus[address] = mtu
+			gatt.discoverServices()
+		}
+
+		override fun onServicesDiscovered(gatt: BluetoothGatt, status: Int) {
+			if (status != BluetoothGatt.GATT_SUCCESS) {
+				emitError("E_GATT", "Service discovery failed: $status")
+				return
+			}
+			val uuid = serviceUuid
+			val service = if (uuid != null) gatt.getService(uuid) else null
+			val tx = service?.getCharacteristic(TX_CHARACTERISTIC_UUID)
+			if (service == null || tx == null || service.getCharacteristic(RX_CHARACTERISTIC_UUID) == null) {
+				emitError("E_GATT", "Nearby service/characteristics not found on peer")
+				gatt.disconnect()
+				return
+			}
+			gatt.setCharacteristicNotification(tx, true)
+			val cccd = tx.getDescriptor(CCCD_UUID) ?: return
+			if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+				gatt.writeDescriptor(cccd, BluetoothGattDescriptor.ENABLE_NOTIFICATION_VALUE)
+			} else {
+				@Suppress("DEPRECATION")
+				cccd.value = BluetoothGattDescriptor.ENABLE_NOTIFICATION_VALUE
+				@Suppress("DEPRECATION")
+				gatt.writeDescriptor(cccd)
+			}
+		}
+
+		override fun onDescriptorWrite(gatt: BluetoothGatt, descriptor: BluetoothGattDescriptor, status: Int) {
+			if (descriptor.uuid != CCCD_UUID) return
+			if (status != BluetoothGatt.GATT_SUCCESS) {
+				emitError("E_GATT", "Failed to enable notifications: $status")
+				return
+			}
+			emitConnected(address, clientMtus[address] ?: 23, "central")
+		}
+
+		// Pre-API-33 path.
+		@Suppress("DEPRECATION")
+		override fun onCharacteristicChanged(gatt: BluetoothGatt, characteristic: BluetoothGattCharacteristic) {
+			if (characteristic.uuid == TX_CHARACTERISTIC_UUID) emitFrame(address, characteristic.value ?: ByteArray(0))
+		}
+
+		// API 33+ overload; compiled against compileSdk 36 so this always
+		// resolves, but the framework only calls it on API 33+ devices -- the
+		// two-arg override above still fires on older ones.
+		override fun onCharacteristicChanged(gatt: BluetoothGatt, characteristic: BluetoothGattCharacteristic, value: ByteArray) {
+			if (characteristic.uuid == TX_CHARACTERISTIC_UUID) emitFrame(address, value)
+		}
+
+		override fun onCharacteristicWrite(gatt: BluetoothGatt, characteristic: BluetoothGattCharacteristic, status: Int) {
+			if (characteristic.uuid == RX_CHARACTERISTIC_UUID) resolvePendingSend(address, status == BluetoothGatt.GATT_SUCCESS)
+		}
+	}
+
+	// --- send / disconnect -------------------------------------------------
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun send(address: String, base64: String, promise: Promise) {
+		try {
+			val bytes = Base64.decode(base64, Base64.NO_WRAP)
+			val centralGatt = clientGatts[address]
+			val peripheralDevice = serverDevices[address]
+			when {
+				centralGatt != null -> sendAsCentral(centralGatt, address, bytes, promise)
+				peripheralDevice != null -> sendAsPeripheral(peripheralDevice, address, bytes, promise)
+				else -> promise.reject("E_NOT_CONNECTED", "No connection to $address")
+			}
+		} catch (e: SecurityException) {
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_SEND", e.message, e)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun sendAsCentral(gatt: BluetoothGatt, address: String, bytes: ByteArray, promise: Promise) {
+		val uuid = serviceUuid
+		val rx = (if (uuid != null) gatt.getService(uuid) else null)?.getCharacteristic(RX_CHARACTERISTIC_UUID)
+		if (rx == null) {
+			promise.reject("E_NOT_CONNECTED", "rx characteristic not available for $address")
+			return
+		}
+		pendingSendPromises[address] = promise
+		val started = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+			gatt.writeCharacteristic(rx, bytes, BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT) == BluetoothGatt.GATT_SUCCESS
+		} else {
+			@Suppress("DEPRECATION")
+			rx.value = bytes
+			@Suppress("DEPRECATION")
+			rx.writeType = BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT
+			@Suppress("DEPRECATION")
+			gatt.writeCharacteristic(rx)
+		}
+		if (!started) {
+			pendingSendPromises.remove(address)
+			promise.reject("E_SEND", "writeCharacteristic failed to start for $address")
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	private fun sendAsPeripheral(device: BluetoothDevice, address: String, bytes: ByteArray, promise: Promise) {
+		val server = gattServer
+		val tx = txCharacteristic
+		if (server == null || tx == null) {
+			promise.reject("E_NOT_CONNECTED", "GATT server not open")
+			return
+		}
+		pendingSendPromises[address] = promise
+		val started = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+			server.notifyCharacteristicChanged(device, tx, false, bytes) == BluetoothGatt.GATT_SUCCESS
+		} else {
+			@Suppress("DEPRECATION")
+			tx.value = bytes
+			@Suppress("DEPRECATION")
+			server.notifyCharacteristicChanged(device, tx, false)
+		}
+		if (!started) {
+			pendingSendPromises.remove(address)
+			promise.reject("E_SEND", "notifyCharacteristicChanged failed to start for $address")
+		}
+	}
+
+	private fun resolvePendingSend(address: String, success: Boolean) {
+		val promise = pendingSendPromises.remove(address) ?: return
+		if (success) promise.resolve(null) else promise.reject("E_SEND", "Write/notify was not acknowledged for $address")
+	}
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun disconnect(address: String, promise: Promise) {
+		try {
+			clientGatts.remove(address)?.let { it.disconnect(); it.close() }
+			serverDevices.remove(address)?.let { gattServer?.cancelConnection(it) }
+			serverMtus.remove(address)
+			pendingSendPromises.remove(address)?.reject("E_SEND", "Disconnected before write completed")
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_DISCONNECT", e.message, e)
+		}
+	}
+
+	@SuppressLint("MissingPermission")
+	@ReactMethod
+	fun stopAll(promise: Promise) {
+		try {
+			scanCallback?.let { scanner?.stopScan(it) }
+			scanCallback = null
+			legacyAdvertiseCallback?.let { advertiser?.stopAdvertising(it) }
+			legacyAdvertiseCallback = null
+			extendedAdvertiseCallback?.let { advertiser?.stopAdvertisingSet(it) }
+			extendedAdvertiseCallback = null
+			for (gatt in clientGatts.values) { gatt.disconnect(); gatt.close() }
+			clientGatts.clear()
+			for (device in serverDevices.values) gattServer?.cancelConnection(device)
+			serverDevices.clear()
+			serverMtus.clear()
+			for (pending in pendingSendPromises.values) pending.reject("E_SEND", "stopAll() called")
+			pendingSendPromises.clear()
+			gattServer?.close()
+			gattServer = null
+			serviceUuid = null
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_STOP", e.message, e)
+		}
+	}
+
+	// --- adapter state events -----------------------------------------
+
+	private fun registerAdapterStateReceiver() {
+		val receiver = object : BroadcastReceiver() {
+			override fun onReceive(context: Context, intent: Intent) {
+				val state = intent.getIntExtra(BluetoothAdapter.EXTRA_STATE, BluetoothAdapter.ERROR)
+				val mapped = when (state) {
+					BluetoothAdapter.STATE_ON -> "on"
+					BluetoothAdapter.STATE_OFF -> "off"
+					else -> return // ignore the turning-on/turning-off transitions
+				}
+				emitAdapterState(mapped)
+			}
+		}
+		adapterStateReceiver = receiver
+		val filter = IntentFilter(BluetoothAdapter.ACTION_STATE_CHANGED)
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+			reactApplicationContext.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED)
+		} else {
+			reactApplicationContext.registerReceiver(receiver, filter)
+		}
+	}
+
+	// --- NativeEventEmitter plumbing -----------------------------------
+
+	@ReactMethod
+	fun addListener(eventName: String) {
+		// Required stub: NativeEventEmitter calls this to let native modules
+		// start any listening they only need while JS listeners exist. This
+		// module always listens (adapter receiver, GATT callbacks once
+		// started), so there's nothing to do here.
+	}
+
+	@ReactMethod
+	fun removeListeners(count: Int) {
+		// See addListener().
+	}
+
+	// --- event emission -------------------------------------------------
+
+	private fun emit(eventName: String, params: WritableMap) {
+		reactApplicationContext
+			.getJSModule(DeviceEventManagerModule.RCTDeviceEventEmitter::class.java)
+			.emit(eventName, params)
+	}
+
+	private fun emitScanResult(address: String, rssi: Int, tokenHex: String) {
+		val map = Arguments.createMap()
+		map.putString("address", address)
+		map.putInt("rssi", rssi)
+		map.putString("tokenHex", tokenHex)
+		emit("nearbyScanResult", map)
+	}
+
+	private fun emitConnected(address: String, mtu: Int, role: String) {
+		val map = Arguments.createMap()
+		map.putString("address", address)
+		map.putInt("mtu", mtu)
+		map.putString("role", role)
+		emit("nearbyConnected", map)
+	}
+
+	private fun emitDisconnected(address: String, reason: String) {
+		val map = Arguments.createMap()
+		map.putString("address", address)
+		map.putString("reason", reason)
+		emit("nearbyDisconnected", map)
+	}
+
+	private fun emitFrame(address: String, bytes: ByteArray) {
+		val map = Arguments.createMap()
+		map.putString("address", address)
+		map.putString("base64", Base64.encodeToString(bytes, Base64.NO_WRAP))
+		emit("nearbyFrame", map)
+	}
+
+	private fun emitError(code: String, message: String) {
+		val map = Arguments.createMap()
+		map.putString("code", code)
+		map.putString("message", message)
+		emit("nearbyError", map)
+	}
+
+	private fun emitAdapterState(state: String) {
+		val map = Arguments.createMap()
+		map.putString("state", state)
+		emit("nearbyAdapterState", map)
+	}
+
+	// --- hex helpers ---------------------------------------------------
+
+	private fun hexToBytes(hex: String): ByteArray {
+		val out = ByteArray(hex.length / 2)
+		for (i in out.indices) {
+			val high = Character.digit(hex[i * 2], 16)
+			val low = Character.digit(hex[i * 2 + 1], 16)
+			out[i] = ((high shl 4) + low).toByte()
+		}
+		return out
+	}
+
+	private fun bytesToHex(bytes: ByteArray): String {
+		val sb = StringBuilder(bytes.size * 2)
+		for (b in bytes) sb.append(String.format("%02x", b))
+		return sb.toString()
+	}
+}
