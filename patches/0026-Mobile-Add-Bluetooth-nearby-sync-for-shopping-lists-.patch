@@ -0,0 +1,360 @@
+// State machine for one Bluetooth LE connection (one peer device), see
+// PROTOCOL.md and docs/KONZEPT.md section 3. Knows nothing about BLE itself
+// -- it's fed raw frame bytes and calls back to send raw frame bytes, so it
+// can be driven identically by the real transport (nearbyManager.ts) and by
+// tests.
+import { VerifiedEvent } from 'nostr-tools';
+import { randomBytes, bytesToHex } from '../core/crypto';
+import { debugLog } from '../../utils/debugLog';
+import {
+	decodeFrame, deriveProof, encodeFrame, Frame, FrameReassembler, FrameType, fragmentMessage,
+	HelloMessage, MessageIdAllocator, ProofMessage, SummaryItemEntry, SummaryMessage, PROTOCOL_VERSION,
+} from './protocol';
+
+const log = debugLog('lists.nearby');
+
+export const HEARTBEAT_INTERVAL_MS = 10 * 1000;
+export const PEER_LOST_TIMEOUT_MS = 30 * 1000;
+export const HANDSHAKE_TIMEOUT_MS = 15 * 1000;
+
+export type SessionState = 'handshaking' | 'syncing' | 'active' | 'closed';
+
+export interface SessionSummary {
+	items: SummaryItemEntry[];
+	directoryTime: number;
+}
+
+export interface SessionCallbacks {
+	// Writes one already-framed chunk to the peer. Resolves once the native
+	// layer has confirmed the write (or notification) -- the session sends
+	// its next frame only after this resolves, matching the native queue.
+	sendFrame: (bytes: Uint8Array)=> Promise<void>;
+	// Whether `pubkey` is an active member of this list, per the locally held
+	// directory.
+	isActiveMember: (pubkey: string)=> Promise<boolean>;
+	localSummary: ()=> Promise<SessionSummary>;
+	// Builds a fresh, signed item event from this device's own merged state
+	// for `dTag`, or null if this device has no such item.
+	buildLocalItemEvent: (dTag: string)=> Promise<VerifiedEvent | null>;
+	// Verifies signature + membership, decrypts and merges; returns whether
+	// it was accepted.
+	applyRemoteItemEvent: (event: VerifiedEvent)=> Promise<boolean>;
+	localDirectoryEvent: ()=> Promise<VerifiedEvent | null>;
+	applyRemoteDirectoryEvent: (event: VerifiedEvent)=> Promise<boolean>;
+	// Open lists only: accepts a peer that proved knowledge of the list's
+	// content key but isn't in the directory yet (QR-code join without
+	// internet, see docs/KONZEPT.md section 3). Absent/no-op for managed
+	// lists and once relay sync exists.
+	acceptUnknownOpenListMember?: (pubkey: string, deviceName: string | undefined)=> Promise<void>;
+	// Called as soon as the peer's hello arrives (before the handshake is
+	// verified), so the caller can resolve a duplicate connection to the
+	// same peer -- see nearbyManager.ts.
+	onPeerIdentified?: (peerPubkey: string)=> void;
+	onStateChange?: (state: SessionState)=> void;
+	onSyncComplete?: (sent: number, received: number)=> void;
+	onClosed?: (reason: string)=> void;
+	now?: ()=> number;
+	setTimer?: (fn: ()=> void, ms: number)=> ReturnType<typeof setTimeout>;
+	clearTimer?: (handle: ReturnType<typeof setTimeout>)=> void;
+}
+
+export interface SessionOptions {
+	listId: string;
+	localPubkey: string;
+	localDeviceName?: string;
+	contentKey: Uint8Array;
+	mtu: number;
+	isOpenList: boolean;
+}
+
+// One BLE connection's handshake + sync + live-push state machine. Both
+// sides of a connection run an identical Session -- there's no separate
+// "initiator"/"responder" code path; whichever side happens to have
+// established the underlying GATT connection (central vs. peripheral) only
+// matters to the transport, not here.
+export class Session {
+	public state: SessionState = 'handshaking';
+	public peerPubkey: string | null = null;
+
+	private readonly options: SessionOptions;
+	private readonly callbacks: SessionCallbacks;
+	private readonly localNonce = bytesToHex(randomBytes(16));
+	private peerNonce: string | null = null;
+	private readonly reassembler = new FrameReassembler();
+	private readonly messageIds = new MessageIdAllocator();
+	private readonly now: ()=> number;
+	private readonly setTimer: (fn: ()=> void, ms: number)=> ReturnType<typeof setTimeout>;
+	private readonly clearTimer: (handle: ReturnType<typeof setTimeout>)=> void;
+
+	private helloSent = false;
+	private proofSent = false;
+	private proofVerified = false;
+	private localSummary: SessionSummary | null = null;
+	private peerSummary: SessionSummary | null = null;
+	private sentEventCount = 0;
+	private receivedEventCount = 0;
+	private closed = false;
+
+	private handshakeTimer: ReturnType<typeof setTimeout> | null = null;
+	private heartbeatTimer: ReturnType<typeof setTimeout> | null = null;
+	private peerLostTimer: ReturnType<typeof setTimeout> | null = null;
+
+	public constructor(options: SessionOptions, callbacks: SessionCallbacks) {
+		this.options = options;
+		this.callbacks = callbacks;
+		this.now = callbacks.now ?? (() => Date.now());
+		this.setTimer = callbacks.setTimer ?? ((fn, ms) => setTimeout(fn, ms));
+		this.clearTimer = callbacks.clearTimer ?? (handle => clearTimeout(handle));
+	}
+
+	// Begins the handshake by sending our hello. Call once, right after the
+	// underlying connection is established.
+	public start(): void {
+		this.handshakeTimer = this.setTimer(() => this.fail('Handshake timed out'), HANDSHAKE_TIMEOUT_MS);
+		void this.sendHello();
+	}
+
+	private setState(state: SessionState): void {
+		if (this.state === state) return;
+		this.state = state;
+		this.callbacks.onStateChange?.(state);
+	}
+
+	private async sendHello(): Promise<void> {
+		const message: HelloMessage = {
+			v: PROTOCOL_VERSION, listId: this.options.listId, pubkey: this.options.localPubkey, nonce: this.localNonce,
+			deviceName: this.options.localDeviceName,
+		};
+		this.helloSent = true;
+		await this.sendMessage(FrameType.Hello, message);
+	}
+
+	// Feeds one raw frame received from the transport. Call for every
+	// `nearbyFrame` event on this connection.
+	public async onFrameBytes(bytes: Uint8Array): Promise<void> {
+		if (this.closed) return;
+		this.resetPeerLostTimer();
+		let frame: Frame;
+		try {
+			frame = decodeFrame(bytes);
+		} catch (error) {
+			log.warn('Dropped malformed nearby frame', { error: String(error) });
+			return;
+		}
+		const message = this.reassembler.addFrame(frame, this.now());
+		if (!message) return; // still reassembling
+		try {
+			await this.onMessage(message.type, message.value);
+		} catch (error) {
+			log.warn('Nearby session: error handling incoming message', { type: message.type, error: String(error) });
+			this.fail('Error while handling an incoming message');
+		}
+	}
+
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any -- see FrameReassembler#addFrame
+	private async onMessage(type: FrameType, value: any): Promise<void> {
+		switch (type) {
+		case FrameType.Hello: return this.onHello(value as HelloMessage);
+		case FrameType.Proof: return this.onProof(value as ProofMessage);
+		case FrameType.Summary: return this.onSummary(value as SummaryMessage);
+		case FrameType.Event: return this.onEventMessage(value as { event: VerifiedEvent });
+		case FrameType.Directory: return this.onDirectoryMessage(value as { event: VerifiedEvent });
+		case FrameType.Heartbeat: return; // resetPeerLostTimer() above already handled it
+		case FrameType.Done: return this.onPeerDone();
+		case FrameType.Bye: return this.close('Peer said goodbye');
+		default: log.warn('Ignoring unknown nearby frame type', { type });
+		}
+	}
+
+	private async onHello(hello: HelloMessage): Promise<void> {
+		if (hello.v !== PROTOCOL_VERSION || hello.listId !== this.options.listId) {
+			this.fail('Peer hello is for a different list or protocol version');
+			return;
+		}
+		this.peerPubkey = hello.pubkey;
+		this.peerNonce = hello.nonce;
+		this.callbacks.onPeerIdentified?.(hello.pubkey);
+		this.pendingDeviceName = hello.deviceName;
+		if (!this.helloSent) await this.sendHello();
+		await this.sendProof();
+	}
+
+	private pendingDeviceName: string | undefined;
+
+	private async sendProof(): Promise<void> {
+		if (this.proofSent || !this.peerNonce) return;
+		this.proofSent = true;
+		const proof = deriveProof(this.options.contentKey, this.options.localPubkey, this.peerNonce, this.localNonce);
+		await this.sendMessage(FrameType.Proof, { proof } as ProofMessage);
+	}
+
+	private async onProof(message: ProofMessage): Promise<void> {
+		if (!this.peerPubkey || !this.peerNonce) {
+			this.fail('Received proof before hello');
+			return;
+		}
+		const expected = deriveProof(this.options.contentKey, this.peerPubkey, this.localNonce, this.peerNonce);
+		if (expected !== message.proof) {
+			log.warn('Nearby handshake proof mismatch', { peer: this.peerPubkey.slice(0, 8) });
+			this.fail('Proof verification failed (wrong list key)');
+			return;
+		}
+		const isMember = await this.callbacks.isActiveMember(this.peerPubkey);
+		if (!isMember) {
+			if (this.options.isOpenList && this.callbacks.acceptUnknownOpenListMember) {
+				// Correct proof against our content key is, for an open list,
+				// exactly the knowledge an invite grants -- accept and register
+				// them (join without internet), see docs/KONZEPT.md section 3.
+				await this.callbacks.acceptUnknownOpenListMember(this.peerPubkey, this.pendingDeviceName);
+			} else {
+				log.info('Nearby peer proof ok but not a directory member; closing', { peer: this.peerPubkey.slice(0, 8) });
+				this.fail('Peer is not a member of this list');
+				return;
+			}
+		}
+		this.proofVerified = true;
+		if (this.handshakeTimer) {
+			this.clearTimer(this.handshakeTimer);
+			this.handshakeTimer = null;
+		}
+		log.info('Nearby handshake verified', { peer: this.peerPubkey.slice(0, 8) });
+		this.setState('syncing');
+		await this.sendSummary();
+	}
+
+	// Memoized: onProof() and (if the peer's summary arrives first, which can
+	// happen -- there's no guaranteed ordering between "we decided to send
+	// our summary" and "the peer's summary arrived") onSummary() both need
+	// our own summary computed and sent exactly once, and onSummary() must
+	// never run pushOutgoingDiff() against a summary that hasn't actually
+	// been sent yet. Sharing the one in-flight promise guarantees both.
+	private summaryPromise: Promise<void> | null = null;
+
+	private sendSummary(): Promise<void> {
+		if (!this.summaryPromise) {
+			this.summaryPromise = (async () => {
+				this.localSummary = await this.callbacks.localSummary();
+				await this.sendMessage(FrameType.Summary, this.localSummary as SummaryMessage);
+			})();
+		}
+		return this.summaryPromise;
+	}
+
+	private async onSummary(message: SummaryMessage): Promise<void> {
+		if (!this.proofVerified) {
+			this.fail('Received summary before the handshake was verified');
+			return;
+		}
+		await this.sendSummary(); // ensure ours has been computed + sent too, see sendSummary()
+		this.peerSummary = message;
+		await this.pushOutgoingDiff();
+		await this.sendMessage(FrameType.Done, {});
+	}
+
+	// Sends every item and (if newer) the directory this device has that the
+	// peer's summary shows as missing or older.
+	private async pushOutgoingDiff(): Promise<void> {
+		if (!this.localSummary || !this.peerSummary) return;
+		const peerTimes = new Map(this.peerSummary.items.map(i => [i.dTag, i.maxFieldTime]));
+		for (const item of this.localSummary.items) {
+			const peerTime = peerTimes.get(item.dTag);
+			if (peerTime !== undefined && peerTime >= item.maxFieldTime) continue;
+			const event = await this.callbacks.buildLocalItemEvent(item.dTag);
+			if (event) await this.sendEvent(event);
+		}
+		if (this.localSummary.directoryTime > this.peerSummary.directoryTime) {
+			const event = await this.callbacks.localDirectoryEvent();
+			if (event) await this.sendDirectoryEvent(event);
+		}
+	}
+
+	private peerDone = false;
+
+	private async onPeerDone(): Promise<void> {
+		this.peerDone = true;
+		this.maybeFinishInitialSync();
+	}
+
+	private maybeFinishInitialSync(): void {
+		if (this.state !== 'syncing') return;
+		if (!this.peerDone) return;
+		this.setState('active');
+		this.callbacks.onSyncComplete?.(this.sentEventCount, this.receivedEventCount);
+		log.info('Nearby sync complete', { peer: this.peerPubkey?.slice(0, 8), sent: this.sentEventCount, received: this.receivedEventCount });
+		this.startHeartbeat();
+	}
+
+	private async onEventMessage(message: { event: VerifiedEvent }): Promise<void> {
+		const accepted = await this.callbacks.applyRemoteItemEvent(message.event);
+		if (accepted) this.receivedEventCount++;
+	}
+
+	private async onDirectoryMessage(message: { event: VerifiedEvent }): Promise<void> {
+		await this.callbacks.applyRemoteDirectoryEvent(message.event);
+	}
+
+	private async sendEvent(event: VerifiedEvent): Promise<void> {
+		await this.sendMessage(FrameType.Event, { event });
+		this.sentEventCount++;
+	}
+
+	private async sendDirectoryEvent(event: VerifiedEvent): Promise<void> {
+		await this.sendMessage(FrameType.Directory, { event });
+	}
+
+	// Pushes a single locally-changed item to an already-active peer (called
+	// by nearbyManager on store.onChange once the initial sync is done).
+	public async pushLocalChange(dTag: string): Promise<void> {
+		if (this.state !== 'active' && this.state !== 'syncing') return;
+		const event = await this.callbacks.buildLocalItemEvent(dTag);
+		if (event) await this.sendEvent(event);
+	}
+
+	public async pushLocalDirectoryChange(): Promise<void> {
+		if (this.state !== 'active' && this.state !== 'syncing') return;
+		const event = await this.callbacks.localDirectoryEvent();
+		if (event) await this.sendDirectoryEvent(event);
+	}
+
+	private async sendMessage(type: FrameType, value: unknown): Promise<void> {
+		const messageId = this.messageIds.allocate();
+		const frames = fragmentMessage(type, messageId, value, this.options.mtu);
+		for (const frame of frames) {
+			if (this.closed) return;
+			// eslint-disable-next-line no-await-in-loop -- frames of the same message must be sent in order, one write at a time (see PROTOCOL.md)
+			await this.callbacks.sendFrame(encodeFrame(frame));
+		}
+		if (type === FrameType.Done) this.maybeFinishInitialSync();
+	}
+
+	private startHeartbeat(): void {
+		const tick = (): void => {
+			if (this.closed) return;
+			void this.sendMessage(FrameType.Heartbeat, {});
+			this.heartbeatTimer = this.setTimer(tick, HEARTBEAT_INTERVAL_MS);
+		};
+		this.heartbeatTimer = this.setTimer(tick, HEARTBEAT_INTERVAL_MS);
+		this.resetPeerLostTimer();
+	}
+
+	private resetPeerLostTimer(): void {
+		if (this.state !== 'active' && this.state !== 'syncing') return;
+		if (this.peerLostTimer) this.clearTimer(this.peerLostTimer);
+		this.peerLostTimer = this.setTimer(() => this.fail('No frame from peer for 30s'), PEER_LOST_TIMEOUT_MS);
+	}
+
+	private fail(reason: string): void {
+		log.info('Nearby session closing', { peer: this.peerPubkey?.slice(0, 8), reason });
+		this.close(reason);
+	}
+
+	public close(reason: string): void {
+		if (this.closed) return;
+		this.closed = true;
+		if (this.handshakeTimer) this.clearTimer(this.handshakeTimer);
+		if (this.heartbeatTimer) this.clearTimer(this.heartbeatTimer);
+		if (this.peerLostTimer) this.clearTimer(this.peerLostTimer);
+		this.setState('closed');
+		this.callbacks.onClosed?.(reason);
+	}
+}
