+import * as React from 'react';
+import { useMemo } from 'react';
+import { connect } from 'react-redux';
+import { StyleSheet, Text, TouchableOpacity, View, ViewStyle, TextStyle } from 'react-native';
+import { AppState } from '../utils/types';
+import { _ } from '@joplin/lib/locale';
+import Modal from './Modal';
+import { themeStyle } from './global-style';
+import { getTileColor, TileColorName, tileColorNames } from '../utils/tileColors';
+
+interface Props {
+	themeId: number;
+	isDarkTheme: boolean;
+	visible: boolean;
+	onSelect: (color: TileColorName|null)=> void;
+	onClose: ()=> void;
+}
+
+const colorLabels = (): Record<TileColorName, string> => ({
+	red: _('Red'),
+	orange: _('Orange'),
+	yellow: _('Yellow'),
+	green: _('Green'),
+	teal: _('Teal'),
+	blue: _('Blue'),
+	purple: _('Purple'),
+	pink: _('Pink'),
+	brown: _('Brown'),
+	grey: _('Grey'),
+});
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+
+		const container: ViewStyle = {
+			backgroundColor: theme.backgroundColor,
+			borderRadius: 4,
+			maxWidth: 400,
+			width: '90%',
+			alignSelf: 'center',
+			marginVertical: 'auto',
+			padding: theme.margin,
+		};
+
+		const title: TextStyle = {
+			...theme.headerStyle,
+			marginBottom: theme.marginTop,
+		};
+
+		const grid: ViewStyle = {
+			flexDirection: 'row',
+			flexWrap: 'wrap',
+			justifyContent: 'center',
+		};
+
+		const swatch: ViewStyle = {
+			width: 44,
+			height: 44,
+			borderRadius: 22,
+			margin: 6,
+			borderWidth: 1,
+			borderColor: theme.dividerColor,
+			alignItems: 'center',
+			justifyContent: 'center',
+		};
+
+		const noneLabel: TextStyle = {
+			color: theme.color,
+			fontSize: theme.fontSizeSmaller,
+		};
+
+		return StyleSheet.create({ container, title, grid, swatch, noneLabel });
+	}, [themeId]);
+};
+
+const NoteTileColorDialogComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const labels = colorLabels();
+
+	if (!props.visible) return null;
+
+	return (
+		<Modal visible={props.visible} onClose={props.onClose} containerStyle={styles.container}>
+			<Text style={styles.title}>{_('Colour')}</Text>
+			<View style={styles.grid}>
+				<TouchableOpacity
+					style={styles.swatch}
+					onPress={() => props.onSelect(null)}
+					accessibilityRole='button'
+					accessibilityLabel={_('None')}
+				>
+					<Text style={styles.noneLabel}>{'✕'}</Text>
+				</TouchableOpacity>
+				{tileColorNames.map(name => (
+					<TouchableOpacity
+						key={name}
+						testID={`note-tile-color-${name}`}
+						style={[styles.swatch, { backgroundColor: getTileColor(name, props.isDarkTheme).background }]}
+						onPress={() => props.onSelect(name)}
+						accessibilityRole='button'
+						accessibilityLabel={labels[name]}
+					/>
+				))}
+			</View>
+		</Modal>
+	);
+};
+
+export default connect((state: AppState) => {
+	return {
+		themeId: state.settings.theme,
+		isDarkTheme: themeStyle(state.settings.theme).appearance === 'dark',
+	};
+})(NoteTileColorDialogComponent);
