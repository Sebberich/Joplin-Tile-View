+import { contrastRatio, getTileColor, isTileColorName, tileColorNames } from './tileColors';
+
+describe('tileColors', () => {
+	test.each([false, true])('text keeps a contrast of at least 4.5:1 (dark theme: %s)', isDark => {
+		for (const name of tileColorNames) {
+			const variant = getTileColor(name, isDark);
+			expect(contrastRatio(variant.background, variant.text)).toBeGreaterThanOrEqual(4.5);
+			expect(contrastRatio(variant.background, variant.secondaryText)).toBeGreaterThanOrEqual(4.5);
+		}
+	});
+
+	test('should compute known contrast ratios', () => {
+		expect(contrastRatio('#000000', '#ffffff')).toBeCloseTo(21, 5);
+		expect(contrastRatio('#777777', '#777777')).toBeCloseTo(1, 5);
+	});
+
+	test('should have the ten documented colours', () => {
+		expect(tileColorNames).toHaveLength(10);
+		expect(isTileColorName('teal')).toBe(true);
+		expect(isTileColorName('black')).toBe(false);
+	});
+});
diff --git a/packages/app-mobile/utils/tileColors.ts b/packages/app-mobile/utils/tileColors.ts
new file mode 100644
index 0000000..34d50ee
--- /dev/null
+++ b/packages/app-mobile/utils/tileColors.ts
@@ -0,0 +1,65 @@
+// Colour palette for note tiles (Google-Keep style). A note's colour is stored as a
+// `color:<name>` tag, so the names below are part of the synced data format.
+
+export const tileColorNames = ['red', 'orange', 'yellow', 'green', 'teal', 'blue', 'purple', 'pink', 'brown', 'grey'] as const;
+export type TileColorName = typeof tileColorNames[number];
+
+export interface TileColorVariant {
+	background: string;
+	text: string;
+	// Used for the preview text under the title.
+	secondaryText: string;
+}
+
+interface TileColorEntry {
+	light: TileColorVariant;
+	dark: TileColorVariant;
+}
+
+const lightText = { text: '#1f1f1f', secondaryText: '#2f3133' };
+const darkText = { text: '#f1f3f4', secondaryText: '#c9ccd0' };
+
+const entry = (light: string, dark: string): TileColorEntry => ({
+	light: { background: light, ...lightText },
+	dark: { background: dark, ...darkText },
+});
+
+export const tileColorPalette: Record<TileColorName, TileColorEntry> = {
+	red: entry('#f28b82', '#5c2b29'),
+	orange: entry('#fbbc04', '#614a19'),
+	yellow: entry('#fff475', '#5b5517'),
+	green: entry('#ccff90', '#345920'),
+	teal: entry('#a7ffeb', '#16504b'),
+	blue: entry('#aecbfa', '#254a73'),
+	purple: entry('#d7aefb', '#42275e'),
+	pink: entry('#fdcfe8', '#5b2245'),
+	brown: entry('#e6c9a8', '#4a3320'),
+	grey: entry('#e8eaed', '#3c3f43'),
+};
+
+export const isTileColorName = (name: string): name is TileColorName => {
+	return (tileColorNames as readonly string[]).includes(name);
+};
+
+export const getTileColor = (name: TileColorName, isDark: boolean): TileColorVariant => {
+	return tileColorPalette[name][isDark ? 'dark' : 'light'];
+};
+
+const channelToLinear = (value: number) => {
+	const v = value / 255;
+	return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+};
+
+const relativeLuminance = (hex: string) => {
+	const m = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex);
+	if (!m) throw new Error(`Invalid colour: ${hex}`);
+	const [r, g, b] = [m[1], m[2], m[3]].map(c => channelToLinear(parseInt(c, 16)));
+	return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+
+// WCAG 2.x contrast ratio between two #rrggbb colours.
+export const contrastRatio = (colorA: string, colorB: string) => {
+	const a = relativeLuminance(colorA);
+	const b = relativeLuminance(colorB);
+	return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
+};
