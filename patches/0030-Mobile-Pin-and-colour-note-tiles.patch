@@ -0,0 +1,64 @@
+import { setupDatabaseAndSynchronizer, switchClient } from '@joplin/lib/testing/test-utils';
+import Folder from '@joplin/lib/models/Folder';
+import Note from '@joplin/lib/models/Note';
+import Tag from '@joplin/lib/models/Tag';
+import { colorFromTagTitle, loadTileTags, orderPinnedFirst, setNotesColor, setNotesPinned, tileInfoFromTagTitles } from './tileTags';
+
+const tagTitles = async (noteId: string) => (await Tag.tagsByNoteId(noteId)).map(t => t.title).sort();
+
+describe('tileTags', () => {
+	beforeEach(async () => {
+		await setupDatabaseAndSynchronizer(1);
+		await switchClient(1);
+	});
+
+	test('should parse tag titles', () => {
+		expect(colorFromTagTitle('color:red')).toBe('red');
+		expect(colorFromTagTitle('Color:Blue')).toBe('blue');
+		expect(colorFromTagTitle('color:magenta')).toBeNull();
+		expect(colorFromTagTitle('red')).toBeNull();
+		expect(tileInfoFromTagTitles(['work', 'pinned', 'color:teal'])).toEqual({ pinned: true, color: 'teal' });
+	});
+
+	test('should put pinned notes first and keep the order stable', () => {
+		const notes = ['a', 'b', 'c', 'd', 'e'].map(id => ({ id }));
+		const ordered = orderPinnedFirst(notes, { b: { pinned: true, color: null }, d: { pinned: true, color: 'red' } });
+		expect(ordered.map(n => n.id)).toEqual(['b', 'd', 'a', 'c', 'e']);
+		expect(orderPinnedFirst(notes, {}).map(n => n.id)).toEqual(['a', 'b', 'c', 'd', 'e']);
+	});
+
+	test('should pin and unpin notes through the pinned tag', async () => {
+		const folder = await Folder.save({ title: 'f' });
+		const n1 = await Note.save({ title: 'n1', parent_id: folder.id });
+		const n2 = await Note.save({ title: 'n2', parent_id: folder.id });
+
+		await setNotesPinned([n1.id, n2.id], true);
+		expect(await tagTitles(n1.id)).toEqual(['pinned']);
+		expect((await loadTileTags([n1.id, n2.id]))[n2.id].pinned).toBe(true);
+
+		await setNotesPinned([n1.id], false);
+		expect(await tagTitles(n1.id)).toEqual([]);
+		const info = await loadTileTags([n1.id, n2.id]);
+		expect(info[n1.id]).toBeUndefined();
+		expect(info[n2.id].pinned).toBe(true);
+	});
+
+	test('should replace the colour tag and leave other tags alone', async () => {
+		const folder = await Folder.save({ title: 'f' });
+		const note = await Note.save({ title: 'n', parent_id: folder.id });
+		await Tag.addNoteTagByTitle(note.id, 'work');
+
+		await setNotesColor([note.id], 'red');
+		expect(await tagTitles(note.id)).toEqual(['color:red', 'work']);
+
+		await setNotesColor([note.id], 'blue');
+		expect(await tagTitles(note.id)).toEqual(['color:blue', 'work']);
+		expect((await loadTileTags([note.id]))[note.id].color).toBe('blue');
+
+		await setNotesColor([note.id], 'blue');
+		expect(await tagTitles(note.id)).toEqual(['color:blue', 'work']);
+
+		await setNotesColor([note.id], null);
+		expect(await tagTitles(note.id)).toEqual(['work']);
+	});
+});
diff --git a/packages/app-mobile/utils/tileTags.ts b/packages/app-mobile/utils/tileTags.ts
new file mode 100644
index 0000000..0111ee2
--- /dev/null
+++ b/packages/app-mobile/utils/tileTags.ts
@@ -0,0 +1,126 @@
+import Tag from '@joplin/lib/models/Tag';
+import { debugLog } from './debugLog';
+import { isTileColorName, TileColorName } from './tileColors';
+
+const log = debugLog('tiles');
+
+// Pinning and colouring of note tiles is stored in ordinary Joplin tags, so it syncs to
+// the desktop app and other devices.
+export const pinnedTagTitle = 'pinned';
+export const colorTagPrefix = 'color:';
+
+export interface TileTagInfo {
+	pinned: boolean;
+	color: TileColorName|null;
+}
+
+export type TileTagMap = Record<string, TileTagInfo>;
+
+export const colorTagTitle = (color: TileColorName) => `${colorTagPrefix}${color}`;
+
+export const colorFromTagTitle = (title: string): TileColorName|null => {
+	const lower = (title ?? '').trim().toLowerCase();
+	if (!lower.startsWith(colorTagPrefix)) return null;
+	const name = lower.substring(colorTagPrefix.length).trim();
+	return isTileColorName(name) ? name : null;
+};
+
+export const tileInfoFromTagTitles = (titles: string[]): TileTagInfo => {
+	let pinned = false;
+	let color: TileColorName|null = null;
+	for (const title of titles) {
+		if ((title ?? '').trim().toLowerCase() === pinnedTagTitle) pinned = true;
+		const c = colorFromTagTitle(title);
+		if (c && !color) color = c;
+	}
+	return { pinned, color };
+};
+
+// Stable partition: pinned notes first, each group keeping its incoming (sort) order.
+export const orderPinnedFirst = <T extends { id?: string }>(notes: T[], tileTags: TileTagMap): T[] => {
+	const pinned: T[] = [];
+	const others: T[] = [];
+	for (const note of notes) {
+		(tileTags[note.id]?.pinned ? pinned : others).push(note);
+	}
+	return [...pinned, ...others];
+};
+
+// Simple pub/sub so that tiles refresh right after a pin/colour change made through this module.
+type Listener = ()=> void;
+const listeners: Listener[] = [];
+export const onTileTagsChanged = (listener: Listener) => {
+	listeners.push(listener);
+	return () => {
+		const index = listeners.indexOf(listener);
+		if (index >= 0) listeners.splice(index, 1);
+	};
+};
+const notifyChanged = () => {
+	for (const listener of [...listeners]) listener();
+};
+
+const chunkSize = 400;
+
+// Loads pinned/colour state for many notes using one query per chunk of note IDs (rather than
+// one query per note).
+export const loadTileTags = async (noteIds: string[]): Promise<TileTagMap> => {
+	const result: TileTagMap = {};
+	for (let i = 0; i < noteIds.length; i += chunkSize) {
+		const chunk = noteIds.slice(i, i + chunkSize);
+		const rows: { note_id: string; title: string }[] = await Tag.db().selectAll(
+			`SELECT note_tags.note_id AS note_id, tags.title AS title FROM note_tags
+			JOIN tags ON tags.id = note_tags.tag_id
+			WHERE note_tags.note_id IN (${chunk.map(() => '?').join(',')})
+			AND (tags.title = ? COLLATE NOCASE OR tags.title LIKE ? ESCAPE '\\')`,
+			[...chunk, pinnedTagTitle, `${colorTagPrefix}%`],
+		);
+
+		const titlesByNote: Record<string, string[]> = {};
+		for (const row of rows) {
+			if (!titlesByNote[row.note_id]) titlesByNote[row.note_id] = [];
+			titlesByNote[row.note_id].push(row.title);
+		}
+		for (const noteId of chunk) {
+			const info = tileInfoFromTagTitles(titlesByNote[noteId] ?? []);
+			if (info.pinned || info.color) result[noteId] = info;
+		}
+	}
+	return result;
+};
+
+export const setNotesPinned = async (noteIds: string[], pinned: boolean) => {
+	for (const noteId of noteIds) {
+		if (pinned) {
+			await Tag.addNoteTagByTitle(noteId, pinnedTagTitle);
+		} else {
+			const tags = await Tag.tagsByNoteId(noteId);
+			for (const tag of tags) {
+				if (tag.title.trim().toLowerCase() === pinnedTagTitle) await Tag.removeNote(tag.id, noteId);
+			}
+		}
+	}
+	log.info('Pinned state changed', { pinned, noteCount: noteIds.length });
+	notifyChanged();
+};
+
+// Sets the tile colour of the notes. A note has at most one colour tag, so any existing colour
+// tag is removed first. `color` null removes the colour.
+export const setNotesColor = async (noteIds: string[], color: TileColorName|null) => {
+	const wanted = color ? colorTagTitle(color) : null;
+	for (const noteId of noteIds) {
+		const tags = await Tag.tagsByNoteId(noteId);
+		let hasWanted = false;
+		for (const tag of tags) {
+			if (!colorFromTagTitle(tag.title)) continue;
+			if (wanted && tag.title.trim().toLowerCase() === wanted) {
+				hasWanted = true;
+			} else {
+				await Tag.removeNote(tag.id, noteId);
+			}
+		}
+		if (wanted && !hasWanted) await Tag.addNoteTagByTitle(noteId, wanted);
+	}
+	log.info('Colour changed', { color, noteCount: noteIds.length });
+	notifyChanged();
+};
