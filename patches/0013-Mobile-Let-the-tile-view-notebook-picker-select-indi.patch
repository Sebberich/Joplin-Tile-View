+
+// Whether every visible folder is selected -- this is the condition under which the "All
+// notebooks" row is shown as checked.
+export const isAllSelected = (selectedIds: string[], folders: FolderEntity[]) => {
+	const visibleIds = getVisibleFolders(folders).map(folder => folder.id);
+	if (!visibleIds.length) return false;
+	const selected = new Set(selectedIds);
+	return visibleIds.every(id => selected.has(id));
+};
+
+// Converts the stored setting value ('' or a comma-separated ID list) to the set of folder IDs
+// the dialog should start with selected. An empty stored value means "all", so it expands to
+// every currently-visible folder. IDs that no longer refer to a visible folder are dropped.
+export const workingSetFromStoredValue = (stored: string, folders: FolderEntity[]) => {
+	const visibleIds = getVisibleFolders(folders).map(folder => folder.id);
+	if (!stored) return visibleIds;
+	const storedIds = new Set(stored.split(',').filter(Boolean));
+	return visibleIds.filter(id => storedIds.has(id));
+};
+
+// Converts a working selection back to the stored setting format, preserving the "all" (empty
+// string) semantics when every visible folder is selected.
+export const storedValueFromWorkingSet = (selectedIds: string[], folders: FolderEntity[]) => {
+	return isAllSelected(selectedIds, folders) ? '' : selectedIds.join(',');
+};
+
+// How many of `folderId` and its descendants are selected, out of how many there are in total.
+// Used to show a folder as fully checked, unchecked, or partially selected (as an "(n/m)" count,
+// since the checkbox in use has no indeterminate state).
+export const getFolderSelectionCounts = (folderId: string, selectedIds: string[], folders: FolderEntity[]) => {
+	const ids = [folderId, ...getDescendantFolderIds(folderId, folders)];
+	const selected = new Set(selectedIds);
+	return { selected: ids.filter(id => selected.has(id)).length, total: ids.length };
+};
