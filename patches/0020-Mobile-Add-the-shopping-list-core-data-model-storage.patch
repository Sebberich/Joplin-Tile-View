+import { VerifiedEvent } from 'nostr-tools';
+import { ListsDatabase } from './db';
+import { bytesToHex, deriveOpenListKeys, dTag, hexToBytes } from './crypto';
+import { buildJoinRequestEvent } from './events';
+import {
+	createManagedInviteToken,
