diff --git a/packages/app-mobile/lists/core/crypto.test.ts b/packages/app-mobile/lists/core/crypto.test.ts
new file mode 100644
index 0000000..a061138
--- /dev/null
+++ b/packages/app-mobile/lists/core/crypto.test.ts
@@ -0,0 +1,95 @@
+import { finalizeEvent, getPublicKey, verifyEvent } from 'nostr-tools';
+import {
+	bytesToHex,
+	conversationKey,
+	decryptWithKey,
+	deriveOpenListKeys,
+	dTag,
+	encryptWithKey,
+	generateContentKey,
+	generateKeyPair,
+	generateListKey,
+	hexToBytes,
+} from './crypto';
+
+describe('lists/core/crypto', () => {
+	test('generateKeyPair produces a valid, verifiable device key pair', () => {
+		const pair = generateKeyPair();
+		expect(pair.secretKey).toHaveLength(32);
+		expect(pair.publicKey).toMatch(/^[0-9a-f]{64}$/);
+
+		// A pair that can actually sign and be verified with is a usable key pair.
+		const event = finalizeEvent({ kind: 1, tags: [], content: 'hi', created_at: 0 }, pair.secretKey);
+		expect(event.pubkey).toBe(pair.publicKey);
+		expect(verifyEvent(event)).toBe(true);
+	});
+
+	test('generateListKey and generateContentKey produce distinct 32-byte random keys', () => {
+		expect(generateListKey()).toHaveLength(32);
+		expect(bytesToHex(generateListKey())).not.toBe(bytesToHex(generateListKey()));
+		expect(generateContentKey()).toHaveLength(32);
+	});
+
+	test('deriveOpenListKeys is deterministic', () => {
+		const listKey = generateListKey();
+		const a = deriveOpenListKeys(listKey);
+		const b = deriveOpenListKeys(listKey);
+
+		expect(bytesToHex(a.listSecretKey)).toBe(bytesToHex(b.listSecretKey));
+		expect(a.listPubkey).toBe(b.listPubkey);
+		expect(bytesToHex(a.contentKey)).toBe(bytesToHex(b.contentKey));
+	});
+
+	test('deriveOpenListKeys derives a usable list key pair', () => {
+		const { listSecretKey, listPubkey } = deriveOpenListKeys(generateListKey());
+		expect(getPublicKey(listSecretKey)).toBe(listPubkey);
+	});
+
+	test('deriveOpenListKeys derives different keys for different list keys', () => {
+		const a = deriveOpenListKeys(generateListKey());
+		const b = deriveOpenListKeys(generateListKey());
+		expect(a.listPubkey).not.toBe(b.listPubkey);
+		expect(bytesToHex(a.contentKey)).not.toBe(bytesToHex(b.contentKey));
+	});
+
+	test('dTag is stable for the same content key and name, and differs otherwise', () => {
+		const contentKey = generateContentKey();
+		const tagA = dTag(contentKey, 'milch');
+		const tagB = dTag(contentKey, 'milch');
+		expect(tagA).toBe(tagB);
+		expect(tagA).toMatch(/^[0-9a-f]{64}$/);
+
+		expect(dTag(contentKey, 'butter')).not.toBe(tagA);
+		expect(dTag(generateContentKey(), 'milch')).not.toBe(tagA);
+	});
+
+	test('encryptWithKey/decryptWithKey round-trip with a shared content key', () => {
+		const key = generateContentKey();
+		const ciphertext = encryptWithKey(key, 'hello shopping list');
+		expect(ciphertext).not.toContain('hello');
+		expect(decryptWithKey(key, ciphertext)).toBe('hello shopping list');
+	});
+
+	test('decrypting with the wrong key fails', () => {
+		const ciphertext = encryptWithKey(generateContentKey(), 'secret');
+		expect(() => decryptWithKey(generateContentKey(), ciphertext)).toThrow();
+	});
+
+	test('conversationKey lets two device key pairs agree on the same shared secret', () => {
+		const alice = generateKeyPair();
+		const bob = generateKeyPair();
+
+		const aliceToBob = conversationKey(alice.secretKey, bob.publicKey);
+		const bobToAlice = conversationKey(bob.secretKey, alice.publicKey);
+
+		expect(bytesToHex(aliceToBob)).toBe(bytesToHex(bobToAlice));
+
+		const ciphertext = encryptWithKey(aliceToBob, 'join request');
+		expect(decryptWithKey(bobToAlice, ciphertext)).toBe('join request');
+	});
+
+	test('hexToBytes/bytesToHex round-trip', () => {
+		const bytes = generateContentKey();
+		expect(hexToBytes(bytesToHex(bytes))).toEqual(bytes);
+	});
+});
diff --git a/packages/app-mobile/lists/core/crypto.ts b/packages/app-mobile/lists/core/crypto.ts
new file mode 100644
index 0000000..610a22c
--- /dev/null
+++ b/packages/app-mobile/lists/core/crypto.ts
@@ -0,0 +1,56 @@
+import { generateSecretKey, getPublicKey, nip44 } from 'nostr-tools';
+import { bytesToHex, hexToBytes, randomBytes } from '@noble/hashes/utils';
+import { hkdf } from '@noble/hashes/hkdf';
+import { hmac } from '@noble/hashes/hmac';
+import { sha256 } from '@noble/hashes/sha256';
+
+export interface KeyPair {
+	secretKey: Uint8Array;
+	publicKey: string;
+}
+
+// Used for both device identities and a managed list's own (random) key pair.
+export const generateKeyPair = (): KeyPair => {
+	const secretKey = generateSecretKey();
+	return { secretKey, publicKey: getPublicKey(secretKey) };
+};
+
+export const generateListKey = (): Uint8Array => randomBytes(32);
+export const generateContentKey = (): Uint8Array => randomBytes(32);
+
+const deriveKey = (ikm: Uint8Array, info: string, length = 32): Uint8Array => hkdf(sha256, ikm, undefined, info, length);
+
+const LIST_SECRET_KEY_INFO = 'joplin-tiles/list/nostr-sk';
+const CONTENT_KEY_INFO = 'joplin-tiles/list/content-key';
+
+export interface OpenListKeys {
+	listSecretKey: Uint8Array;
+	listPubkey: string;
+	contentKey: Uint8Array;
+}
+
+// Derives an open list's identity and content key from its shared list key
+// (the secret carried by an open-list invite). Deterministic: the same list
+// key always derives the same keys, on any device.
+export const deriveOpenListKeys = (listKey: Uint8Array): OpenListKeys => {
+	const listSecretKey = deriveKey(listKey, LIST_SECRET_KEY_INFO);
+	return {
+		listSecretKey,
+		listPubkey: getPublicKey(listSecretKey),
+		contentKey: deriveKey(listKey, CONTENT_KEY_INFO),
+	};
+};
+
+export const hmacSha256 = (key: Uint8Array, message: string): Uint8Array => hmac(sha256, key, new TextEncoder().encode(message));
+
+// HMAC(contentKey, 'item:' + normalizedName), the addressable event's d-tag.
+export const dTag = (contentKey: Uint8Array, normalizedName: string): string => bytesToHex(hmacSha256(contentKey, `item:${normalizedName}`));
+
+export const encryptWithKey = (key: Uint8Array, plaintext: string): string => nip44.encrypt(plaintext, key);
+export const decryptWithKey = (key: Uint8Array, payload: string): string => nip44.decrypt(payload, key);
+
+// Conversation key for direct (device-to-device) NIP-44 messages, e.g. wrapping
+// a content key for a specific member, or a join request sent to an admin.
+export const conversationKey = (secretKey: Uint8Array, peerPubkey: string): Uint8Array => nip44.getConversationKey(secretKey, peerPubkey);
+
+export { bytesToHex, hexToBytes, randomBytes };
