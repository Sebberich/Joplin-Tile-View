+		this.changes.emit();
+		return list;
+	}
+
+	public async createManagedList(name: string): Promise<ListRecord> {
+		const identity = await this.ensureOpen();
+		const list = await this.db.createList('managed', name);
+		await this.db.upsertMember({ listId: list.id, pubkey: identity.publicKey, name: identity.name, role: 'admin', since: Date.now(), removedAt: null });
+		this.changes.emit();
+		return list;
+	}
+
+	// Decodes an invite (link or code) and creates the local list record for
