+	// managed list, the caller still needs to send the returned join request
+	// to the admin (over relays or Bluetooth) and wait to be added -- nothing
+	// here does that, see the class doc comment.
+	public async joinFromInvite(text: string, deviceName?: string): Promise<JoinResult> {
+		const identity = await this.ensureOpen();
