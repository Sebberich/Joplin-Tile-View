+			const derived = deriveOpenListKeys(invite.listKey);
+			const list: ListRecord = {
+				id: derived.listPubkey, kind: 'open', listKey: bytesToHex(invite.listKey),
+				contentKey: bytesToHex(derived.contentKey), name: 'Shared list', settings: null, relays: null, sortOrder: 0,
+			};
+			await this.db.importList(list);
+			await this.db.upsertMember({ listId: list.id, pubkey: identity.publicKey, name: deviceName ?? identity.name, role: 'member', since: Date.now(), removedAt: null });
+			this.changes.emit();
+			return { type: 'open', list };
+		}
+
+		if (!verifyManagedInviteToken(invite.token, invite.adminPubkey)) throw new Error('Invite signature is invalid');
+		if (isInviteExpired(invite.token)) throw new Error('Invite has expired');
+
+		const list: ListRecord = {
+			id: invite.listPubkey, kind: 'managed', listKey: null, contentKey: null,
+			name: 'Shared list', settings: null, relays: null, sortOrder: 0,
+		};
+		await this.db.importList(list);
+		const joinRequest = buildJoinRequestEvent(identity.secretKey, invite.adminPubkey, {
+			inviteToken: encodeInvite(invite).code,
+			deviceName: deviceName ?? identity.name,
+		});
+		this.changes.emit();
+		return { type: 'managed', list, joinRequest };
+	}
+
+	// Builds an invite for the given list. For an open list any member may
+	// call this (the invite carries the list key itself); for a managed list
+	// only a local admin may, since the invite is signed with this device's
+	// key. `role` only applies to managed lists.
+	public async inviteFor(listId: string, role: Role = 'member'): Promise<EncodedInvite> {
+		const identity = await this.ensureOpen();
+		const list = await this.requireList(listId);
+
+		if (list.kind === 'open') {
+			if (!list.listKey) throw new Error('Open list is missing its list key');
+			return encodeInvite({ kind: 'open', listKey: hexToBytes(list.listKey) });
+		}
+
+		const members = await this.db.members(listId);
+		const self = members.find(m => m.pubkey === identity.publicKey && !m.removedAt);
+		if (!self || self.role !== 'admin') throw new Error('Only an admin can create an invite for this list');
+
+		const token = createManagedInviteToken(identity.secretKey, { role });
+		return encodeInvite({ kind: 'managed', listPubkey: list.id, adminPubkey: identity.publicKey, token });
+	}
+
+	// Adds an item by free-typed name, resolving it against the catalog and
+	// re-opening an existing (bought or deleted) item instead of duplicating
+	// it, so two people adding "Milch" independently land on the same record.
+	public async addItem(listId: string, text: string): Promise<ItemRecord> {
+		const identity = await this.ensureOpen();
+		const list = await this.requireList(listId);
+		if (!list.contentKey) throw new Error('List is not ready yet: no content key');
+		const contentKey = hexToBytes(list.contentKey);
+
+		const match = resolveCatalog(text);
+		const tag = dTag(contentKey, normalizeName(match.canonical));
+		const device = deviceTag(identity.publicKey);
+		const t = await this.nextTimestamp(listId);
+
+		const existing = await this.db.item(listId, tag);
+		if (existing) {
+			if (existing.deleted) {
+				await this.db.undeleteItem(listId, tag, t, device);
+			} else if (!existing.open) {
+				await this.db.setOpen(listId, tag, true, t, device);
+			}
+			this.changes.emit();
+			return (await this.db.item(listId, tag)) as ItemRecord;
+		}
+
+		const record: ItemRecord = {
+			listId, dTag: tag, name: match.canonical,
+			detail: null, detailT: null,
+			category: match.category, categoryT: match.category ? t : null,
+			icon: match.emoji, iconT: match.emoji ? t : null,
+			open: true, openT: t,
+			deleted: false, deletedT: null,
+			device, pending: true,
+		};
+		await this.db.upsertItem(record);
+		this.changes.emit();
+		return record;
+	}
+
+	public async toggleOpen(listId: string, itemDTag: string): Promise<void> {
+		const identity = await this.ensureOpen();
+		const item = await this.db.item(listId, itemDTag);
+		if (!item) throw new Error(`Unknown item: ${itemDTag}`);
+		const t = await this.nextTimestamp(listId);
+		await this.db.setOpen(listId, itemDTag, !item.open, t, deviceTag(identity.publicKey));
+		this.changes.emit();
+	}
+
+	public async setDetail(listId: string, itemDTag: string, detail: string | null): Promise<void> {
+		const identity = await this.ensureOpen();
+		const t = await this.nextTimestamp(listId);
+		await this.db.setDetail(listId, itemDTag, detail, t, deviceTag(identity.publicKey));
+		this.changes.emit();
+	}
+
+	public async removeItem(listId: string, itemDTag: string): Promise<void> {
+		const identity = await this.ensureOpen();
+		const t = await this.nextTimestamp(listId);
+		await this.db.deleteItem(listId, itemDTag, t, deviceTag(identity.publicKey));
+		this.changes.emit();
+	}
+
+	// Merges an incoming (already decrypted) item payload into local state.
+	// Field-wise LWW via mergeItem(), so it doesn't matter whether the remote
+	// or the local record is newer, or which one calls this first.
+	public async applyRemoteItem(listId: string, itemDTag: string, remote: ItemPayload): Promise<ItemRecord> {
+		await this.ensureOpen();
+		const existing = await this.db.item(listId, itemDTag);
+		const merged = existing ? mergeItem(itemRecordToPayload(existing), remote) : remote;
+		const record = payloadToItemRecord(listId, itemDTag, merged, existing?.pending ?? false);
+		await this.db.upsertItem(record);
+		this.changes.emit();
+		return record;
+	}
+
+	public async pendingItems(listId?: string): Promise<ItemRecord[]> {
+		await this.ensureOpen();
+		return this.db.pendingItems(listId);
+	}
+
+	public async markPublished(listId: string, itemDTag: string): Promise<void> {
+		await this.ensureOpen();
+		await this.db.markPublished(listId, itemDTag);
+	}
+}
