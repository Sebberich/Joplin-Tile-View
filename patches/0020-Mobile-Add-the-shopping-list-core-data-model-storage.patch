+import { generateKeyPair, generateListKey } from './crypto';
+import {
+	createManagedInviteToken,
+	decodeInvitePayload,
+	encodeInviteCode,
+	encodeInviteLink,
+	encodeInvitePayload,
+	isInviteExpired,
+	ListInvite,
+	parseInvite,
+	verifyManagedInviteToken,
+} from './invite';
+
+describe('lists/core/invite', () => {
+	const openInvite = (): ListInvite => ({ kind: 'open', listKey: generateListKey() });
+
+	const managedInvite = (): ListInvite => {
+		const admin = generateKeyPair();
+		const token = createManagedInviteToken(admin.secretKey, { role: 'member' });
+		return { kind: 'managed', listPubkey: generateKeyPair().publicKey, adminPubkey: admin.publicKey, token };
+	};
+
+	describe.each([
+		['open', openInvite],
+		['managed', managedInvite],
+	])('%s list invite', (_name, makeInvite) => {
+		test('link and code round-trip to the same invite', () => {
+			const invite = makeInvite();
+
+			const fromLink = parseInvite(encodeInviteLink(invite));
+			const fromCode = parseInvite(encodeInviteCode(invite));
+
+			expect(decodeInvitePayload(encodeInvitePayload(fromLink))).toEqual(decodeInvitePayload(encodeInvitePayload(invite)));
+			expect(fromCode).toEqual(fromLink);
+		});
+
+		test('code is tolerant of lowercase, spaces and dashes', () => {
+			const invite = makeInvite();
+			const code = encodeInviteCode(invite);
+			const messy = code.toLowerCase().replace(/-/g, ' - ');
+
+			expect(parseInvite(messy)).toEqual(parseInvite(code));
+		});
+	});
+
+	test('managed invite token can be verified with the admin pubkey', () => {
+		const admin = generateKeyPair();
+		const token = createManagedInviteToken(admin.secretKey, { role: 'admin' });
+
+		expect(verifyManagedInviteToken(token, admin.publicKey)).toBe(true);
+	});
+
+	test('managed invite token fails verification against the wrong pubkey', () => {
+		const admin = generateKeyPair();
+		const impostor = generateKeyPair();
+		const token = createManagedInviteToken(admin.secretKey, { role: 'admin' });
+
+		expect(verifyManagedInviteToken(token, impostor.publicKey)).toBe(false);
+	});
+
+	test('a token with expires: 0 never expires', () => {
+		const admin = generateKeyPair();
+		const token = createManagedInviteToken(admin.secretKey, { role: 'member', expires: 0 });
+
+		expect(isInviteExpired(token, Number.MAX_SAFE_INTEGER)).toBe(false);
+	});
+
+	test('a token with a past expires is expired', () => {
+		const admin = generateKeyPair();
+		const token = createManagedInviteToken(admin.secretKey, { role: 'member', expires: 1000 });
+
+		expect(isInviteExpired(token, 999)).toBe(false);
+		expect(isInviteExpired(token, 1001)).toBe(true);
+	});
+
+	test('the link carries the payload in the URL fragment, not the path', () => {
+		const link = encodeInviteLink(openInvite());
+		expect(link.startsWith('https://sebberich.github.io/joplin-tile-view/l#')).toBe(true);
+	});
+
+	test('parseInvite rejects garbage input', () => {
+		expect(() => parseInvite('not a valid invite')).toThrow();
+	});
+});
diff --git a/packages/app-mobile/lists/core/invite.ts b/packages/app-mobile/lists/core/invite.ts
new file mode 100644
index 0000000..75a6302
--- /dev/null
+++ b/packages/app-mobile/lists/core/invite.ts
@@ -0,0 +1,218 @@
+import { Buffer } from 'buffer';
+import { EventTemplate, finalizeEvent, verifyEvent, VerifiedEvent } from 'nostr-tools';
+import { bytesToHex, hexToBytes, randomBytes } from './crypto';
+import { Role } from './types';
+
+// Kind used for every event this module produces or reconstructs (see events.ts).
+const EVENT_KIND = 30078;
+const INVITE_D_TAG = 'invite';
+
+export interface ManagedInviteToken {
+	role: Role;
+	// Unix seconds, 0 = never expires.
+	expires: number;
+	once: boolean;
+	nonce: string;
+	createdAt: number;
+	id: string;
+	sig: string;
+}
+
+const inviteContent = (role: Role, expires: number, once: boolean, nonce: string): string =>
+	JSON.stringify({ role, expires, once, nonce });
+
+// Signs a fresh managed-list invite with the admin's device key. The token is
+// a detached, self-contained proof: verifyManagedInviteToken() only needs the
+// admin's public key (carried alongside the token in the invite payload) to
+// check it, nothing else from the issuing device.
+export const createManagedInviteToken = (
+	adminSecretKey: Uint8Array,
+	options: { role: Role; expires?: number; once?: boolean },
+	createdAt: number = Math.floor(Date.now() / 1000),
+): ManagedInviteToken => {
+	const expires = options.expires ?? 0;
+	const once = options.once ?? false;
+	const nonce = bytesToHex(randomBytes(8));
+	const template: EventTemplate = {
+		kind: EVENT_KIND,
+		tags: [['d', INVITE_D_TAG]],
+		content: inviteContent(options.role, expires, once, nonce),
+		created_at: createdAt,
+	};
+	const event = finalizeEvent(template, adminSecretKey);
+	return { role: options.role, expires, once, nonce, createdAt, id: event.id, sig: event.sig };
+};
+
+const reconstructInviteEvent = (token: ManagedInviteToken, adminPubkey: string): VerifiedEvent => ({
+	kind: EVENT_KIND,
+	tags: [['d', INVITE_D_TAG]],
+	content: inviteContent(token.role, token.expires, token.once, token.nonce),
+	created_at: token.createdAt,
+	pubkey: adminPubkey,
+	id: token.id,
+	sig: token.sig,
+} as VerifiedEvent);
+
+export const verifyManagedInviteToken = (token: ManagedInviteToken, adminPubkey: string): boolean => {
+	try {
+		return verifyEvent(reconstructInviteEvent(token, adminPubkey));
+	} catch {
+		return false;
+	}
+};
+
+export const isInviteExpired = (token: ManagedInviteToken, nowSeconds: number = Math.floor(Date.now() / 1000)): boolean =>
+	token.expires !== 0 && nowSeconds > token.expires;
+
+export type ListInvite =
+	| { kind: 'open'; listKey: Uint8Array }
+	| { kind: 'managed'; listPubkey: string; adminPubkey: string; token: ManagedInviteToken };
+
+const VERSION = 1;
+const INVITE_KIND_OPEN = 0;
+const INVITE_KIND_MANAGED = 1;
+
+const concatBytes = (...parts: Uint8Array[]): Uint8Array => {
+	const total = parts.reduce((sum, p) => sum + p.length, 0);
+	const output = new Uint8Array(total);
+	let offset = 0;
+	for (const part of parts) {
+		output.set(part, offset);
+		offset += part.length;
+	}
+	return output;
+};
+
+const uint16be = (value: number): Uint8Array => {
+	const bytes = new Uint8Array(2);
+	new DataView(bytes.buffer).setUint16(0, value, false);
+	return bytes;
+};
+
+export const encodeInvitePayload = (invite: ListInvite): Uint8Array => {
+	if (invite.kind === 'open') {
+		if (invite.listKey.length !== 32) throw new Error('List key must be 32 bytes');
+		return concatBytes(Uint8Array.of(VERSION, INVITE_KIND_OPEN), invite.listKey);
+	}
+
+	const tokenJson = JSON.stringify({
+		r: invite.token.role, e: invite.token.expires, o: invite.token.once ? 1 : 0,
+		n: invite.token.nonce, c: invite.token.createdAt, i: invite.token.id, s: invite.token.sig,
+	});
+	const tokenBytes = new TextEncoder().encode(tokenJson);
+	if (tokenBytes.length > 0xffff) throw new Error('Invite token too large to encode');
+
+	return concatBytes(
+		Uint8Array.of(VERSION, INVITE_KIND_MANAGED),
+		hexToBytes(invite.listPubkey),
+		hexToBytes(invite.adminPubkey),
+		uint16be(tokenBytes.length),
+		tokenBytes,
+	);
+};
+
+export const decodeInvitePayload = (bytes: Uint8Array): ListInvite => {
+	if (bytes.length < 2) throw new Error('Invite payload is too short');
+	const [version, inviteKind] = bytes;
+	if (version !== VERSION) throw new Error(`Unsupported invite version: ${version}`);
+
+	if (inviteKind === INVITE_KIND_OPEN) {
+		if (bytes.length !== 34) throw new Error('Invalid open-list invite payload');
+		return { kind: 'open', listKey: bytes.slice(2, 34) };
+	}
+
+	if (inviteKind === INVITE_KIND_MANAGED) {
+		if (bytes.length < 2 + 32 + 32 + 2) throw new Error('Invalid managed-list invite payload');
+		const listPubkey = bytesToHex(bytes.slice(2, 34));
+		const adminPubkey = bytesToHex(bytes.slice(34, 66));
+		const tokenLength = new DataView(bytes.buffer, bytes.byteOffset + 66, 2).getUint16(0, false);
+		const tokenBytes = bytes.slice(68, 68 + tokenLength);
+		if (tokenBytes.length !== tokenLength) throw new Error('Truncated invite token');
+
+		const parsed = JSON.parse(new TextDecoder().decode(tokenBytes));
+		const token: ManagedInviteToken = {
+			role: parsed.r, expires: parsed.e, once: !!parsed.o,
+			nonce: parsed.n, createdAt: parsed.c, id: parsed.i, sig: parsed.s,
+		};
+		return { kind: 'managed', listPubkey, adminPubkey, token };
+	}
+
+	throw new Error(`Unknown invite kind: ${inviteKind}`);
+};
+
+const BASE64URL_PADDING = /=+$/;
+
+const toBase64Url = (bytes: Uint8Array): string =>
+	Buffer.from(bytes).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(BASE64URL_PADDING, '');
+
+const fromBase64Url = (text: string): Uint8Array => {
+	const normalized = text.replace(/-/g, '+').replace(/_/g, '/');
+	const padded = normalized + '='.repeat((4 - normalized.length % 4) % 4);
+	return new Uint8Array(Buffer.from(padded, 'base64'));
+};
+
+// Crockford base32: excludes I, L, O, U to avoid confusion when typed by hand.
+const CROCKFORD_ALPHABET = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
+
+const toCrockfordBase32 = (bytes: Uint8Array): string => {
+	let bits = 0;
+	let value = 0;
+	let output = '';
+	for (const byte of bytes) {
+		value = (value << 8) | byte;
+		bits += 8;
+		while (bits >= 5) {
+			output += CROCKFORD_ALPHABET[(value >>> (bits - 5)) & 31];
+			bits -= 5;
+		}
+	}
+	if (bits > 0) output += CROCKFORD_ALPHABET[(value << (5 - bits)) & 31];
+	return output;
+};
+
+// Tolerant to lowercase, whitespace/dashes and the common look-alike
+// substitutions (O -> 0, I/L -> 1) so a code can be typed by hand.
+const fromCrockfordBase32 = (text: string): Uint8Array => {
+	const cleaned = text.toUpperCase().replace(/[\s-]/g, '').replace(/O/g, '0').replace(/[IL]/g, '1');
+	let bits = 0;
+	let value = 0;
+	const bytes: number[] = [];
+	for (const char of cleaned) {
+		const digit = CROCKFORD_ALPHABET.indexOf(char);
+		if (digit === -1) throw new Error(`Invalid character in invite code: ${char}`);
+		value = (value << 5) | digit;
+		bits += 5;
+		if (bits >= 8) {
+			bytes.push((value >>> (bits - 8)) & 0xff);
+			bits -= 8;
+		}
+	}
+	return Uint8Array.from(bytes);
+};
+
+const groupInFours = (code: string): string => (code.match(/.{1,4}/g) ?? []).join('-');
+
+export const INVITE_LINK_PREFIX = 'https://sebberich.github.io/joplin-tile-view/l#';
+
+export const encodeInviteLink = (invite: ListInvite): string => INVITE_LINK_PREFIX + toBase64Url(encodeInvitePayload(invite));
+export const encodeInviteCode = (invite: ListInvite): string => groupInFours(toCrockfordBase32(encodeInvitePayload(invite)));
+
+export interface EncodedInvite {
+	link: string;
+	code: string;
+}
+
+export const encodeInvite = (invite: ListInvite): EncodedInvite => ({ link: encodeInviteLink(invite), code: encodeInviteCode(invite) });
+
+// Accepts either an invite link (the payload lives in the URL fragment, which
+// a server never sees) or a manually typed code, and decodes it to the same
+// ListInvite either way.
+export const parseInvite = (text: string): ListInvite => {
+	const trimmed = text.trim();
+	const hashIndex = trimmed.indexOf('#');
+	if (trimmed.includes('://') || hashIndex !== -1) {
+		const fragment = hashIndex !== -1 ? trimmed.slice(hashIndex + 1) : trimmed;
+		return decodeInvitePayload(fromBase64Url(fragment));
+	}
+	return decodeInvitePayload(fromCrockfordBase32(trimmed));
+};
