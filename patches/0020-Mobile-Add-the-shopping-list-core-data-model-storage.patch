+const openTestDatabase = async (): Promise<{ db: ListsDatabase; path: string }> => {
+	const path = join(tmpdir(), `tiles-lists-test-${uuid.createNano()}.sqlite`);
+	const db = new ListsDatabase(new Database(new DatabaseDriverNode()));
+	await db.openOrCreate(path);
+	return { db, path };
