index 0000000..b7c1e7a
--- /dev/null
+++ b/packages/app-mobile/lists/core/merge.ts
@@ -0,0 +1,61 @@
+import { FieldValue, ItemPayload } from './types';
+
+// A device never sets a timestamp behind the newest one it has already seen,
+// protecting against clocks that run slow or backwards (see KONZEPT.md section 2).
+export const clampTime = (now: number, maxSeen: number): number => Math.max(now, maxSeen + 1);
+
+// Order used to break exact timestamp ties deterministically and symmetrically:
+// the field value attached to the higher device id string wins.
+const fieldRank = <T>(field: FieldValue<T> | undefined, device: string): [number, string] =>
+	field ? [field.t, device] : [-Infinity, device];
+
+const isRankHigher = (a: [number, string], b: [number, string]): boolean => {
+	if (a[0] !== b[0]) return a[0] > b[0];
+	return a[1] >= b[1];
+};
+
+const mergeField = <T>(a: FieldValue<T> | undefined, aDevice: string, b: FieldValue<T> | undefined, bDevice: string): FieldValue<T> | undefined => {
+	if (!a) return b;
+	if (!b) return a;
+	return isRankHigher(fieldRank(a, aDevice), fieldRank(b, bDevice)) ? a : b;
+};
+
+// Field-wise last-writer-wins merge of two states of the same item (identified
+// by the same d-tag), as described in KONZEPT.md section 2. Commutative,
+// associative and idempotent: mergeItem(a, b) === mergeItem(b, a), and merging
+// the result with either input again changes nothing.
+export const mergeItem = (a: ItemPayload, b: ItemPayload): ItemPayload => {
+	// "name" itself carries no per-field timestamp: it follows whichever record
+	// has the most recently changed field overall.
+	const ranks: [FieldValue<unknown> | undefined, string][] = [
+		[a.detail, a.device], [a.category, a.device], [a.icon, a.device], [a.deleted, a.device], [a.open, a.device],
+	];
+	const bRanks: [FieldValue<unknown> | undefined, string][] = [
+		[b.detail, b.device], [b.category, b.device], [b.icon, b.device], [b.deleted, b.device], [b.open, b.device],
+	];
+	const maxRank = (entries: [FieldValue<unknown> | undefined, string][]): [number, string] =>
+		entries.reduce((best, [field, device]) => {
+			const rank = fieldRank(field, device);
+			return isRankHigher(rank, best) ? rank : best;
+		}, [-Infinity, entries[0][1]] as [number, string]);
+
+	const aMax = maxRank(ranks);
+	const bMax = maxRank(bRanks);
+	const nameSource = isRankHigher(aMax, bMax) ? a : b;
+
+	const merged: ItemPayload = {
+		name: nameSource.name,
+		open: mergeField(a.open, a.device, b.open, b.device),
+		device: nameSource.device,
+	};
+	const detail = mergeField(a.detail, a.device, b.detail, b.device);
+	if (detail) merged.detail = detail;
+	const category = mergeField(a.category, a.device, b.category, b.device);
+	if (category) merged.category = category;
+	const icon = mergeField(a.icon, a.device, b.icon, b.device);
+	if (icon) merged.icon = icon;
+	const deleted = mergeField(a.deleted, a.device, b.deleted, b.device);
+	if (deleted) merged.deleted = deleted;
+
+	return merged;
+};
