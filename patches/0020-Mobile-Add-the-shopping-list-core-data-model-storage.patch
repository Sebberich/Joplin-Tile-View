+		await this.openPromise;
+		return this.db.deviceIdentity();
+	}
+
+	public onChange(listener: ChangeListener): ()=> void {
+		return this.changes.on(listener);
+	}
+
+	public async lists(): Promise<ListRecord[]> {
+		await this.ensureOpen();
+		return this.db.lists();
+	}
+
+	public async items(listId: string, options: { open?: boolean } = {}): Promise<ItemRecord[]> {
+		await this.ensureOpen();
+		return this.db.items(listId, options);
+	}
+
+	public async suggestions(prefix: string, limit = 10) {
+		await this.ensureOpen();
+		return this.db.suggestions(prefix, limit);
+	}
+
+	private async requireList(listId: string): Promise<ListRecord> {
