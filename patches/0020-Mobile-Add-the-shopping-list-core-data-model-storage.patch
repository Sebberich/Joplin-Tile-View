+		await db.upsertItem(item({ dTag: 'closed-item', open: false }));
+		await db.upsertItem(item({ dTag: 'deleted-item', deleted: true, deletedT: 5 }));
+
+		const all = await db.items('list-1');
+		expect(all.map(i => i.dTag).sort()).toEqual(['closed-item', 'open-item']);
+
+		const openOnly = await db.items('list-1', { open: true });
+		expect(openOnly.map(i => i.dTag)).toEqual(['open-item']);
+	});
+
+	test('setOpen, setDetail and deleteItem update the targeted item and mark it pending', async () => {
+		await db.upsertItem(item({ pending: false }));
+
+		await db.setOpen('list-1', 'tag-1', false, 10, 'bbbbbbbb');
+		let stored = await db.item('list-1', 'tag-1');
+		expect(stored).toMatchObject({ open: false, openT: 10, device: 'bbbbbbbb', pending: true });
+
+		await db.setDetail('list-1', 'tag-1', '2 l', 11, 'bbbbbbbb');
+		stored = await db.item('list-1', 'tag-1');
+		expect(stored).toMatchObject({ detail: '2 l', detailT: 11 });
