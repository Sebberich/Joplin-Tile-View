+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { ListsDatabase } from './db';
+import { ListsStore } from './store';
+import { parseInvite } from './invite';
+
+const openTestStore = async (): Promise<{ store: ListsStore; path: string }> => {
+	const path = join(tmpdir(), `tiles-lists-store-test-${uuid.createNano()}.sqlite`);
+	const db = new ListsDatabase(new Database(new DatabaseDriverNode()));
+	return { store: new ListsStore(db, path), path };
+};
+
+describe('lists/core/store', () => {
+	let store: ListsStore;
+	let path: string;
+
+	beforeEach(async () => {
+		({ store, path } = await openTestStore());
+	});
+
+	afterEach(async () => {
+		await rm(path, { force: true });
+	});
+
+	test('addItem resolves a catalog synonym and marks the item pending', async () => {
+		const list = await store.createOpenList('Groceries');
+
+		const item = await store.addItem(list.id, 'H-Milch');
+
+		expect(item).toMatchObject({ name: 'Milch', icon: '🥛', open: true, pending: true });
+		expect(await store.items(list.id)).toEqual([item]);
+	});
+
+	test('adding the same item twice reuses the same record instead of duplicating it', async () => {
+		const list = await store.createOpenList('Groceries');
+
+		const first = await store.addItem(list.id, 'Milch');
+		const second = await store.addItem(list.id, 'milch');
+
+		expect(second.dTag).toBe(first.dTag);
+		expect(await store.items(list.id)).toHaveLength(1);
+	});
+
+	test('re-adding a bought (closed) item re-opens it', async () => {
+		const list = await store.createOpenList('Groceries');
+		const item = await store.addItem(list.id, 'Milch');
+		await store.toggleOpen(list.id, item.dTag);
+		expect((await store.items(list.id, { open: true }))).toEqual([]);
+
+		await store.addItem(list.id, 'Milch');
+
+		expect((await store.items(list.id, { open: true }))[0].dTag).toBe(item.dTag);
+	});
+
+	test('re-adding a removed item revives it instead of creating a duplicate', async () => {
+		const list = await store.createOpenList('Groceries');
+		const item = await store.addItem(list.id, 'Milch');
+		await store.removeItem(list.id, item.dTag);
+		expect(await store.items(list.id)).toEqual([]);
+
+		await store.addItem(list.id, 'Milch');
+
+		const items = await store.items(list.id);
+		expect(items).toHaveLength(1);
+		expect(items[0].dTag).toBe(item.dTag);
+	});
+
+	test('toggleOpen flips open and setDetail updates detail, both bumping the timestamp', async () => {
+		const list = await store.createOpenList('Groceries');
+		const item = await store.addItem(list.id, 'Milch');
+
+		await store.toggleOpen(list.id, item.dTag);
+		await store.setDetail(list.id, item.dTag, '2 l');
+
+		const [stored] = await store.items(list.id);
+		expect(stored.open).toBe(false);
+		expect(stored.detail).toBe('2 l');
+		expect(stored.openT).toBeGreaterThan(item.openT);
+	});
+
+	test('an open-list invite round-trips to another store joining the same list', async () => {
+		const list = await store.createOpenList('Groceries');
+		const { link } = await store.inviteFor(list.id);
+
+		const other = await openTestStore();
+		try {
+			const result = await other.store.joinFromInvite(link);
+			expect(result.type).toBe('open');
+			expect(result.list.id).toBe(list.id);
+			expect(result.list.contentKey).toBe(list.contentKey);
+		} finally {
+			await rm(other.path, { force: true });
+		}
+	});
+
+	test('a managed-list invite carries a join request the sync layer can send to the admin', async () => {
+		const list = await store.createManagedList('Household');
+		const { link } = await store.inviteFor(list.id, 'member');
+		expect(parseInvite(link).kind).toBe('managed');
+
+		const other = await openTestStore();
+		try {
+			const result = await other.store.joinFromInvite(link);
+			expect(result.type).toBe('managed');
+			if (result.type === 'managed') {
+				expect(result.joinRequest.kind).toBe(30078);
+				expect(result.list.contentKey).toBeNull();
+			}
+		} finally {
+			await rm(other.path, { force: true });
+		}
+	});
+
+	test('inviteFor refuses a non-admin device on a managed list', async () => {
+		const list = await store.createManagedList('Household');
+		const { link } = await store.inviteFor(list.id);
+
+		const other = await openTestStore();
+		try {
+			await other.store.joinFromInvite(link);
+			await expect(other.store.inviteFor(list.id)).rejects.toThrow();
+		} finally {
+			await rm(other.path, { force: true });
+		}
+	});
+
+	test('applyRemoteItem merges an incoming payload with the local item field-wise', async () => {
+		const list = await store.createOpenList('Groceries');
+		const item = await store.addItem(list.id, 'Milch');
+
+		const merged = await store.applyRemoteItem(list.id, item.dTag, {
+			name: 'Milch',
+			open: { v: false, t: item.openT + 1000 },
+			device: 'ffffffff',
+		});
+
+		expect(merged.open).toBe(false);
+		expect(merged.icon).toBe(item.icon); // untouched field survives the merge
+	});
+
+	test('pendingItems and markPublished track which items still need publishing', async () => {
+		const list = await store.createOpenList('Groceries');
+		const item = await store.addItem(list.id, 'Milch');
+
+		expect((await store.pendingItems(list.id)).map(i => i.dTag)).toEqual([item.dTag]);
+
+		await store.markPublished(list.id, item.dTag);
+
+		expect(await store.pendingItems(list.id)).toEqual([]);
+	});
+
+	test('onChange is notified on local mutations and the unsubscribe function stops further notifications', async () => {
+		const list = await store.createOpenList('Groceries');
+		let calls = 0;
+		const unsubscribe = store.onChange(() => { calls++; });
+
+		await store.addItem(list.id, 'Milch');
+		expect(calls).toBe(1);
+
+		unsubscribe();
+		await store.addItem(list.id, 'Butter');
+		expect(calls).toBe(1);
+	});
+});
