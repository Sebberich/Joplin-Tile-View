+import { clampTime, mergeItem } from './merge';
+import { ItemPayload } from './types';
+
+const base = (): ItemPayload => ({
+	name: 'Milch',
+	open: { v: false, t: 100 },
+	detail: { v: '1 l', t: 100 },
+	device: 'aaaaaaaa',
+});
+
+describe('lists/core/merge', () => {
+	describe('clampTime', () => {
+		test('returns now when it is already ahead of the newest seen timestamp', () => {
+			expect(clampTime(1000, 500)).toBe(1000);
+		});
+
+		test('never returns a timestamp at or behind the newest one already seen', () => {
+			expect(clampTime(500, 1000)).toBe(1001);
+		});
+	});
+
+	describe('mergeItem', () => {
+		test('picks the newer value per field, keeping the older value of untouched fields', () => {
+			const local = base();
+			const remote: ItemPayload = { ...base(), open: { v: true, t: 200 }, device: 'bbbbbbbb' };
+
+			const merged = mergeItem(local, remote);
+
+			expect(merged.open).toEqual({ v: true, t: 200 });
+			expect(merged.detail).toEqual({ v: '1 l', t: 100 });
+		});
+
+		test('breaks an exact timestamp tie by the higher device id', () => {
+			const a: ItemPayload = { ...base(), open: { v: false, t: 200 }, device: 'aaaaaaaa' };
+			const b: ItemPayload = { ...base(), open: { v: true, t: 200 }, device: 'bbbbbbbb' };
+
+			expect(mergeItem(a, b).open).toEqual({ v: true, t: 200 });
+			expect(mergeItem(b, a).open).toEqual({ v: true, t: 200 });
+		});
+
+		test('a deleted tombstone wins over a later local un-delete only if its timestamp is newer', () => {
+			const local: ItemPayload = { ...base(), deleted: { v: false, t: 100 } };
+			const remote: ItemPayload = { ...base(), deleted: { v: true, t: 300 }, device: 'bbbbbbbb' };
+
+			expect(mergeItem(local, remote).deleted).toEqual({ v: true, t: 300 });
+		});
+
+		test('is order-independent: mergeItem(a, b) === mergeItem(b, a)', () => {
+			const a: ItemPayload = { ...base(), open: { v: true, t: 150 }, detail: { v: '2 l', t: 50 } };
+			const b: ItemPayload = { ...base(), open: { v: false, t: 90 }, detail: { v: '3 l', t: 400 }, device: 'zzzzzzzz' };
+
+			expect(mergeItem(a, b)).toEqual(mergeItem(b, a));
+		});
+
+		test('is idempotent: merging the result with either input again changes nothing', () => {
+			const a = base();
+			const b: ItemPayload = { ...base(), open: { v: true, t: 500 }, device: 'cccccccc' };
+
+			const merged = mergeItem(a, b);
+
+			expect(mergeItem(merged, a)).toEqual(merged);
+			expect(mergeItem(merged, b)).toEqual(merged);
+		});
+
+		test('the display name follows whichever record has the most recently changed field', () => {
+			const older: ItemPayload = { ...base(), name: 'Milch', open: { v: false, t: 100 } };
+			const newer: ItemPayload = { ...base(), name: 'MILCH', open: { v: true, t: 900 }, device: 'bbbbbbbb' };
+
+			expect(mergeItem(older, newer).name).toBe('MILCH');
+			expect(mergeItem(newer, older).name).toBe('MILCH');
+		});
+	});
+});
