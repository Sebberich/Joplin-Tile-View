+	dTag: dTagValue,
+	name: payload.name,
+	detail: payload.detail?.v ?? null,
+	detailT: payload.detail?.t ?? null,
+	category: payload.category?.v ?? null,
+	categoryT: payload.category?.t ?? null,
+	icon: payload.icon?.v ?? null,
+	iconT: payload.icon?.t ?? null,
+	open: payload.open.v,
+	openT: payload.open.t,
