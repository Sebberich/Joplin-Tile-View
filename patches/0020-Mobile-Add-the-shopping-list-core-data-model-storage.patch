@@ -0,0 +1,133 @@
+import { generateContentKey, generateKeyPair } from './crypto';
+import {
+	buildItemEvent,
+	buildJoinRequestEvent,
+	buildManagedDirectoryEvent,
+	buildOpenDirectoryEvent,
+	DirectoryPayload,
+	InvalidEventError,
+	isDirectoryAcceptable,
+	parseItemEvent,
+	parseJoinRequestEvent,
+	parseManagedDirectoryEvent,
+	parseOpenDirectoryEvent,
+	unwrapManagedContentKey,
+} from './events';
+import { ItemPayload, MemberRecord } from './types';
+
+describe('lists/core/events', () => {
+	const payload = (): ItemPayload => ({ name: 'Milch', open: { v: true, t: 1 }, device: 'aaaaaaaa' });
+
+	test('item event round-trips through build/parse', () => {
+		const device = generateKeyPair();
+		const contentKey = generateContentKey();
+
+		const event = buildItemEvent(device.secretKey, 'list-pubkey', 'd-tag', contentKey, payload());
+
+		expect(parseItemEvent(event, contentKey)).toEqual(payload());
+	});
+
+	test('parsing an item event fails with a wrong content key', () => {
+		const device = generateKeyPair();
+		const event = buildItemEvent(device.secretKey, 'list-pubkey', 'd-tag', generateContentKey(), payload());
+
+		expect(() => parseItemEvent(event, generateContentKey())).toThrow();
+	});
+
+	test('parsing a tampered item event fails signature verification', () => {
+		const device = generateKeyPair();
+		const contentKey = generateContentKey();
+		const event = buildItemEvent(device.secretKey, 'list-pubkey', 'd-tag', contentKey, payload());
+
+		// A plain JSON round-trip (rather than a spread) drops nostr-tools'
+		// internal "already verified" cache flag, so verifyEvent actually
+		// re-checks this tampered copy instead of trusting the original.
+		const tampered = { ...JSON.parse(JSON.stringify(event)), content: `${event.content.slice(0, -2)}zz` };
+
+		expect(() => parseItemEvent(tampered, contentKey)).toThrow(InvalidEventError);
+	});
+
+	test('open list directory round-trips and is signed by the list key', () => {
+		const list = generateKeyPair();
+		const contentKey = generateContentKey();
+		const directoryPayload: DirectoryPayload = { members: [{ listId: list.publicKey, pubkey: 'x', name: null, role: 'member', since: 1, removedAt: null }], settings: null };
+
+		const event = buildOpenDirectoryEvent(list.secretKey, contentKey, directoryPayload);
+
+		expect(event.pubkey).toBe(list.publicKey);
+		expect(parseOpenDirectoryEvent(event, contentKey)).toEqual(directoryPayload);
+	});
+
+	test('managed directory lets a wrapped member recover the content key and then the directory', () => {
+		const admin = generateKeyPair();
+		const member = generateKeyPair();
+		const contentKey = generateContentKey();
+		const members: MemberRecord[] = [
+			{ listId: 'l', pubkey: admin.publicKey, name: 'Admin', role: 'admin', since: 1, removedAt: null },
+			{ listId: 'l', pubkey: member.publicKey, name: 'Member', role: 'member', since: 2, removedAt: null },
+		];
+		const directoryPayload: DirectoryPayload = { members, settings: null };
+
+		const event = buildManagedDirectoryEvent(admin.secretKey, contentKey, directoryPayload);
+
+		const recoveredKey = unwrapManagedContentKey(event, member.secretKey);
+		expect(recoveredKey).toEqual(contentKey);
+		expect(parseManagedDirectoryEvent(event, recoveredKey)).toEqual(directoryPayload);
+	});
+
+	test('managed directory omits removed members from the wrapped keys', () => {
+		const admin = generateKeyPair();
+		const removed = generateKeyPair();
+		const members: MemberRecord[] = [
+			{ listId: 'l', pubkey: admin.publicKey, name: 'Admin', role: 'admin', since: 1, removedAt: null },
+			{ listId: 'l', pubkey: removed.publicKey, name: 'Gone', role: 'member', since: 2, removedAt: 999 },
+		];
+		const event = buildManagedDirectoryEvent(admin.secretKey, generateContentKey(), { members, settings: null });
+
+		expect(() => unwrapManagedContentKey(event, removed.secretKey)).toThrow();
+	});
+
+	describe('isDirectoryAcceptable', () => {
+		test('accepts the very first directory only if signed by the list key', () => {
+			const listPubkey = generateKeyPair().publicKey;
+			expect(isDirectoryAcceptable(null, listPubkey, listPubkey)).toBe(true);
+			expect(isDirectoryAcceptable(null, listPubkey, 'someone-else')).toBe(false);
+		});
+
+		test('accepts a later directory only if signed by an admin from the previous one', () => {
+			const admin = generateKeyPair();
+			const nonAdmin = generateKeyPair();
+			const previous: DirectoryPayload = {
+				members: [
+					{ listId: 'l', pubkey: admin.publicKey, name: null, role: 'admin', since: 1, removedAt: null },
+					{ listId: 'l', pubkey: nonAdmin.publicKey, name: null, role: 'member', since: 1, removedAt: null },
+				],
+				settings: null,
+			};
+
+			expect(isDirectoryAcceptable(previous, 'list-pubkey', admin.publicKey)).toBe(true);
+			expect(isDirectoryAcceptable(previous, 'list-pubkey', nonAdmin.publicKey)).toBe(false);
+			expect(isDirectoryAcceptable(previous, 'list-pubkey', 'list-pubkey')).toBe(false);
+		});
+
+		test('rejects a directory signed by a removed admin', () => {
+			const admin = generateKeyPair();
+			const previous: DirectoryPayload = {
+				members: [{ listId: 'l', pubkey: admin.publicKey, name: null, role: 'admin', since: 1, removedAt: 5 }],
+				settings: null,
+			};
+
+			expect(isDirectoryAcceptable(previous, 'list-pubkey', admin.publicKey)).toBe(false);
+		});
+	});
+
+	test('join request round-trips and reveals the requesting device pubkey', () => {
+		const device = generateKeyPair();
+		const admin = generateKeyPair();
+
+		const event = buildJoinRequestEvent(device.secretKey, admin.publicKey, { inviteToken: 'ABCD-1234', deviceName: 'My phone' });
+
+		const parsed = parseJoinRequestEvent(event, admin.secretKey);
+		expect(parsed).toEqual({ inviteToken: 'ABCD-1234', deviceName: 'My phone', devicePubkey: device.publicKey });
+	});
+});
diff --git a/packages/app-mobile/lists/core/events.ts b/packages/app-mobile/lists/core/events.ts
new file mode 100644
index 0000000..1dea620
--- /dev/null
+++ b/packages/app-mobile/lists/core/events.ts
@@ -0,0 +1,152 @@
+import { EventTemplate, finalizeEvent, getPublicKey, nip44, VerifiedEvent, verifyEvent } from 'nostr-tools';
+import { bytesToHex, hexToBytes } from './crypto';
+import { ItemPayload, MemberRecord } from './types';
+
+// NIP-78 "application-specific data", addressable per (pubkey, kind, d-tag).
+export const LIST_EVENT_KIND = 30078;
+
+const nowSeconds = (): number => Math.floor(Date.now() / 1000);
+
+// --- Item events -----------------------------------------------------------
+
+// Builds a signed, encrypted item event. Author is always the device that
+// made the change; the 'L' tag lets relays be queried for a whole list
+// (`#L` = listPubkey) across all members' events.
+export const buildItemEvent = (deviceSecretKey: Uint8Array, listPubkey: string, dTag: string, contentKey: Uint8Array, payload: ItemPayload, createdAt: number = nowSeconds()): VerifiedEvent => {
+	const template: EventTemplate = {
+		kind: LIST_EVENT_KIND,
+		tags: [['d', dTag], ['L', listPubkey]],
+		content: nip44.encrypt(JSON.stringify(payload), contentKey),
+		created_at: createdAt,
+	};
+	return finalizeEvent(template, deviceSecretKey);
+};
+
+export class InvalidEventError extends Error {}
+
+// Verifies the event's signature, then decrypts and parses its payload.
+// Throws InvalidEventError if the signature doesn't check out, or whatever
+// nip44.decrypt/JSON.parse throw (e.g. a wrong content key) otherwise.
+export const parseItemEvent = (event: VerifiedEvent, contentKey: Uint8Array): ItemPayload => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Item event has an invalid signature');
+	const plaintext = nip44.decrypt(event.content, contentKey);
+	return JSON.parse(plaintext) as ItemPayload;
+};
+
+// --- Member directory --------------------------------------------------
+
+const DIRECTORY_D_TAG = 'members';
+
+export interface DirectoryPayload {
+	members: MemberRecord[];
+	settings: string | null;
+}
+
+// Open lists: every member can derive the content key from the shared list
+// key, so the directory is encrypted with it directly and signed by the
+// list's own key (which every member also holds).
+export const buildOpenDirectoryEvent = (listSecretKey: Uint8Array, contentKey: Uint8Array, payload: DirectoryPayload, createdAt: number = nowSeconds()): VerifiedEvent => {
+	const template: EventTemplate = {
+		kind: LIST_EVENT_KIND,
+		tags: [['d', DIRECTORY_D_TAG]],
+		content: nip44.encrypt(JSON.stringify(payload), contentKey),
+		created_at: createdAt,
+	};
+	return finalizeEvent(template, listSecretKey);
+};
+
+export const parseOpenDirectoryEvent = (event: VerifiedEvent, contentKey: Uint8Array): DirectoryPayload => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Directory event has an invalid signature');
+	return JSON.parse(nip44.decrypt(event.content, contentKey)) as DirectoryPayload;
+};
+
+export interface ManagedDirectoryContent {
+	// Member pubkey (hex) -> content key (hex), nip44-encrypted to that member
+	// with the admin device's conversation key. Lets a new member recover the
+	// content key from their own entry alone, without already having it.
+	wrapped: Record<string, string>;
+	// The actual directory (members + settings), nip44-encrypted with the
+	// content key every wrapped entry unlocks.
+	body: string;
+}
+
+// Managed lists: signed by an admin device key. See isDirectoryAcceptable()
+// for how a reader decides whether to trust that signer.
+export const buildManagedDirectoryEvent = (adminSecretKey: Uint8Array, contentKey: Uint8Array, payload: DirectoryPayload, createdAt: number = nowSeconds()): VerifiedEvent => {
+	const wrapped: Record<string, string> = {};
+	for (const member of payload.members) {
+		if (member.removedAt) continue;
+		const convKey = nip44.getConversationKey(adminSecretKey, member.pubkey);
+		wrapped[member.pubkey] = nip44.encrypt(bytesToHex(contentKey), convKey);
+	}
+	const content: ManagedDirectoryContent = {
+		wrapped,
+		body: nip44.encrypt(JSON.stringify(payload), contentKey),
+	};
+	const template: EventTemplate = {
+		kind: LIST_EVENT_KIND,
+		tags: [['d', DIRECTORY_D_TAG]],
+		content: JSON.stringify(content),
+		created_at: createdAt,
+	};
+	return finalizeEvent(template, adminSecretKey);
+};
+
+// Recovers the content key from a managed directory event's wrapped entry for
+// the given member. Requires the member's own device secret key.
+export const unwrapManagedContentKey = (event: VerifiedEvent, memberSecretKey: Uint8Array): Uint8Array => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Directory event has an invalid signature');
+	const content = JSON.parse(event.content) as ManagedDirectoryContent;
+	const memberPubkey = getPublicKey(memberSecretKey);
+	const wrappedHex = content.wrapped[memberPubkey];
+	if (!wrappedHex) throw new Error('No wrapped content key for this device in the directory');
+	const convKey = nip44.getConversationKey(memberSecretKey, event.pubkey);
+	return hexToBytes(nip44.decrypt(wrappedHex, convKey));
+};
+
+export const parseManagedDirectoryEvent = (event: VerifiedEvent, contentKey: Uint8Array): DirectoryPayload => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Directory event has an invalid signature');
+	const content = JSON.parse(event.content) as ManagedDirectoryContent;
+	return JSON.parse(nip44.decrypt(content.body, contentKey)) as DirectoryPayload;
+};
+
+// A reader accepts a new directory only if it is signed by a device that was
+// already an admin in the last directory it accepted, or -- for the very
+// first directory it ever sees for a list -- if it is signed by the list's
+// own key. This is the only place trust in a directory update is decided.
+export const isDirectoryAcceptable = (previouslyAccepted: DirectoryPayload | null, listPubkey: string, signerPubkey: string): boolean => {
+	if (!previouslyAccepted) return signerPubkey === listPubkey;
+	return previouslyAccepted.members.some(m => m.pubkey === signerPubkey && m.role === 'admin' && !m.removedAt);
+};
+
+// --- Join requests -----------------------------------------------------
+
+export const joinRequestDTag = (devicePubkey: string): string => `join:${devicePubkey}`;
+
+export interface JoinRequestPayload {
+	inviteToken: string;
+	deviceName: string;
+}
+
+export const buildJoinRequestEvent = (deviceSecretKey: Uint8Array, adminPubkey: string, payload: JoinRequestPayload, createdAt: number = nowSeconds()): VerifiedEvent => {
+	const devicePubkey = getPublicKey(deviceSecretKey);
+	const convKey = nip44.getConversationKey(deviceSecretKey, adminPubkey);
+	const template: EventTemplate = {
+		kind: LIST_EVENT_KIND,
+		tags: [['d', joinRequestDTag(devicePubkey)], ['p', adminPubkey]],
+		content: nip44.encrypt(JSON.stringify(payload), convKey),
+		created_at: createdAt,
+	};
+	return finalizeEvent(template, deviceSecretKey);
+};
+
+export interface ParsedJoinRequest extends JoinRequestPayload {
+	devicePubkey: string;
+}
+
+export const parseJoinRequestEvent = (event: VerifiedEvent, adminSecretKey: Uint8Array): ParsedJoinRequest => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Join request event has an invalid signature');
+	const convKey = nip44.getConversationKey(adminSecretKey, event.pubkey);
+	const payload = JSON.parse(nip44.decrypt(event.content, convKey)) as JoinRequestPayload;
+	return { ...payload, devicePubkey: event.pubkey };
+};
