+import { normalizeName, resolveCatalog } from './normalize';
+
+describe('lists/core/normalize', () => {
+	test.each([
+		['  Milch  ', 'milch'],
+		['MILCH', 'milch'],
+		['Äpfel', 'äpfel'],
+	])('normalizeName trims, lowercases and NFC-normalizes: %s', (input, expected) => {
+		expect(normalizeName(input)).toBe(expected);
+	});
+
+	test('does not rewrite German spelling variants itself', () => {
+		// ß/ss and ä/ae variants are handled by explicit catalog synonyms, not here.
+		expect(normalizeName('Aepfel')).toBe('aepfel');
+		expect(normalizeName('Gruß')).toBe('gruß');
+	});
+
+	test('resolves a synonym to its canonical catalog name', () => {
+		expect(resolveCatalog('H-Milch')).toEqual({ canonical: 'Milch', emoji: '🥛', category: 'kuehlregal' });
+	});
+
+	test('resolves a compound word containing a catalog term as a whole word', () => {
+		expect(resolveCatalog('Bio-Milch')).toEqual({ canonical: 'Milch', emoji: '🥛', category: 'kuehlregal' });
+	});
+
+	test('resolves its own catalog entry rather than a shorter unrelated term', () => {
+		// "Hafermilch" is itself a catalog entry (distinct from "Milch"), and is
+		// longer than "milch", so it must win over the shorter substring match.
+		expect(resolveCatalog('hafermilch')).toEqual({ canonical: 'Hafermilch', emoji: '🥛', category: 'kuehlregal' });
+	});
+
+	test('falls back to the raw input with no icon/category when nothing matches', () => {
+		expect(resolveCatalog('Quietscheentchen')).toEqual({ canonical: 'Quietscheentchen', emoji: null, category: null });
+	});
+
+	test('is case-insensitive and trims the fallback input', () => {
+		expect(resolveCatalog('  ZauberTrank  ')).toEqual({ canonical: 'ZauberTrank', emoji: null, category: null });
+	});
+});
diff --git a/packages/app-mobile/lists/core/normalize.ts b/packages/app-mobile/lists/core/normalize.ts
new file mode 100644
index 0000000..bbae1d4
--- /dev/null
+++ b/packages/app-mobile/lists/core/normalize.ts
@@ -0,0 +1,75 @@
+import { CatalogItemDef, CatalogMatch, CategoryDef } from './types';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires -- plain JSON data files, no resolveJsonModule configured for this package
+const categories: CategoryDef[] = require('../catalog/categories.json');
+// eslint-disable-next-line @typescript-eslint/no-var-requires -- see above
+const catalogItems: CatalogItemDef[] = require('../catalog/items.json');
+
+const FALLBACK_CATEGORY_ID = 'sonstiges';
+
+// Trims, lowercases and Unicode-normalizes (NFC) a name for matching purposes.
+// German spelling variants (ß vs ss, ä vs ae, ...) are intentionally NOT rewritten
+// here -- those are handled by the catalog's explicit synonym lists instead.
+export const normalizeName = (name: string): string => name.trim().toLowerCase().normalize('NFC');
+
+interface CatalogTerm {
+	term: string;
+	item: CatalogItemDef;
+}
+
+let termIndex: CatalogTerm[] | null = null;
+
+const buildTermIndex = (): CatalogTerm[] => {
+	const terms: CatalogTerm[] = [];
+	for (const item of catalogItems) {
+		terms.push({ term: normalizeName(item.name), item });
+		for (const synonym of item.synonyms) {
+			terms.push({ term: normalizeName(synonym), item });
+		}
+	}
+	// Longest term first, so a compound match ("h-milch") is preferred over a
+	// shorter one that happens to be a substring of it.
+	terms.sort((a, b) => b.term.length - a.term.length);
+	return terms;
+};
+
+const getTermIndex = (): CatalogTerm[] => {
+	if (!termIndex) termIndex = buildTermIndex();
+	return termIndex;
+};
+
+const escapeRegExp = (s: string): string => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+const containsWholeTerm = (haystack: string, term: string): boolean => {
+	// \b doesn't work reliably with German umlauts, so match on non-alphanumeric
+	// boundaries (or start/end of string) explicitly instead.
+	const pattern = new RegExp(`(^|[^\\p{L}\\p{N}])${escapeRegExp(term)}($|[^\\p{L}\\p{N}])`, 'u');
+	return pattern.test(`,${haystack},`);
+};
+
+// Resolves a free-typed item name against the shipped catalog: exact name or
+// synonym match first, then the longest catalog term found as a whole word
+// inside the input (so "Bio-Milch" still resolves to "Milch"). Falls back to
+// the input itself with no icon/category when nothing matches, leaving the
+// first-letter fallback to the UI layer.
+export const resolveCatalog = (name: string): CatalogMatch => {
+	const normalized = normalizeName(name);
+	const terms = getTermIndex();
+
+	const exact = terms.find(t => t.term === normalized);
+	if (exact) return { canonical: exact.item.name, emoji: exact.item.emoji, category: exact.item.category };
+
+	const contained = terms.find(t => containsWholeTerm(normalized, t.term));
+	if (contained) return { canonical: contained.item.name, emoji: contained.item.emoji, category: contained.item.category };
+
+	return { canonical: name.trim(), emoji: null, category: null };
+};
+
+export const categoryEmoji = (categoryId: string): string | null => {
+	const category = categories.find(c => c.id === categoryId);
+	return category ? category.emoji : null;
+};
+
+export const categoryOrder = (): CategoryDef[] => categories;
+
+export const fallbackCategoryId = FALLBACK_CATEGORY_ID;
