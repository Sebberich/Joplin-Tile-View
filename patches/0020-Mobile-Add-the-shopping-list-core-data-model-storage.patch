+		await db.deleteItem('list-1', 'tag-1', 12, 'bbbbbbbb');
+		stored = await db.item('list-1', 'tag-1');
+		expect(stored).toMatchObject({ deleted: true, deletedT: 12 });
+	});
+
+	test('undeleteItem revives a tombstoned item and re-opens it', async () => {
+		await db.upsertItem(item({ deleted: true, deletedT: 5, open: false }));
+
+		await db.undeleteItem('list-1', 'tag-1', 20, 'cccccccc');
+
+		const stored = await db.item('list-1', 'tag-1');
+		expect(stored).toMatchObject({ deleted: false, open: true, openT: 20 });
+	});
+
+	test('maxSeenTime returns the highest field timestamp seen for the list', async () => {
