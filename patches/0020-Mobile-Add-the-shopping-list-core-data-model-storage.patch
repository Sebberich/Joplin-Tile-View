+import Database, { Row } from '@joplin/lib/database';
+import { getPublicKey } from 'nostr-tools';
+import { generateContentKey, generateKeyPair, generateListKey, deriveOpenListKeys, bytesToHex, hexToBytes } from './crypto';
+import { normalizeName } from './normalize';
+import { CatalogItemDef, CatalogMatch, ItemRecord, ListKind, ListRecord, MemberRecord } from './types';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires -- plain JSON data file, no resolveJsonModule configured for this package
+const catalogItems: CatalogItemDef[] = require('../catalog/items.json');
+
+const SCHEMA_VERSION = 1;
+const DEFAULT_DEVICE_NAME = 'Joplin Tiles';
+
+const CREATE_TABLES: string[] = [
+	`CREATE TABLE lists (
+		id TEXT PRIMARY KEY,
+		kind TEXT NOT NULL,
+		list_key TEXT,
+		content_key TEXT,
+		name TEXT NOT NULL,
+		settings TEXT,
+		relays TEXT,
+		sort_order INTEGER NOT NULL DEFAULT 0
+	)`,
+	`CREATE TABLE members (
+		list_id TEXT NOT NULL,
+		pubkey TEXT NOT NULL,
+		name TEXT,
+		role TEXT NOT NULL,
+		since INTEGER NOT NULL,
+		removed_at INTEGER,
+		PRIMARY KEY (list_id, pubkey)
+	)`,
+	`CREATE TABLE items (
+		list_id TEXT NOT NULL,
+		d_tag TEXT NOT NULL,
+		name TEXT NOT NULL,
+		detail TEXT,
+		detail_t INTEGER,
+		category TEXT,
+		category_t INTEGER,
+		icon TEXT,
+		icon_t INTEGER,
+		open INTEGER NOT NULL,
+		open_t INTEGER NOT NULL,
+		deleted INTEGER NOT NULL DEFAULT 0,
+		deleted_t INTEGER,
+		device TEXT NOT NULL,
+		pending INTEGER NOT NULL DEFAULT 0,
+		PRIMARY KEY (list_id, d_tag)
+	)`,
+	'CREATE INDEX items_display ON items(list_id, deleted, open, category)',
+	'CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT)',
+];
+
+export interface DeviceIdentity {
+	secretKey: Uint8Array;
+	publicKey: string;
+	name: string;
+}
+
+const rowToList = (row: Row): ListRecord => ({
+	id: row.id,
+	kind: row.kind,
+	listKey: row.list_key ?? null,
+	contentKey: row.content_key ?? null,
+	name: row.name,
+	settings: row.settings ?? null,
+	relays: row.relays ? JSON.parse(row.relays) : null,
+	sortOrder: Number(row.sort_order),
+});
+
+const rowToMember = (row: Row): MemberRecord => ({
+	listId: row.list_id,
+	pubkey: row.pubkey,
+	name: row.name ?? null,
+	role: row.role,
+	since: Number(row.since),
+	removedAt: row.removed_at === null || row.removed_at === undefined ? null : Number(row.removed_at),
+});
+
+const nullableNumber = (value: unknown): number | null => (value === null || value === undefined ? null : Number(value));
+
+const rowToItem = (row: Row): ItemRecord => ({
+	listId: row.list_id,
+	dTag: row.d_tag,
+	name: row.name,
+	detail: row.detail ?? null,
+	detailT: nullableNumber(row.detail_t),
+	category: row.category ?? null,
+	categoryT: nullableNumber(row.category_t),
+	icon: row.icon ?? null,
+	iconT: nullableNumber(row.icon_t),
+	open: !!row.open,
+	openT: Number(row.open_t),
+	deleted: !!row.deleted,
+	deletedT: nullableNumber(row.deleted_t),
+	device: row.device,
+	pending: !!row.pending,
+});
+
+// Local persistence for the shopping-list feature: its own SQLite file,
+// independent of Joplin's own database and migration numbering (see
+// docs/KONZEPT.md section 2). The Database instance (and its driver -- RN's
+// expo-sqlite in the app, the Node driver in tests) is provided by the caller.
+export class ListsDatabase {
+	private db: Database;
+	private opened = false;
+
+	public constructor(db: Database) {
+		this.db = db;
+	}
+
+	public async openOrCreate(name: string): Promise<void> {
+		if (this.opened) return;
+		await this.db.open({ name });
+		await this.migrate();
+		this.opened = true;
+	}
+
+	public async close(): Promise<void> {
+		if (!this.opened) return;
+		await this.db.close();
+		this.opened = false;
+	}
+
+	private async migrate(): Promise<void> {
+		const row = await this.db.selectOne('PRAGMA user_version');
+		const version = Number(row?.user_version ?? 0);
+		if (version < SCHEMA_VERSION) {
+			await this.db.transactionExecBatch([...CREATE_TABLES, `PRAGMA user_version = ${SCHEMA_VERSION}`]);
+		}
+	}
+
+	// --- meta / device identity -----------------------------------------
+
+	public async getMeta(key: string): Promise<string | null> {
+		const row = await this.db.selectOne('SELECT value FROM meta WHERE key = ?', [key]);
+		return row ? (row.value as string) : null;
+	}
+
+	public async setMeta(key: string, value: string): Promise<void> {
+		await this.db.exec(
+			'INSERT INTO meta (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value',
+			[key, value],
+		);
+	}
+
+	// Reads the device's key pair and display name from meta, generating and
+	// persisting a fresh key pair the first time this is called.
+	public async deviceIdentity(): Promise<DeviceIdentity> {
+		let secretHex = await this.getMeta('deviceSecretKey');
+		if (!secretHex) {
+			const pair = generateKeyPair();
+			secretHex = bytesToHex(pair.secretKey);
+			await this.setMeta('deviceSecretKey', secretHex);
+		}
+		let name = await this.getMeta('deviceName');
+		if (!name) {
+			name = DEFAULT_DEVICE_NAME;
+			await this.setMeta('deviceName', name);
+		}
+		const secretKey = hexToBytes(secretHex);
+		return { secretKey, publicKey: getPublicKey(secretKey), name };
+	}
+
+	public async setDeviceName(name: string): Promise<void> {
+		await this.setMeta('deviceName', name);
+	}
+
+	// --- lists -------------------------------------------------------------
+
+	public async lists(): Promise<ListRecord[]> {
+		const rows = await this.db.selectAll('SELECT * FROM lists ORDER BY sort_order ASC, name ASC');
+		return rows.map(rowToList);
+	}
+
+	public async list(id: string): Promise<ListRecord | null> {
+		const row = await this.db.selectOne('SELECT * FROM lists WHERE id = ?', [id]);
+		return row ? rowToList(row) : null;
+	}
+
+	// Persists a fully-formed list record as-is, without generating any keys.
+	// Used both by createList() below and when joining a list from an invite.
+	public async importList(record: ListRecord): Promise<void> {
+		const rows = await this.db.selectAll('SELECT COALESCE(MAX(sort_order), -1) as maxOrder FROM lists');
+		const nextOrder = record.sortOrder || Number(rows[0]?.maxOrder ?? -1) + 1;
+		await this.db.exec(
+			`INSERT INTO lists (id, kind, list_key, content_key, name, settings, relays, sort_order)
+				VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+				ON CONFLICT(id) DO UPDATE SET kind = excluded.kind, list_key = excluded.list_key,
+					content_key = excluded.content_key, name = excluded.name, settings = excluded.settings,
+					relays = excluded.relays`,
+			[record.id, record.kind, record.listKey, record.contentKey, record.name, record.settings, record.relays ? JSON.stringify(record.relays) : null, nextOrder],
+		);
+	}
+
+	// Creates a brand-new list, generating its keys locally (see
+	// docs/KONZEPT.md section 3 for open vs. managed). For a managed list, the
+	// `list_key` column holds the list's own secret key -- kept only on the
+	// creating admin's device, never distributed -- rather than being empty as
+	// it is for a device that only ever joined one.
+	public async createList(kind: ListKind, name: string): Promise<ListRecord> {
+		let id: string;
+		let listKeyHex: string | null;
+		let contentKey: Uint8Array;
+
+		if (kind === 'open') {
+			const listKey = generateListKey();
+			const derived = deriveOpenListKeys(listKey);
+			id = derived.listPubkey;
+			listKeyHex = bytesToHex(listKey);
+			contentKey = derived.contentKey;
+		} else {
+			const pair = generateKeyPair();
+			id = pair.publicKey;
+			listKeyHex = bytesToHex(pair.secretKey);
+			contentKey = generateContentKey();
+		}
+
+		const record: ListRecord = {
+			id, kind, listKey: listKeyHex, contentKey: bytesToHex(contentKey),
+			name, settings: null, relays: null, sortOrder: 0,
+		};
+		await this.importList(record);
+		return record;
+	}
+
+	public async renameList(id: string, name: string): Promise<void> {
+		await this.db.exec('UPDATE lists SET name = ? WHERE id = ?', [name, id]);
+	}
+
+	public async setListSettings(id: string, settings: string | null): Promise<void> {
+		await this.db.exec('UPDATE lists SET settings = ? WHERE id = ?', [settings, id]);
+	}
+
+	// Sets a list's content key to a specific value, e.g. once a joining
+	// device has unwrapped it from the admin's directory event.
+	public async setContentKey(listId: string, contentKey: Uint8Array): Promise<void> {
+		await this.db.exec('UPDATE lists SET content_key = ? WHERE id = ?', [bytesToHex(contentKey), listId]);
+	}
+
+	// Replaces a managed list's content key, e.g. after removing a member.
+	// Returns the new key so the caller can build and publish a fresh
+	// directory event with it.
+	public async rotateContentKey(listId: string): Promise<Uint8Array> {
+		const contentKey = generateContentKey();
+		await this.db.exec('UPDATE lists SET content_key = ? WHERE id = ?', [bytesToHex(contentKey), listId]);
+		return contentKey;
+	}
+
+	// --- members -------------------------------------------------------
+
+	public async members(listId: string): Promise<MemberRecord[]> {
+		const rows = await this.db.selectAll('SELECT * FROM members WHERE list_id = ? ORDER BY since ASC', [listId]);
+		return rows.map(rowToMember);
+	}
+
+	public async upsertMember(member: MemberRecord): Promise<void> {
+		await this.db.exec(
+			`INSERT INTO members (list_id, pubkey, name, role, since, removed_at) VALUES (?, ?, ?, ?, ?, ?)
+				ON CONFLICT(list_id, pubkey) DO UPDATE SET name = excluded.name, role = excluded.role,
+					since = excluded.since, removed_at = excluded.removed_at`,
+			[member.listId, member.pubkey, member.name, member.role, member.since, member.removedAt],
+		);
+	}
+
+	public async removeMember(listId: string, pubkey: string, removedAt: number): Promise<void> {
+		await this.db.exec('UPDATE members SET removed_at = ? WHERE list_id = ? AND pubkey = ?', [removedAt, listId, pubkey]);
+	}
+
+	// --- items -----------------------------------------------------------
+
+	public async items(listId: string, options: { open?: boolean } = {}): Promise<ItemRecord[]> {
+		let sql = 'SELECT * FROM items WHERE list_id = ? AND deleted = 0';
+		const params: (string | number)[] = [listId];
+		if (options.open !== undefined) {
+			sql += ' AND open = ?';
+			params.push(options.open ? 1 : 0);
+		}
+		sql += ' ORDER BY category ASC, name ASC';
+		const rows = await this.db.selectAll(sql, params);
+		return rows.map(rowToItem);
+	}
+
+	public async item(listId: string, dTag: string): Promise<ItemRecord | null> {
+		const row = await this.db.selectOne('SELECT * FROM items WHERE list_id = ? AND d_tag = ?', [listId, dTag]);
+		return row ? rowToItem(row) : null;
+	}
+
+	// Inserts or fully replaces an item row, e.g. after merging a remote
+	// payload. `pending` is left at 0 -- callers that make a local change
+	// should go through the field setters below, which set it.
+	public async upsertItem(item: ItemRecord): Promise<void> {
+		await this.db.exec(
+			`INSERT INTO items (list_id, d_tag, name, detail, detail_t, category, category_t, icon, icon_t, open, open_t, deleted, deleted_t, device, pending)
+				VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+				ON CONFLICT(list_id, d_tag) DO UPDATE SET name = excluded.name, detail = excluded.detail,
+					detail_t = excluded.detail_t, category = excluded.category, category_t = excluded.category_t,
+					icon = excluded.icon, icon_t = excluded.icon_t, open = excluded.open, open_t = excluded.open_t,
+					deleted = excluded.deleted, deleted_t = excluded.deleted_t, device = excluded.device, pending = excluded.pending`,
+			[
+				item.listId, item.dTag, item.name, item.detail, item.detailT, item.category, item.categoryT,
+				item.icon, item.iconT, item.open ? 1 : 0, item.openT, item.deleted ? 1 : 0, item.deletedT, item.device,
+				item.pending ? 1 : 0,
+			],
+		);
+	}
+
+	public async setOpen(listId: string, dTag: string, open: boolean, t: number, device: string): Promise<void> {
+		await this.db.exec(
+			'UPDATE items SET open = ?, open_t = ?, device = ?, pending = 1 WHERE list_id = ? AND d_tag = ?',
+			[open ? 1 : 0, t, device, listId, dTag],
+		);
+	}
+
+	public async setDetail(listId: string, dTag: string, detail: string | null, t: number, device: string): Promise<void> {
+		await this.db.exec(
+			'UPDATE items SET detail = ?, detail_t = ?, device = ?, pending = 1 WHERE list_id = ? AND d_tag = ?',
+			[detail, t, device, listId, dTag],
+		);
+	}
+
+	// Tombstones an item rather than removing the row, so a device that was
+	// offline when it was deleted doesn't resurrect it (see KONZEPT.md).
+	public async deleteItem(listId: string, dTag: string, t: number, device: string): Promise<void> {
+		await this.db.exec(
+			'UPDATE items SET deleted = 1, deleted_t = ?, device = ?, pending = 1 WHERE list_id = ? AND d_tag = ?',
+			[t, device, listId, dTag],
+		);
+	}
+
+	// Un-tombstones an existing item, e.g. when adding an item whose name
+	// matches one previously deleted.
+	public async undeleteItem(listId: string, dTag: string, t: number, device: string): Promise<void> {
+		await this.db.exec(
+			'UPDATE items SET deleted = 0, deleted_t = ?, open = 1, open_t = ?, device = ?, pending = 1 WHERE list_id = ? AND d_tag = ?',
+			[t, t, device, listId, dTag],
+		);
+	}
+
+	// The latest field timestamp seen so far for a list, used to clamp new
+	// local timestamps against a misbehaving device clock (see merge.ts).
+	public async maxSeenTime(listId: string): Promise<number> {
+		const row = await this.db.selectOne(
+			`SELECT MAX(
+				COALESCE(open_t, 0), COALESCE(detail_t, 0), COALESCE(category_t, 0), COALESCE(deleted_t, 0)
+			) as maxT FROM items WHERE list_id = ?`,
+			[listId],
+		);
+		return Number(row?.maxT ?? 0);
+	}
+
+	public async pendingItems(listId?: string): Promise<ItemRecord[]> {
+		const rows = listId
+			? await this.db.selectAll('SELECT * FROM items WHERE list_id = ? AND pending = 1', [listId])
+			: await this.db.selectAll('SELECT * FROM items WHERE pending = 1');
+		return rows.map(rowToItem);
+	}
+
+	public async markPublished(listId: string, dTag: string): Promise<void> {
+		await this.db.exec('UPDATE items SET pending = 0 WHERE list_id = ? AND d_tag = ?', [listId, dTag]);
+	}
+
+	// Autocomplete suggestions for the "add item" field: catalog entries
+	// (name or synonym) whose text starts with the prefix, then previously
+	// used item names across all lists that aren't already covered.
+	public async suggestions(prefix: string, limit = 10): Promise<CatalogMatch[]> {
+		const normalizedPrefix = normalizeName(prefix);
+		const results: CatalogMatch[] = [];
+		const seen = new Set<string>();
+
+		if (normalizedPrefix) {
+			for (const item of catalogItems) {
+				if (results.length >= limit) break;
+				const matches = normalizeName(item.name).startsWith(normalizedPrefix)
+					|| item.synonyms.some(s => normalizeName(s).startsWith(normalizedPrefix));
+				if (matches && !seen.has(item.name)) {
+					seen.add(item.name);
+					results.push({ canonical: item.name, emoji: item.emoji, category: item.category });
+				}
+			}
+		}
+
+		if (results.length < limit) {
+			const rows = await this.db.selectAll(
+				'SELECT DISTINCT name FROM items WHERE deleted = 0 AND name LIKE ? ORDER BY name LIMIT ?',
+				[`${prefix}%`, limit - results.length],
+			);
+			for (const row of rows) {
+				const name = row.name as string;
+				if (!seen.has(name)) {
+					seen.add(name);
+					results.push({ canonical: name, emoji: null, category: null });
+				}
+			}
+		}
+
+		return results.slice(0, limit);
+	}
+}
diff --git a/packages/app-mobile/lists/core/events.test.ts b/packages/app-mobile/lists/core/events.test.ts
