+
+		await db.upsertItem(item({ dTag: 'custom', name: 'Zauberkeks' }));
+		const custom = await db.suggestions('Zauber');
+		expect(custom).toContainEqual({ canonical: 'Zauberkeks', emoji: null, category: null });
+	});
+});
