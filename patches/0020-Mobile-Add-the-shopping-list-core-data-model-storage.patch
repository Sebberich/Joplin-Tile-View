+	});
+
+	test('members can be upserted and removed (tombstoned)', async () => {
+		const member: MemberRecord = { listId: 'list-1', pubkey: 'mem1', name: 'Sebastian', role: 'admin', since: 1, removedAt: null };
+		await db.upsertMember(member);
+		expect(await db.members('list-1')).toEqual([member]);
+
+		await db.removeMember('list-1', 'mem1', 42);
+		expect(await db.members('list-1')).toEqual([{ ...member, removedAt: 42 }]);
+	});
+
+	test('rotateContentKey and setContentKey change the list content key', async () => {
+		const list = await db.createList('managed', 'Household');
+		const rotated = await db.rotateContentKey(list.id);
+		const stored = await db.list(list.id);
+		expect(stored!.contentKey).not.toBe(list.contentKey);
+
+		await db.setContentKey(list.id, rotated);
+		expect((await db.list(list.id))!.contentKey).toBe(bytesToHex(rotated));
+	});
+
+	test('suggestions returns catalog matches by prefix, then previously used item names', async () => {
+		const fromCatalog = await db.suggestions('Milc');
