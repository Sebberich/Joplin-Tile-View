+// Pure data types shared by the shopping-list core. No UI, no networking.
+
+// Whether a list's member directory is controlled by every member equally ('open')
+// or only by admins ('managed'). See docs/KONZEPT.md section 3.
+export type ListKind = 'open' | 'managed';
+
+export type Role = 'admin' | 'member';
+
+// A single field in a merged record: its current value and the device time at
+// which it was set. Used for last-writer-wins merging, see merge.ts.
+export interface FieldValue<T> {
+	v: T;
+	t: number;
+}
+
+export interface ListRecord {
+	// Hex-encoded list public key (Nostr pubkey), also the list's identifier on relays.
+	id: string;
+	kind: ListKind;
+	// Hex-encoded 32-byte list key, only present for 'open' lists (source of the
+	// derived list key pair and content key). Null for 'managed' lists.
+	listKey: string | null;
+	// Hex-encoded 32-byte symmetric content key, used to derive item d-tags and
+	// to encrypt/decrypt item and directory events. Null while joining a
+	// managed list, until the admin's directory event has been received and
+	// this device's wrapped entry in it has been unwrapped.
+	contentKey: string | null;
+	name: string;
+	// Arbitrary JSON, synced as part of the list (category order, custom synonyms).
+	settings: string | null;
+	// JSON array of relay URLs; null/empty means "use the app defaults".
+	relays: string[] | null;
+	sortOrder: number;
+}
+
+export interface MemberRecord {
+	listId: string;
+	// Hex-encoded device public key of the member.
+	pubkey: string;
+	name: string | null;
+	role: Role;
+	since: number;
+	// Set when the member was removed (tombstone); null while active.
+	removedAt: number | null;
+}
+
+export interface ItemRecord {
+	listId: string;
+	// HMAC(contentKey, 'item:' + normalizedName), see crypto.ts#dTag.
+	dTag: string;
+	// Display name, following the field with the latest timestamp among the
+	// contributing records (name itself carries no per-field timestamp).
+	name: string;
+	detail: string | null;
+	detailT: number | null;
+	category: string | null;
+	categoryT: number | null;
+	icon: string | null;
+	iconT: number | null;
+	open: boolean;
+	openT: number;
+	deleted: boolean;
+	deletedT: number | null;
+	// Hex prefix (8 chars) of the device pubkey that produced the current state.
+	device: string;
+	// True while this item has local changes not yet confirmed published.
+	pending: boolean;
+}
+
+// The decrypted payload carried by an item event (see events.ts).
+export interface ItemPayload {
+	name: string;
+	detail?: FieldValue<string>;
+	category?: FieldValue<string>;
+	open: FieldValue<boolean>;
+	deleted?: FieldValue<boolean>;
+	icon?: FieldValue<string>;
+	device: string;
+}
+
+export interface CategoryDef {
+	id: string;
+	name: string;
+	emoji: string;
+}
+
+export interface CatalogItemDef {
+	name: string;
+	emoji: string;
+	category: string;
+	synonyms: string[];
+}
+
+export interface CatalogMatch {
+	canonical: string;
+	emoji: string | null;
+	category: string | null;
+}
