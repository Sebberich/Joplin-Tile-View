+++ b/packages/app-mobile/lists/notify/suppression.test.ts
@@ -0,0 +1,34 @@
+import { decideNotify, SuppressionInput } from './suppression';
+
+const base: SuppressionInput = {
+	globalNotifyEnabled: true,
+	listNotifyEnabled: true,
+	isActiveListScreen: false,
+	appInForeground: true,
+};
+
+describe('lists/notify/suppression', () => {
+	test('notifies when nothing suppresses it', () => {
+		expect(decideNotify(base)).toEqual({ notify: true });
+	});
+
+	test('suppresses when notifications are off globally', () => {
+		expect(decideNotify({ ...base, globalNotifyEnabled: false })).toEqual({ notify: false, reason: 'globalDisabled' });
+	});
+
+	test('suppresses when notifications are off for this list, even if global is on', () => {
+		expect(decideNotify({ ...base, listNotifyEnabled: false })).toEqual({ notify: false, reason: 'listDisabled' });
+	});
+
+	test('suppresses when the list\'s screen is open and the app is foregrounded', () => {
+		expect(decideNotify({ ...base, isActiveListScreen: true, appInForeground: true })).toEqual({ notify: false, reason: 'listScreenOpen' });
+	});
+
+	test('does not suppress for an active screen while the app is backgrounded (e.g. left mid-screen)', () => {
+		expect(decideNotify({ ...base, isActiveListScreen: true, appInForeground: false })).toEqual({ notify: true });
+	});
+
+	test('global takes priority over the per-list reason when both would suppress', () => {
+		expect(decideNotify({ ...base, globalNotifyEnabled: false, listNotifyEnabled: false })).toEqual({ notify: false, reason: 'globalDisabled' });
+	});
+});
diff --git a/packages/app-mobile/lists/notify/suppression.ts b/packages/app-mobile/lists/notify/suppression.ts
new file mode 100644
index 0000000..c54d156
--- /dev/null
+++ b/packages/app-mobile/lists/notify/suppression.ts
@@ -0,0 +1,21 @@
+// Pure "should this notification actually be shown" decision, kept separate
+// from notifyManager.ts's DB/native-module wiring so it's directly testable.
+export interface SuppressionInput {
+	globalNotifyEnabled: boolean;
+	listNotifyEnabled: boolean;
+	// True when this list's screen is the one currently on screen.
+	isActiveListScreen: boolean;
+	// True when the app itself is in the foreground (AppState.currentState === 'active').
+	appInForeground: boolean;
+}
+
+export type SuppressionResult =
+	| { notify: true }
+	| { notify: false; reason: 'globalDisabled' | 'listDisabled' | 'listScreenOpen' };
+
+export const decideNotify = (input: SuppressionInput): SuppressionResult => {
+	if (!input.globalNotifyEnabled) return { notify: false, reason: 'globalDisabled' };
+	if (!input.listNotifyEnabled) return { notify: false, reason: 'listDisabled' };
+	if (input.isActiveListScreen && input.appInForeground) return { notify: false, reason: 'listScreenOpen' };
+	return { notify: true };
+};
