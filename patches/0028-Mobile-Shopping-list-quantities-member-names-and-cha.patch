@@ -0,0 +1,18 @@
+// Per-list "notify me about this list" toggle. Stored in the lists DB's own
+// meta table (ListsDatabase#getMeta/setMeta, see ../core/db.ts) -- local to
+// this device, never synced -- the same pattern ListScreen.tsx already uses
+// for its tile-column count (see TILE_COLUMNS_META_KEY there).
+import { ListsDatabase } from '../core/db';
+
+const metaKey = (listId: string): string => `notify.enabled:${listId}`;
+
+// Default is enabled (matches the global 'lists.notifyChanges' setting's
+// default): a list with no stored value yet has never been turned off.
+export const isListNotifyEnabled = async (db: ListsDatabase, listId: string): Promise<boolean> => {
+	const value = await db.getMeta(metaKey(listId));
+	return value !== '0';
+};
+
+export const setListNotifyEnabled = async (db: ListsDatabase, listId: string, enabled: boolean): Promise<void> => {
+	await db.setMeta(metaKey(listId), enabled ? '1' : '0');
+};
diff --git a/packages/app-mobile/lists/notify/notifyManager.ts b/packages/app-mobile/lists/notify/notifyManager.ts
new file mode 100644
index 0000000..4e86e3f
--- /dev/null
+++ b/packages/app-mobile/lists/notify/notifyManager.ts
@@ -0,0 +1,110 @@
+// Wires remote list changes (see ../core/remoteChanges.ts, fed from
+// ListsStore#applyRemoteItem -- both the relay sync pass and Bluetooth
+// nearby sync go through it) into "someone changed your list" notifications:
+// aggregates per list for 30s (see ./aggregator.ts), resolves a display name
+// from the member directory, and skips showing anything the suppression
+// rules in ./suppression.ts say to skip. Call startNotifyManager() once at
+// startup (see utils/buildStartupTasks.ts); calling it again is a no-op.
+import { AppState } from 'react-native';
+import { _, _n } from '@joplin/lib/locale';
+import { ListsDatabase } from '../core/db';
+import { onRemoteChange, RemoteChangeEvent } from '../core/remoteChanges';
+import { showNativeNotification } from '../nearby/nativeBle';
+import { debugLog } from '../../utils/debugLog';
+import { getActiveListId } from './activeScreen';
+import { isListNotifyEnabled } from './listSettings';
+import { AggregatedEntry, formatAggregatedText, NotifyAggregator } from './aggregator';
+import { decideNotify } from './suppression';
+
+const log = debugLog('lists.notify');
+
+const AGGREGATION_WINDOW_MS = 30 * 1000;
+
+// Best-effort: Setting may not be initialized yet in tests or very early
+// startup (same pattern as lists/nearby/nearbyManager.ts's readAutoOffMinutes).
+const globalNotifyEnabled = (): boolean => {
+	try {
+		// eslint-disable-next-line @typescript-eslint/no-var-requires -- optional, avoids a hard dependency for this module's own tests
+		const Setting = require('@joplin/lib/models/Setting').default;
+		return Setting.value('lists.notifyChanges') !== false;
+	} catch (error) {
+		return true;
+	}
+};
+
+export class NotifyManager {
+	private db: ListsDatabase;
+	private aggregator: NotifyAggregator;
+	private unsubRemoteChange: (()=> void) | null = null;
+	private nextNotificationId = 1;
+
+	public constructor(db: ListsDatabase) {
+		this.db = db;
+		this.aggregator = new NotifyAggregator((listId, entries) => { void this.flush(listId, entries); }, AGGREGATION_WINDOW_MS);
+	}
+
+	public start(): void {
+		if (this.unsubRemoteChange) return;
+		this.unsubRemoteChange = onRemoteChange(event => this.onRemoteChange(event));
+	}
+
+	public stop(): void {
+		this.unsubRemoteChange?.();
+		this.unsubRemoteChange = null;
+		this.aggregator.dispose();
+	}
+
+	private onRemoteChange(event: RemoteChangeEvent): void {
+		const entry: AggregatedEntry = { device: event.device, itemName: event.itemName, kind: event.kind };
+		this.aggregator.add(event.listId, entry);
+		log.debug('Queued remote change for notification aggregation', { listId: event.listId.slice(0, 8), device: event.device, kind: event.kind });
+	}
+
+	private async flush(listId: string, entries: AggregatedEntry[]): Promise<void> {
+		if (entries.length === 0) return;
+		const listNotifyEnabled = await isListNotifyEnabled(this.db, listId);
+		const decision = decideNotify({
+			globalNotifyEnabled: globalNotifyEnabled(),
+			listNotifyEnabled,
+			isActiveListScreen: getActiveListId() === listId,
+			appInForeground: AppState.currentState === 'active',
+		});
+		if (decision.notify === false) {
+			log.info('Suppressed notification', { listId: listId.slice(0, 8), reason: decision.reason, entryCount: entries.length });
+			return;
+		}
+
+		const list = await this.db.list(listId);
+		if (!list) return;
+		const members = await this.db.members(listId);
+		const resolveName = (device: string): string | null => members.find(m => m.pubkey.slice(0, 8) === device)?.name ?? null;
+		const text = formatAggregatedText(
+			list.name, entries, resolveName, _('Someone'),
+			count => _n('+ %d more', '+ %d more', count, count),
+		);
+
+		log.info('Showing notification', { listId: listId.slice(0, 8), entryCount: entries.length });
+		try {
+			await showNativeNotification({
+				id: this.nextNotificationId++,
+				title: _('Shopping list changes'),
+				text,
+				deepLink: `joplintiles://list/${listId}`,
+			});
+		} catch (error) {
+			log.warn('Failed to show notification', { error: String(error) });
+		}
+	}
+}
+
+let singleton: NotifyManager | null = null;
+
+export const startNotifyManager = (db: ListsDatabase): void => {
+	if (!singleton) singleton = new NotifyManager(db);
+	singleton.start();
+};
+
+export const stopNotifyManager = (): void => {
+	singleton?.stop();
+	singleton = null;
+};
