+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { setupDatabaseAndSynchronizer } from '@joplin/lib/testing/test-utils';
+import Setting from '@joplin/lib/models/Setting';
+import { ListsDatabase } from '../core/db';
+import { ListsStore } from '../core/store';
+
+let testStore: ListsStore;
+let testDatabase: ListsDatabase;
+let dbPath: string;
+let refreshAllCalls: number;
+
+// Same swap-in as ListScreen.test.tsx/ShareScreen.test.tsx: a Node-backed
+// ListsStore/ListsDatabase instead of listsRuntime's real (expo-sqlite) one,
+// and a sync API whose refreshAll() is just counted, not a real relay pass.
+jest.mock('./listsRuntime', () => ({
+	getListsStore: () => testStore,
+	getListsDatabase: async () => { await testDatabase.openOrCreate('ignored'); return testDatabase; },
+	getListsDatabaseInstance: () => testDatabase,
+}));
+
+jest.mock('./syncApi', () => ({
+	getListsSync: () => ({
+		refreshAll: async () => { refreshAllCalls++; },
+	}),
+}));
+
+import { isListsDeviceNameSettingKey, LISTS_DEVICE_NAME_SETTING_KEY, onListsDeviceNameSettingChanged } from './deviceNameSettings';
+
+describe('lists/ui/deviceNameSettings', () => {
+	beforeEach(async () => {
+		await setupDatabaseAndSynchronizer(0);
+		dbPath = join(tmpdir(), `tiles-lists-devicename-test-${uuid.createNano()}.sqlite`);
+		testDatabase = new ListsDatabase(new Database(new DatabaseDriverNode()));
+		testStore = new ListsStore(testDatabase, dbPath);
+		refreshAllCalls = 0;
+	});
+
+	afterEach(async () => {
+		await rm(dbPath, { force: true });
+	});
+
+	test('isListsDeviceNameSettingKey matches only lists.deviceName', () => {
+		expect(isListsDeviceNameSettingKey('lists.deviceName')).toBe(true);
+		expect(isListsDeviceNameSettingKey('lists.relays')).toBe(false);
+	});
+
+	test('changing the setting updates the device identity and every list\'s own member row', async () => {
+		const db = await testDatabase.openOrCreate(dbPath).then(() => testDatabase);
+		const listA = await testStore.createOpenList('Groceries');
+		const listB = await testStore.createOpenList('Household');
+		const identity = await db.deviceIdentity();
+
+		Setting.setValue(LISTS_DEVICE_NAME_SETTING_KEY, 'Küchen-Tablet');
+		await onListsDeviceNameSettingChanged();
+
+		expect((await db.deviceIdentity()).name).toBe('Küchen-Tablet');
+		expect(await db.deviceNameChangedAt()).toBeGreaterThan(0);
+		expect(await db.profileName(listA.id, identity.publicKey)).toMatchObject({ name: 'Küchen-Tablet' });
+		expect(await db.profileName(listB.id, identity.publicKey)).toMatchObject({ name: 'Küchen-Tablet' });
+		expect(refreshAllCalls).toBe(1);
+	});
+
+	test('is a no-op when the setting value equals the current device name', async () => {
+		const db = await testDatabase.openOrCreate(dbPath).then(() => testDatabase);
+		const identity = await db.deviceIdentity();
+
+		Setting.setValue(LISTS_DEVICE_NAME_SETTING_KEY, identity.name);
+		await onListsDeviceNameSettingChanged();
+
+		expect(await db.deviceNameChangedAt()).toBe(0);
+		expect(refreshAllCalls).toBe(0);
+	});
+});
diff --git a/packages/app-mobile/lists/ui/deviceNameSettings.ts b/packages/app-mobile/lists/ui/deviceNameSettings.ts
new file mode 100644
index 0000000..a9a544d
--- /dev/null
+++ b/packages/app-mobile/lists/ui/deviceNameSettings.ts
@@ -0,0 +1,53 @@
+// Bridges the lists.deviceName setting (packages/lib/models/settings/builtInMetadata.ts,
+// section 'lists') to the shopping-list feature: propagating a rename to every list this
+// device is a member of. Modelled on utils/debugLogSettings.ts's bridge for the "Test
+// logging" settings -- see there for the general pattern (isXSettingKey() + a handler,
+// wired up from root.tsx's redux middleware whenever a matching setting changes).
+//
+// A managed list's directory can only be re-signed by an admin (see core/events.ts), so a
+// rename can't simply update the directory's `name` field the way an admin's own edits do.
+// Instead, each device publishes its own signed "profile" event per list (core/profile.ts)
+// with its current name; every device merges the newest one it's seen (by device time) into
+// its local `profiles` table and prefers it over the directory name when displaying a member
+// (see MembersScreen.tsx). Publishing itself is the sync layer's job (ListsSync#publishOwnProfile,
+// run as part of every normal sync pass) so a rename made while offline is simply queued,
+// the same way a pending item is.
+
+import Setting from '@joplin/lib/models/Setting';
+import { debugLog } from '../../utils/debugLog';
+import { getListsDatabase } from './listsRuntime';
+import { getListsSync } from './syncApi';
+
+const log = debugLog('lists.store');
+
+export const LISTS_DEVICE_NAME_SETTING_KEY = 'lists.deviceName';
+
+export const isListsDeviceNameSettingKey = (key: string): boolean => key === LISTS_DEVICE_NAME_SETTING_KEY;
+
+// Applies the current lists.deviceName setting value: updates the device's own identity and
+// this device's own row in every list's local `profiles` table (so MembersScreen reflects the
+// new name immediately, without waiting for a sync round trip), then kicks off a sync pass to
+// publish the change -- best-effort, since the device may be offline (the next natural sync
+// picks it up regardless, see ListsSync#publishOwnProfile).
+export const onListsDeviceNameSettingChanged = async (): Promise<void> => {
+	const db = await getListsDatabase();
+	const identity = await db.deviceIdentity();
+	// An empty setting means "use the default" (the device model, see
+	// core/db.ts#defaultDeviceName) -- but that default was already generated and persisted the
+	// first time deviceIdentity() ran, so there's nothing to change here in that case.
+	const newName = (Setting.value(LISTS_DEVICE_NAME_SETTING_KEY) as string || '').trim() || identity.name;
+	if (newName === identity.name) return;
+
+	const changedAt = Date.now();
+	await db.setDeviceName(newName, changedAt);
+
+	const lists = await db.lists();
+	for (const list of lists) await db.upsertProfileName(list.id, identity.publicKey, newName, changedAt);
+
+	log.info('Device name changed, queued profile republish', { lists: lists.length });
+	try {
+		await getListsSync().refreshAll();
+	} catch (error) {
+		log.warn('Could not publish the new device name right away (will retry on the next sync)', error);
+	}
+};
