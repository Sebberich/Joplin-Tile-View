diff --git a/packages/app-mobile/lists/core/remoteChanges.ts b/packages/app-mobile/lists/core/remoteChanges.ts
new file mode 100644
index 0000000..7bc2beb
--- /dev/null
+++ b/packages/app-mobile/lists/core/remoteChanges.ts
@@ -0,0 +1,55 @@
+// Tiny pub/sub, parallel to ListsStore's own ChangeEmitter (see ./store.ts),
+// that reports item changes ListsStore#applyRemoteItem accepted from another
+// device. Used by lists/notify to decide whether to show a "someone changed
+// your list" notification. Kept separate from ListsStore itself so that
+// store.ts (owned by another agent this round) only needs a single call
+// added to applyRemoteItem, see there.
+import { ItemPayload, ItemRecord } from './types';
+
+export type RemoteChangeKind = 'added' | 'reopened' | 'bought' | 'deleted';
+
+export interface RemoteChangeEvent {
+	listId: string;
+	itemDTag: string;
+	itemName: string;
+	// The remote device's 8-char tag, same truncation as store.ts's own
+	// (unexported) deviceTag() helper -- used to resolve a display name and to
+	// exclude a device's own changes from its own notifications.
+	device: string;
+	kind: RemoteChangeKind;
+	at: number;
+}
+
+type Listener = (event: RemoteChangeEvent)=> void;
+const listeners = new Set<Listener>();
+
+export const onRemoteChange = (listener: Listener): (()=> void) => {
+	listeners.add(listener);
+	return () => listeners.delete(listener);
+};
+
+// What visibly changed between the item's state before and after
+// applyRemoteItem() merged in a remote payload -- or null if nothing a person
+// would notice changed (e.g. a field-wise merge that didn't move `open`/
+// `deleted`, such as a detail/category/icon-only update, or a no-op replay).
+export const deriveRemoteChangeKind = (previous: ItemRecord | null, merged: ItemRecord): RemoteChangeKind | null => {
+	if (!previous) return merged.deleted ? null : 'added';
+	if (merged.deleted && !previous.deleted) return 'deleted';
+	if (merged.deleted) return null;
+	if (merged.open && !previous.open) return 'reopened';
+	if (!merged.open && previous.open) return 'bought';
+	return null;
+};
+
+// Called from ListsStore#applyRemoteItem with the item's state just before
+// and just after the merge. Skips devices notifying about their own changes
+// (an echo of a locally-authored event coming back via relay or Bluetooth).
+export const emitRemoteChange = (
+	listId: string, itemDTag: string, previous: ItemRecord | null, remote: ItemPayload, merged: ItemRecord, localPublicKey: string,
+): void => {
+	if (remote.device === localPublicKey.slice(0, 8)) return;
+	const kind = deriveRemoteChangeKind(previous, merged);
+	if (!kind) return;
+	const event: RemoteChangeEvent = { listId, itemDTag, itemName: merged.name, device: remote.device, kind, at: Date.now() };
+	for (const listener of listeners) listener(event);
+};
