new file mode 100644
index 0000000..d14d944
--- /dev/null
+++ b/packages/app-mobile/lists/notify/aggregator.ts
@@ -0,0 +1,98 @@
+// Pure aggregation logic for "someone changed your list" notifications: buffers
+// remote changes for a list for a short window, then formats them into one
+// line such as "Zuhause – Anna: + Milch, + Brot, ✓ Eier". No native/DB/setting
+// code here -- see notifyManager.ts for the wiring, and RemoteChangeKind in
+// ../core/remoteChanges.ts for where entries come from.
+import { RemoteChangeKind } from '../core/remoteChanges';
+
+export interface AggregatedEntry {
+	device: string;
+	itemName: string;
+	kind: RemoteChangeKind;
+}
+
+// 'added' and 'reopened' share a symbol: from a notification's point of view
+// both mean "back on the list", see docs/KONZEPT.md section 3's icon table.
+export const KIND_SYMBOL: Record<RemoteChangeKind, string> = {
+	added: '+',
+	reopened: '+',
+	bought: '✓',
+	deleted: '−',
+};
+
+export const MAX_SHOWN_ENTRIES = 6;
+
+// Formats one aggregated notification line. `resolveName` looks up a display
+// name for a device tag (member directory / profile name), returning null if
+// unknown -- the caller then falls back to a localized "Someone"/"Jemand".
+// `formatMore` formats the "+ n more" tail, also localized by the caller
+// (e.g. with @joplin/lib's `_n`).
+export const formatAggregatedText = (
+	listName: string,
+	entries: AggregatedEntry[],
+	resolveName: (device: string)=> string | null,
+	unknownMemberLabel: string,
+	formatMore: (count: number)=> string,
+): string => {
+	const authorNames: string[] = [];
+	for (const entry of entries) {
+		const name = resolveName(entry.device) ?? unknownMemberLabel;
+		if (!authorNames.includes(name)) authorNames.push(name);
+	}
+	const shown = entries.slice(0, MAX_SHOWN_ENTRIES);
+	const extraCount = entries.length - shown.length;
+	const parts = shown.map(entry => `${KIND_SYMBOL[entry.kind]} ${entry.itemName}`);
+	if (extraCount > 0) parts.push(formatMore(extraCount));
+	return `${listName} – ${authorNames.join(', ')}: ${parts.join(', ')}`;
+};
+
+type FlushCallback = (listId: string, entries: AggregatedEntry[])=> void;
+
+// Buffers incoming entries per list for `windowMs` (30s in production, see
+// notifyManager.ts) before calling `flush` once with everything collected --
+// so five quick changes to the same list become one notification, not five.
+export class NotifyAggregator {
+	private pending = new Map<string, { entries: AggregatedEntry[]; timer: ReturnType<typeof setTimeout> }>();
+	private flush: FlushCallback;
+	private windowMs: number;
+	private setTimeoutFn: typeof setTimeout;
+	private clearTimeoutFn: typeof clearTimeout;
+
+	public constructor(flush: FlushCallback, windowMs = 30000, setTimeoutFn: typeof setTimeout = setTimeout, clearTimeoutFn: typeof clearTimeout = clearTimeout) {
+		this.flush = flush;
+		this.windowMs = windowMs;
+		this.setTimeoutFn = setTimeoutFn;
+		this.clearTimeoutFn = clearTimeoutFn;
+	}
+
+	public add(listId: string, entry: AggregatedEntry): void {
+		let bucket = this.pending.get(listId);
+		if (!bucket) {
+			bucket = { entries: [], timer: this.setTimeoutFn(() => this.flushList(listId), this.windowMs) };
+			this.pending.set(listId, bucket);
+		}
+		bucket.entries.push(entry);
+	}
+
+	private flushList(listId: string): void {
+		const bucket = this.pending.get(listId);
+		if (!bucket) return;
+		this.pending.delete(listId);
+		this.flush(listId, bucket.entries);
+	}
+
+	// Flushes every pending list immediately (e.g. before the app is
+	// backgrounded/closed, so a change isn't silently lost mid-window).
+	public flushAll(): void {
+		for (const listId of [...this.pending.keys()]) {
+			const bucket = this.pending.get(listId);
+			if (bucket) this.clearTimeoutFn(bucket.timer);
+			this.flushList(listId);
+		}
+	}
+
+	public dispose(): void {
+		for (const bucket of this.pending.values()) this.clearTimeoutFn(bucket.timer);
+		this.pending.clear();
+	}
+}
