--- /dev/null
+++ b/packages/app-mobile/lists/core/profile.test.ts
@@ -0,0 +1,66 @@
+import { generateContentKey, generateKeyPair } from './crypto';
+import { InvalidEventError } from './events';
+import {
+	buildProfileEvent,
+	displayName,
+	isProfileDTag,
+	mergeProfileName,
+	parseProfileEvent,
+	profileDTag,
+} from './profile';
+
+describe('lists/core/profile', () => {
+	test('profile event round-trips through build/parse', () => {
+		const device = generateKeyPair();
+		const contentKey = generateContentKey();
+
+		const event = buildProfileEvent(device.secretKey, 'list-pubkey', contentKey, 'Küche', 1234);
+
+		expect(event.tags).toContainEqual(['d', 'profile:list-pubkey']);
+		expect(event.tags).toContainEqual(['L', 'list-pubkey']);
+		const parsed = parseProfileEvent(event, contentKey);
+		expect(parsed).toEqual({ name: 'Küche', t: 1234, devicePubkey: device.publicKey });
+	});
+
+	test('parsing a profile event fails with a wrong content key', () => {
+		const device = generateKeyPair();
+		const event = buildProfileEvent(device.secretKey, 'list-pubkey', generateContentKey(), 'Küche', 1);
+
+		expect(() => parseProfileEvent(event, generateContentKey())).toThrow();
+	});
+
+	test('parsing a tampered profile event fails signature verification', () => {
+		const device = generateKeyPair();
+		const contentKey = generateContentKey();
+		const event = buildProfileEvent(device.secretKey, 'list-pubkey', contentKey, 'Küche', 1);
+
+		// See events.test.ts for why a JSON round-trip (not a spread) is needed
+		// here: it drops nostr-tools' cached "already verified" flag.
+		const tampered = { ...JSON.parse(JSON.stringify(event)), content: `${event.content.slice(0, -2)}zz` };
+
+		expect(() => parseProfileEvent(tampered, contentKey)).toThrow(InvalidEventError);
+	});
+
+	test('isProfileDTag distinguishes profile d-tags from item/directory/join ones', () => {
+		expect(isProfileDTag(profileDTag('list-pubkey'))).toBe(true);
+		expect(isProfileDTag('members')).toBe(false);
+		expect(isProfileDTag('join:abc')).toBe(false);
+		expect(isProfileDTag('item-d-tag')).toBe(false);
+	});
+
+	test.each([
+		{ current: null, incoming: { name: 'Handy', t: 5 }, expected: { name: 'Handy', t: 5 } },
+		{ current: { name: 'Alt', t: 5 }, incoming: { name: 'Neu', t: 10 }, expected: { name: 'Neu', t: 10 } },
+		{ current: { name: 'Alt', t: 10 }, incoming: { name: 'Neu', t: 5 }, expected: { name: 'Alt', t: 10 } },
+		{ current: { name: 'Alt', t: 10 }, incoming: { name: 'Neu', t: 10 }, expected: { name: 'Alt', t: 10 } },
+	])('mergeProfileName: newest t wins ($current, $incoming)', ({ current, incoming, expected }) => {
+		expect(mergeProfileName(current, incoming)).toEqual(expected);
+	});
+
+	test('displayName prefers the profile name, then the directory name, then null', () => {
+		expect(displayName({ name: 'Handy', t: 1 }, 'Küchen-Tablet')).toBe('Handy');
+		expect(displayName(null, 'Küchen-Tablet')).toBe('Küchen-Tablet');
+		expect(displayName(null, null)).toBeNull();
+		expect(displayName({ name: '', t: 1 }, 'Küchen-Tablet')).toBe('Küchen-Tablet');
+	});
+});
