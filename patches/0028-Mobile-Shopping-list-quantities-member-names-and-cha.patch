+import {
+	applyLocalQtyDelta, epochForReopen, formatQty, mergeQty, parseQuantityToken,
+	qtyIsZero, qtyTotal, REOPEN_UNDO_WINDOW_MS, splitQuantityFromText,
+} from './qty';
+import { Qty } from './types';
+
+describe('lists/core/qty', () => {
+	describe('parseQuantityToken', () => {
+		test.each([
+			['3', { unit: 'count', amount: 3 }],
+			['-4', { unit: 'count', amount: -4 }],
+			['3x', { unit: 'count', amount: 3 }],
+			['2kg', { unit: 'g', amount: 2000 }],
+			['500g', { unit: 'g', amount: 500 }],
+			['1,5l', { unit: 'ml', amount: 1500 }],
+			['500ml', { unit: 'ml', amount: 500 }],
+			['', null],
+			['abc', null],
+		])('%s -> %j', (input, expected) => {
+			expect(parseQuantityToken(input)).toEqual(expected);
+		});
+	});
+
+	describe('splitQuantityFromText', () => {
+		test('splits a leading amount from the name', () => {
+			expect(splitQuantityFromText('3 Eier')).toEqual({ quantity: { unit: 'count', amount: 3 }, rest: 'Eier' });
+		});
+
+		test('splits a trailing amount from the name', () => {
+			expect(splitQuantityFromText('Eier 7')).toEqual({ quantity: { unit: 'count', amount: 7 }, rest: 'Eier' });
+		});
+
+		test('returns null when there is no amount', () => {
+			expect(splitQuantityFromText('Salat')).toBeNull();
+		});
+
+		test('with allowWholeMatch, a bare amount matches with an empty rest', () => {
+			expect(splitQuantityFromText('1,5 kg', true)).toEqual({ quantity: { unit: 'g', amount: 1500 }, rest: '' });
+		});
+
+		test('without allowWholeMatch, an amount with nothing meaningful left over does not match', () => {
+			expect(splitQuantityFromText('7')).toBeNull();
+		});
+	});
+
+	describe('applyLocalQtyDelta (additive PN-counter) and qtyTotal', () => {
+		test('adds up multiple local deltas for the same device and unit', () => {
+			let qty = applyLocalQtyDelta(null, 1, 'aaaaaaaa', 'count', 3, 10);
+			qty = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'count', 7, 20);
+			expect(qtyTotal(qty, 'count')).toBe(10);
+		});
+
+		test('a negative delta is clamped so the known total never goes below 0', () => {
+			let qty = applyLocalQtyDelta(null, 1, 'aaaaaaaa', 'count', 3, 10);
+			qty = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'count', 7, 20); // 10
+			qty = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'count', -4, 30); // 6
+			expect(qtyTotal(qty, 'count')).toBe(6);
+
+			qty = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'count', -100, 40);
+			expect(qtyTotal(qty, 'count')).toBe(0);
+		});
+
+		test('incompatible units are tracked side by side', () => {
+			let qty = applyLocalQtyDelta(null, 1, 'aaaaaaaa', 'count', 2, 10);
+			qty = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'ml', 1000, 20);
+			expect(qtyTotal(qty, 'count')).toBe(2);
+			expect(qtyTotal(qty, 'ml')).toBe(1000);
+			expect(formatQty(qty)).toBe('2 + 1 l');
+		});
+
+		test('qtyIsZero is true only once every unit totals 0', () => {
+			expect(qtyIsZero(null)).toBe(true);
+			const qty = applyLocalQtyDelta(null, 1, 'aaaaaaaa', 'count', 3, 10);
+			expect(qtyIsZero(qty)).toBe(false);
+			const zeroed = applyLocalQtyDelta(qty, 1, 'aaaaaaaa', 'count', -3, 20);
+			expect(qtyIsZero(zeroed)).toBe(true);
+		});
+	});
+
+	describe('mergeQty (PN-counter merge across devices)', () => {
+		test('is commutative and idempotent, and sums concurrent adds from different devices', () => {
+			// Device A adds 3, device B (independently, without seeing A's write) adds 2.
+			const a: Qty = { epoch: 1, byDevice: { aaaaaaaa: { t: 10, units: { count: 3 } } } };
+			const b: Qty = { epoch: 1, byDevice: { bbbbbbbb: { t: 20, units: { count: 2 } } } };
+
+			const mergedAB = mergeQty(a, b);
+			const mergedBA = mergeQty(b, a);
+			expect(mergedAB).toEqual(mergedBA);
+			expect(qtyTotal(mergedAB, 'count')).toBe(5);
+
+			// Merging the result back in again changes nothing.
+			expect(mergeQty(mergedAB, a)).toEqual(mergedAB);
+			expect(mergeQty(mergedAB, b)).toEqual(mergedAB);
+		});
+
+		test('is associative and order-independent across three devices', () => {
+			const a: Qty = { epoch: 1, byDevice: { aaaaaaaa: { t: 10, units: { count: 3 } } } };
+			const b: Qty = { epoch: 1, byDevice: { bbbbbbbb: { t: 20, units: { count: 2 } } } };
+			const c: Qty = { epoch: 1, byDevice: { cccccccc: { t: 30, units: { count: 1 } } } };
+
+			const total = (qty: Qty | undefined) => qtyTotal(qty, 'count');
+			expect(total(mergeQty(mergeQty(a, b), c))).toBe(6);
+			expect(total(mergeQty(a, mergeQty(b, c)))).toBe(6);
+			expect(total(mergeQty(mergeQty(c, a), b))).toBe(6);
+		});
+
+		test('for the same device, keeps the entry with the higher t (its own latest write wins)', () => {
+			const older: Qty = { epoch: 1, byDevice: { aaaaaaaa: { t: 10, units: { count: 3 } } } };
+			const newer: Qty = { epoch: 1, byDevice: { aaaaaaaa: { t: 20, units: { count: 5 } } } };
+			expect(mergeQty(older, newer)).toEqual(newer);
+			expect(mergeQty(newer, older)).toEqual(newer);
+		});
+
+		test('a higher epoch wins outright, discarding the whole previous epoch', () => {
+			const old: Qty = { epoch: 1, byDevice: { aaaaaaaa: { t: 10, units: { count: 3 } } } };
+			const fresh: Qty = { epoch: 2, byDevice: { bbbbbbbb: { t: 5, units: { count: 1 } } } };
+			expect(mergeQty(old, fresh)).toEqual(fresh);
+			expect(mergeQty(fresh, old)).toEqual(fresh);
+		});
+	});
+
+	describe('epochForReopen', () => {
+		const qty: Qty = { epoch: 100, byDevice: { aaaaaaaa: { t: 100, units: { count: 3 } } } };
+
+		test('within the undo window, keeps the previous epoch', () => {
+			const boughtT = 1_000_000;
+			const reopenT = boughtT + REOPEN_UNDO_WINDOW_MS - 1;
+			expect(epochForReopen(qty, boughtT, reopenT)).toBe(qty.epoch);
+		});
+
+		test('past the undo window, starts a fresh epoch at the reopen time', () => {
+			const boughtT = 1_000_000;
+			const reopenT = boughtT + REOPEN_UNDO_WINDOW_MS + 1;
+			expect(epochForReopen(qty, boughtT, reopenT)).toBe(reopenT);
+		});
+	});
+
+	describe('formatQty', () => {
+		test.each([
+			[{ epoch: 1, byDevice: { a: { t: 1, units: { count: 10 } } } }, '10'],
+			[{ epoch: 1, byDevice: { a: { t: 1, units: { ml: 2500 } } } }, '2,5 l'],
+			[{ epoch: 1, byDevice: { a: { t: 1, units: { ml: 500 } } } }, '500 ml'],
+			[{ epoch: 1, byDevice: { a: { t: 1, units: { g: 2500 } } } }, '2,5 kg'],
+			[{ epoch: 1, byDevice: { a: { t: 1, units: { g: 500 } } } }, '500 g'],
+			[null, ''],
+		])('%j -> %s', (qty, expected) => {
+			expect(formatQty(qty as Qty | null)).toBe(expected);
+		});
+	});
+});
