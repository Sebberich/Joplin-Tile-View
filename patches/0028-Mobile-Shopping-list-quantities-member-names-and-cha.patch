diff --git a/packages/app-mobile/lists/ui/ShareScreen.test.tsx b/packages/app-mobile/lists/ui/ShareScreen.test.tsx
new file mode 100644
index 0000000..66a8b4e
--- /dev/null
+++ b/packages/app-mobile/lists/ui/ShareScreen.test.tsx
@@ -0,0 +1,89 @@
+import * as React from 'react';
+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import { Share } from 'react-native';
+import { Store } from 'redux';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import TestProviderStack from '../../components/testing/TestProviderStack';
+import createMockReduxStore from '../../utils/testing/createMockReduxStore';
+import setupGlobalStore from '../../utils/testing/setupGlobalStore';
+import { fireEvent, render, screen, waitFor } from '../../utils/testing/testingLibrary';
+import { AppState } from '../../utils/types';
+import { ListsDatabase } from '../core/db';
+import { INVITE_LINK_PREFIX } from '../core/invite';
+import { ListsStore } from '../core/store';
+
+// Same approach as ListScreen.test.tsx: swap in a Node-backed ListsStore/
+// ListsDatabase instead of listsRuntime's real (expo-sqlite) one.
+let testStore: ListsStore;
+let testDatabase: ListsDatabase;
+
+jest.mock('./listsRuntime', () => ({
+	getListsStore: () => testStore,
+	getListsDatabase: async () => { await testDatabase.openOrCreate('ignored'); return testDatabase; },
+	getListsDatabaseInstance: () => testDatabase,
+}));
+
+import { ShareScreenComponent } from './ShareScreen';
+
+let reduxStore: Store<AppState>;
+let dbPath: string;
+
+const WrappedShareScreen: React.FC<{ listId: string }> = ({ listId }) => {
+	return <TestProviderStack store={reduxStore}>
+		<ShareScreenComponent navigation={{ state: { listId } }} themeId={reduxStore.getState().settings.theme} dispatch={reduxStore.dispatch} />
+	</TestProviderStack>;
+};
+
+describe('lists/ui/ShareScreen', () => {
+	beforeEach(async () => {
+		dbPath = join(tmpdir(), `tiles-lists-share-test-${uuid.createNano()}.sqlite`);
+		testDatabase = new ListsDatabase(new Database(new DatabaseDriverNode()));
+		testStore = new ListsStore(testDatabase, dbPath);
+
+		reduxStore = createMockReduxStore();
+		setupGlobalStore(reduxStore);
+	});
+
+	afterEach(async () => {
+		await rm(dbPath, { force: true });
+		jest.restoreAllMocks();
+	});
+
+	test('renders a normal header (title + back button) above the invite, not inside it', async () => {
+		const list = await testStore.createOpenList('Groceries');
+
+		render(<WrappedShareScreen listId={list.id} />);
+
+		await waitFor(() => {
+			expect(screen.getByText('Share list')).toBeTruthy();
+		});
+		expect(screen.getByLabelText('Back')).toBeTruthy();
+		// The QR code and invite link only show up once the invite has loaded.
+		await waitFor(() => {
+			expect(screen.getByText('Copy link')).toBeTruthy();
+		});
+	});
+
+	test('pressing "Share…" opens the share sheet with an invite message including the list name and link', async () => {
+		const list = await testStore.createOpenList('Groceries');
+		const shareSpy = jest.spyOn(Share, 'share').mockResolvedValue({ action: 'sharedAction' });
+
+		render(<WrappedShareScreen listId={list.id} />);
+
+		await waitFor(() => {
+			expect(screen.getByText('Share…')).toBeTruthy();
+		});
+		fireEvent.press(screen.getByText('Share…'));
+
+		await waitFor(() => {
+			expect(shareSpy).toHaveBeenCalledTimes(1);
+		});
+		const [{ message }] = shareSpy.mock.calls[0];
+		expect(message).toContain('Groceries');
+		expect(message).toContain(INVITE_LINK_PREFIX);
+	});
+});
