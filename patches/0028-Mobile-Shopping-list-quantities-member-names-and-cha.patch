@@ -0,0 +1,89 @@
+import { AggregatedEntry, formatAggregatedText, MAX_SHOWN_ENTRIES, NotifyAggregator } from './aggregator';
+
+const entry = (itemName: string, kind: AggregatedEntry['kind'], device = 'aaaaaaaa'): AggregatedEntry => ({ device, itemName, kind });
+
+describe('lists/notify/aggregator', () => {
+	test('formats entries with symbols, author name and list name', () => {
+		const entries = [entry('Milch', 'added'), entry('Brot', 'added'), entry('Eier', 'bought')];
+		const text = formatAggregatedText('Zuhause', entries, () => 'Anna', 'Someone', n => `+ ${n} more`);
+		expect(text).toBe('Zuhause – Anna: + Milch, + Brot, ✓ Eier');
+	});
+
+	test('falls back to the unknown-member label when the device has no resolvable name', () => {
+		const text = formatAggregatedText('Zuhause', [entry('Milch', 'added')], () => null, 'Someone', n => `+ ${n} more`);
+		expect(text).toBe('Zuhause – Someone: + Milch');
+	});
+
+	test('lists each distinct author once, in first-seen order', () => {
+		const entries = [entry('Milch', 'added', 'aaaaaaaa'), entry('Brot', 'added', 'bbbbbbbb'), entry('Eier', 'bought', 'aaaaaaaa')];
+		const names: Record<string, string> = { aaaaaaaa: 'Anna', bbbbbbbb: 'Ben' };
+		const text = formatAggregatedText('Zuhause', entries, device => names[device] ?? null, 'Someone', n => `+ ${n} more`);
+		expect(text).toBe('Zuhause – Anna, Ben: + Milch, + Brot, ✓ Eier');
+	});
+
+	test('truncates after MAX_SHOWN_ENTRIES and appends a "+ n more" tail', () => {
+		const entries = Array.from({ length: MAX_SHOWN_ENTRIES + 3 }, (_unused, i) => entry(`Item ${i}`, 'added'));
+		const text = formatAggregatedText('Zuhause', entries, () => 'Anna', 'Someone', n => `+ ${n} more`);
+		const parts = text.split(': ')[1].split(', ');
+		expect(parts).toHaveLength(MAX_SHOWN_ENTRIES + 1);
+		expect(parts[parts.length - 1]).toBe('+ 3 more');
+	});
+
+	test('deleted uses the "−" symbol', () => {
+		const text = formatAggregatedText('Zuhause', [entry('Milch', 'deleted')], () => 'Anna', 'Someone', n => `+ ${n} more`);
+		expect(text).toBe('Zuhause – Anna: − Milch');
+	});
+
+	test('notifyAggregator buffers entries per list and flushes once after the window elapses', () => {
+		jest.useFakeTimers();
+		try {
+			const flush = jest.fn();
+			const aggregator = new NotifyAggregator(flush, 30000);
+			aggregator.add('list-1', entry('Milch', 'added'));
+			aggregator.add('list-1', entry('Brot', 'added'));
+			aggregator.add('list-2', entry('Eier', 'bought'));
+
+			expect(flush).not.toHaveBeenCalled();
+			jest.advanceTimersByTime(30000);
+
+			expect(flush).toHaveBeenCalledTimes(2);
+			expect(flush).toHaveBeenCalledWith('list-1', [entry('Milch', 'added'), entry('Brot', 'added')]);
+			expect(flush).toHaveBeenCalledWith('list-2', [entry('Eier', 'bought')]);
+		} finally {
+			jest.useRealTimers();
+		}
+	});
+
+	test('notifyAggregator starts a fresh window for a list after an earlier one already flushed', () => {
+		jest.useFakeTimers();
+		try {
+			const flush = jest.fn();
+			const aggregator = new NotifyAggregator(flush, 30000);
+			aggregator.add('list-1', entry('Milch', 'added'));
+			jest.advanceTimersByTime(30000);
+			aggregator.add('list-1', entry('Brot', 'added'));
+			jest.advanceTimersByTime(30000);
+
+			expect(flush).toHaveBeenCalledTimes(2);
+			expect(flush).toHaveBeenNthCalledWith(1, 'list-1', [entry('Milch', 'added')]);
+			expect(flush).toHaveBeenNthCalledWith(2, 'list-1', [entry('Brot', 'added')]);
+		} finally {
+			jest.useRealTimers();
+		}
+	});
+
+	test('notifyAggregator#flushAll() flushes every pending list immediately, without waiting for the window', () => {
+		jest.useFakeTimers();
+		try {
+			const flush = jest.fn();
+			const aggregator = new NotifyAggregator(flush, 30000);
+			aggregator.add('list-1', entry('Milch', 'added'));
+			aggregator.flushAll();
+			expect(flush).toHaveBeenCalledTimes(1);
+			jest.advanceTimersByTime(30000);
+			expect(flush).toHaveBeenCalledTimes(1); // no second, stale flush from the cleared timer
+		} finally {
+			jest.useRealTimers();
+		}
+	});
+});
