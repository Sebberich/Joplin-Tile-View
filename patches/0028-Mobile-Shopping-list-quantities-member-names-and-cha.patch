@@ -0,0 +1,76 @@
+import { deriveRemoteChangeKind, emitRemoteChange, onRemoteChange, RemoteChangeEvent } from './remoteChanges';
+import { ItemPayload, ItemRecord } from './types';
+
+const record = (overrides: Partial<ItemRecord> = {}): ItemRecord => ({
+	listId: 'list-1', dTag: 'item-1', name: 'Milch',
+	detail: null, detailT: null, category: null, categoryT: null, icon: null, iconT: null,
+	open: true, openT: 1000, deleted: false, deletedT: null, device: 'bbbbbbbb', pending: false, qty: null,
+	...overrides,
+});
+
+const payload = (overrides: Partial<ItemPayload> = {}): ItemPayload => ({
+	name: 'Milch', open: { v: true, t: 1000 }, device: 'bbbbbbbb', ...overrides,
+});
+
+describe('lists/core/remoteChanges', () => {
+	test('deriveRemoteChangeKind: a brand-new item is "added"', () => {
+		expect(deriveRemoteChangeKind(null, record())).toBe('added');
+	});
+
+	test('deriveRemoteChangeKind: a brand-new item that arrives already deleted is not reported', () => {
+		expect(deriveRemoteChangeKind(null, record({ deleted: true }))).toBeNull();
+	});
+
+	test('deriveRemoteChangeKind: deleted transition is "deleted"', () => {
+		expect(deriveRemoteChangeKind(record({ deleted: false }), record({ deleted: true }))).toBe('deleted');
+	});
+
+	test('deriveRemoteChangeKind: already-deleted staying deleted reports nothing', () => {
+		expect(deriveRemoteChangeKind(record({ deleted: true }), record({ deleted: true }))).toBeNull();
+	});
+
+	test('deriveRemoteChangeKind: bought -> open transition is "reopened"', () => {
+		expect(deriveRemoteChangeKind(record({ open: false }), record({ open: true }))).toBe('reopened');
