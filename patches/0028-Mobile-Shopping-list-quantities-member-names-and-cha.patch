+// Quantity math for shopping-list items: parsing amounts out of free text,
+// the additive PN-counter used to track "how much" across devices without a
+// central total, unit conversion/formatting, and the epoch-reset rule for
+// re-opening a bought item. See docs/KONZEPT.md section 2 and
+// lists/ui/parseItemInput.ts, which builds on splitQuantityFromText() below.
+//
+// Data model: `qty.byDevice[device]` holds one device's own cumulative delta
+// per unit, plus when it last wrote that entry. A device only ever writes
+// its own entry, which is what makes merging safe (see mergeQty()): the
+// known total for a unit is the sum of every device's entry for it, clamped
+// to >= 0 for display.
+
+import { QtyDeviceEntry, Qty, QtyUnit, QuantityDelta } from './types';
+
+// A re-open within this many ms of the bought timestamp undoes the "mark
+// bought" (the old quantity comes back); past it, it starts a fresh epoch
+// (the old quantity is gone). See epochForReopen().
+export const REOPEN_UNDO_WINDOW_MS = 5 * 60 * 1000;
+
+export const QTY_UNITS: QtyUnit[] = ['count', 'g', 'ml'];
+
+// Recognised amount units, longest/most specific first isn't required here
+// since the caller's regex always requires a word boundary after the match.
+// Kept in one place so the "add item" field, the item editor's quantity
+// field and the detail->qty migration (db.ts) all agree on the same set.
+export const QTY_UNIT_WORDS = ['kg', 'g', 'l', 'ml', 'stk', 'stück', 'st', 'pkg', 'pck', 'dose', 'dosen', 'flasche', 'flaschen', 'packung', 'packungen', 'bund', 'bündel', 'x'];
+
+const NUMBER_PATTERN = '-?\\d+(?:[.,]\\d+)?';
+const UNIT_PATTERN = QTY_UNIT_WORDS.join('|');
+const AMOUNT_TOKEN = `${NUMBER_PATTERN}\\s*(?:${UNIT_PATTERN})?`;
+const QUANTITY_TOKEN = new RegExp(`^(${NUMBER_PATTERN})\\s*(${UNIT_PATTERN})?$`, 'i');
+const LEADING_AMOUNT = new RegExp(`^(${AMOUNT_TOKEN})\\s+(.+)$`, 'i');
+const TRAILING_AMOUNT = new RegExp(`^(.+?)\\s+(${AMOUNT_TOKEN})$`, 'i');
+
+const parseGermanNumber = (raw: string): number => parseFloat(raw.replace(',', '.'));
+
+// Parses a single amount token, e.g. "3", "-4", "2kg", "500ml", "1,5l",
+// "3x" -- no surrounding name text. Container-type count units (Stück, Pck,
+// Flasche, Dose, Bund, "x", or no unit at all) all map to the same 'count'
+// bucket; only mass and volume convert to a smaller base unit.
+export const parseQuantityToken = (raw: string): QuantityDelta | null => {
+	const trimmed = raw.trim();
+	if (!trimmed) return null;
+	const match = QUANTITY_TOKEN.exec(trimmed);
+	if (!match) return null;
+	const amount = parseGermanNumber(match[1]);
+	if (Number.isNaN(amount)) return null;
+	const unit = (match[2] ?? '').toLowerCase();
+	if (unit === 'kg') return { unit: 'g', amount: amount * 1000 };
+	if (unit === 'g') return { unit: 'g', amount };
+	if (unit === 'l') return { unit: 'ml', amount: amount * 1000 };
+	if (unit === 'ml') return { unit: 'ml', amount };
+	return { unit: 'count', amount };
+};
+
+export interface SplitQuantity {
+	quantity: QuantityDelta;
+	rest: string;
+}
+
+// Pulls a leading or trailing amount out of free text, e.g. "3 Eier",
+// "Eier 7", "2 l Milch" -- the rest is what's left over (the item name for
+// the "add item" field, or the remaining note text when migrating an old
+// combined detail value, see db.ts). With `allowWholeMatch` (only used by
+// that migration) a detail value that is *only* an amount, with nothing
+// left over, also matches -- not used for the "add item" field, where a
+// bare number has no name to attach it to.
+export const splitQuantityFromText = (text: string, allowWholeMatch = false): SplitQuantity | null => {
+	const trimmed = text.trim().replace(/\s+/g, ' ');
+	if (!trimmed) return null;
+
+	if (allowWholeMatch) {
+		const whole = parseQuantityToken(trimmed);
+		if (whole) return { quantity: whole, rest: '' };
+	}
+
+	const leading = trimmed.match(LEADING_AMOUNT);
+	if (leading) {
+		const quantity = parseQuantityToken(leading[1]);
+		if (quantity) return { quantity, rest: leading[2].trim() };
+	}
+
+	const trailing = trimmed.match(TRAILING_AMOUNT);
+	if (trailing) {
+		const quantity = parseQuantityToken(trailing[2]);
+		if (quantity) return { quantity, rest: trailing[1].trim() };
+	}
+
+	return null;
+};
+
+export const emptyQty = (epoch: number): Qty => ({ epoch, byDevice: {} });
+
+// The known total for one unit: the sum of every device's own entry,
+// clamped to >= 0 so a merge that hasn't yet seen every device's latest
+// write never displays (or triggers "bought" on) a transient negative.
+export const qtyTotal = (qty: Qty | null | undefined, unit: QtyUnit): number => {
+	if (!qty) return 0;
+	let sum = 0;
+	for (const entry of Object.values(qty.byDevice)) sum += entry.units[unit] ?? 0;
+	return Math.max(0, sum);
+};
+
+// Every unit with a non-zero total, e.g. { count: 2, ml: 1000 } for
+// "2 Pck + 1 l".
+export const qtyTotals = (qty: Qty | null | undefined): Partial<Record<QtyUnit, number>> => {
+	const totals: Partial<Record<QtyUnit, number>> = {};
+	for (const unit of QTY_UNITS) {
+		const total = qtyTotal(qty, unit);
+		if (total > 0) totals[unit] = total;
+	}
+	return totals;
+};
+
+export const qtyIsZero = (qty: Qty | null | undefined): boolean => QTY_UNITS.every(unit => qtyTotal(qty, unit) === 0);
+
+// The latest per-device write time in a qty object -- participates in an
+// item's overall "max field time", used by BLE/relay sync to decide who has
+// the newer version of an item (see core/store.ts#itemMaxFieldTime,
+// lists/nearby/nearbyManager.ts, lists/sync/listSync.ts).
+export const qtyMaxTime = (qty: Qty | null | undefined): number => {
+	if (!qty) return 0;
+	let max = 0;
+	for (const entry of Object.values(qty.byDevice)) max = Math.max(max, entry.t);
+	return max;
+};
+
+// Applies one device's local delta for one unit. The delta is clamped
+// against the *known* total (the sum across all devices) at input time, so
+// this device's own recorded delta can never drive that known total below
+// 0 -- e.g. typing "-4" against a known total of 3 records a delta of -3,
+// not -4. A device only ever writes its own entry (`device`); switching to
+// a different epoch (a fresh start after a >5 minute re-open, see
+// epochForReopen()) drops every device's previous entries.
+export const applyLocalQtyDelta = (qty: Qty | null | undefined, epoch: number, device: string, unit: QtyUnit, delta: number, t: number): Qty => {
+	const base: Qty = qty && qty.epoch === epoch ? qty : emptyQty(epoch);
+	const currentTotal = qtyTotal(base, unit);
+	const clampedDelta = delta < 0 ? -Math.min(-delta, currentTotal) : delta;
+	const existingEntry = base.byDevice[device];
+	const previousOwn = existingEntry?.units[unit] ?? 0;
+	const units = { ...(existingEntry?.units ?? {}), [unit]: previousOwn + clampedDelta };
+	return { epoch: base.epoch, byDevice: { ...base.byDevice, [device]: { t, units } } };
+};
+
+// Decides the epoch an item's quantity should be under after re-opening it
+// (bought -> open), given when it was marked bought and the re-open time:
+// within REOPEN_UNDO_WINDOW_MS it's treated as an undo of "mark bought" (the
+// same epoch, so the old quantity comes back); after that it's a fresh
+// start (a new epoch, discarding the old quantity). No timer is kept
+// running for this -- it's decided once, at re-open time, from the bought
+// timestamp.
+export const epochForReopen = (previousQty: Qty | null | undefined, boughtT: number, reopenT: number): number => {
+	if (reopenT - boughtT <= REOPEN_UNDO_WINDOW_MS) return previousQty?.epoch ?? reopenT;
+	return reopenT;
+};
+
+// Field-wise merge of two qty objects for the same item (see merge.ts):
+// commutative, associative and idempotent, like mergeItem(). A higher epoch
+// always wins outright -- a fresh epoch discards the whole previous one, on
+// every device, at once. For equal epochs, every device's entry is merged
+// independently by keeping the one with the higher `t`: since a device only
+// ever writes its own entry, its latest write always wins over its own
+// older one, and two different devices' entries never conflict with each
+// other.
+export const mergeQty = (a: Qty | undefined, b: Qty | undefined): Qty | undefined => {
+	if (!a) return b;
+	if (!b) return a;
+	if (a.epoch !== b.epoch) return a.epoch > b.epoch ? a : b;
+
+	const byDevice: { [device: string]: QtyDeviceEntry } = { ...a.byDevice };
+	for (const [device, entry] of Object.entries(b.byDevice)) {
+		const existing = byDevice[device];
+		if (!existing || entry.t >= existing.t) byDevice[device] = entry;
+	}
+	return { epoch: a.epoch, byDevice };
+};
+
+const formatNumber = (n: number): string => {
+	// German decimal comma, and no more than the fractional precision
+	// needed (1.5 -> "1,5", 2 -> "2", 0.25 -> "0,25").
+	const rounded = Math.round(n * 100) / 100;
+	return rounded.toString().replace('.', ',');
+};
+
+// Formats one unit's total for display: count as a plain number, mass as g
+// or kg (>= 1000 g), volume as ml or l (>= 1000 ml) -- always with a German
+// decimal comma. Used both by formatQty() below (every unit present) and by
+// ItemEditModal's quantity field (its own single edited unit).
+export const formatQtyUnit = (unit: QtyUnit, amount: number): string => {
+	if (unit === 'g') return amount >= 1000 ? `${formatNumber(amount / 1000)} kg` : `${formatNumber(amount)} g`;
+	if (unit === 'ml') return amount >= 1000 ? `${formatNumber(amount / 1000)} l` : `${formatNumber(amount)} ml`;
+	return formatNumber(amount);
+};
+
+// Formats an item's full quantity for the tile/editor, e.g. "10",
+// "2,5 l", or "2 + 1 l" when incompatible units are both present (see
+// qtyIsZero() for why they're never auto-converted into each other). Empty
+// when there's no quantity at all.
+export const formatQty = (qty: Qty | null | undefined): string => {
+	const totals = qtyTotals(qty);
+	const parts = QTY_UNITS.filter(unit => totals[unit] !== undefined).map(unit => formatQtyUnit(unit, totals[unit] as number));
+	return parts.join(' + ');
+};
