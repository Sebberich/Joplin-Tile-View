+	// --- foreground service (keeps the app alive while syncing, see
+	// NearbyForegroundService.kt and PROTOCOL.md) --------------------------
+
+	@ReactMethod
+	fun startForegroundService(channelName: String, channelDescription: String, title: String, text: String, stopLabel: String, promise: Promise) {
+		try {
+			NearbyForegroundService.start(reactApplicationContext, channelName, channelDescription, title, text, stopLabel)
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_FOREGROUND_SERVICE", e.message, e)
+		}
+	}
+
+	@ReactMethod
+	fun updateForegroundService(text: String, promise: Promise) {
+		try {
+			NearbyForegroundService.update(reactApplicationContext, text)
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_FOREGROUND_SERVICE", e.message, e)
+		}
+	}
+
+	@ReactMethod
+	fun stopForegroundService(promise: Promise) {
+		try {
+			NearbyForegroundService.stop(reactApplicationContext)
+			promise.resolve(null)
+		} catch (e: Exception) {
+			promise.reject("E_FOREGROUND_SERVICE", e.message, e)
+		}
+	}
+
+	private fun registerForegroundServiceStopReceiver() {
+		val receiver = object : BroadcastReceiver() {
+			override fun onReceive(context: Context, intent: Intent) {
+				emit("nearbyForegroundServiceStop", Arguments.createMap())
+			}
+		}
+		foregroundServiceStopReceiver = receiver
+		val filter = IntentFilter(NearbyForegroundService.BROADCAST_STOP)
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+			reactApplicationContext.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED)
+		} else {
+			reactApplicationContext.registerReceiver(receiver, filter)
+		}
+	}
+
+	// --- immediate local notifications ("someone changed your list", see
+	// lists/notify/) -----------------------------------------------------
+
+	@ReactMethod
+	fun showNotification(id: Int, channelId: String, channelName: String, channelDescription: String, title: String, text: String, deepLink: String, promise: Promise) {
+		try {
+			ensureNotificationChannel(channelId, channelName, channelDescription)
+			val intent = Intent(Intent.ACTION_VIEW, Uri.parse(deepLink))
+			intent.setPackage(reactApplicationContext.packageName)
+			val flags = PendingIntent.FLAG_UPDATE_CURRENT or (if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) PendingIntent.FLAG_IMMUTABLE else 0)
+			val contentIntent = PendingIntent.getActivity(reactApplicationContext, id, intent, flags)
+			val notification = NotificationCompat.Builder(reactApplicationContext, channelId)
+				.setContentTitle(title)
+				.setContentText(text)
+				.setStyle(NotificationCompat.BigTextStyle().bigText(text))
+				.setSmallIcon(reactApplicationContext.applicationInfo.icon)
+				.setAutoCancel(true)
+				.setContentIntent(contentIntent)
+				.setPriority(NotificationCompat.PRIORITY_DEFAULT)
+				.build()
+			NotificationManagerCompat.from(reactApplicationContext).notify(id, notification)
+			promise.resolve(null)
+		} catch (e: SecurityException) {
+			// POST_NOTIFICATIONS (API 33+) not granted -- the TS side is
+			// expected to have requested it (see NearbyStatusCircle.tsx), but
+			// this must never crash a sync pass just because it wasn't.
+			promise.reject("E_PERMISSION", e.message, e)
+		} catch (e: Exception) {
+			promise.reject("E_NOTIFY", e.message, e)
+		}
+	}
+
+	private fun ensureNotificationChannel(channelId: String, channelName: String, channelDescription: String) {
+		if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+		val manager = reactApplicationContext.getSystemService(NotificationManager::class.java) ?: return
+		if (manager.getNotificationChannel(channelId) != null) return
+		val channel = NotificationChannel(channelId, channelName, NotificationManager.IMPORTANCE_DEFAULT)
+		channel.description = channelDescription
+		manager.createNotificationChannel(channel)
+	}
+
