+// Per-list device profile events: a lightweight, addressable (kind 30078,
+// d = 'profile:' + listPubkey) event through which each device publishes its
+// own display name for one list, so a lists.deviceName change reaches other
+// members without needing directory write access (only admins may re-sign a
+// managed list's directory, see core/events.ts#buildManagedDirectoryEvent).
+// Mirrors the item/directory event builders in events.ts; kept in its own
+// module since it's a distinct concept (a device's self-reported name, not
+// list content) with its own merge rule below.
+import { EventTemplate, finalizeEvent, nip44, VerifiedEvent, verifyEvent } from 'nostr-tools';
+import { InvalidEventError, LIST_EVENT_KIND } from './events';
+
+export const PROFILE_D_TAG_PREFIX = 'profile:';
+
+export const profileDTag = (listPubkey: string): string => `${PROFILE_D_TAG_PREFIX}${listPubkey}`;
+
+// Whether an event's 'd' tag identifies it as a profile event, so the sync
+// layer can route kind-30078 events it fetches for a list (items, directory,
+// join requests, profiles) to the right handler without extra round trips.
+export const isProfileDTag = (dTag: string): boolean => dTag.startsWith(PROFILE_D_TAG_PREFIX);
+
+export interface ProfilePayload {
+	name: string;
+	// Device time (ms since epoch) the name was set -- the field this event's
+	// own created_at (seconds, clamped like every other event) can't safely
+	// carry across relay "too old" rejections and republishes, see
+	// listSync.ts#publishOwnProfile.
+	t: number;
+}
+
+const nowSeconds = (): number => Math.floor(Date.now() / 1000);
+
+export const buildProfileEvent = (
+	deviceSecretKey: Uint8Array,
+	listPubkey: string,
+	contentKey: Uint8Array,
+	name: string,
+	t: number,
+	createdAt: number = nowSeconds(),
+): VerifiedEvent => {
+	const payload: ProfilePayload = { name, t };
+	const template: EventTemplate = {
+		kind: LIST_EVENT_KIND,
+		tags: [['d', profileDTag(listPubkey)], ['L', listPubkey]],
+		content: nip44.encrypt(JSON.stringify(payload), contentKey),
+		created_at: createdAt,
+	};
+	return finalizeEvent(template, deviceSecretKey);
+};
+
+export interface ParsedProfile extends ProfilePayload {
+	devicePubkey: string;
+}
+
+// Verifies the event's signature, then decrypts and parses its payload.
+// Throws InvalidEventError / whatever nip44.decrypt or JSON.parse throw for a
+// bad signature, wrong content key or tampered event -- same contract as
+// events.ts#parseItemEvent.
+export const parseProfileEvent = (event: VerifiedEvent, contentKey: Uint8Array): ParsedProfile => {
+	if (!verifyEvent(event)) throw new InvalidEventError('Profile event has an invalid signature');
+	const payload = JSON.parse(nip44.decrypt(event.content, contentKey)) as ProfilePayload;
+	return { ...payload, devicePubkey: event.pubkey };
+};
+
+export interface NamedAt {
+	name: string;
+	t: number;
+}
+
+// Last-writer-wins merge for a member's displayed name: an incoming profile
+// only replaces what's already known if it's strictly newer -- an equal or
+// older t (e.g. the same event delivered twice, once over relays and once
+// over Bluetooth) is a no-op. Mirrors merge.ts's field semantics for items.
+export const mergeProfileName = (current: NamedAt | null, incoming: NamedAt): NamedAt => {
+	if (!current || incoming.t > current.t) return incoming;
+	return current;
+};
+
+// The name to show for a member: the newest profile event's name if we have
+// one, otherwise the member directory's own name field (set at invite/join
+// time), otherwise null -- callers fall back to a shortened pubkey.
+export const displayName = (profile: NamedAt | null, directoryName: string | null): string | null =>
+	(profile && profile.name) || directoryName || null;
