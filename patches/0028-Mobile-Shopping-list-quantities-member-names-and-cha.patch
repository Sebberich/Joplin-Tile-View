@@ -0,0 +1,129 @@
+package net.cozic.joplin.nearby
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.os.Build
+import android.os.IBinder
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+
+// Foreground service that keeps the app process alive (screen off, in a
+// pocket) while Bluetooth nearby sync is on -- see PROTOCOL.md's "Live sync"
+// and "Token rotation, discovery loop, auto-off" sections. Started/updated/
+// stopped from NearbyModule.kt, which mirrors this on the JS side via
+// lists/nearby/nativeBle.ts's startForegroundService/updateForegroundService/
+// stopForegroundService, called from lists/nearby/nearbyManager.ts.
+//
+// All strings (channel name/description, notification title/text, the Stop
+// button's label) are passed in from the TS side, already localized via
+// @joplin/lib's _() -- this class has no resource strings of its own, only
+// the fallbacks below for the unlikely case the service is started without
+// having gone through NearbyModule (defensive; shouldn't happen in practice).
+class NearbyForegroundService : Service() {
+
+	companion object {
+		const val CHANNEL_ID = "net.cozic.joplin.nearby.sync"
+		const val NOTIFICATION_ID = 4821
+		const val ACTION_UPDATE = "net.cozic.joplin.nearby.ACTION_UPDATE"
+		const val ACTION_STOP = "net.cozic.joplin.nearby.ACTION_STOP"
+		// Broadcast NearbyModule listens for to relay the Stop button tap to JS
+		// (see NearbyModule.kt's stopBroadcastReceiver).
+		const val BROADCAST_STOP = "net.cozic.joplin.nearby.STOP_REQUESTED"
+
+		private const val EXTRA_CHANNEL_NAME = "channelName"
+		private const val EXTRA_CHANNEL_DESCRIPTION = "channelDescription"
+		private const val EXTRA_TITLE = "title"
+		private const val EXTRA_TEXT = "text"
+		private const val EXTRA_STOP_LABEL = "stopLabel"
+
+		fun start(context: Context, channelName: String, channelDescription: String, title: String, text: String, stopLabel: String) {
+			val intent = Intent(context, NearbyForegroundService::class.java)
+			intent.putExtra(EXTRA_CHANNEL_NAME, channelName)
+			intent.putExtra(EXTRA_CHANNEL_DESCRIPTION, channelDescription)
+			intent.putExtra(EXTRA_TITLE, title)
+			intent.putExtra(EXTRA_TEXT, text)
+			intent.putExtra(EXTRA_STOP_LABEL, stopLabel)
+			if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) context.startForegroundService(intent) else context.startService(intent)
+		}
+
+		fun update(context: Context, text: String) {
+			val intent = Intent(context, NearbyForegroundService::class.java)
+			intent.action = ACTION_UPDATE
+			intent.putExtra(EXTRA_TEXT, text)
+			if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) context.startForegroundService(intent) else context.startService(intent)
+		}
+
+		fun stop(context: Context) {
+			context.stopService(Intent(context, NearbyForegroundService::class.java))
+		}
+	}
+
+	private var channelName = "Nearby sync"
+	private var channelDescription = ""
+	private var title = "Nearby sync"
+	private var stopLabel = "Stop"
+
+	override fun onBind(intent: Intent?): IBinder? = null
+
+	override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+		if (intent?.action == ACTION_STOP) {
+			sendBroadcast(Intent(BROADCAST_STOP).setPackage(packageName))
+			stopForeground(STOP_FOREGROUND_REMOVE)
+			stopSelf()
+			return START_NOT_STICKY
+		}
+
+		intent?.getStringExtra(EXTRA_CHANNEL_NAME)?.let { channelName = it }
+		intent?.getStringExtra(EXTRA_CHANNEL_DESCRIPTION)?.let { channelDescription = it }
+		intent?.getStringExtra(EXTRA_TITLE)?.let { title = it }
+		intent?.getStringExtra(EXTRA_STOP_LABEL)?.let { stopLabel = it }
+		val text = intent?.getStringExtra(EXTRA_TEXT) ?: ""
+
+		ensureChannel()
+		startForegroundWithNotification(text)
+		return START_STICKY
+	}
+
+	private fun ensureChannel() {
+		if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+		val manager = getSystemService(NotificationManager::class.java) ?: return
+		// A channel's name/description can't be changed once created without
+		// deleting and recreating it (which would briefly drop the ongoing
+		// notification) -- recreating on every locale change is out of scope
+		// this round; the values below only take effect for a channel that
+		// doesn't exist yet (e.g. after a fresh install).
+		if (manager.getNotificationChannel(CHANNEL_ID) != null) return
+		val channel = NotificationChannel(CHANNEL_ID, channelName, NotificationManager.IMPORTANCE_LOW)
+		channel.description = channelDescription
+		channel.setShowBadge(false)
+		manager.createNotificationChannel(channel)
+	}
+
+	private fun startForegroundWithNotification(text: String) {
+		val stopIntent = Intent(this, NearbyForegroundService::class.java).setAction(ACTION_STOP)
+		val stopFlags = PendingIntent.FLAG_UPDATE_CURRENT or (if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) PendingIntent.FLAG_IMMUTABLE else 0)
+		val stopPendingIntent = PendingIntent.getService(this, 0, stopIntent, stopFlags)
+
+		val notification = NotificationCompat.Builder(this, CHANNEL_ID)
+			.setContentTitle(title)
+			.setContentText(text)
+			.setSmallIcon(applicationInfo.icon)
+			.setOngoing(true)
+			.setOnlyAlertOnce(true)
+			.setPriority(NotificationCompat.PRIORITY_LOW)
+			.setCategory(NotificationCompat.CATEGORY_SERVICE)
+			.addAction(0, stopLabel, stopPendingIntent)
+			.build()
+
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+			ServiceCompat.startForeground(this, NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE)
+		} else {
+			startForeground(NOTIFICATION_ID, notification)
+		}
+	}
+}
