+import Folder from '@joplin/lib/models/Folder';
+import { itemIsInTrash } from '@joplin/lib/services/trash';
 import { FolderEntity } from '@joplin/lib/services/database/types';
 
+// The folders that can be picked in the notebook filter dialog -- trashed folders and the
+// virtual trash/conflict folders are excluded, since they don't hold notes that belong in the
+// tile view.
+export const getVisibleFolders = (folders: FolderEntity[]): FolderEntity[] => {
+	const conflictFolderId = Folder.conflictFolderId();
+	return folders.filter(folder => folder.id !== conflictFolderId && !itemIsInTrash(folder));
+};
+
