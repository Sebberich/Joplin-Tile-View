From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sebberich <sebberich@users.noreply.github.com>
Date: Thu, 1 Oct 2026 10:06:48 +0000
Subject: [PATCH 33/33] Android: Rename the app to Forklin

- App name "Forklin", application ID io.github.sebberich.forklin,
  versionName 3.7.10-forklin.N.
- Own adaptive launcher icon (vector) and notification icon; the Joplin
  logo bitmaps are removed from the launcher resources.
- New invite links https://sebberich.github.io/forklin/l#... and the
  forklin:// scheme; links and joplintiles:// from before the rename are
  still accepted.
- Notice "unofficial, modified version of Joplin ... Joplin is a trademark
  of JOPLIN SAS" in the version info.
- German translations for the tile pinning, Bluetooth fix, list backup,
  manual emoji and icon statistics strings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015mATJ5zDWtHUm4X7vhb9u2

diff --git a/packages/app-mobile/android/app/build.gradle b/packages/app-mobile/android/app/build.gradle
index 97f0374..c3448fa 100644
--- a/packages/app-mobile/android/app/build.gradle
+++ b/packages/app-mobile/android/app/build.gradle
@@ -80,14 +80,14 @@ android {
 
     namespace "net.cozic.joplin"
     defaultConfig {
-        applicationId "net.cozic.joplin.tileview"
+        applicationId "io.github.sebberich.forklin"
         minSdkVersion rootProject.ext.minSdkVersion
         targetSdkVersion rootProject.ext.targetSdkVersion
-		// The tile view fork appends the CI build number so that every build has a higher
+		// Forklin appends the CI build number so that every build has a higher
 		// versionCode and a distinct versionName (needed for in-place updates, e.g. via Obtainium).
 		def tileViewBuildNumber = (findProperty('TILE_VIEW_BUILD_NUMBER') ?: '0').toInteger()
 		versionCode 2097819 + tileViewBuildNumber
-		versionName tileViewBuildNumber > 0 ? "3.7.10-tiles.${tileViewBuildNumber}" : "3.7.10"
+		versionName tileViewBuildNumber > 0 ? "3.7.10-forklin.${tileViewBuildNumber}" : "3.7.10"
 
         buildConfigField "String", "REACT_NATIVE_RELEASE_LEVEL", "\"${findProperty('reactNativeReleaseLevel') ?: 'stable'}\""
 
diff --git a/packages/app-mobile/android/app/src/main/AndroidManifest.xml b/packages/app-mobile/android/app/src/main/AndroidManifest.xml
index 68371c5..52ec9cc 100644
--- a/packages/app-mobile/android/app/src/main/AndroidManifest.xml
+++ b/packages/app-mobile/android/app/src/main/AndroidManifest.xml
@@ -131,12 +131,19 @@
 				<action android:name="android.intent.action.VIEW" />
 				<category android:name="android.intent.category.DEFAULT" />
 				<category android:name="android.intent.category.BROWSABLE" />
+				<data android:scheme="forklin" />
+				<!-- Scheme from before the rename to Forklin -->
 				<data android:scheme="joplintiles" />
 			</intent-filter>
 			<intent-filter>
 				<action android:name="android.intent.action.VIEW" />
 				<category android:name="android.intent.category.DEFAULT" />
 				<category android:name="android.intent.category.BROWSABLE" />
+				<data
+					android:scheme="https"
+					android:host="sebberich.github.io"
+					android:pathPrefix="/forklin/l" />
+				<!-- Invite links from before the rename to Forklin -->
 				<data
 					android:scheme="https"
 					android:host="sebberich.github.io"
diff --git a/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyForegroundService.kt b/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyForegroundService.kt
index 10a8896..f94f640 100644
--- a/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyForegroundService.kt
+++ b/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyForegroundService.kt
@@ -112,7 +112,7 @@ class NearbyForegroundService : Service() {
 		val notification = NotificationCompat.Builder(this, CHANNEL_ID)
 			.setContentTitle(title)
 			.setContentText(text)
-			.setSmallIcon(applicationInfo.icon)
+			.setSmallIcon(net.cozic.joplin.R.drawable.ic_stat_forklin)
 			.setOngoing(true)
 			.setOnlyAlertOnce(true)
 			.setPriority(NotificationCompat.PRIORITY_LOW)
diff --git a/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyModule.kt b/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyModule.kt
index e09d14e..c66eb85 100644
--- a/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyModule.kt
+++ b/packages/app-mobile/android/app/src/main/java/net/cozic/joplin/nearby/NearbyModule.kt
