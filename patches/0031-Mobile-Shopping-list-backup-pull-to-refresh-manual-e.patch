@@ -0,0 +1,39 @@
+// UI-side glue for the lists backup (core/backup.ts): writing the export file
+// and handing it to the share sheet, and picking and reading a file to import.
+import shim from '@joplin/lib/shim';
+import uuid from '@joplin/lib/uuid';
+import shareFile from '../../utils/shareFile';
+import pickDocument from '../../utils/pickDocument';
+import { writeTextToCacheFile } from '../../utils/ShareUtils';
+import { backupFileName, buildBackup, serializeBackup } from '../core/backup';
+import { ListsDatabase } from '../core/db';
+import { debugLog } from '../../utils/debugLog';
+
+const log = debugLog('lists.store');
+
+export const exportListsToShareSheet = async (db: ListsDatabase, options: { password?: string; includeIdentity: boolean }): Promise<void> => {
+	const backup = await buildBackup(db, { includeIdentity: options.includeIdentity });
+	const text = await serializeBackup(backup, options.password || undefined);
+	const path = await writeTextToCacheFile(text, backupFileName());
+	log.info('Lists backup written', { lists: backup.lists.length, encrypted: !!options.password, identity: options.includeIdentity });
+	try {
+		await shareFile(path, 'application/json');
+	} finally {
+		// Contains list keys: don't leave the plain copy lying around in the cache.
+		await shim.fsDriver().remove(path);
+	}
+};
+
+// Lets the person pick a backup file and returns its text, or null if they
+// cancelled.
+export const pickBackupText = async (): Promise<string | null> => {
+	const files = await pickDocument({ multiple: false });
+	if (!files.length) return null;
+	const cachePath = `${shim.fsDriver().getCacheDirectoryPath()}/import-${uuid.createNano()}.json`;
+	try {
+		await shim.fsDriver().copy(files[0].uri, cachePath);
+		return await shim.fsDriver().readFile(cachePath, 'utf8');
+	} finally {
+		await shim.fsDriver().remove(cachePath);
+	}
+};
