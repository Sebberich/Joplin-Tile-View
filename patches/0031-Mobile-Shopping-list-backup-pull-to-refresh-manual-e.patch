+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { backupFileName, BackupError, buildBackup, importBackup, isEncryptedBackup, parseBackup, serializeBackup } from './backup';
+import { ListsDatabase } from './db';
+import { ListsStore } from './store';
+import { bytesToHex } from './crypto';
+import { customIconFor, parseListSettings } from './icons';
+
+// Real iteration counts take seconds in pure JS; the file records the count it
+// was made with, so a small one exercises the same code path.
+const TEST_ITERATIONS = 1000;
+
+interface Fixture { db: ListsDatabase; store: ListsStore; path: string }
+
+const open = async (): Promise<Fixture> => {
+	const path = join(tmpdir(), `tiles-lists-backup-test-${uuid.createNano()}.sqlite`);
+	const db = new ListsDatabase(new Database(new DatabaseDriverNode()));
+	return { db, store: new ListsStore(db, path), path };
+};
+
+describe('lists/core/backup', () => {
+	let source: Fixture;
+	let target: Fixture;
+
+	beforeEach(async () => {
+		source = await open();
+		target = await open();
+	});
+
+	afterEach(async () => {
+		await source.db.close();
+		await target.db.close();
+		await rm(source.path, { force: true });
+		await rm(target.path, { force: true });
+	});
+
+	const populate = async () => {
+		const list = await source.store.createOpenList('Groceries');
+		await source.store.addItem(list.id, 'Milch', { unit: 'ml', amount: 1000 });
+		await source.store.addItem(list.id, 'Brot');
+		const second = await source.store.createManagedList('Party');
+		await source.store.addItem(second.id, 'Chips');
+		await source.db.upsertProfileName(list.id, 'ab'.repeat(32), 'Anna', 5);
+		return { list, second };
+	};
+
+	const dump = async (fixture: Fixture, listId: string) => {
+		const items = await fixture.db.allItemsForSync(listId);
+		return items.map(({ pending: _p, ...rest }) => rest).sort((a, b) => a.dTag.localeCompare(b.dTag));
+	};
+
+	test('file name looks like forklin-listen-yyyymmdd-hhmm.json', () => {
+		expect(backupFileName(new Date(2026, 9, 1, 14, 5))).toBe('forklin-listen-20261001-1405.json');
+	});
+
+	test('plain roundtrip restores lists, items (with timestamps and qty), members and profiles on a fresh device', async () => {
+		const { list, second } = await populate();
+		const backup = await buildBackup(source.db, { includeIdentity: false });
+		const text = await serializeBackup(backup);
+		expect(isEncryptedBackup(text)).toBe(false);
+		expect(backup.identity).toBeUndefined();
+
+		await target.store.lists(); // opens the target database
+		const summary = await importBackup(target.db, await parseBackup(text));
+
+		expect(summary).toMatchObject({ listsAdded: 2, itemsAdded: 3, identityImported: false });
+		expect((await target.db.lists()).map(l => l.name).sort()).toEqual(['Groceries', 'Party']);
+		expect(await dump(target, list.id)).toEqual(await dump(source, list.id));
+		expect(await dump(target, second.id)).toEqual(await dump(source, second.id));
+		expect(await target.db.members(list.id)).toEqual(await source.db.members(list.id));
+		expect((await target.db.profileName(list.id, 'ab'.repeat(32)))).toEqual({ name: 'Anna', t: 5 });
+		const milch = (await target.db.allItemsForSync(list.id)).find(i => i.name === 'Milch');
+		expect(milch!.qty).not.toBeNull();
+		// The device identity stayed the target's own.
+		expect(bytesToHex((await target.db.deviceIdentity()).secretKey)).not.toBe(bytesToHex((await source.db.deviceIdentity()).secretKey));
+	});
+
+	test('encrypted roundtrip, wrong password and missing password', async () => {
+		await populate();
+		const backup = await buildBackup(source.db, { includeIdentity: false });
+		const text = await serializeBackup(backup, 'correct horse', TEST_ITERATIONS);
+
+		expect(isEncryptedBackup(text)).toBe(true);
+		expect(text).not.toContain('Milch');
+		expect(text).not.toContain('listKey');
+
+		await expect(parseBackup(text)).rejects.toMatchObject({ code: 'passwordRequired' });
+		await expect(parseBackup(text, 'wrong')).rejects.toMatchObject({ code: 'wrongPassword' });
+		await expect(parseBackup(text, 'wrong')).rejects.toBeInstanceOf(BackupError);
+		expect(await parseBackup(text, 'correct horse')).toEqual(backup);
+	});
+
+	test('the production key derivation uses at least 200k PBKDF2 iterations', async () => {
+		await source.store.lists(); // opens the database
+		const backup = await buildBackup(source.db, { includeIdentity: false });
+		const text = await serializeBackup(backup, 'pw');
+		expect(JSON.parse(text).iterations).toBeGreaterThanOrEqual(200000);
+		expect((await parseBackup(text, 'pw')).format).toBe('forklin-lists');
+	}, 120000);
+
+	test('rejects files that are not backups, or are from a newer version', async () => {
+		await expect(parseBackup('not json')).rejects.toMatchObject({ code: 'notABackup' });
+		await expect(parseBackup('{"format":"other","lists":[]}')).rejects.toMatchObject({ code: 'notABackup' });
+		await expect(parseBackup('{"format":"forklin-lists","version":99,"lists":[]}')).rejects.toMatchObject({ code: 'unsupportedVersion' });
+	});
+
+	test('import merges field-wise and never overwrites newer local data', async () => {
+		const { list } = await populate();
+		const backup = await buildBackup(source.db, { includeIdentity: false });
+
+		// Target already has the same list (same keys) with the same item, where the
+		// local copy is newer for `open` (bought later) and has its own detail.
+		await target.store.lists();
+		await target.db.importList(list);
+		const milch = (await source.db.allItemsForSync(list.id)).find(i => i.name === 'Milch')!;
+		await target.db.upsertItem({ ...milch, open: false, openT: milch.openT + 1000, detail: 'lokal', detailT: milch.openT + 500, qty: null, pending: false });
+		const newerLocal = await target.db.item(list.id, milch.dTag);
+
+		const summary = await importBackup(target.db, backup);
+
+		const after = await target.db.item(list.id, milch.dTag);
+		expect(after!.open).toBe(false); // newer local value kept
+		expect(after!.openT).toBe(newerLocal!.openT);
+		expect(after!.detail).toBe('lokal');
+		expect(after!.qty).toEqual(milch.qty); // qty merged in from the backup
+		expect(summary.listsAdded).toBe(1); // only "Party"
+		expect(summary.itemsAdded).toBe(2); // Brot, Chips
+		expect(summary.itemsUpdated).toBe(1); // Milch gained its qty
+		expect((await target.db.allItemsForSync(list.id)).length).toBe(2);
+
+		// a second import is a no-op
+		const again = await importBackup(target.db, backup);
+		expect(again).toMatchObject({ listsAdded: 0, itemsAdded: 0, itemsUpdated: 0 });
+		expect(again.itemsUnchanged).toBe(3);
+	});
+
+	test('newer data in the backup is taken, and settings merge per key', async () => {
+		const { list } = await populate();
+		await source.store.addItem(list.id, 'Käse');
+		const milch = (await source.db.allItemsForSync(list.id)).find(i => i.name === 'Milch')!;
+		await source.store.setItemIcon(list.id, milch.dTag, '🐄', true);
+		const backup = await buildBackup(source.db, { includeIdentity: false });
+
+		await target.store.lists();
+		await target.db.importList({ ...list, settings: JSON.stringify({ customIcons: { brot: '🥖' }, customIconsT: { brot: 1 } }) });
+		await target.db.upsertItem({ ...milch, icon: '🥛', iconT: 1, pending: false });
+
+		await importBackup(target.db, backup);
+
+		const restored = await target.db.item(list.id, milch.dTag);
+		expect(restored!.icon).toBe('🐄');
+		const settings = parseListSettings((await target.db.list(list.id))!.settings);
+		expect(customIconFor(settings, 'Milch')).toBe('🐄');
+		expect(customIconFor(settings, 'Brot')).toBe('🥖');
+	});
+
+	test('device identity is imported only when present and confirmed', async () => {
+		await populate();
+		const withIdentity = await buildBackup(source.db, { includeIdentity: true });
+		const sourceKey = bytesToHex((await source.db.deviceIdentity()).secretKey);
+		expect(withIdentity.identity?.secretKey).toBe(sourceKey);
+
+		await target.store.lists();
+		const targetKey = bytesToHex((await target.db.deviceIdentity()).secretKey);
+
+		// not confirmed
+		let summary = await importBackup(target.db, withIdentity, { confirmIdentity: async () => false });
+		expect(summary.identityImported).toBe(false);
+		expect(bytesToHex((await target.db.deviceIdentity()).secretKey)).toBe(targetKey);
+
+		// no callback at all counts as not confirmed
+		summary = await importBackup(target.db, withIdentity);
+		expect(summary.identityImported).toBe(false);
+
+		// confirmed
+		const confirm = jest.fn(async () => true);
+		summary = await importBackup(target.db, withIdentity, { confirmIdentity: confirm });
+		expect(confirm).toHaveBeenCalledTimes(1);
+		expect(summary.identityImported).toBe(true);
+		expect(bytesToHex((await target.db.deviceIdentity()).secretKey)).toBe(sourceKey);
+
+		// a backup without identity never asks
+		const without = await buildBackup(source.db, { includeIdentity: false });
+		const neverCalled = jest.fn(async () => true);
+		await importBackup(target.db, without, { confirmIdentity: neverCalled });
+		expect(neverCalled).not.toHaveBeenCalled();
+	});
+});
