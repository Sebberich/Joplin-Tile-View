+// Icon handling for shopping-list items: validating a hand-typed emoji,
+// deciding which icon a tile shows, and the per-list `customIcons` setting
+// ("always use this emoji for <name>"). See docs/KONZEPT.md section 2,
+// "Emoji von Hand festlegen".
+import { categoryEmoji, normalizeName, resolveCatalog } from './normalize';
+import { CatalogItemDef } from './types';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires -- plain JSON data file, no resolveJsonModule configured for this package
+const catalogItems: CatalogItemDef[] = require('../catalog/items.json');
+
+// --- emoji validation --------------------------------------------------
+
+// Written with explicit code point ranges rather than \p{Extended_Pictographic}
+// & co.: Hermes' support for Unicode property escapes is incomplete, and these
+// ranges cover the emoji blocks that matter for shopping items.
+const PICTOGRAPH = '[\\u{1F300}-\\u{1FAFF}\\u{1F000}-\\u{1F2FF}\\u{2600}-\\u{27BF}\\u{2B00}-\\u{2BFF}\\u{2300}-\\u{23FF}\\u{2190}-\\u{21FF}\\u{2900}-\\u{297F}\\u{25A0}-\\u{25FF}\\u{3030}\\u{303D}\\u{3297}\\u{3299}]';
+const MODIFIER_OR_VS = '(?:\\u{FE0F}|[\\u{1F3FB}-\\u{1F3FF}])?';
+const TAG_SEQUENCE = '(?:[\\u{E0020}-\\u{E007E}]+\\u{E007F})?'; // e.g. England/Scotland flags
+const ELEMENT = `${PICTOGRAPH}${MODIFIER_OR_VS}`;
+const EMOJI_GRAPHEME = new RegExp(
+	'^(?:' +
+		'[\\u{1F1E6}-\\u{1F1FF}]{2}' + // flag: a pair of regional indicators
+		'|[#*0-9]\\u{FE0F}?\\u{20E3}' + // keycap
+		`|${ELEMENT}${TAG_SEQUENCE}(?:\\u{200D}${ELEMENT})*` + // pictograph, skin tone, ZWJ sequence
+	')$',
+	'u',
+);
+
+interface Segmenter { segment(input: string): Iterable<unknown> }
+type SegmenterConstructor = new (locale?: string, options?: { granularity: 'grapheme' })=> Segmenter;
+
+// Number of user-perceived characters in `text`: Intl.Segmenter where the
+// JS engine has it, otherwise null (the caller then relies on the regex above,
+// which only ever matches a single grapheme).
+const graphemeCount = (text: string): number | null => {
+	const SegmenterClass = (typeof Intl !== 'undefined' ? (Intl as unknown as { Segmenter?: SegmenterConstructor }).Segmenter : undefined);
+	if (!SegmenterClass) return null;
+	return Array.from(new SegmenterClass(undefined, { granularity: 'grapheme' }).segment(text)).length;
+};
+
+// True for exactly one emoji grapheme (including skin tones, ZWJ sequences
+// such as the cook emoji, and flags). Plain letters, digits, several emoji
+// and empty input are rejected.
+export const isSingleEmoji = (text: string): boolean => {
+	const trimmed = text.trim();
+	if (!trimmed) return false;
+	const count = graphemeCount(trimmed);
+	if (count !== null && count !== 1) return false;
+	return EMOJI_GRAPHEME.test(trimmed);
+};
+
+// --- icon resolution ---------------------------------------------------
+
+export interface IconSettings {
+	customIcons?: Record<string, string>;
+	// Time (ms) each customIcons entry was last changed, for per-key merging
+	// between devices -- see mergeListSettings(). An empty-string value is a
+	// tombstone ("no custom icon for this name any more").
+	customIconsT?: Record<string, number>;
+	[key: string]: unknown;
+}
+
+export const parseListSettings = (json: string | null | undefined): IconSettings => {
+	if (!json) return {};
+	try {
+		const parsed = JSON.parse(json);
+		return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed as IconSettings : {};
+	} catch (error) {
+		return {};
+	}
+};
+
+export const customIconFor = (settings: IconSettings, name: string): string | null => {
+	const emoji = settings.customIcons?.[normalizeName(name)];
+	return emoji ? emoji : null;
+};
+
+// resolveCatalog() scans the whole term index, so tiles (which resolve their
+// icon on every render) go through this small cache instead.
+const matchCache = new Map<string, ReturnType<typeof resolveCatalog>>();
+const cachedMatch = (name: string): ReturnType<typeof resolveCatalog> => {
+	const key = normalizeName(name);
+	let match = matchCache.get(key);
+	if (!match) {
+		match = resolveCatalog(name);
+		if (matchCache.size > 2000) matchCache.clear();
+		matchCache.set(key, match);
+	}
+	return match;
+};
+
+// The emoji the catalog alone would give an item of this name (what addItem()
+// stores in the item's `icon` field when nothing was chosen by hand).
+export const catalogEmojiFor = (name: string): string | null => cachedMatch(name).emoji;
+
+// Icon shown for an item, in the order from the concept: the item's own icon
+// if set by hand -> the list's customIcons -> the catalog -> the category
+// emoji -> null (the UI then draws the first letter).
+//
+// An item's `icon` field is also filled automatically from the catalog when
+// the item is added, so "set by hand" means "differs from what the catalog
+// gives for this name" -- otherwise a later customIcons entry could never
+// take effect on items that already exist.
+export const resolveItemIcon = (item: { name: string; icon: string | null; category: string | null }, settings: IconSettings): string | null => {
+	const match = cachedMatch(item.name);
+	if (item.icon && item.icon !== match.emoji) return item.icon;
+	const custom = customIconFor(settings, item.name);
+	if (custom) return custom;
+	if (item.icon) return item.icon;
+	if (match.emoji) return match.emoji;
+	const categoryId = item.category ?? match.category;
+	return categoryId ? categoryEmoji(categoryId) : null;
+};
+
+// Quick-pick emojis for the item editor: the item's category emoji first,
+// then the emojis of catalog items in the same category or with a similar
+// name (sharing a word), without duplicates.
+export const suggestEmojis = (name: string, categoryId: string | null, limit = 12): string[] => {
+	const result: string[] = [];
+	const add = (emoji: string | null | undefined) => {
+		if (emoji && !result.includes(emoji) && result.length < limit) result.push(emoji);
+	};
+	const match = cachedMatch(name);
+	const category = categoryId ?? match.category;
+	if (category) add(categoryEmoji(category));
+	add(match.emoji);
+
+	const words = normalizeName(name).split(/[^\p{L}\p{N}]+/u).filter(w => w.length >= 3);
+	if (words.length) {
+		for (const item of catalogItems) {
+			const terms = [item.name, ...item.synonyms].map(normalizeName);
+			if (terms.some(term => words.some(w => term.includes(w) || w.includes(term)))) add(item.emoji);
+		}
+	}
+	if (category) for (const item of catalogItems) if (item.category === category) add(item.emoji);
+	return result;
+};
+
+// --- synced settings: per-key merge of customIcons -------------------------
+
+// Merges two JSON settings blobs of the same list. customIcons entries merge
+// per name, newest timestamp wins (a tie goes to the larger emoji string, so
+// the result is the same whichever side is "local"); any other key falls back
+// to the remote value, as the whole blob did before customIcons existed.
+export const mergeListSettings = (localJson: string | null, remoteJson: string | null): string | null => {
+	if (!localJson && !remoteJson) return null;
+	const local = parseListSettings(localJson);
+	const remote = parseListSettings(remoteJson);
+	const merged: IconSettings = { ...local, ...remote };
+
+	const icons: Record<string, string> = {};
+	const times: Record<string, number> = {};
+	const names = new Set([...Object.keys(local.customIcons ?? {}), ...Object.keys(remote.customIcons ?? {})]);
+	for (const name of names) {
+		const l = local.customIcons?.[name];
+		const r = remote.customIcons?.[name];
+		const lt = local.customIconsT?.[name] ?? 0;
+		const rt = remote.customIconsT?.[name] ?? 0;
+		let winner: string | undefined;
+		let t: number;
+		if (l === undefined) { winner = r; t = rt; } else if (r === undefined) { winner = l; t = lt; } else if (lt !== rt) { winner = lt > rt ? l : r; t = Math.max(lt, rt); } else { winner = l >= r ? l : r; t = lt; }
+		icons[name] = winner as string;
+		times[name] = t;
+	}
+	if (names.size) {
+		merged.customIcons = icons;
+		merged.customIconsT = times;
+	}
+	return JSON.stringify(merged);
+};
+
+// Sets (or, with null, clears via tombstone) one customIcons entry.
+export const withCustomIcon = (settingsJson: string | null, name: string, emoji: string | null, t: number): string => {
+	const settings = parseListSettings(settingsJson);
+	const key = normalizeName(name);
+	settings.customIcons = { ...settings.customIcons, [key]: emoji ?? '' };
+	settings.customIconsT = { ...settings.customIconsT, [key]: t };
+	return JSON.stringify(settings);
+};
