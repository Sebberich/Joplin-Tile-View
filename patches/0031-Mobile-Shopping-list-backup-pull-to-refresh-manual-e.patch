--- /dev/null
+++ b/packages/app-mobile/lists/core/backup.ts
@@ -0,0 +1,261 @@
+// Backup and restore of the shopping lists ("Sicherung der Listen", see
+// docs/KONZEPT.md section 4): one JSON file with lists, items (all field
+// timestamps and quantities), members, profiles and list settings, optionally
+// with the device identity, optionally encrypted with a password.
+//
+// Import merges into the existing data with the same field-wise rules as sync
+// (mergeItem, per-key settings merge) and never overwrites newer local data.
+import shim from '@joplin/lib/shim';
+import { CipherAlgorithm, Digest, EncryptionParameters, EncryptionResult } from '@joplin/lib/services/e2ee/types';
+import { bytesToHex } from './crypto';
+import { ListsDatabase } from './db';
+import { mergeListSettings } from './icons';
+import { mergeItem } from './merge';
+import { itemRecordToPayload, payloadToItemRecord } from './store';
+import { ItemRecord, ListRecord, MemberRecord } from './types';
+import { debugLog } from '../../utils/debugLog';
+
+const log = debugLog('lists.store');
+
+export const BACKUP_FORMAT = 'forklin-lists';
+export const BACKUP_VERSION = 1;
+const ENCRYPTED_FORMAT = 'forklin-lists-encrypted';
+// The password is stretched with PBKDF2-HMAC-SHA256 and the file encrypted with
+// AES-256-GCM, both through Joplin's native crypto layer (shim.crypto:
+// react-native-quick-crypto on the phone, node:crypto in tests) -- the same
+// primitives Joplin's own E2EE uses. A pure-JS PBKDF2 at this iteration count
+// would take minutes on Hermes.
+export const PBKDF2_ITERATIONS = 220000;
+
+export interface BackupProfile {
+	pubkey: string;
+	name: string;
+	t: number;
+}
+
+export interface BackupList {
+	list: ListRecord;
+	members: MemberRecord[];
+	profiles: BackupProfile[];
+	// Item rows without their local `pending` flag.
+	items: Omit<ItemRecord, 'pending'>[];
+}
+
+export interface BackupIdentity {
+	secretKey: string; // hex
+	name: string;
+}
+
+export interface BackupFile {
+	format: typeof BACKUP_FORMAT;
+	version: number;
+	exportedAt: number;
+	lists: BackupList[];
+	identity?: BackupIdentity;
+}
+
+export class BackupError extends Error {
+	public constructor(public code: 'notABackup' | 'unsupportedVersion' | 'wrongPassword' | 'passwordRequired', message: string) {
+		super(message);
+	}
+}
+
+// --- export ------------------------------------------------------------
+
+export const buildBackup = async (db: ListsDatabase, options: { includeIdentity: boolean; now?: number }): Promise<BackupFile> => {
+	const lists: BackupList[] = [];
+	for (const list of await db.lists()) {
+		const items = (await db.allItemsForSync(list.id)).map(item => {
+			const copy: Partial<ItemRecord> = { ...item };
+			delete copy.pending; // local-only flag
+			return copy as Omit<ItemRecord, 'pending'>;
+		});
+		lists.push({ list, members: await db.members(list.id), profiles: await db.allProfiles(list.id), items });
+	}
+	const backup: BackupFile = { format: BACKUP_FORMAT, version: BACKUP_VERSION, exportedAt: options.now ?? Date.now(), lists };
+	if (options.includeIdentity) {
+		const identity = await db.deviceIdentity();
+		backup.identity = { secretKey: bytesToHex(identity.secretKey), name: identity.name };
+	}
+	return backup;
+};
+
+// Default file name, e.g. forklin-listen-20261001-1430.json (local time).
+export const backupFileName = (date: Date = new Date()): string => {
+	const p = (n: number) => String(n).padStart(2, '0');
+	return `forklin-listen-${date.getFullYear()}${p(date.getMonth() + 1)}${p(date.getDate())}-${p(date.getHours())}${p(date.getMinutes())}.json`;
+};
+
+// --- password encryption ---------------------------------------------------
+
+interface EncryptedEnvelope extends EncryptionResult {
+	format: typeof ENCRYPTED_FORMAT;
+	version: number;
+	kdf: 'pbkdf2-sha256';
+	iterations: number;
+	cipher: 'aes-256-gcm';
+}
+
+const encryptionParameters = (iterations: number): EncryptionParameters => ({
+	cipherAlgorithm: CipherAlgorithm.AES_256_GCM,
+	authTagLength: 16,
+	digestAlgorithm: Digest.sha256,
+	keyLength: 32,
+	associatedData: new Uint8Array(0),
+	iterationCount: iterations,
+});
+
+// `iterations` is a parameter only so tests don't have to pay for the full
+// production cost on every call.
+export const serializeBackup = async (backup: BackupFile, password?: string, iterations: number = PBKDF2_ITERATIONS): Promise<string> => {
+	const json = JSON.stringify(backup);
+	if (!password) return json;
+	const salt = await shim.crypto.randomBytes(16);
+	const data = new Uint8Array(new TextEncoder().encode(json));
+	const result = await shim.crypto.encrypt(password.normalize('NFKC'), salt, data, encryptionParameters(iterations));
+	const envelope: EncryptedEnvelope = { format: ENCRYPTED_FORMAT, version: 1, kdf: 'pbkdf2-sha256', iterations, cipher: 'aes-256-gcm', ...result };
+	return JSON.stringify(envelope);
+};
+
+export const isEncryptedBackup = (text: string): boolean => {
+	try {
+		return JSON.parse(text)?.format === ENCRYPTED_FORMAT;
+	} catch (error) {
+		return false;
+	}
+};
+
+// Parses a backup file's text, decrypting it first if needed. Throws a
+// BackupError ('passwordRequired', 'wrongPassword', 'notABackup',
+// 'unsupportedVersion').
+export const parseBackup = async (text: string, password?: string): Promise<BackupFile> => {
+	let parsed;
+	try {
+		parsed = JSON.parse(text);
+	} catch (error) {
+		throw new BackupError('notABackup', 'The file is not a lists backup');
+	}
+
+	if (parsed?.format === ENCRYPTED_FORMAT) {
+		if (!password) throw new BackupError('passwordRequired', 'This backup is encrypted, a password is needed');
+		const envelope = parsed as EncryptedEnvelope;
+		if (envelope.kdf !== 'pbkdf2-sha256' || envelope.cipher !== 'aes-256-gcm' || !(envelope.iterations >= 1)) {
+			throw new BackupError('unsupportedVersion', 'Unsupported encryption');
+		}
+		let plain: Uint8Array;
+		try {
+			plain = await shim.crypto.decrypt(password.normalize('NFKC'), { salt: envelope.salt, iv: envelope.iv, ct: envelope.ct }, encryptionParameters(envelope.iterations));
+		} catch (error) {
+			throw new BackupError('wrongPassword', 'Wrong password, or the file is damaged');
+		}
+		try {
+			parsed = JSON.parse(new TextDecoder().decode(plain));
+		} catch (error) {
+			throw new BackupError('notABackup', 'The file is not a lists backup');
+		}
+	}
+
+	if (!parsed || parsed.format !== BACKUP_FORMAT || !Array.isArray(parsed.lists)) throw new BackupError('notABackup', 'The file is not a lists backup');
+	if (typeof parsed.version !== 'number' || parsed.version > BACKUP_VERSION) throw new BackupError('unsupportedVersion', 'The backup was made by a newer version of the app');
+	return parsed as BackupFile;
+};
+
+// --- import --------------------------------------------------------------
+
+export interface ImportSummary {
+	listsAdded: number;
+	listsUpdated: number;
+	itemsAdded: number;
+	itemsUpdated: number;
+	itemsUnchanged: number;
+	membersAdded: number;
+	identityImported: boolean;
+}
+
+export interface ImportOptions {
+	// Called only when the backup contains a device identity; the identity is
+	// imported only if this resolves to true.
+	confirmIdentity?: ()=> Promise<boolean>;
+}
+
+const isHex = (value: unknown, length: number): value is string => typeof value === 'string' && value.length === length && /^[0-9a-f]+$/i.test(value);
+
+// Merges `backup` into the database. Local data that is newer always wins
+// (mergeItem, per-key customIcons, member `since`, profile `t`); nothing is
+// deleted. Items that the backup adds or improves are marked pending so the
+// next sync publishes them.
+export const importBackup = async (db: ListsDatabase, backup: BackupFile, options: ImportOptions = {}): Promise<ImportSummary> => {
+	const summary: ImportSummary = { listsAdded: 0, listsUpdated: 0, itemsAdded: 0, itemsUpdated: 0, itemsUnchanged: 0, membersAdded: 0, identityImported: false };
+
+	for (const entry of backup.lists) {
+		const incoming = entry.list;
+		const existing = await db.list(incoming.id);
+		let listChanged = false;
+
+		if (!existing) {
+			await db.importList({ ...incoming, sortOrder: 0 });
+			summary.listsAdded++;
+		} else {
+			// Keep local name/relays/sort order; only fill in what's missing, and
+			// merge the settings per key.
+			const settings = mergeListSettings(existing.settings, incoming.settings);
+			const merged: ListRecord = {
+				...existing,
+				listKey: existing.listKey ?? incoming.listKey,
+				contentKey: existing.contentKey ?? incoming.contentKey,
+				settings,
+			};
+			if (merged.listKey !== existing.listKey || merged.contentKey !== existing.contentKey || merged.settings !== existing.settings) {
+				await db.importList(merged);
+				listChanged = true;
+			}
+		}
+
+		const localMembers = new Map((await db.members(incoming.id)).map(m => [m.pubkey, m]));
+		for (const member of entry.members ?? []) {
+			const local = localMembers.get(member.pubkey);
+			if (!local) {
+				await db.upsertMember({ ...member, listId: incoming.id });
+				summary.membersAdded++;
+				listChanged = true;
+			} else if (member.since > local.since || (member.since === local.since && (member.removedAt ?? 0) > (local.removedAt ?? 0))) {
+				await db.upsertMember({ ...member, listId: incoming.id });
+				listChanged = true;
+			}
+		}
+
+		for (const profile of entry.profiles ?? []) await db.upsertProfileName(incoming.id, profile.pubkey, profile.name, profile.t);
+
+		let itemsTouched = 0;
+		for (const raw of entry.items ?? []) {
+			const incomingItem: ItemRecord = { ...raw, listId: incoming.id, pending: false };
+			const local = await db.item(incoming.id, incomingItem.dTag);
+			if (!local) {
+				await db.upsertItem({ ...incomingItem, pending: true });
+				summary.itemsAdded++;
+				itemsTouched++;
+				continue;
+			}
+			const mergedPayload = mergeItem(itemRecordToPayload(local), itemRecordToPayload(incomingItem));
+			const mergedRecord = payloadToItemRecord(incoming.id, incomingItem.dTag, mergedPayload, local.pending);
+			const withoutDevice = (record: ItemRecord) => JSON.stringify({ ...itemRecordToPayload(record), device: '' });
+			if (withoutDevice(mergedRecord) === withoutDevice(local)) {
+				summary.itemsUnchanged++;
+				continue;
+			}
+			await db.upsertItem({ ...mergedRecord, pending: true });
+			summary.itemsUpdated++;
+			itemsTouched++;
+		}
+		if (existing && (listChanged || itemsTouched)) summary.listsUpdated++;
+	}
+
+	if (backup.identity && isHex(backup.identity.secretKey, 64) && options.confirmIdentity && await options.confirmIdentity()) {
+		await db.setMeta('deviceSecretKey', backup.identity.secretKey.toLowerCase());
+		if (backup.identity.name) await db.setMeta('deviceName', backup.identity.name);
+		summary.identityImported = true;
+	}
+
+	log.info('Lists backup imported', { ...summary });
+	return summary;
+};
