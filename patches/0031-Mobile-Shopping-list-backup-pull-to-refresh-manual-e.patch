@@ -0,0 +1,70 @@
+import { optionalResyncPeers, REFRESH_TIMEOUT_MS, refreshMessage, runRefresh } from './pullRefresh';
+
+const never = (): Promise<void> => new Promise(() => {});
+
+describe('lists/ui/pullRefresh', () => {
+	afterEach(() => {
+		jest.useRealTimers();
+	});
+
+	test('reports "updated" when the relay sync finishes online', async () => {
+		const syncRelays = jest.fn(async () => {});
+		const result = await runRefresh({ syncRelays, isOnline: () => true });
+		expect(result).toEqual({ outcome: 'updated' });
+		expect(syncRelays).toHaveBeenCalledTimes(1);
+	});
+
+	test('reports "offline" when the relays were unreachable', async () => {
+		expect(await runRefresh({ syncRelays: async () => {}, isOnline: () => false })).toEqual({ outcome: 'offline' });
+	});
+
+	test('reports the error when the sync throws', async () => {
+		const result = await runRefresh({ syncRelays: async () => { throw new Error('boom'); }, isOnline: () => true });
+		expect(result).toEqual({ outcome: 'error', message: 'boom' });
+		expect(refreshMessage(result)).toBe('boom');
+	});
+
+	test('gives up after 15 seconds and ends the spinner', async () => {
+		jest.useFakeTimers();
+		let finished = false;
+		const promise = (async () => {
+			const r = await runRefresh({ syncRelays: never, isOnline: () => true });
+			finished = true;
+			return r;
+		})();
+
+		await jest.advanceTimersByTimeAsync(REFRESH_TIMEOUT_MS - 1);
+		expect(finished).toBe(false);
+		await jest.advanceTimersByTimeAsync(1);
+		expect(await promise).toEqual({ outcome: 'timeout' });
+		expect(REFRESH_TIMEOUT_MS).toBe(15000);
+		expect(refreshMessage({ outcome: 'timeout' })).toBe('Offline – changes will be sent later');
+	});
+
+	test('a custom timeout is honoured', async () => {
+		jest.useFakeTimers();
+		const promise = runRefresh({ syncRelays: never, isOnline: () => true, timeoutMs: 100 });
+		await jest.advanceTimersByTimeAsync(100);
+		expect(await promise).toEqual({ outcome: 'timeout' });
+	});
+
+	test('calls the optional Bluetooth resync alongside the relay sync, and a failing peer resync does not fail the refresh', async () => {
+		const resyncPeers = jest.fn(async () => { throw new Error('ble down'); });
+		const syncRelays = jest.fn(async () => {});
+		expect(await runRefresh({ syncRelays, resyncPeers, isOnline: () => true })).toEqual({ outcome: 'updated' });
+		expect(resyncPeers).toHaveBeenCalledTimes(1);
+	});
+
+	test('optionalResyncPeers only returns a function if the transport has one', async () => {
+		expect(optionalResyncPeers({ start: () => {} })).toBeUndefined();
+		expect(optionalResyncPeers(null)).toBeUndefined();
+		const transport = { calls: 0, async resyncPeers() { this.calls++; } };
+		await optionalResyncPeers(transport)!();
+		expect(transport.calls).toBe(1);
+	});
+
+	test('status line texts', () => {
+		expect(refreshMessage({ outcome: 'updated' })).toBe('Updated');
+		expect(refreshMessage({ outcome: 'offline' })).toBe('Offline – changes will be sent later');
+	});
+});
diff --git a/packages/app-mobile/lists/ui/pullRefresh.ts b/packages/app-mobile/lists/ui/pullRefresh.ts
new file mode 100644
index 0000000..65f9316
--- /dev/null
+++ b/packages/app-mobile/lists/ui/pullRefresh.ts
@@ -0,0 +1,102 @@
+// Pull-to-refresh logic for the list screens ("Herunterziehen zum
+// Aktualisieren", docs/KONZEPT.md section 2), kept free of React so it can be
+// tested directly: runs the relay sync, and -- only if the nearby transport
+// offers an optional resyncPeers() -- a Bluetooth resync, ends after at most
+// REFRESH_TIMEOUT_MS and reports what happened for the status line.
+import { _ } from '@joplin/lib/locale';
+import { debugLog } from '../../utils/debugLog';
+
+const log = debugLog('lists.sync');
+
+export const REFRESH_TIMEOUT_MS = 15000;
+
+export type RefreshOutcome = 'updated' | 'offline' | 'error' | 'timeout';
+
+export interface RefreshResult {
+	outcome: RefreshOutcome;
+	// Human-readable error text for outcome 'error'.
+	message?: string;
+}
+
+export interface RefreshSources {
+	// Syncs the list (or all lists) over the relays.
+	syncRelays: ()=> Promise<void>;
+	// True if the relays were reachable during the last sync.
+	isOnline: ()=> boolean;
+	// Optional: ask connected nearby devices for a fresh comparison.
+	resyncPeers?: ()=> Promise<void>;
+	timeoutMs?: number;
+	now?: ()=> number;
+}
+
+const withTimeout = async <T>(promise: Promise<T>, ms: number): Promise<T | 'timeout'> => {
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	const timeout = new Promise<'timeout'>(resolve => {
+		timer = setTimeout(() => resolve('timeout'), ms);
+	});
+	try {
+		return await Promise.race([promise, timeout]);
+	} finally {
+		clearTimeout(timer);
+	}
+};
+
+export const runRefresh = async (sources: RefreshSources): Promise<RefreshResult> => {
+	const now = sources.now ?? Date.now;
+	const timeoutMs = sources.timeoutMs ?? REFRESH_TIMEOUT_MS;
+	const start = now();
+	log.info('Pull-to-refresh started', { nearby: !!sources.resyncPeers });
+
+	const timed = async (label: string, run: ()=> Promise<void>): Promise<string> => {
+		const legStart = now();
+		try {
+			await run();
+			log.info(`Pull-to-refresh: ${label} done`, { ms: now() - legStart });
+			return 'ok';
+		} catch (error) {
+			log.warn(`Pull-to-refresh: ${label} failed`, { ms: now() - legStart, error: String(error) });
+			throw error;
+		}
+	};
+
+	const legs: Promise<string>[] = [timed('relays', sources.syncRelays)];
+	if (sources.resyncPeers) {
+		const resyncPeers = sources.resyncPeers;
+		// A failing Bluetooth resync (already logged by timed()) must not fail the refresh.
+		legs.push((async () => {
+			try {
+				return await timed('bluetooth', resyncPeers);
+			} catch (error) {
+				return 'peer-error';
+			}
+		})());
+	}
+
+	let result: RefreshResult;
+	try {
+		const settled = await withTimeout(Promise.all(legs), timeoutMs);
+		if (settled === 'timeout') result = { outcome: 'timeout' };
+		else result = { outcome: sources.isOnline() ? 'updated' : 'offline' };
+	} catch (error) {
+		result = { outcome: 'error', message: error instanceof Error ? error.message : String(error) };
+	}
+	log.info('Pull-to-refresh finished', { outcome: result.outcome, ms: now() - start });
+	return result;
+};
+
+// Status-line text for a refresh result.
+export const refreshMessage = (result: RefreshResult): string => {
+	switch (result.outcome) {
+	case 'updated': return _('Updated');
+	case 'offline':
+	case 'timeout': return _('Offline – changes will be sent later');
+	default: return result.message || _('Sync failed');
+	}
+};
+
+// Looks up the optional Bluetooth resync of the nearby transport without
+// depending on its (separately owned) interface.
+export const optionalResyncPeers = (transport: unknown): (()=> Promise<void>) | undefined => {
+	const candidate = (transport as { resyncPeers?: ()=> Promise<void> } | null)?.resyncPeers;
+	return typeof candidate === 'function' ? () => candidate.call(transport) : undefined;
+};
diff --git a/packages/app-mobile/lists/ui/usePullRefresh.ts b/packages/app-mobile/lists/ui/usePullRefresh.ts
new file mode 100644
index 0000000..139b971
--- /dev/null
+++ b/packages/app-mobile/lists/ui/usePullRefresh.ts
@@ -0,0 +1,47 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { refreshMessage, RefreshSources, runRefresh } from './pullRefresh';
+
+const MESSAGE_VISIBLE_MS = 5000;
+
+// React side of pull-to-refresh (see ./pullRefresh.ts): `refreshing` drives
+// the RefreshControl spinner, `message` is the short result text for the
+// screen's status line ("Updated", "Offline – changes will be sent later",
+// or the error), cleared again after a few seconds.
+const usePullRefresh = (buildSources: ()=> RefreshSources) => {
+	const [refreshing, setRefreshing] = useState(false);
+	const [message, setMessage] = useState<string | null>(null);
+	const busyRef = useRef(false);
+	const buildRef = useRef(buildSources);
+	buildRef.current = buildSources;
+	const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+	const unmountedRef = useRef(false);
+
+	useEffect(() => {
+		unmountedRef.current = false;
+		return () => {
+			unmountedRef.current = true;
+			if (timerRef.current) clearTimeout(timerRef.current);
+		};
+	}, []);
+
+	const onRefresh = useCallback(async () => {
+		if (busyRef.current) return;
+		busyRef.current = true;
+		setRefreshing(true);
+		setMessage(null);
+		try {
+			const result = await runRefresh(buildRef.current());
+			if (unmountedRef.current) return;
+			setMessage(refreshMessage(result));
+			if (timerRef.current) clearTimeout(timerRef.current);
+			timerRef.current = setTimeout(() => setMessage(null), MESSAGE_VISIBLE_MS);
+		} finally {
+			busyRef.current = false;
+			if (!unmountedRef.current) setRefreshing(false);
+		}
+	}, []);
+
+	return { refreshing, message, onRefresh };
+};
+
+export default usePullRefresh;
