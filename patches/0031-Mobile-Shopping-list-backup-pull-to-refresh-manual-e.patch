+import { customIconFor, isSingleEmoji, mergeListSettings, parseListSettings, resolveItemIcon, suggestEmojis, withCustomIcon } from './icons';
+
+describe('lists/core/icons', () => {
+	test.each([
+		['🍎', true],
+		['  🥛 ', true],
+		['👍🏽', true], // skin tone
+		['🧑‍🍳', true], // ZWJ sequence
+		['👨‍👩‍👧‍👦', true], // longer ZWJ sequence
+		['🇩🇪', true], // flag
+		['❤️', true], // symbol + variation selector
+		['1️⃣', true], // keycap
+		['🏴󠁧󠁢󠁥󠁮󠁧󠁿', true], // England flag (tag sequence)
+		['a', false],
+		['A', false],
+		['1', false],
+		['ab', false],
+		['🍎🍌', false],
+		['🍎a', false],
+		['', false],
+		['   ', false],
+		['Milch', false],
+	])('isSingleEmoji(%j) is %s', (input, expected) => {
+		expect(isSingleEmoji(input)).toBe(expected);
+	});
+
+	test('resolution order: item icon (by hand) -> customIcons -> catalog -> category emoji -> null', () => {
+		const settings = parseListSettings(withCustomIcon(null, 'Milch', '🐄', 1));
+		const base = { name: 'Milch', icon: null as string | null, category: null as string | null };
+
+		// 1. a hand-set item icon beats everything
+		expect(resolveItemIcon({ ...base, icon: '🧀' }, settings)).toBe('🧀');
+		// 2. then the list's customIcons -- even over the catalog emoji the item stored when it was added
+		expect(resolveItemIcon({ ...base, icon: '🥛' }, settings)).toBe('🐄');
+		expect(resolveItemIcon(base, settings)).toBe('🐄');
+		// 3. then the catalog
+		expect(resolveItemIcon(base, {})).toBe('🥛');
+		// 4. then the category emoji (no catalog entry for this name)
+		const unknown = { name: 'Zzzxqy', icon: null as string | null, category: 'obst_gemuese' as string | null };
+		const categoryResult = resolveItemIcon(unknown, {});
+		expect(categoryResult).toEqual(expect.any(String));
+		expect(isSingleEmoji(categoryResult as string)).toBe(true);
+		// 5. otherwise nothing (the UI draws the first letter)
+		expect(resolveItemIcon({ name: 'Zzzxqy', icon: null, category: null }, {})).toBeNull();
+		// a cleared icon ('') counts as none
+		expect(resolveItemIcon({ name: 'Zzzxqy', icon: '', category: null }, {})).toBeNull();
+	});
+
+	test('customIcons lookup uses the normalized name and ignores tombstones', () => {
+		let json = withCustomIcon(null, '  Milch ', '🐄', 5);
+		expect(customIconFor(parseListSettings(json), 'MILCH')).toBe('🐄');
+		json = withCustomIcon(json, 'milch', null, 6);
+		expect(customIconFor(parseListSettings(json), 'milch')).toBeNull();
+	});
+
+	test('suggestEmojis starts with the category emoji and offers similar catalog items without duplicates', () => {
+		const picks = suggestEmojis('Hafermilch', 'kuehlregal');
+		expect(picks.length).toBeGreaterThan(1);
+		expect(new Set(picks).size).toBe(picks.length);
+		expect(picks).toContain('🥛');
+		for (const emoji of picks) expect(isSingleEmoji(emoji)).toBe(true);
+	});
+
+	test('mergeListSettings merges customIcons per key by timestamp, symmetrically, instead of replacing the object', () => {
+		const a = withCustomIcon(withCustomIcon(null, 'Milch', '🐄', 10), 'Brot', '🍞', 10);
+		const b = withCustomIcon(withCustomIcon(null, 'Milch', '🥛', 20), 'Käse', '🧀', 5);
+
+		const ab = parseListSettings(mergeListSettings(a, b));
+		const ba = parseListSettings(mergeListSettings(b, a));
+		expect(ab).toEqual(ba);
+		expect(ab.customIcons).toEqual({ milch: '🥛', brot: '🍞', käse: '🧀' });
+		expect(ab.customIconsT?.milch).toBe(20);
+
+		// merging again changes nothing (idempotent)
+		expect(parseListSettings(mergeListSettings(JSON.stringify(ab), b))).toEqual(ab);
+		// a missing side keeps the other
+		expect(parseListSettings(mergeListSettings(null, a)).customIcons).toEqual({ milch: '🐄', brot: '🍞' });
+		expect(mergeListSettings(null, null)).toBeNull();
+	});
+
+	test('a newer tombstone removes an entry on merge', () => {
+		const a = withCustomIcon(null, 'Milch', '🐄', 10);
+		const b = withCustomIcon(null, 'Milch', null, 20);
+		expect(customIconFor(parseListSettings(mergeListSettings(a, b)), 'Milch')).toBeNull();
+		expect(customIconFor(parseListSettings(mergeListSettings(b, a)), 'Milch')).toBeNull();
+	});
+});
