@@ -0,0 +1,23 @@
+// CSV export of the local icon statistics ("Artikel ohne Icon zählen", see
+// docs/KONZEPT.md section 2). Semicolon-separated so German spreadsheet
+// programs open it directly.
+import { IconMissRow } from './db';
+
+const csvCell = (value: string): string => {
+	// A leading = + - @ would make a spreadsheet evaluate the cell as a formula.
+	let text = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+	if (/[;"\n\r]/.test(text)) text = `"${text.replace(/"/g, '""')}"`;
+	return text;
+};
+
+const isoDate = (ms: number): string => new Date(ms).toISOString().slice(0, 10);
+
+const iconMissesToCsv = (rows: IconMissRow[]): string => {
+	const lines = ['name;count;lists;first;last;chosenEmoji'];
+	for (const row of rows) {
+		lines.push([csvCell(row.displayName), String(row.count), String(row.listCount), isoDate(row.firstSeen), isoDate(row.lastSeen), csvCell(row.chosenEmoji ?? '')].join(';'));
+	}
+	return `${lines.join('\n')}\n`;
+};
+
+export default iconMissesToCsv;
