@@ -0,0 +1,102 @@
+import * as React from 'react';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { FlatList, Modal, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { _ } from '@joplin/lib/locale';
+import shim from '@joplin/lib/shim';
+import { themeStyle } from '../../components/global-style';
+import shareFile from '../../utils/shareFile';
+import { writeTextToCacheFile } from '../../utils/ShareUtils';
+import { getListsStore } from './listsRuntime';
+import { IconMissRow } from '../core/db';
+import iconMissesToCsv from '../core/iconStats';
+import { debugLog } from '../../utils/debugLog';
+
+const log = debugLog('lists.ui');
+
+interface Props {
+	visible: boolean;
+	themeId: number;
+	onClose: ()=> void;
+}
+
+const formatDate = (ms: number): string => new Date(ms).toISOString().slice(0, 10);
+
+// "Icon statistics": which items were added without a catalog icon, most
+// frequent first (see docs/KONZEPT.md section 2). Local to this device; the
+// only way out is the explicit CSV export.
+const IconStatsScreen: React.FC<Props> = ({ visible, themeId, onClose }) => {
+	const store = useMemo(() => getListsStore(), []);
+	const [rows, setRows] = useState<IconMissRow[]>([]);
+
+	const styles = useMemo(() => {
+		const theme = themeStyle(themeId);
+		return StyleSheet.create({
+			container: { flex: 1, backgroundColor: theme.backgroundColor },
+			header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: theme.margin },
+			title: { fontSize: theme.fontSize * 1.2, fontWeight: 'bold', color: theme.color },
+			button: { paddingVertical: 8, paddingHorizontal: 12 },
+			buttonText: { fontSize: theme.fontSize, color: theme.color4 },
+			row: { paddingHorizontal: theme.margin, paddingVertical: 10, borderBottomWidth: 1, borderBottomColor: theme.dividerColor },
+			name: { fontSize: theme.fontSize, color: theme.color },
+			meta: { fontSize: theme.fontSize * 0.8, color: theme.colorFaded },
+			empty: { padding: theme.margin, textAlign: 'center', color: theme.colorFaded, fontSize: theme.fontSize },
+			footer: { flexDirection: 'row', justifyContent: 'space-around', padding: theme.margin },
+		});
+	}, [themeId]);
+
+	const reload = useCallback(async () => setRows(await store.iconMisses()), [store]);
+	useEffect(() => {
+		if (visible) void reload();
+	}, [visible, reload]);
+
+	const onExportCsv = useCallback(async () => {
+		const path = await writeTextToCacheFile(iconMissesToCsv(rows), 'forklin-icon-statistics.csv');
+		log.info('Exporting icon statistics as CSV', { rows: rows.length });
+		try {
+			await shareFile(path, 'text/csv');
+		} finally {
+			await shim.fsDriver().remove(path);
+		}
+	}, [rows]);
+
+	const onClear = useCallback(async () => {
+		const ok = await shim.showConfirmationDialog(_('Delete all icon statistics on this device?'));
+		if (!ok) return;
+		await store.clearIconMisses();
+		await reload();
+	}, [store, reload]);
+
+	return (
+		<Modal visible={visible} animationType='slide' onRequestClose={onClose}>
+			<View style={styles.container}>
+				<View style={styles.header}>
+					<Text style={styles.title}>{_('Icon statistics')}</Text>
+					<TouchableOpacity style={styles.button} onPress={onClose} accessibilityRole='button'>
+						<Text style={styles.buttonText}>{_('Close')}</Text>
+					</TouchableOpacity>
+				</View>
+				<FlatList
+					data={rows}
+					keyExtractor={row => row.name}
+					ListEmptyComponent={<Text style={styles.empty}>{_('No items without an icon have been counted yet.')}</Text>}
+					renderItem={({ item }) => (
+						<View style={styles.row}>
+							<Text style={styles.name}>{item.chosenEmoji ? `${item.chosenEmoji} ` : ''}{item.displayName}</Text>
+							<Text style={styles.meta}>{_('%d times in %d lists, %s to %s', item.count, item.listCount, formatDate(item.firstSeen), formatDate(item.lastSeen))}</Text>
+						</View>
+					)}
+				/>
+				<View style={styles.footer}>
+					<TouchableOpacity style={styles.button} onPress={() => void onExportCsv()} disabled={!rows.length}>
+						<Text style={styles.buttonText}>{_('Export as CSV')}</Text>
+					</TouchableOpacity>
+					<TouchableOpacity style={styles.button} onPress={() => void onClear()} disabled={!rows.length}>
+						<Text style={styles.buttonText}>{_('Clear statistics')}</Text>
+					</TouchableOpacity>
+				</View>
+			</View>
+		</Modal>
+	);
+};
+
+export default IconStatsScreen;
