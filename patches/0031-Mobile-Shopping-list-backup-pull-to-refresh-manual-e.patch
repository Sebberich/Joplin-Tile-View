+import { rm } from 'fs-extra';
+import { join } from 'path';
+import { tmpdir } from 'os';
+import Database from '@joplin/lib/database';
+import { DatabaseDriverNode } from '@joplin/lib/database-driver-node';
+import uuid from '@joplin/lib/uuid';
+import { ListsDatabase } from './db';
+import { ListsStore } from './store';
+import iconMissesToCsv from './iconStats';
+import { customIconFor } from './icons';
+
+describe('lists/core/iconMisses', () => {
+	let enabled: boolean;
+	let store: ListsStore;
+	let path: string;
+
+	beforeEach(() => {
+		enabled = true;
+		path = join(tmpdir(), `tiles-lists-iconmiss-test-${uuid.createNano()}.sqlite`);
+		store = new ListsStore(new ListsDatabase(new Database(new DatabaseDriverNode())), path, { countIconMisses: () => enabled });
+	});
+
+	afterEach(async () => {
+		await rm(path, { force: true });
+	});
+
+	test('counts adds and re-opens of items without a catalog icon, per normalized name', async () => {
+		const a = await store.createOpenList('A');
+		const b = await store.createOpenList('B');
+
+		await store.addItem(a.id, 'Zzzxqy');
+		await store.addItem(a.id, ' zzzxqy '); // same normalized name, added again
+		await store.addItem(b.id, 'ZZZXQY');
+		const item = await store.addItem(a.id, 'Qqqwww');
+		await store.toggleOpen(a.id, item.dTag); // bought
+		await store.toggleOpen(a.id, item.dTag); // re-opened: counted
+
+		const rows = await store.iconMisses();
+		expect(rows.map(r => [r.name, r.count, r.listCount])).toEqual([['zzzxqy', 3, 2], ['qqqwww', 2, 1]]);
+		expect(rows[0].displayName).toBe('ZZZXQY');
+		expect(rows[0].firstSeen).toBeLessThanOrEqual(rows[0].lastSeen);
+	});
+
+	test('items with a catalog icon are not counted; category-only fallbacks are', async () => {
+		const list = await store.createOpenList('A');
+		await store.addItem(list.id, 'Milch');
+		await store.addItem(list.id, 'H-Milch');
+		expect(await store.iconMisses()).toEqual([]);
+
+		// "Obst" style names that only map to a category are misses too: here a name
+		// the catalog does not know at all, with a category set afterwards.
+		const item = await store.addItem(list.id, 'Zzzxqy');
+		await store.setCategory(list.id, item.dTag, 'obst_gemuese');
+		await store.toggleOpen(list.id, item.dTag);
+		await store.toggleOpen(list.id, item.dTag);
+		expect((await store.iconMisses())[0]).toMatchObject({ name: 'zzzxqy', count: 2 });
+	});
+
+	test('nothing is counted or recorded while the setting is off, and counting resumes when it is switched on', async () => {
+		enabled = false;
+		const list = await store.createOpenList('A');
+		const item = await store.addItem(list.id, 'Zzzxqy');
+		await store.setItemIcon(list.id, item.dTag, '🧿', true);
+		expect(await store.iconMisses()).toEqual([]);
+
+		enabled = true;
+		await store.addItem(list.id, 'Zzzxqy');
+		expect(await store.iconMisses()).toHaveLength(1);
+	});
+
+	test('manually chosen emojis are recorded, and clearing the statistics empties the table', async () => {
+		const list = await store.createOpenList('A');
+		const item = await store.addItem(list.id, 'Zzzxqy');
+		await store.setItemIcon(list.id, item.dTag, '🧿', true);
+
+		expect(await store.iconMisses()).toEqual([expect.objectContaining({ name: 'zzzxqy', count: 1, chosenEmoji: '🧿' })]);
+
+		// a name never counted before gets a row with count 0
+		const other = await store.addItem(list.id, 'Milch');
+		await store.setItemIcon(list.id, other.dTag, '🐄', false);
+		expect((await store.iconMisses()).map(r => r.name)).toEqual(['zzzxqy']); // has a catalog emoji: not a miss
+
+		await store.clearIconMisses();
+		expect(await store.iconMisses()).toEqual([]);
+	});
+
+	test('setItemIcon stores the emoji on the item and, with "always", in the list settings; reset reverts both', async () => {
+		const list = await store.createOpenList('A');
+		const item = await store.addItem(list.id, 'Milch');
+
+		await store.setItemIcon(list.id, item.dTag, '🐄', true);
+		let stored = (await store.items(list.id))[0];
+		expect(stored).toMatchObject({ icon: '🐄', pending: true });
+		expect(stored.iconT).toBeGreaterThan(item.iconT as number);
+		expect(customIconFor(await store.listSettings(list.id), 'Milch')).toBe('🐄');
+
+		await store.setItemIcon(list.id, item.dTag, null);
+		stored = (await store.items(list.id))[0];
+		expect(stored.icon).toBe('🥛'); // the catalog's emoji again
+		expect(customIconFor(await store.listSettings(list.id), 'Milch')).toBeNull();
+
+		// without "always", the list settings stay untouched
+		await store.setItemIcon(list.id, item.dTag, '🧀', false);
+		expect(customIconFor(await store.listSettings(list.id), 'Milch')).toBeNull();
+	});
+
+	test('setItemIcon rejects anything but a single emoji', async () => {
+		const list = await store.createOpenList('A');
+		const item = await store.addItem(list.id, 'Milch');
+		await expect(store.setItemIcon(list.id, item.dTag, 'M')).rejects.toThrow();
+		await expect(store.setItemIcon(list.id, item.dTag, '🍎🍌')).rejects.toThrow();
+		expect((await store.items(list.id))[0].icon).toBe('🥛');
+	});
+
+	test('cSV export has the documented columns and escapes spreadsheet-hostile cells', () => {
+		const csv = iconMissesToCsv([
+			{ name: 'a', displayName: 'Salz; fein', count: 3, listCount: 2, firstSeen: Date.UTC(2026, 8, 1), lastSeen: Date.UTC(2026, 9, 1), chosenEmoji: '🧂' },
+			{ name: 'b', displayName: '=SUM(A1)', count: 1, listCount: 1, firstSeen: Date.UTC(2026, 8, 2), lastSeen: Date.UTC(2026, 8, 2), chosenEmoji: null },
+		]);
+		expect(csv.split('\n')).toEqual([
+			'name;count;lists;first;last;chosenEmoji',
+			'"Salz; fein";3;2;2026-09-01;2026-10-01;🧂',
+			'\'=SUM(A1);1;1;2026-09-02;2026-09-02;',
+			'',
+		]);
+	});
+});
