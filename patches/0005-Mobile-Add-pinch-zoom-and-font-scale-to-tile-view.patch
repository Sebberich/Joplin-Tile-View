@@ -71,6 +71,17 @@ const useStyles = (themeId: number) => {
 	}, [themeId]);
 };
 
+// Two-finger distance, used by the pinch-to-zoom gesture below.
+const touchDistance = (touches: { pageX: number; pageY: number }[]) => {
+	const dx = touches[0].pageX - touches[1].pageX;
+	const dy = touches[0].pageY - touches[1].pageY;
+	return Math.sqrt(dx * dx + dy * dy);
+};
+
+// The pinch distance, in pixels, that triggers one zoom step. Matches the earlier plugin's
+// implementation.
+const pinchZoomThreshold = 60;
+
 // Note tiles are laid out in a fixed number of columns, using the same note data (and
 // selection/dispatch logic, in NoteTile.tsx) as the list view in NoteList.tsx.
 const NoteTileListComponent: React.FC<Props> = props => {
@@ -115,22 +126,67 @@ const NoteTileListComponent: React.FC<Props> = props => {
 	const items = folderIds.length ? (filteredNotes ?? []) : props.items;
 
 	// FlatList requires a remount (via `key`) when `numColumns` changes.
-	const numColumns = Math.min(4, Math.max(1, props.tileColumns || 1));
+	const numColumns = Math.min(5, Math.max(1, props.tileColumns || 1));
 
+	// Zoom steps match the earlier plugin's zoom() function: first the column count is changed,
+	// and once at either end of the column range, the font scale is changed instead.
 	const zoomIn = useCallback(() => {
 		const columns = Setting.value('notes.tileColumns');
-		if (columns > 1) Setting.setValue('notes.tileColumns', columns - 1);
+		if (columns > 1) {
+			Setting.setValue('notes.tileColumns', columns - 1);
+		} else {
+			Setting.setValue('notes.tileFontScale', Math.min(160, Setting.value('notes.tileFontScale') + 10));
+		}
 	}, []);
 
 	const zoomOut = useCallback(() => {
 		const columns = Setting.value('notes.tileColumns');
-		if (columns < 4) Setting.setValue('notes.tileColumns', columns + 1);
+		if (columns < 5) {
+			Setting.setValue('notes.tileColumns', columns + 1);
+		} else {
+			Setting.setValue('notes.tileFontScale', Math.max(60, Setting.value('notes.tileFontScale') - 10));
+		}
+	}, []);
+
+	const pinchStateRef = useRef<{ lastDistance: number }|null>(null);
+
+	const onStartShouldSetResponderCapture = useCallback((event: GestureResponderEvent) => {
+		return event.nativeEvent.touches.length === 2;
+	}, []);
+
+	const onResponderGrant = useCallback((event: GestureResponderEvent) => {
+		pinchStateRef.current = { lastDistance: touchDistance(event.nativeEvent.touches) };
+	}, []);
+
+	const onResponderMove = useCallback((event: GestureResponderEvent) => {
+		if (event.nativeEvent.touches.length !== 2 || !pinchStateRef.current) return;
+
+		const distance = touchDistance(event.nativeEvent.touches);
+		const delta = distance - pinchStateRef.current.lastDistance;
+		if (delta > pinchZoomThreshold) {
+			zoomIn();
+			pinchStateRef.current.lastDistance = distance;
+		} else if (-delta > pinchZoomThreshold) {
+			zoomOut();
+			pinchStateRef.current.lastDistance = distance;
+		}
+	}, [zoomIn, zoomOut]);
+
+	const onResponderEnd = useCallback(() => {
+		pinchStateRef.current = null;
 	}, []);
 
 	const toolbar = <NoteTileToolbar onZoomIn={zoomIn} onZoomOut={zoomOut}/>;
 
 	if (items.length) {
-		return <View style={styles.root}>
+		return <View
+			style={styles.root}
+			onStartShouldSetResponderCapture={onStartShouldSetResponderCapture}
+			onResponderGrant={onResponderGrant}
+			onResponderMove={onResponderMove}
+			onResponderRelease={onResponderEnd}
+			onResponderTerminate={onResponderEnd}
+		>
 			{toolbar}
 			<FlatList
 				key={`note-tile-list-${numColumns}`}
