+import * as React from 'react';
+import { useMemo } from 'react';
+import { connect } from 'react-redux';
+import { FlatList, StyleSheet, Text, TouchableHighlight, View, ViewStyle, TextStyle } from 'react-native';
+import Folder from '@joplin/lib/models/Folder';
+import Setting from '@joplin/lib/models/Setting';
+import { FolderEntity } from '@joplin/lib/services/database/types';
+import { AppState } from '../utils/types';
+import { toggleFolderSelection } from '../utils/tileFolderSelection';
+import { _ } from '@joplin/lib/locale';
+import Checkbox from './Checkbox';
+import Modal from './Modal';
+import { themeStyle } from './global-style';
+
+interface Props {
+	themeId: number;
+	folders: FolderEntity[];
+	selectedFolderIds: string[];
+	visible: boolean;
+	onClose: ()=> void;
+}
+
+interface FolderListItem {
+	id: string;
+	title: string;
+	depth: number;
+}
+
+const flattenFolderTree = (folders: FolderEntity[]): FolderListItem[] => {
+	const output: FolderListItem[] = [];
+	const addChildren = (folder: { id: string; title: string; children: FolderEntity[] }, depth: number) => {
+		output.push({ id: folder.id, title: Folder.displayTitle(folder), depth });
+		const children = [...folder.children].sort((a, b) => Folder.displayTitle(a).localeCompare(Folder.displayTitle(b)));
+		for (const child of children) addChildren(child as typeof folder, depth + 1);
+	};
+	const tree = Folder.buildTree(folders.filter(f => f.id !== Folder.conflictFolderId()));
+	const roots = [...tree].sort((a, b) => Folder.displayTitle(a).localeCompare(Folder.displayTitle(b)));
+	for (const root of roots) addChildren(root as unknown as { id: string; title: string; children: FolderEntity[] }, 0);
+	return output;
+};
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+
+		const container: ViewStyle = {
+			backgroundColor: theme.backgroundColor,
+			borderRadius: 4,
+			maxWidth: 600,
+			width: '90%',
+			maxHeight: '80%',
+			alignSelf: 'center',
+			marginVertical: 'auto',
+			padding: theme.margin,
+		};
+
+		const title: TextStyle = {
+			...theme.headerStyle,
+			marginBottom: theme.marginTop,
+		};
+
+		const row: ViewStyle = {
+			flexDirection: 'row',
+			alignItems: 'center',
+			paddingVertical: 8,
+		};
+
+		const rowLabel: TextStyle = {
+			color: theme.color,
+			fontSize: theme.fontSize,
+			marginLeft: 8,
+			flexShrink: 1,
+		};
+
+		return StyleSheet.create({
+			container,
+			title,
+			row,
+			rowLabel,
+			checkboxStyle: { color: theme.color },
+		});
+	}, [themeId]);
+};
+
+const NoteTileFolderDialogComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const items = useMemo(() => flattenFolderTree(props.folders), [props.folders]);
+
+	if (!props.visible) return null;
+
+	const setSelection = (ids: string[]) => {
+		Setting.setValue('notes.tileFolderIds', ids.join(','));
+	};
+
+	const onAllPress = () => setSelection([]);
+
+	const onFolderToggle = (folderId: string, checked: boolean) => {
+		setSelection(toggleFolderSelection(props.selectedFolderIds, folderId, checked, props.folders));
+	};
+
+	return (
+		<Modal
+			visible={props.visible}
+			onClose={props.onClose}
+			containerStyle={styles.container}
+			scrollOverflow={true}
+		>
+			<Text style={styles.title}>{_('Notebooks')}</Text>
+			<View style={styles.row}>
+				<Checkbox
+					style={styles.checkboxStyle}
+					checked={!props.selectedFolderIds.length}
+					onChange={onAllPress}
+					accessibilityLabel={_('All notebooks')}
+				/>
+				<Text style={styles.rowLabel}>{_('All notebooks')}</Text>
+			</View>
+			<FlatList
+				data={items}
+				keyExtractor={item => item.id}
+				renderItem={({ item }) => (
+					<TouchableHighlight onPress={() => onFolderToggle(item.id, !props.selectedFolderIds.includes(item.id))}>
+						<View style={[styles.row, { paddingLeft: 8 + item.depth * 20 }]}>
+							<Checkbox
+								style={styles.checkboxStyle}
+								checked={props.selectedFolderIds.includes(item.id)}
+								onChange={checked => onFolderToggle(item.id, checked)}
+								accessibilityLabel={item.title}
+							/>
+							<Text style={styles.rowLabel}>{item.title}</Text>
+						</View>
+					</TouchableHighlight>
+				)}
+			/>
+		</Modal>
+	);
+};
+
+const NoteTileFolderDialog = connect((state: AppState) => {
+	const raw = state.settings['notes.tileFolderIds'] as string;
+	return {
+		themeId: state.settings.theme,
+		folders: state.folders,
+		selectedFolderIds: raw ? raw.split(',').filter(Boolean) : [],
+	};
+})(NoteTileFolderDialogComponent);
+
+export default NoteTileFolderDialog;
