+import { FolderEntity } from '@joplin/lib/services/database/types';
+import { toggleFolderSelection } from './tileFolderSelection';
+
+const makeFolder = (id: string, parentId: string): FolderEntity => ({ id, parent_id: parentId } as FolderEntity);
+
+describe('tileFolderSelection', () => {
+	const folders: FolderEntity[] = [
+		makeFolder('parent', ''),
+		makeFolder('child1', 'parent'),
+		makeFolder('child2', 'parent'),
+		makeFolder('grandchild', 'child1'),
+		makeFolder('other', ''),
+	];
+
+	test('checking a parent folder also checks all of its descendants', () => {
+		const result = toggleFolderSelection([], 'parent', true, folders);
+		expect(result.sort()).toEqual(['child1', 'child2', 'grandchild', 'parent'].sort());
+	});
+
+	test('unchecking a single child only removes that child', () => {
+		const selected = ['parent', 'child1', 'child2', 'grandchild'];
+		const result = toggleFolderSelection(selected, 'child2', false, folders);
+		expect(result.sort()).toEqual(['parent', 'child1', 'grandchild'].sort());
+	});
+
+	test('unchecking a parent folder also removes all of its descendants', () => {
+		const selected = ['parent', 'child1', 'child2', 'grandchild', 'other'];
+		const result = toggleFolderSelection(selected, 'parent', false, folders);
+		expect(result.sort()).toEqual(['other'].sort());
+	});
+});
