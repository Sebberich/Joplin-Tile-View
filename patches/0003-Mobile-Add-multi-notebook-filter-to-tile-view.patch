@@ -0,0 +1,41 @@
+import { FolderEntity } from '@joplin/lib/services/database/types';
+
+// Builds a map from folder ID to the IDs of its direct children.
+const buildChildrenMap = (folders: FolderEntity[]) => {
+	const childrenMap: Record<string, string[]> = {};
+	for (const folder of folders) {
+		const parentId = folder.parent_id || '';
+		childrenMap[parentId] ??= [];
+		childrenMap[parentId].push(folder.id);
+	}
+	return childrenMap;
+};
+
+// All descendant folder IDs (children, grandchildren, ...) of `folderId`.
+export const getDescendantFolderIds = (folderId: string, folders: FolderEntity[]) => {
+	const childrenMap = buildChildrenMap(folders);
+	const output: string[] = [];
+	const stack = [...(childrenMap[folderId] ?? [])];
+	while (stack.length) {
+		const id = stack.pop();
+		output.push(id);
+		for (const childId of childrenMap[id] ?? []) stack.push(childId);
+	}
+	return output;
+};
+
+// Toggles a folder's selection, applying the parent/child rule: checking a folder also checks
+// all of its descendants, and unchecking a folder also unchecks all of its descendants. A
+// descendant can still be checked or unchecked on its own afterward.
+export const toggleFolderSelection = (selectedIds: string[], folderId: string, checked: boolean, folders: FolderEntity[]) => {
+	const ids = [folderId, ...getDescendantFolderIds(folderId, folders)];
+	const selected = new Set(selectedIds);
+	for (const id of ids) {
+		if (checked) {
+			selected.add(id);
+		} else {
+			selected.delete(id);
+		}
+	}
+	return [...selected];
+};
