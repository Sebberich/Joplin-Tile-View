@@ -0,0 +1,140 @@
+import * as React from 'react';
+import { useMemo, useState } from 'react';
+import { connect } from 'react-redux';
+import { Text, StyleSheet, TouchableHighlight, View, ViewStyle, TextStyle } from 'react-native';
+import Setting from '@joplin/lib/models/Setting';
+import { FolderEntity } from '@joplin/lib/services/database/types';
+import { AppState } from '../utils/types';
+import { _ } from '@joplin/lib/locale';
+import IconButton from './IconButton';
+import NoteTileFolderDialog from './NoteTileFolderDialog';
+import { themeStyle } from './global-style';
+
+interface Props {
+	themeId: number;
+	folders: FolderEntity[];
+	selectedFolderIds: string[];
+	tileColumns: number;
+	onZoomIn: ()=> void;
+	onZoomOut: ()=> void;
+}
+
+const useStyles = (themeId: number) => {
+	return useMemo(() => {
+		const theme = themeStyle(themeId);
+
+		const root: ViewStyle = {
+			flexDirection: 'row',
+			alignItems: 'center',
+			paddingHorizontal: theme.marginLeft / 2,
+			paddingVertical: 4,
+			borderBottomWidth: 1,
+			borderBottomColor: theme.dividerColor,
+		};
+
+		const folderButton: ViewStyle = {
+			flexDirection: 'row',
+			alignItems: 'center',
+			flexShrink: 1,
+			paddingVertical: 6,
+			paddingHorizontal: 8,
+		};
+
+		const folderButtonLabel: TextStyle = {
+			color: theme.color,
+			fontSize: theme.fontSize,
+			marginLeft: 6,
+		};
+
+		const spacer: ViewStyle = { flexGrow: 1 };
+
+		const icon: TextStyle = {
+			color: theme.color,
+			fontSize: theme.fontSizeLarger,
+			width: 32,
+			textAlign: 'center',
+		};
+
+		return StyleSheet.create({
+			root,
+			folderButton,
+			folderButtonLabel,
+			spacer,
+			icon,
+		});
+	}, [themeId]);
+};
+
+const folderTitleById = (folders: FolderEntity[], id: string) => {
+	return folders.find(f => f.id === id)?.title ?? '';
+};
+
+const NoteTileToolbarComponent: React.FC<Props> = props => {
+	const styles = useStyles(props.themeId);
+	const [folderDialogVisible, setFolderDialogVisible] = useState(false);
+
+	const folderLabel = useMemo(() => {
+		if (!props.selectedFolderIds.length) return _('All notebooks');
+		if (props.selectedFolderIds.length === 1) return folderTitleById(props.folders, props.selectedFolderIds[0]) || _('1 notebook');
+		return _('%d notebooks', props.selectedFolderIds.length);
+	}, [props.selectedFolderIds, props.folders]);
+
+	const onSwitchToListPress = () => {
+		Setting.setValue('notes.mobileLayout', 'list');
+	};
+
+	return (
+		<View style={styles.root}>
+			<TouchableHighlight onPress={() => setFolderDialogVisible(true)} accessibilityRole='button'>
+				<View style={styles.folderButton}>
+					<IconButton
+						iconName='fas fa-folder'
+						onPress={() => setFolderDialogVisible(true)}
+						description={_('Filter by notebook')}
+						iconStyle={styles.icon}
+						themeId={props.themeId}
+					/>
+					<Text style={styles.folderButtonLabel} numberOfLines={1}>{folderLabel}</Text>
+				</View>
+			</TouchableHighlight>
+			<View style={styles.spacer}/>
+			<IconButton
+				iconName='fas fa-minus'
+				onPress={props.onZoomOut}
+				description={_('Smaller')}
+				iconStyle={styles.icon}
+				themeId={props.themeId}
+			/>
+			<IconButton
+				iconName='fas fa-plus'
+				onPress={props.onZoomIn}
+				description={_('Larger')}
+				iconStyle={styles.icon}
+				themeId={props.themeId}
+			/>
+			<IconButton
+				iconName='fas fa-list'
+				onPress={onSwitchToListPress}
+				description={_('Switch to list view')}
+				iconStyle={styles.icon}
+				themeId={props.themeId}
+			/>
+			<NoteTileFolderDialog
+				visible={folderDialogVisible}
+				onClose={() => setFolderDialogVisible(false)}
+			/>
+		</View>
+	);
+};
+
+const NoteTileToolbar = connect((state: AppState) => {
+	const raw = state.settings['notes.tileFolderIds'] as string;
+	return {
+		themeId: state.settings.theme,
+		folders: state.folders,
+		selectedFolderIds: raw ? raw.split(',').filter(Boolean) : [],
+		tileColumns: state.settings['notes.tileColumns'],
+	};
+})(NoteTileToolbarComponent);
+
